      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 707040119,
          "type": null,
          "body": "I don't know why the heck POSIX makes `st_blksize` a signed integer, but here we are.\n\nFortunately, `MAX_READ_BUF_SIZE` is less than the largest 32-bit signed value, so casting it to `long` on an ILP32 platform, where `long` is 32 bits, won't turn it into a negative value.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
