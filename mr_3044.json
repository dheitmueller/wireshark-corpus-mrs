        }
      ]
    },
    {
      "id": "686e33509c93a7d6b9e51d8a91f20b72bb672784",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 580922153,
          "type": null,
          "body": "I mean (manually) optimize away in the same sense one would disable a debugging printf().",
