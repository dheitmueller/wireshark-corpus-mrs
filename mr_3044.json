    {
      "id": "259a289e381ff25b6ba96ef73db87a1b4440a064",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 580616665,
          "type": null,
          "body": "> The fact that we may choose to optimize it away under certain conditions\n\nPresumably by \"other conditions\" you mean something other than \"`WS_DISABLE_ASSERT` being defined\" - that's not \"optimizing it away\", that's \"explicitly removing it\".  \"Optimizing it away\" means \"not doing the test if the compiler can prove that it will always succeed\".",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-05-20T09:13:11.948Z",
          "updated_at": "2021-05-20T09:13:11.948Z",
