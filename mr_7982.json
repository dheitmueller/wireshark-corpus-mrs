      "notes": [
        {
          "id": 1084570809,
          "type": "DiscussionNote",
          "body": "> If we need to use a member of it (seq) as a key in a map that is declared at file scope, it needs to be copied to a key also declared in file scope.\n\nSo is the key an integer or a pointer to an integer?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-08-31T23:17:41.900Z",
          "updated_at": "2022-08-31T23:23:47.839Z",
          "system": false,
          "noteable_id": 174581498,
