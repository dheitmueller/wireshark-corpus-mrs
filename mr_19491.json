      "diff": "@@ -114,6 +114,7 @@ static int bit_tohex(lua_State *L)\n   const char *hexdigits = \"0123456789abcdef\";\n   char buf[8];\n   int i;\n+  if (n == INT32_MIN) n = INT32_MIN+1;\n   if (n < 0) { n = -n; hexdigits = \"0123456789ABCDEF\"; }\n   if (n > 8) n = 8;\n   for (i = (int)n; --i >= 0; ) { buf[i] = hexdigits[b & 15]; b >>= 4; }\n",
