  "changes_data": [
    {
      "diff": "@@ -413,7 +413,7 @@ own mkstemp implementation for use on platforms that lack mkstemp.\n Note: mkstemp does not accept NULL as a parameter.\n \n Wireshark requires minimum versions of each of the libraries it uses, in\n-particular GLib 2.38.0 and Qt 5.3.0 or newer. If you require a mechanism\n+particular GLib 2.38.0 and Qt 5.6.0 or newer. If you require a mechanism\n that is available only in a newer version of a library then use its\n version detection macros, e.g. \"#if GLIB_CHECK_VERSION(...)\" and \"#if\n QT_VERSION_CHECK(...)\" to conditionally compile code using that\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/README.developer",
      "old_path": "doc/README.developer",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -15,7 +15,7 @@ README.windows for those instructions.\n    development packages installed. Try running\n    'pkg-config glib-2.0 --modversion' to see if you have GLib 2.x\n    installed.  Then try running 'pkg-config Qt5Widgets --modversion'\n-   to see if you have Qt installed. Wireshark requires Qt 5.3 or later,\n+   to see if you have Qt installed. Wireshark requires Qt 5.6 or later,\n    but the most recent LTS release is strongly recommended. It needs\n    version 2.38.0 or above of GLib.  If you need to install or\n    re-install GLIB, you can find the packages at:\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "INSTALL",
