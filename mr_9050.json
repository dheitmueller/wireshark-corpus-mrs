        {
          "id": 1209290687,
          "type": "DiscussionNote",
          "body": "Holding the Ctrl button would work for me but I fear that the need for holding the Ctrl button would actually hide this feature from many users. How would the average user know that this option exist?\n\nHow about a different order of the items of the context menu?\nCould this help to make the context menu more clear?",
          "author": {
            "id": 7625625,
            "username": "Developer-Alexander",
            "public_email": "",
            "name": "Developer Alexander",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/81b3f01484e58a678d9a77825dd6726e0e7e2383b67d9a16215a35fe0a729529?s=80&d=identicon",
            "web_url": "https://gitlab.com/Developer-Alexander"
          },
          "created_at": "2022-12-14T14:41:09.888Z",
          "updated_at": "2022-12-14T14:41:09.888Z",
          "system": false,
          "noteable_id": 193312945,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
