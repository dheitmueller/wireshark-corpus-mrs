      "diff": "@@ -143,10 +143,16 @@ static bool dCMAC(const eax_s *instance, uint8_t *pK, uint8_t *ws, const uint8_t\n         return false;\n     }\n \n-    /* worksize must be an integral multiple of 16 */\n-    worksize = WS_ROUNDUP_16(SizeT);\n-    /* WS_ROUNDUP_16 can \"round up\" to 0, but then g_malloc will\n-     * safely return NULL and we'll return false. */\n+    /* worksize must be an integral multiple of 16, with at least 16 bytes for CMAC padding */\n+    if (SizeT == 0) {\n+        worksize = EAX_SIZEOF_KEY;\n+    } else {\n+        worksize = WS_ROUNDUP_16(SizeT);\n+        if (worksize == 0) {\n+            /* WS_ROUNDUP_16 overflowed */\n+            return false;\n+        }\n+    }\n     work = (uint8_t *)g_malloc(worksize);\n     if (work == NULL) {\n         return false;\n",
