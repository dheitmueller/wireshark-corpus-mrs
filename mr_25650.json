      "diff": "@@ -137,9 +137,6 @@ indent_size = tab\n indent_style = tab\n indent_size = tab\n \n-[tvbuff_base64.[ch]]\n-indent_size = 2\n-\n [tvbuff_composite.[ch]]\n indent_style = tab\n indent_size = tab\n",
      "collapsed": false,
