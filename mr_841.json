    {
      "id": "3980033b20b45519e48f6b3077db80c3d8acd330",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 441717297,
          "type": null,
          "body": "@AndersBroman SendParameters is not defined for TS 29.002, only for GSM 09.02. That said SubscriberId is defined for TS 29.002 and hasn't changed since. This has never been changed between the protocol versions, it looks like a simple confusion since the two types look alike (SubscriberId vs SubscriberIdentity). SubscriberIdentity was never used in the context of SendParameters operation.\n\nEDIT: Fixed spelling and grammar.",
          "author": {
            "id": 7560614,
            "username": "DrBuchkov",
            "public_email": "",
            "name": "Nikolas Pafitis",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/a36769a4b22ebb56cf87aa5f1730ecf29c44c7adc3bf7aca4119a5f8f00ce851?s=80&d=identicon",
