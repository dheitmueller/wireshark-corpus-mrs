      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1433596923,
          "type": null,
          "body": "I don't. This is my own \"clean-room\" implementation based on dissecting the protocol transfer and information available [here](https://scapy.readthedocs.io/en/latest/api/scapy.contrib.automotive.bmw.hsfz.html).\n\nIf you think this is problematic, I'm fine to close the pull request and keep it in my private fork.",
          "author": {
            "id": 3549585,
            "username": "mickeyl",
            "public_email": "",
            "name": "Dr. Mickey Lauer",
