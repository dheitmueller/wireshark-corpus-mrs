    {
      "diff": "@@ -0,0 +1,191 @@\n+/* packet-hsfz.c\n+ *\n+ * Routines for BMW High-Speed-Fahrzeug-Zugang Protocol dissection\n+ *\n+ * Copyright 2022-2023, Dr. Michael 'Mickey' Lauer <mickey@vanille.de>\n+ *\n+ * Wireshark - Network traffic analyzer\n+ * By Gerald Combs <gerald@wireshark.org>\n+ * Copyright 1998 Gerald Combs\n+ *\n+ * SPDX-License-Identifier: GPL-2.0-or-later\n+ */\n+\n+/*\n+ * BMW High-Speed-Fahrzeug-Zugang (HSFZ) Protocol (TCP Port 6801) Wireshark Dissector\n+ *\n+ * For decrypting network traffic between a BMW ZGW central gateway\n+ * and an automotive diagnostic tester application.\n+ *\n+ * HSFZ encapsulates standard UDS packets by adding a small header including the\n+ * payload length, a message type, and a pair of source ECU and destination ECU.\n+ * It is a proprietary protocol that has been in use since the late 2000s, and by now\n+ * shipped in millions of vehicles all around the world.\n+ *\n+ * It can be viewed as the inofficial predeccessor to DoIP (Diagnostics over IP).\n+ *\n+ * Protocol\tMessage, Port 6801\n+ *\n+ *         +-------+-------+-------+-------+------+------+------+------+---------------+\n+ *  TCP    | Big-endian 32-bit byte count  +  MSG Type   + SRC  + DST  +  UDS Payload  |\n+ *         +-------+-------+-------+-------+------+------+------+------+---------------+\n+ *\n+ */\n+\n+#include <assert.h>\n+#include <config.h>\n+#include <epan/packet.h>\n+#include <epan/address.h>\n+#include <epan/conversation.h>\n+#include <epan/wmem_scopes.h>\n+#include \"packet-tcp.h\"\n+\n+#define HSFZ_PORT                6801            /* Not IANA registered */\n+#define FRAME_HEADER_LEN\t     6               /* 6 bytes of TCP frame length header info */\n+\n+#define HSFZ_MESSAGE             0x0001\n+#define HSFZ_ECHO                0x0002\n+#define HSFZ_INVALID_SOURCE      0x0040\n+#define HSFZ_INVALID_TYPE        0x0041\n+#define HSFZ_INVALID_LENGTH      0x0042\n+#define HSFZ_INVALID_DESTINATION 0x0043\n+\n+/* Message Types */\n+static const value_string hsfz_message_types[] = {\n+  { HSFZ_MESSAGE,                \"MESSAGE\" },\n+  { HSFZ_ECHO,                   \"ECHO\" },\n+  { HSFZ_INVALID_SOURCE,         \"INVALID SOURCE\" },\n+  { HSFZ_INVALID_TYPE,           \"INVALID TYPE\" },\n+  { HSFZ_INVALID_LENGTH,         \"INVALID LENGTH\" },\n+  { HSFZ_INVALID_DESTINATION,    \"INVALID DESTINATION\" },\n+  { 0, NULL }\n+};\n+\n+/* Initialize the protocol and registered fields */\n+static dissector_handle_t uds_handle;\n+\n+static int\tproto_hsfz\t= -1;\n+static gint\tett_hsfz\t= -1;\n+\n+static int\thf_hsfz_payload_length\t= -1;\n+static int\thf_hsfz_message_type\t= -1;\n+static int\thf_hsfz_source_address\t= -1;\n+static int\thf_hsfz_destination_address\t= -1;\n+\n+/* Dissect a single HSFZ message. */\n+static int\n+dissect_hsfz_message(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree,\n+        void *data _U_)\n+{\n+    proto_item *ti;\n+    proto_tree *hsfz_tree;\n+\n+    guint32 hsfz_payload_length = tvb_get_guint32(tvb, 0, ENC_BIG_ENDIAN);\n+    guint16 hsfz_message_type = tvb_get_guint16(tvb, 4, ENC_BIG_ENDIAN);\n+    guint8 hsfz_source_address = hsfz_payload_length > 0 ? tvb_get_guint8(tvb, 6) : 0;\n+    guint8 hsfz_destination_address = hsfz_payload_length > 1 ? tvb_get_guint8(tvb, 7) : 0;\n+\n+    if (try_val_to_str(hsfz_message_type, hsfz_message_types) == NULL)\n+        return 0;\n+\n+    col_set_str(pinfo->cinfo, COL_PROTOCOL, \"HSFZ\");\t\t\t\t    /* show the protocol name of what we're dissecting */\n+    col_clear(pinfo->cinfo, COL_INFO);\t\t\t    \t\t\t\t    /* and clear anything that might be in the Info field on the UI */\n+    switch (hsfz_message_type) {\n+        case HSFZ_MESSAGE:\n+            col_add_fstr(pinfo->cinfo, COL_INFO, \"MESSAGE 0x%02X -> 0x%02X\",\n+                hsfz_source_address, hsfz_destination_address);\n+            break;\n+        default:\n+            col_add_str(pinfo->cinfo, COL_INFO,\n+                val_to_str(hsfz_message_type, hsfz_message_types, \"Unknown Message Type(%d)\"));\n+            break;\n+    }\n+\n+    ti = proto_tree_add_item(tree, proto_hsfz, tvb, 0, -1, ENC_NA);\t\t/* create display subtree for this protocol */\n+    proto_item_append_text(ti, \", %s\",\n+        val_to_str(hsfz_message_type, hsfz_message_types, \"Unknown Message Type(%d)\"));\n+\n+    hsfz_tree = proto_item_add_subtree(ti, ett_hsfz);\t\t            /* and add it to the display tree */\n+\n+    proto_tree_add_item(hsfz_tree, hf_hsfz_payload_length, tvb, 0, 4, ENC_BIG_ENDIAN); /* length */\n+    proto_tree_add_item(hsfz_tree, hf_hsfz_message_type, tvb, 4, 2, ENC_BIG_ENDIAN); /* message type */\n+\n+    if (hsfz_payload_length > 0) { /* source address */\n+        proto_tree_add_item(hsfz_tree, hf_hsfz_source_address, tvb, 6, 1, ENC_BIG_ENDIAN);\n+        proto_item_append_text(ti, \", Src: 0x%02X\", hsfz_source_address);\n+    }\n+    if (hsfz_payload_length > 1) { /* destination address */\n+        proto_tree_add_item(hsfz_tree, hf_hsfz_destination_address, tvb, 7, 1, ENC_BIG_ENDIAN);\n+        proto_item_append_text(ti, \", Dst: 0x%02X\", hsfz_destination_address);\n+    }\n+    if (hsfz_payload_length > 2 && hsfz_message_type == HSFZ_MESSAGE) { /* call UDS to dissect the payload */\n+        call_dissector(uds_handle, tvb_new_subset_remaining(tvb, FRAME_HEADER_LEN + 2), pinfo, tree);\n+    }\n+    return FRAME_HEADER_LEN + hsfz_payload_length;\n+}\n+\n+/* Compute the length of the message. */\n+static guint\n+get_hsfz_message_len(packet_info *pinfo _U_, tvbuff_t *tvb, int offset, void *data _U_)\n+{\n+    return (guint)tvb_get_ntohl(tvb, offset) + FRAME_HEADER_LEN;\n+}\n+\n+/* The main dissector function. */\n+static int\n+dissect_hsfz(tvbuff_t *tvb , packet_info *pinfo, proto_tree *tree, void *data)\n+{\n+    tcp_dissect_pdus(tvb, pinfo, tree, TRUE, FRAME_HEADER_LEN,\n+        get_hsfz_message_len, dissect_hsfz_message, data);\n+    return tvb_captured_length(tvb);\n+}\n+\n+/* Register the protocol with Wireshark. */\n+void\n+proto_register_hsfz(void)\n+{\n+    static hf_register_info hf[] = {\n+        { &hf_hsfz_payload_length,\n+            { \"Length\", \"hsfz.len\",\n+                FT_UINT32, BASE_DEC, NULL, 0,\n+                \"Message Length\", HFILL }\n+        },\n+        { &hf_hsfz_message_type,\n+            { \"Type\", \"hsfz.type\",\n+              FT_UINT16, BASE_DEC, VALS(hsfz_message_types), 0,\n+              \"Message Type\", HFILL }\n+        },\n+        { &hf_hsfz_source_address,\n+            { \"Source\", \"hsfz.source\",\n+              FT_UINT8, BASE_HEX, NULL, 0,\n+              \"Source Address\", HFILL }\n+        },\n+        { &hf_hsfz_destination_address,\n+            { \"Destination\", \"hsfz.dest\",\n+              FT_UINT8, BASE_HEX, NULL, 0,\n+              \"Destination Address\", HFILL }\n+        },\n+    };\n+    \n+    static gint *ett[] = {\n+        &ett_hsfz\n+    };\n+    \n+\n+    proto_hsfz = proto_register_protocol(\"High-Speed-Fahrzeug-Zugang\",\n+            \"HSFZ\", \"hsfz\");\n+\n+    proto_register_field_array(proto_hsfz, hf, array_length(hf));\n+    proto_register_subtree_array(ett, array_length(ett));\n+}\n+\n+void\n+proto_reg_handoff_hsfz(void)\n+{\n+    dissector_handle_t hsfz_handle;\n+\n+    hsfz_handle = create_dissector_handle(dissect_hsfz, proto_hsfz);\n+    dissector_add_uint_with_preference(\"tcp.port\", HSFZ_PORT, hsfz_handle);\n+ \n+    uds_handle = find_dissector(\"uds\");\n+}\n\\ No newline at end of file\n",
      "collapsed": false,
      "too_large": false,
