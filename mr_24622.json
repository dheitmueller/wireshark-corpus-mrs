  "changes_data": [
    {
      "diff": "@@ -980,6 +980,14 @@ macOS Build:\n     # The cache should be large enough to be useful but it shouldn't take\n     # too long to restore+save each run.\n     - ccache --max-size $( gdu --summarize --block-size=1M \"$CI_PROJECT_DIR/build\" | awk '{printf (\"%dM\", $1 * 1.5)}' )\n+  # allow_failure: true\n+  # https://support.gitlab.com/hc/en-us/articles/20417424085020-GitLab-com-hosted-macOS-runners-stuck-preparing-the-instance\n+  timeout: 45 minutes\n+  retry:\n+    max: 2\n+    when:\n+      - runner_system_failure\n+      - stuck_or_timeout_failure\n   artifacts:\n     when: always\n     reports:\n",
