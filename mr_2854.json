        "21b334fd827c9e37c8973ab7e6625784726be243"
      ],
      "title": "Don't cast away upper bits when assigning to a nstime_t's secs field.",
      "message": "Don't cast away upper bits when assigning to a nstime_t's secs field.\n\nThe secs field is a time_t, which is not necessarily 32 bits.  If it's\nnot, casting away the upper bits, by casting to guint32, introduces a\nY2.038K bug.\n\nEither cast to time_t or, if you're assigning a time_t to it, don't\nbother with the cast.\n",
      "author_name": "Guy Harris",
      "author_email": "gharris@sonic.net",
      "authored_date": "2021-04-28T13:16:29.000-07:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-04-28T21:31:15.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/eb4d68033e33b6aa23b293ee070c5c799381aba4"
    }
