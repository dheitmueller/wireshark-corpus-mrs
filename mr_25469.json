  "changes_data": [
    {
      "diff": "@@ -1353,6 +1353,7 @@ Code Lines and Data:\n     INSTALL_PREFIX: \"$CI_PROJECT_DIR/_install\"\n     MIN_PLUGINS: 10\n     MAX_PASSES: 15\n+    FUZZ_STDERR: \"/tmp/fuzz/fuzz-test.err\"\n   before_script:\n     - source /clang-latest.env\n     - DEBIAN_FRONTEND=noninteractive apt-get update\n@@ -1377,7 +1378,7 @@ Code Lines and Data:\n     - FUZZ_CAPTURE=$( basename $( find . -name \"fuzz-*.pcap\" -o -name \"randpkt-*.pcap\" | head -n 1 ) )\n     - FUZZ_ERRORS=\"$( basename \"$FUZZ_CAPTURE\" .pcap ).err\"\n     - printf \"\\nfuzz-test.sh stderr:\\n\" >> \"$FUZZ_ERRORS\"\n-    - cat fuzz-test.err >> \"$FUZZ_ERRORS\"\n+    - cat \"$FUZZ_STDERR\" >> \"$FUZZ_ERRORS\"\n     - rclone config create wireshark $WS_RCLONE_REMOTE_OPTS > /dev/null\n     - if [ -n \"$S3_DESTINATION_FUZZ\" ] ; then rclone copy . \"wireshark:$S3_DESTINATION_FUZZ\" --include \"$FUZZ_CAPTURE\" --include \"$FUZZ_ERRORS\" ; fi\n \n@@ -1397,7 +1398,7 @@ ASan Menagerie Fuzz:\n     - FUZZ_PASSED=true\n     # /var/menagerie contains captures harvested from wireshark.org's mailing list, wiki, issues, etc.\n     # We have more captures than we can fuzz in $MAX_SECONDS, so we shuffle them each run.\n-    - ./tools/fuzz-test.sh -a -2 -P $MIN_PLUGINS -b $INSTALL_PREFIX/bin -d /tmp/fuzz -t $MAX_SECONDS $( shuf -e /var/menagerie/*/* ) 2> fuzz-test.err || FUZZ_PASSED=false\n+    - ./tools/fuzz-test.sh -a -2 -P $MIN_PLUGINS -b $INSTALL_PREFIX/bin -d /tmp/fuzz -t $MAX_SECONDS $( shuf -e /var/menagerie/*/* ) 2> \"$FUZZ_STDERR\" || FUZZ_PASSED=false\n     # Signal after_script, which runs in its own shell.\n     - echo \"export FUZZ_PASSED=$FUZZ_PASSED\" > /tmp/fuzz_result.sh\n     - $FUZZ_PASSED\n@@ -1416,7 +1417,7 @@ ASan randpkt Fuzz:\n     - ninja install\n     - cd ..\n     - FUZZ_PASSED=true\n-    - ./tools/randpkt-test.sh -a -b $INSTALL_PREFIX/bin -d /tmp/fuzz -p $MAX_PASSES 2> fuzz-test.err || FUZZ_PASSED=false\n+    - ./tools/randpkt-test.sh -a -b $INSTALL_PREFIX/bin -d /tmp/fuzz -p $MAX_PASSES 2> \"$FUZZ_STDERR\" || FUZZ_PASSED=false\n     - echo \"export FUZZ_PASSED=$FUZZ_PASSED\" > /tmp/fuzz_result.sh\n     - $FUZZ_PASSED\n   needs: [ 'ASan Menagerie Fuzz' ]\n@@ -1442,7 +1443,7 @@ Valgrind Menagerie Fuzz:\n     - ninja install\n     - cd ..\n     - FUZZ_PASSED=true\n-    - ./tools/fuzz-test.sh -g -P $MIN_PLUGINS -b $INSTALL_PREFIX/bin -d /tmp/fuzz -t $MAX_SECONDS $( shuf -e /var/menagerie/*/* ) 2> fuzz-test.err || FUZZ_PASSED=false\n+    - ./tools/fuzz-test.sh -g -P $MIN_PLUGINS -b $INSTALL_PREFIX/bin -d /tmp/fuzz -t $MAX_SECONDS $( shuf -e /var/menagerie/*/* ) 2> \"$FUZZ_STDERR\" || FUZZ_PASSED=false\n     - echo \"export FUZZ_PASSED=$FUZZ_PASSED\" > /tmp/fuzz_result.sh\n     - $FUZZ_PASSED\n   needs: [ 'ASan randpkt Fuzz' ]\n",
