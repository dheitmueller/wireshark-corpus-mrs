  "discussions_data": [
    {
      "id": "eb8cac33590d11794fe0ea0731ae873a1e2870ff",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1198733378,
          "type": null,
          "body": "BTW, this is one argument for libwiretap having a mechanism to provide warnings for records/blocks read from a file, in cases where the file isn't quite right but we can work around it (in this case, by trying to fix up the broken UTF-8 by replacing broken stuff with REPLACEMENT CHARACTER), so that, for example, libwiretap could add the warnings to the \"Frame\" section of the protocol tree, to let the user know why a packet comment doesn't contain what they thought it did (and that the code that put that comment into the file has a bug).",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-12-06T20:30:29.531Z",
          "updated_at": "2022-12-06T20:30:29.531Z",
          "system": false,
          "noteable_id": 192876778,
          "noteable_type": "MergeRequest",
