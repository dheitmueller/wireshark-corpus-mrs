    {
      "id": "6ee1e7a344a7e7f505cfa88fcc6fc7dc550f0f23",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1203850588,
          "type": "DiffNote",
          "body": "> Strings in pcapng files are FT_STRING_BUT_WE_ALSO_WORK_AROUND_PEOPLE_WHO_THOUGH_THEY_ARE_FT_STRINGZ, in that the terminating NUL is NOT required, but readers should treat an internal NUL as an early string terminator.\n\nThis would not do that, I believe. It would return false with an early NUL (`g_validate_utf8()` does not just use the length as a maximum, but also returns false if the string terminates early). `g_utf8_make_valid()` would then replace the early NUL with a REPLACEMENT CHARACTER.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2022-12-09T21:33:07.764Z",
          "updated_at": "2022-12-09T21:33:07.764Z",
