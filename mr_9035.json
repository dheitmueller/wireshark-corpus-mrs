    {
      "id": "5010db7e3027b83f42999d901acb6ff29a9ac514",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1198737398,
          "type": null,
          "body": "According to [the documentation for `g_utf8_validate_len()`](https://docs.gtk.org/glib/func.utf8_validate_len.html), it first appeared in GLib 2.60, so presumably we should increase the GLib version required in the test in CMakeLists.txt to 2.60.\n\n(`g_utf8_make_valid()` first appeared in 2.52, according to [its documentstion](https://docs.gtk.org/glib/func.utf8_make_valid.html), so that requires no change.)",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
