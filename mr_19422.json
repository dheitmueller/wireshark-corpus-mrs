    {
      "id": "9289e2d81e25fba43466fecfa1fedda6fd242ca6",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2425135828,
          "type": null,
          "body": "Current RFC 5905 (NTPv4) (which obsoletes RFC 1305 (NTPv3) and RFC 4330 (SNTPv4), which in turn obsoletes RFC 2030 (SNTPv4) and RFC 1769 (SNTP), which in turn obsoletes RFC 1361 (SNTP)) refers to this field as \"Origin timestamp\". It is the obsoleted RFC's that refer to it as you propose.\n\nTherefore I would prefer not to go back to the obsoleted designation of this field.",
          "author": {
            "id": 2398962,
            "username": "JaapKeuter",
            "public_email": "",
            "name": "Jaap Keuter",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/722b0c520542a23cb8f8ea7070a45c88f9e9214dc700ac151e419e9649e0304e?s=80&d=identicon",
