      "notes": [
        {
          "id": 1569182309,
          "type": "DiscussionNote",
          "body": "Hi @alagoutte,\n\nI still see a problem with the commit, please correct me if I'm wrong.\nFor Backhaul and Fronthaul BSS fields, according to the specification false(0) means in-use and true(1) means not-in-use. But if you use \"TFS(&tfs_inuse_not_inuse)\" that would cause outcome to be true(1): in-use and false(0): not-in-use. So I believe the values should also be flipped here.\n\nRegards",
          "author": {
            "id": 1532387,
            "username": "ugurilter",
            "public_email": "",
            "name": "Uğur İlter",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/1532387/avatar.png?v=1759313273",
