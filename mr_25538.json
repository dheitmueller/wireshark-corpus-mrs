      "diff": "@@ -81,6 +81,7 @@ else()\n endif()\n \n option(ENABLE_LTO \"Use Link Time Optimization (release configuration only)\" OFF)\n+option(ENABLE_Y2038 \"Require 64-bit time_t even on 32-bit platforms (experimental)\" OFF)\n \n if(WIN32)\n \toption(ENABLE_VLD \"Enable Visual Leak Detect in Debug configuration\" OFF)\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "CMakeOptions.txt",
