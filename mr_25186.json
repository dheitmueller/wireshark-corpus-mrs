  "changes_data": [
    {
      "diff": "@@ -0,0 +1,117 @@\n+// =====================================================================\n+// Wireshark Midnight Blue Theme\n+// =====================================================================\n+//\n+// Deep navy surfaces with cool blue accents, tuned for dark mode.\n+// Light mode is a cool \"daybreak\" companion with pale blue-gray surfaces.\n+//\n+// Format: JSONC — standard JSON with C-style comments.\n+//\n+// Color value convention:\n+//   Each color is { \"light\": \"#hex\", \"dark\": \"#hex\" }.\n+//\n+// To use as a personal theme, copy this file to your personal themes\n+// directory and select it in Edit → Preferences → Appearance.\n+// =====================================================================\n+\n+{\n+\t// =================================================================\n+\t// REQUIRED SECTIONS\n+\t// =================================================================\n+\n+\t\"meta\": {\n+\t\t\"name\": \"Midnight Blue\",\n+\t\t\"version\": 1,\n+\t\t\"author\": \"Stig Bjørlykke <stig@bjorlykke.org>\",\n+\t\t\"description\": \"Deep navy surfaces with cool blue accents.\"\n+\t},\n+\n+\t// -----------------------------------------------------------------\n+\t// Brand — midnight navy identity\n+\t// -----------------------------------------------------------------\n+\t\"brand\": {\n+\t\t\"primary\": { \"light\": \"#1e4a8a\", \"dark\": \"#6b9fff\" },\n+\t\t\"deep\":    { \"light\": \"#0f1b30\", \"dark\": \"#060a14\" }\n+\t},\n+\n+\t// -----------------------------------------------------------------\n+\t// Accent — semantic colors legible on navy surfaces\n+\t// -----------------------------------------------------------------\n+\t\"accent\": {\n+\t\t\"success\": { \"light\": \"#afffaf\", \"dark\": \"#006600\" },\n+\t\t\"warning\": { \"light\": \"#ffffaf\", \"dark\": \"#666600\" },\n+\t\t\"error\":   { \"light\": \"#ffafaf\", \"dark\": \"#660000\" },\n+\t\t\"info\":    { \"light\": \"#2563eb\", \"dark\": \"#93c5fd\" }\n+\t},\n+\n+\t// -----------------------------------------------------------------\n+\t// Expert info severity colors\n+\t// -----------------------------------------------------------------\n+\t\"expert\": {\n+\t\t\"comment\":    { \"light\": \"#86efac\", \"dark\": \"#4ade80\" },\n+\t\t\"chat\":       { \"light\": \"#93c5fd\", \"dark\": \"#60a5fa\" },\n+\t\t\"note\":       { \"light\": \"#67e8f9\", \"dark\": \"#22d3ee\" },\n+\t\t\"warn\":       { \"light\": \"#fde047\", \"dark\": \"#facc15\" },\n+\t\t\"error\":      { \"light\": \"#fca5a5\", \"dark\": \"#f87171\" },\n+\t\t\"foreground\": { \"light\": \"#0c1220\", \"dark\": \"#0c1220\" }\n+\t},\n+\n+\t// -----------------------------------------------------------------\n+\t// Packet display state colors\n+\t// -----------------------------------------------------------------\n+\t\"packets\": {\n+\t\t\"selection\":     { \"light\": \"#1e4a8a\", \"dark\": \"#243a5c\" },\n+\t\t\"selectionText\": { \"light\": \"#ffffff\", \"dark\": \"#eef2f8\" },\n+\t\t\"inactive\":      { \"light\": \"#e8ecf5\", \"dark\": \"#161f32\" },\n+\t\t\"inactiveText\":  { \"light\": \"#141c2e\", \"dark\": \"#d4dce8\" },\n+\t\t\"marked\":        { \"light\": \"#001a33\", \"dark\": \"#001a33\" },\n+\t\t\"markedText\":    { \"light\": \"#ffffff\", \"dark\": \"#ffffff\" },\n+\t\t\"ignored\":       { \"light\": \"#f4f6fc\", \"dark\": \"#0a0e18\" },\n+\t\t\"ignoredText\":   { \"light\": \"#6b7280\", \"dark\": \"#6b7a94\" },\n+\t\t\"hidden\":        { \"light\": \"#4a5568\", \"dark\": \"#8b9bb5\" }\n+\t},\n+\n+\t// -----------------------------------------------------------------\n+\t// Follow Stream conversation colors\n+\t// -----------------------------------------------------------------\n+\t\"conversation\": {\n+\t\t\"client\":     { \"light\": \"#f5e6d8\", \"dark\": \"#2a1810\" },\n+\t\t\"clientText\": { \"light\": \"#7c2d12\", \"dark\": \"#ffb88a\" },\n+\t\t\"server\":     { \"light\": \"#dce8f8\", \"dark\": \"#0f1e35\" },\n+\t\t\"serverText\": { \"light\": \"#1e3a6e\", \"dark\": \"#9ec5ff\" }\n+\t},\n+\n+\t// -----------------------------------------------------------------\n+\t// QPalette overrides — navy-tinted surfaces\n+\t// -----------------------------------------------------------------\n+\t\"palette\": {\n+\t\t\"window\":          { \"light\": \"#e8ecf5\", \"dark\": \"#10182a\" },\n+\t\t\"windowText\":      { \"light\": \"#141c2e\", \"dark\": \"#d4dce8\" },\n+\t\t\"base\":            { \"light\": \"#f4f6fc\", \"dark\": \"#0c1220\" },\n+\t\t\"text\":            { \"light\": \"#141c2e\", \"dark\": \"#d4dce8\" },\n+\t\t\"alternateBase\":   { \"light\": \"#dde3f0\", \"dark\": \"#141e32\" },\n+\t\t\"mid\":             { \"light\": \"#5a6478\", \"dark\": \"#7a8aa3\" },\n+\t\t\"midlight\":        { \"light\": \"#c5cee0\", \"dark\": \"#1e2a42\" },\n+\t\t\"highlightedText\": { \"light\": \"#ffffff\", \"dark\": \"#ffffff\" }\n+\t},\n+\n+\t// -----------------------------------------------------------------\n+\t// Graph colors — blue-first 14-slot cycle\n+\t// -----------------------------------------------------------------\n+\t\"graphs\": [\n+\t\t{ \"light\": \"#1e4a8a\", \"dark\": \"#6b9fff\" },\n+\t\t{ \"light\": \"#0e7490\", \"dark\": \"#22d3ee\" },\n+\t\t{ \"light\": \"#5b21b6\", \"dark\": \"#a78bfa\" },\n+\t\t{ \"light\": \"#166534\", \"dark\": \"#4ade80\" },\n+\t\t{ \"light\": \"#991b1b\", \"dark\": \"#f87171\" },\n+\t\t{ \"light\": \"#92400e\", \"dark\": \"#fbbf24\" },\n+\t\t{ \"light\": \"#0369a1\", \"dark\": \"#38bdf8\" },\n+\t\t{ \"light\": \"#3d5a80\", \"dark\": \"#3d5a80\" },\n+\t\t{ \"light\": \"#155e75\", \"dark\": \"#0e7490\" },\n+\t\t{ \"light\": \"#6d28d9\", \"dark\": \"#5b21b6\" },\n+\t\t{ \"light\": \"#14532d\", \"dark\": \"#166534\" },\n+\t\t{ \"light\": \"#7f1d1d\", \"dark\": \"#991b1b\" },\n+\t\t{ \"light\": \"#78350f\", \"dark\": \"#92400e\" },\n+\t\t{ \"light\": \"#334155\", \"dark\": \"#475569\" }\n+\t]\n+}\n",
