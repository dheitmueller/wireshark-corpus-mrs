      "diff": "@@ -0,0 +1,22 @@\n+# Configuration file for Stratoshark.\n+#\n+# Packet list hidden columns\n+# List all column indices (1-indexed) to hide in the packet list.\n+gui.column.hide: 6,10\n+\n+# Packet list column format\n+# Each pair of strings consists of a column title and its format\n+gui.column.format:\n+\t\"No.\", \"%m\",\n+\t\"Time\", \"%t\",\n+\t\"Process Name\", \"%Cus:procmon.process.name:0:U\",\n+\t\"Session Number\", \"%Cus:procmon.process.session_number:0:U\",\n+\t\"Process ID\", \"%Cus:procmon.process.id:0:U\",\n+\t\"Thread ID\", \"%Cus:procmon.thread_id:0:U\",\n+\t\"Architecture\", \"%Cus:procmon.process.is_64_bit:0:R\",\n+\t\"Operation\", \"%Cus:procmon.filesystem.operation_type||procmon.registry.operation_type||procmon.network.operation_type||procmon.process.operation_type||procmon.profiling.operation_type:0:R\",\n+\t\"Path\", \"%Cus:procmon.filesystem.path||procmon.registry.key:0:U\",\n+\t\"User Name\", \"%Cus:procmon.process.user_name:0:U\",\n+\t\"Result\", \"%Cus:procmon.event_result:0:R\",\n+\t\"Detail\", \"%i\",\n+\t\"Image Path\", \"%Cus:procmon.process.image_path:0:U\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "resources/share/stratoshark/profiles/Process Monitor/preferences",
      "old_path": "resources/share/stratoshark/profiles/Process Monitor/preferences",
