  "changes_data": [
    {
      "diff": "@@ -1218,6 +1218,7 @@ esp_null_heur(tvbuff_t *tvb, packet_info *pinfo, proto_tree *esp_tree)\n   int esp_packet_len, esp_pad_len, esp_icv_len, offset;\n   guint encapsulated_protocol;\n   guint32 saved_match_uint;\n+  gboolean heur_ok;\n \n   tvbuff_t *next_tvb;\n   dissector_handle_t dissector_handle;\n@@ -1251,11 +1252,16 @@ esp_null_heur(tvbuff_t *tvb, packet_info *pinfo, proto_tree *esp_tree)\n       if (ESP_HEADER_LEN + esp_pad_len > offset) {\n         continue;\n       }\n+      heur_ok = TRUE;\n       for (int j=0; j < esp_pad_len; j++) {\n         if (tvb_get_guint8(tvb, offset - (j + 1)) != (esp_pad_len - j)) {\n-          continue;\n+          heur_ok = FALSE;\n+          break;\n         }\n       }\n+      if (!heur_ok) {\n+        continue;\n+      }\n \n       saved_match_uint  = pinfo->match_uint;\n       pinfo->match_uint = encapsulated_protocol;\n",
