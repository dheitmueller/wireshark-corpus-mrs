      "diff": "@@ -895,6 +895,8 @@ typedef struct {\n     bool                 fake_protocols;\n     unsigned             count;\n     struct _packet_info *pinfo;\n+    int                  max_start;\n+    unsigned             start_idle_count;\n } tree_data_t;\n \n /** Each proto_tree, proto_item is one of these. */\n",
