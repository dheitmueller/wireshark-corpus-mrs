        {
          "id": 450241912,
          "type": "DiscussionNote",
          "body": "Does this print any extra warnings if you uncomment `#define DEBUG_PACKET_DIAGRAM 1` in ui/qt/packet_diagram.cpp?",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789948913",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2020-11-18T17:46:36.747Z",
          "updated_at": "2020-11-19T00:56:15.939Z",
          "system": false,
          "noteable_id": 78468219,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 860017,
            "username": "geraldcombs",
