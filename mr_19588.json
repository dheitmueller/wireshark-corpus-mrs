      "notes": [
        {
          "id": 2452443925,
          "type": "DiscussionNote",
          "body": "I'm all for the removal of global variables, so I support this patch.  But there are other \"singletons\" that really prevent the support of multiple expert level states (because the first question I asked myself was how will the user specify the multiple expert levels).",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2025-04-15T14:49:31.425Z",
          "updated_at": "2025-04-16T09:44:51.684Z",
          "system": false,
