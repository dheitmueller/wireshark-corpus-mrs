    {
      "id": "21ac70d47aa61a9f8ebb28f7a094c1994efe9bcc",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3311599254,
          "type": null,
          "body": "Where's the libxml2 update in this MR - part of glib?  I was surprised to see the update for libxml2 because I thought some older Unix-based flavors didn't support it.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2026-05-04T13:53:00.707Z",
          "updated_at": "2026-05-04T13:53:00.707Z",
          "system": false,
          "noteable_id": 480234817,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 24723,
          "commands_changes": {}
