  "commits_data": [
    {
      "id": "795e3187391bdf689a9f2e79e87dc7d0242e3efb",
      "short_id": "795e3187",
      "created_at": "2022-11-11T14:24:54.000+00:00",
      "parent_ids": [
        "1ed750dd9489fca242a5ec602c11ec84d0abd430"
      ],
      "title": "Gitlab CI: Add build with -Werror enabled",
      "message": "Gitlab CI: Add build with -Werror enabled\n\nCurrently we don't have any build with -Werror because of\nwidespread use of ENABLE_EXTRA_COMPILER_WARNINGS CMake option,\nthat automatically disables -Werror. That's bad because it allows\ncode with warnings to pass the CI jobs and be checked in, which is\nsomething we want to avoid.\n\nConfigure the GCC build to not use ENABLE_EXTRA_COMPILER_WARNINGS.\n",
      "author_name": "João Valverde",
      "author_email": "j@v6e.pt",
      "authored_date": "2022-11-11T14:19:35.000+00:00",
      "committer_name": "João Valverde",
      "committer_email": "j@v6e.pt",
      "committed_date": "2022-11-11T14:24:54.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/795e3187391bdf689a9f2e79e87dc7d0242e3efb"
    },
    {
      "id": "1ed750dd9489fca242a5ec602c11ec84d0abd430",
      "short_id": "1ed750dd",
      "created_at": "2022-11-11T14:20:28.000+00:00",
      "parent_ids": [
        "384bf49591936fa8545f67ef2e75477b71dccd8f"
      ],
      "title": "CMake + Gitlab CI: Allow fuzz jobs to pass with warnings",
      "message": "CMake + Gitlab CI: Allow fuzz jobs to pass with warnings\n\nAllow fuzz jobs to pass with warnings because catching warnings is\nnot their purpose.\n\nRemove -Werror=unused-but-set-variable that was added in\n85357ae721 as a work-around to the fact that -Werror is not\nenabled as a side-effect of ENABLE_EXTRA_COMPILER_WARNINGS.\n\nAllow users to control -Werror. For example the MSYS2 build\nhas many warnings, this policy of adding -Werror= breaks that\nbuild.\n",
      "author_name": "João Valverde",
      "author_email": "j@v6e.pt",
      "authored_date": "2022-11-11T14:12:14.000+00:00",
      "committer_name": "João Valverde",
      "committer_email": "j@v6e.pt",
      "committed_date": "2022-11-11T14:20:28.000+00:00",
