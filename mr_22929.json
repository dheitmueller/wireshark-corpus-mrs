      "diff": "@@ -15,41 +15,29 @@\n #include <wireshark.h>\n \n #if defined(_WIN32) && !defined(__CYGWIN__)\n-\t#include <windows.h>\n-\t#include <ws2tcpip.h>\n-\t#include <winsock2.h>\n-\t#include <process.h>\n+    #include <windows.h>\n+    #include <ws2tcpip.h>\n+    #include <winsock2.h>\n+    #include <process.h>\n \n-\t#define socket_handle_t SOCKET\n-\t#define socklen_t int\n+    #define socket_handle_t SOCKET\n+    #define socklen_t int\n #else\n-\t/*\n-\t * UN*X, or Windows pretending to be UN*X with the aid of Cygwin.\n-\t */\n-\t#ifdef HAVE_UNISTD_H\n-\t\t/*\n-\t\t * For close().\n-\t\t */\n-\t\t#include <unistd.h>\n-\t#endif\n-\t#ifdef HAVE_SYS_SOCKET_H\n-\t\t#include <sys/socket.h>\n-\t#endif\n+    /*\n+     * UN*X, or Windows pretending to be UN*X with the aid of Cygwin.\n+     */\n+    #include <unistd.h> /* For close() */\n+    #include <sys/types.h> /* At least some UN*X needs this before netinet/in.h */\n+    #include <sys/socket.h>\n+    #include <arpa/inet.h>\n+    #include <netinet/in.h> /* For sockaddr_in */\n \n-\t#define closesocket(socket)\tclose(socket)\n-\t#define socket_handle_t\t\tint\n+    #define closesocket(socket)\tclose(socket)\n+    #define socket_handle_t\t\tint\n #ifndef INVALID_SOCKET\n-\t#define INVALID_SOCKET\t\t(-1)\n+    #define INVALID_SOCKET\t\t(-1)\n #endif\n-\t#define SOCKET_ERROR\t\t(-1)\n-#endif\n-\n-#ifdef HAVE_ARPA_INET_H\n-\t#include <arpa/inet.h>\n-#endif\n-\n-#ifdef HAVE_NETINET_IN_H\n-\t#include <netinet/in.h>\n+    #define SOCKET_ERROR\t\t(-1)\n #endif\n \n #ifdef\t__cplusplus\n@@ -91,16 +79,3 @@ WS_DLL_PUBLIC int ws_socket_ptoa(struct sockaddr_storage *dst, const char *src,\n #endif\n \n #endif /* __SOCKET_H__ */\n-\n-/*\n- * Editor modelines  -  https://www.wireshark.org/tools/modelines.html\n- *\n- * Local variables:\n- * c-basic-offset: 8\n- * tab-width: 8\n- * indent-tabs-mode: t\n- * End:\n- *\n- * vi: set shiftwidth=8 tabstop=8 noexpandtab:\n- * :indentSize=8:tabSize=8:noTabs=false:\n- */\n",
