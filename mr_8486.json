      "diff": "@@ -4535,7 +4535,7 @@ dissect_tds7_login(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, tds_conv\n                  * characters in the string.\n                  */\n \n-                gchar *val, *val2;\n+                gchar *val, *val2, *validated;\n                 len *= 2;\n                 val  = (gchar *)tvb_memdup(wmem_packet_scope(), tvb, offset2, len);\n                 val2 = (gchar *)wmem_alloc(wmem_packet_scope(), len/2+1);\n@@ -4549,8 +4549,10 @@ dissect_tds7_login(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, tds_conv\n                     val2[k] = val[j];\n                 }\n                 val2[k] = '\\0'; /* Null terminate our new string */\n+                validated = g_utf8_make_valid(val2, k);\n \n-                proto_tree_add_string_format_value(login_tree, login_hf, tvb, offset2, len, val2, \"%s\", val2);\n+                proto_tree_add_string_format_value(login_tree, login_hf, tvb, offset2, len, validated, \"%s\", validated);\n+                g_free(validated);\n             }\n         }\n     }\n",
