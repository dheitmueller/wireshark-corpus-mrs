  "changes_data": [
    {
      "diff": "@@ -3578,6 +3578,7 @@ check_auth_basic(proto_item *hdr_item, tvbuff_t *tvb, packet_info *pinfo, gchar\n \tsize_t hdrlen;\n \tproto_tree *hdr_tree;\n \tgsize len;\n+\tchar *valid_value = NULL;\n \n \tfor (header = &basic_headers[0]; *header != NULL; header++) {\n \t\thdrlen = strlen(*header);\n@@ -3592,9 +3593,10 @@ check_auth_basic(proto_item *hdr_item, tvbuff_t *tvb, packet_info *pinfo, gchar\n \t\t\tif (strlen(value) > 1) {\n \t\t\t\tg_base64_decode_inplace(value, &len);\n \t\t\t\tvalue[len] = 0;\n+\t\t\t\tvalid_value = g_utf8_make_valid(value, len);\n \t\t\t}\n \t\t\tproto_tree_add_string(hdr_tree, hf_http_basic, tvb,\n-\t\t\t    0, 0, value);\n+\t\t\t    0, 0, valid_value ? valid_value : value);\n \t\t\ttap_credential_t* auth = basic_auth_credentials(value);\n \t\t\tif (auth) {\n \t\t\t\tauth->num = auth->username_num = pinfo->num;\n@@ -3602,6 +3604,7 @@ check_auth_basic(proto_item *hdr_item, tvbuff_t *tvb, packet_info *pinfo, gchar\n \t\t\t\ttap_queue_packet(credentials_tap, pinfo, auth);\n \t\t\t}\n \n+\t\t\tg_free(valid_value);\n \t\t\treturn TRUE;\n \t\t}\n \t}\n",
