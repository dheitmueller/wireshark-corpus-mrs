      "notes": [
        {
          "id": 559318273,
          "type": "DiffNote",
          "body": "According to [the documentation](https://doc.qt.io/qt-5/qguiapplication.html#setHighDpiScaleFactorRoundingPolicy) this was added in Qt 5.14, and needs to be wrapped in `#if QT_VERSION >= QT_VERSION_CHECK(5, 14, 0)` / `#endif`. Is there a reason to use QGuiApplication instead of QApplication here and above? Also, the indentation needs to be fixed.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
