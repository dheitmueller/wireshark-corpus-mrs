    {
      "id": "4130640fa9d10c500ab70a38a38d0e70e7afd89b",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 432656677,
          "type": "DiffNote",
          "body": "It is skipping the bytes that will be written into the front of the payload by wiretap/catapult_dct2000.c, which is really just context information that I didn't want to fatten up the wtap structs with (it also makes them filterable).\n\nFuzzing these bytes I don't think makes sense.  The dct2000 dissector will never see anything that wouldn't get past the wiretap module.  Fuzzing actual .out files might make more sense.  This file format is still being used, albeit with a narrower range of protocols than before.",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2020-10-20T10:09:00.617Z",
          "updated_at": "2020-10-20T10:09:00.617Z",
