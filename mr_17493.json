  "changes_data": [
    {
      "diff": "@@ -1386,6 +1386,7 @@ dissect_frame(tvbuff_t *tvb, packet_info *pinfo, proto_tree *parent_tree, void*\n \tENDTRY;\n \n \tif (proto_field_is_referenced(tree, hf_frame_protocols)) {\n+\t\t/* Accumulate in 'val' the list of protocols separated by ':' */\n \t\twmem_strbuf_t *val = wmem_strbuf_new_sized(pinfo->pool, 128);\n \t\twmem_list_frame_t *frame;\n \t\t/* skip the first entry, it's always the \"frame\" protocol */\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-frame.c",
      "old_path": "epan/dissectors/packet-frame.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -220,9 +220,18 @@ dissect_vlan(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void* data _U_\n \n   ti = proto_tree_add_item(tree, proto_vlan, tvb, 0, 4, ENC_NA);\n   vlan_nested_count = p_get_proto_depth(pinfo, proto_vlan);\n+\n   if (++vlan_nested_count > VLAN_MAX_NESTED_TAGS) {\n-    expert_add_info(pinfo, ti, &ei_vlan_too_many_tags);\n-    return tvb_captured_length(tvb);\n+    /* Are we nested too deeply in VLAN layers?\n+     * Avoid false +ve while dissecting as a file type (rather than capture) */\n+\n+    /* First entry is always \"frame\" */\n+    wmem_list_frame_t *frame = wmem_list_frame_next(wmem_list_head(pinfo->layers));\n+    if (strcmp(proto_get_protocol_filter_name(GPOINTER_TO_UINT(wmem_list_frame_data(frame))), \"mime_dlt\") != 0) {\n+\n+      expert_add_info(pinfo, ti, &ei_vlan_too_many_tags);\n+      return tvb_captured_length(tvb);\n+    }\n   }\n   p_set_proto_depth(pinfo, proto_vlan, vlan_nested_count);\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-vlan.c",
