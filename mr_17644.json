        {
          "id": 2156456002,
          "type": "DiffNote",
          "body": "Given that the CLA byte meaning comes from the ETSI/3GPP spec I think it should be the other way around: add an option to the gsm_sim dissector to call the iso7816 one depending on the CLA value. That would be more generic than doing this in the MBIM dissector.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
