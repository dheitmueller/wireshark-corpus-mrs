    {
      "id": "cb82b80a3708bf6f2251c3778b73ed28d37f8d3a",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2156520155,
          "type": null,
          "body": "Hello,\n\nFor a smart card (CCID USB reader) it makes sens to use the ISO-7816 dissector by default. The smart card can be anything, not just a SIM card.\n\nI did not knew about Mobile Broadband Interface Model (MBIM). A better choice should be to decode MBIM as `gsm_sim` by default.\n\nI do not know a safe way to identify how to decode an APDU. ISO 7816-4 defines an interindustry standard but the developer of the card application (in general a JavaCard applet) can use anything for its commands.",
          "author": {
            "id": 126721,
            "username": "Ludovic",
            "public_email": "",
            "name": "Ludovic Rousseau",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/b50dbb78265d3d354b78ffce7dc0851d160475dbabd8d5b20a991cdf0059c0ad?s=80&d=identicon",
            "web_url": "https://gitlab.com/Ludovic"
          },
          "created_at": "2024-10-13T14:44:30.714Z",
          "updated_at": "2024-10-13T15:00:32.464Z",
          "system": false,
          "noteable_id": 333592900,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 17644,
          "commands_changes": {}
        }
      ]
