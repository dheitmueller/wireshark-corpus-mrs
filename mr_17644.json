        {
          "id": 2156566288,
          "type": "DiscussionNote",
          "body": "The ISO standards are not available for free.\n\nRegarding the CLA byte, ISO 7816-4 indicates: \"Bit 8 set to 1 indicates the proprietary class, except for the value 'FF' which is invalid. The application-context defines the other bits.\"\n\nBut proprietary does not mean 3GPP/ETSI. It is just _not_ defined in ISO 7816-4.",
          "author": {
            "id": 126721,
            "username": "Ludovic",
            "public_email": "",
            "name": "Ludovic Rousseau",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/b50dbb78265d3d354b78ffce7dc0851d160475dbabd8d5b20a991cdf0059c0ad?s=80&d=identicon",
            "web_url": "https://gitlab.com/Ludovic"
          },
          "created_at": "2024-10-13T19:51:59.667Z",
          "updated_at": "2024-10-13T20:07:14.544Z",
          "system": false,
          "noteable_id": 333592900,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
