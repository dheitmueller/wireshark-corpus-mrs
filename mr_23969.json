      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -864,7 +864,11 @@ ws_strdup_underline(wmem_allocator_t *allocator, long offset, size_t len)\n          * adds at least another 128 bytes, which is more than enough \\\n          * for one more character plus a terminating '\\0'. \\\n          */ \\\n-        fmtbuf_len *= 2; \\\n+        if (ckd_mul(&fmtbuf_len, fmtbuf_len, 2)) { \\\n+            ws_debug(\"overflow!\"); \\\n+            FMTBUF_ENDSTR; \\\n+            return fmtbuf; \\\n+        } \\\n         fmtbuf = (char *)wmem_realloc(allocator, fmtbuf, fmtbuf_len); \\\n     }\n \n",
