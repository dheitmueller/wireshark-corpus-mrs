      "diff": "@@ -139,7 +139,7 @@ json_string_unescape(tvbparse_elem_t* tok, gboolean enclose_in_quotation_marks)\n {\n \tint read_index = 0;\n \n-\twmem_strbuf_t* output_string_buffer = wmem_strbuf_sized_new(wmem_packet_scope(), tok->len, tok->len + 2);\n+\twmem_strbuf_t* output_string_buffer = wmem_strbuf_sized_new(wmem_packet_scope(), tok->len + 2 + 10, 0);\n \n \tif (enclose_in_quotation_marks == TRUE)\n \t{\n@@ -170,7 +170,10 @@ json_string_unescape(tvbparse_elem_t* tok, gboolean enclose_in_quotation_marks)\n \n \t\t\tif (utf8_character_length <= 0)\n \t\t\t{\n-\t\t\t\tbreak;\n+\t\t\t\t// Invalid character for UTF-8. Stick replacement character in.\n+\t\t\t\twmem_strbuf_append_unichar(output_string_buffer, 0xFFFD);\n+\t\t\t\tread_index++;\n+\t\t\t\tcontinue;\n \t\t\t}\n \n \t\t\tfor (int i = 0; i < utf8_character_length; i++)\n",
