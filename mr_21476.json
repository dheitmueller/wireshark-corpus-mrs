  "changes_data": [
    {
      "diff": "@@ -616,6 +616,7 @@ update-mime-database %{_datadir}/mime &> /dev/null || :\n \n %{_libdir}/lib*.so.*\n %{_libdir}/wireshark\n+%{_libexecdir}/wireshark\n # Don't pick up the wireshark (GUI) man page here\n %exclude %{_mandir}/man1/wireshark.*\n %{_mandir}/man1/*\n@@ -661,7 +662,7 @@ update-mime-database %{_datadir}/mime &> /dev/null || :\n %{_datadir}/icons/hicolor/*/mimetypes/*\n %{_datadir}/mime/packages/org.wireshark.Stratoshark.xml\n %{_bindir}/stratoshark\n-%{_libdir}/stratoshark\n+%{_libexecdir}/stratoshark\n %{_mandir}/man1/stratoshark.*\n %{_mandir}/man1/falcodump.*\n %{_mandir}/man1/sshdig.*\n@@ -675,22 +676,22 @@ update-mime-database %{_datadir}/mime &> /dev/null || :\n # https://falco.org/docs/setup/container/#docker-least-privileged-modern-ebpf\n %if %{use_stratoshark_group} && %{setuid_falcodump}\n # Setuid but only executable by members of the 'stratoshark' group\n-%attr(4750, root, stratoshark) %{_libdir}/stratoshark/extcap/falcodump\n+%attr(4750, root, stratoshark) %{_libexecdir}/stratoshark/extcap/falcodump\n %else\n %if %{use_stratoshark_group} && %{setcap_falcodump}\n # Setcap but only executable by members of the 'stratoshark' group\n-%attr(0750, root, stratoshark) %caps(cap_sys_admin,cap_sys_resource,cap_sys_ptrace=ep) %{_libdir}/stratoshark/extcap/falcodump\n+%attr(0750, root, stratoshark) %caps(cap_sys_admin,cap_sys_resource,cap_sys_ptrace=ep) %{_libexecdir}/stratoshark/extcap/falcodump\n %else\n %if %{setuid_falcodump}\n # Setuid and executable by all\n-%attr(4755, root, root) %{_libdir}/stratoshark/extcap/falcodump\n+%attr(4755, root, root) %{_libexecdir}/stratoshark/extcap/falcodump\n %else\n %if %{setcap_falcodump}\n # Setcap and executable by all\n-%attr(0755, root, root) %caps(cap_sys_admin,cap_sys_resource,cap_sys_ptrace=ep) %{_libdir}/stratoshark/extcap/falcodump\n+%attr(0755, root, root) %caps(cap_sys_admin,cap_sys_resource,cap_sys_ptrace=ep) %{_libexecdir}/stratoshark/extcap/falcodump\n %else\n # Executable by all but with no special permissions\n-%attr(0755, root, root) %{_libdir}/stratoshark/extcap/falcodump\n+%attr(0755, root, root) %{_libexecdir}/stratoshark/extcap/falcodump\n %endif\n %endif\n %endif\n",
