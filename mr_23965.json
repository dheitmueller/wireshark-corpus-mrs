    },
    {
      "id": "96e63ef28c21c4632c57eb3bf7974f589a9a3225",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3294490641,
          "type": null,
          "body": "If we ever provide an SDK for Windows, we might need the separate project directories for the includes. As it is, I don't think that is used for the package install at all (but might be used for the `install` target if used.)",
          "author": {
            "id": 6764551,
