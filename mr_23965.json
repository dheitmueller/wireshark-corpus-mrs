    {
      "id": "e22e0f748e60696b8d70f076b115ef232eb5fcbc",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3294481324,
          "type": null,
          "body": "Are these values used at all when installing via a package (or Application Bundle on macOS?) Aren't these only for installing via the `install` target, which generally isn't used on Windows (but could be)? I'm not sure about macOS in a non-package forms, putting things into the standard POSIX directories, but this might break that.\n\nWindows and macOS create separate install folders when installing via package, but I'm not sure that they do if the `install` target is used.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-04-28T12:30:16.384Z",
          "updated_at": "2026-04-28T12:30:16.384Z",
          "system": false,
          "noteable_id": 464539389,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 23965,
