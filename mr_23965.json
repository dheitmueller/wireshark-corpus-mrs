    {
      "id": "a3563514d595896495ae3067b4e0333f6b372aa8",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3295211959,
          "type": null,
          "body": "I believe this was one of the steps I identified to get Windows to use the `install` target to \"upgrade\" to using WiX version 4 (or 5), which is not backwards compatible with the version 3 originally used (and no longer supported).  I got hung up on the \"installation tree\" not looking like the NSIS version with Wireshark and TShark components both at the same (top) level (WiX seems to want everything under a single original node) and haven't gotten back to it.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2026-04-28T14:51:21.034Z",
