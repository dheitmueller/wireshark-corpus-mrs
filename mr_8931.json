    {
      "id": "37d317e5d992bf6dfc45c28aca30f346a5d2afa3",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1195160048,
          "type": "DiffNote",
          "body": "This check either has to be moved before the `if (frag_offset + frag_data_len > fd_head->datalen) {` check or there should be a special version for equality (`frag_offset + frag_data_len == fd_head->datalen). Otherwise, this prevents TCP dissector from passing the reassembled data to HTTP dissector in e.g. https://www.wireshark.org/download/automated/captures/fuzz-2015-06-09-24315.pcap packet 117786.",
