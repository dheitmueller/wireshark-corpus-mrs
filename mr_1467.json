    {
      "id": "85deb99637672f2be1f64ab4b07676b91613b6e0",
      "short_id": "85deb996",
      "created_at": "2021-01-03T14:53:28.000+00:00",
      "parent_ids": [
        "41a6457ff31063e898c2ad125e6b9b7b688c6327"
      ],
      "title": "ntp: remove size constraint for invalid refid.",
      "message": "ntp: remove size constraint for invalid refid.\n\nWhen the refid contains non-ascii chars, the conversion function\nreturns a string longer than 4 chars. This results in an invalid\nstring if the output is limited to 4 bytes. Incidentally this\nresults in an invalid PDML output as well that caught this bug\nin the first place.\n\nFix: #17112.\n",
      "author_name": "Dario Lombardo",
      "author_email": "lomato@gmail.com",
      "authored_date": "2020-12-28T19:03:08.000+01:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-01-03T14:53:28.000+00:00",
