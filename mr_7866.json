      "notes": [
        {
          "id": 1074145318,
          "type": "DiscussionNote",
          "body": "What is the improvement? Can you add that to the commit message?\n\nWhy did you remove the pkg-config call?",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2022-08-23T08:59:24.442Z",
          "updated_at": "2022-08-23T12:23:53.823Z",
          "system": false,
          "noteable_id": 172845569,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
