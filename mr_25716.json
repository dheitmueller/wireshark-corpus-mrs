  "changes_data": [
    {
      "diff": "@@ -367,10 +367,14 @@ ssh_params_t* ssh_params_new(void)\n \treturn g_new0(ssh_params_t, 1);\n }\n \n-#if _WIN32\n+#if HAVE_MEMSET_EXPLICIT\n+# define ZERO_FILL_STRING(str) if (str) memset_explicit(str, 0, strlen(str))\n+#elif _WIN32\n # define ZERO_FILL_STRING(str) if (str) SecureZeroMemory(str, strlen(str))\n+#elif HAVE_EXPLICIT_BZERO\n+# define ZERO_FILL_STRING(str) if (str) explicit_bzero(str, strlen(str))\n #elif HAVE_MEMSET_S\n-# define ZERO_FILL_STRING(str) if (str) memset_s(str, strlen(str), 0, strlen(str))\n+# define ZERO_FILL_STRING(str) if (str) (void) memset_s(str, strlen(str), 0, strlen(str))\n #else // Something that will probably be optimized away.\n # define ZERO_FILL_STRING(str) if (str) memset(str, 0, strlen(str))\n #endif\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "extcap/ssh-base.c",
      "old_path": "extcap/ssh-base.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -122,6 +122,8 @@ endif()\n check_symbol_exists(\"clock_gettime\"  \"time.h\"   HAVE_CLOCK_GETTIME)\n # Some platforms (macOS pre 10.15) are non-conformant with C11 and lack timespec_get()\n check_symbol_exists(\"timespec_get\"   \"time.h\"   HAVE_TIMESPEC_GET)\n+# C23 memset_explicit\n+check_symbol_exists(\"memset_explicit\" \"string.h\" HAVE_MEMSET_EXPLICIT)\n if(NOT MSVC)\n \tcheck_symbol_exists(\"localtime_r\"    \"time.h\"   HAVE_LOCALTIME_R)\n \tcheck_symbol_exists(\"gmtime_r\"       \"time.h\"   HAVE_GMTIME_R)\n@@ -130,6 +132,8 @@ if(NOT MSVC)\n \tcheck_symbol_exists(\"tzname\"         \"time.h\"   HAVE_TZNAME)\n \tcheck_symbol_exists(\"getline\"\t     \"stdio.h\"  HAVE_GETLINE)\n \tcheck_symbol_exists(\"memset_s\"       \"string.h\" HAVE_MEMSET_S)\n+\t# BSDs, older glibc, musl\n+\tcheck_symbol_exists(\"explicit_bzero\" \"string.h\" HAVE_EXPLICIT_BZERO)\n endif()\n check_function_exists(\"getifaddrs\"       HAVE_GETIFADDRS)\n check_function_exists(\"issetugid\"        HAVE_ISSETUGID)\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "ConfigureChecks.cmake",
      "old_path": "ConfigureChecks.cmake",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -52,6 +52,9 @@\n /* Define to 1 if you have the `timespec_get` function. */\n #cmakedefine HAVE_TIMESPEC_GET 1\n \n+/* Define to 1 if you have the C23 `memset_explicit` function. */\n+#cmakedefine HAVE_MEMSET_EXPLICIT 1\n+\n /* Define to 1 if you have the `localtime_r` function. */\n #cmakedefine HAVE_LOCALTIME_R 1\n \n@@ -67,6 +70,9 @@\n /* Define to 1 if you have the `memset_s` function. */\n #cmakedefine HAVE_MEMSET_S 1\n \n+/* Define to 1 if you have the `explicit_bzero` function. */\n+#cmakedefine HAVE_EXPLICIT_BZERO 1\n+\n /* Define to use the MaxMind DB library */\n #cmakedefine HAVE_MAXMINDDB 1\n /* MaxmindDB version */\n",
