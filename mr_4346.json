    {
      "id": "da11ef5770ff44c03e60c97a767ae15533c80296",
      "short_id": "da11ef57",
      "created_at": "2021-10-03T10:03:45.000+00:00",
      "parent_ids": [
        "41f4855443af4e5ae547ac8f1324e31c29ddf686"
      ],
      "title": "ieee80211: Add 6E support when converting freq. to channel number.",
      "message": "ieee80211: Add 6E support when converting freq. to channel number.\n\nConverting from freq to channel only needed the 6 GHz freq. range\nto be added, however, converting from channel to freq. will require\nthe function ieee80211_chan_to_mhz to take a starting frequency as\nthere's overlap in the channel numbering between 2.4/5 GHz and 6 GHz\nbands. This may not be possible in some cases, so for now the\nfunction will continue to do the conversion based on the order\non which the freq. ranges are defined. Specifically, it will favor\n2.4/5 GHz over 6 GHz.\n",
      "author_name": "Adrian Granados",
      "author_email": "adrian@intuitibits.com",
      "authored_date": "2021-09-30T11:50:47.000-04:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
