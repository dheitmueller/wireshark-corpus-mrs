  "changes_data": [
    {
      "diff": "@@ -196,6 +196,9 @@ $ pytest -k decryption\n $ pytest --program-path /path/to/wireshark/build/run\n ----\n \n+TIP: Build the \"test-capture\" target on Linux (using sudo) to set dumpcap\n+permissions and enable capture tests.\n+\n To list tests without actually executing them, use the `--collect-only` option:\n \n [source,sh]\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "docbook/wsdg_src/wsdg_tests.adoc",
      "old_path": "docbook/wsdg_src/wsdg_tests.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -4054,6 +4054,14 @@ set_target_properties(test-programs PROPERTIES\n \tEXCLUDE_FROM_DEFAULT_BUILD True\n )\n \n+# Add target to enable capturing from the build directory. Requires Linux capabilities\n+# and running with sudo.\n+if(TARGET dumpcap AND SETCAP_EXECUTABLE)\n+\tadd_custom_target(test-capture\n+\t\tCOMMAND ${SETCAP_EXECUTABLE} cap_net_raw,cap_net_admin+ep $<TARGET_FILE:dumpcap>\n+\t)\n+endif()\n+\n # Test suites\n enable_testing()\n # We could try to build this list dynamically, but given that we tend to\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "CMakeLists.txt",
      "old_path": "CMakeLists.txt",
