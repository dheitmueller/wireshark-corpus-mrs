      "diff": "@@ -891,6 +891,7 @@ static void log_write_do_work(FILE *fp, bool use_color,\n     else if (file != NULL)\n         fprintf(fp, \"%s \", file);\n \n+    /* Any formatting changes here need to be synced with ui/capture.c:capture_input_closed. */\n     fputs(\"-- \", fp);\n \n     /* Function name */\n",
