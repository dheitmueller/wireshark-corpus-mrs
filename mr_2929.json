    {
      "id": "038e99b6196e2e56b5f0f18a25fccd888bce4d5e",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 568196937,
          "type": null,
          "body": "Probably not the appropriate place to comment on this aspect, but should we look at switching the Windows CMake to use the one that is installed by Visual Studio?  It's generally not the latest but at least MS are happy with it.  Currently I get the version info:\n\n    > cmake --version\n    cmake version 3.19.20122902-MSVC_2\n\n    CMake suite maintained and supported by Kitware (kitware.com/cmake).\n\nCMake is on the path after running the appropriate VS dev batch file, e.g. vcvars64.bat.  I've been running my build VM's this way for at least a year, probably longer.",
          "author": {
            "id": 6621762,
            "username": "graham.bloice",
            "public_email": "",
            "name": "Graham Bloice",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/8730bfac2267cb97ff1f8187d285f244745a03a783055c8fd6fcd679bfa71c6e?s=80&d=identicon",
            "web_url": "https://gitlab.com/graham.bloice"
          },
          "created_at": "2021-05-05T17:27:45.676Z",
          "updated_at": "2021-05-05T17:27:45.676Z",
