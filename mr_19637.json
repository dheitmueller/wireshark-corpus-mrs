      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2460863262,
          "type": null,
          "body": "I'm not a fan of this change. Sometimes it's helpful when typing to see what I'm typing. E.g. with nested RDP connections with different operating systems and keyboard language settings and no possibility for copy & paste.\n\nI would be happier with a preference or the option to display what I have typed.\n\nSomething like:\n\n![grafik](/uploads/0ff9af93eccf301da1475d10a6de6628/grafik.png){width=516 height=132}",
          "author": {
            "id": 6518606,
            "username": "uhei",
            "public_email": "",
            "name": "Uli Heilmeier",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6518606/avatar.png?v=1788846115",
            "web_url": "https://gitlab.com/uhei"
          },
