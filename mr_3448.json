{
  "id": 105415201,
  "iid": 3448,
  "project_id": 7898047,
  "title": "dumpcap:Send SP_FILE after SHB passthru in child mode",
  "description": "When dumpcap is running as a capture child in passthrough mode, the\nSP_FILE message should not be sent until after the source SHB is passed\nthrough to the capture file. Fixes a race condition where the capture\nparent attempts to read an SHB from the capture file, following the\nSP_FILE message, but the file is empty.  Closes #17013.",
  "state": "merged",
  "created_at": "2021-06-23T02:01:31.704Z",
  "updated_at": "2021-09-13T05:24:07.510Z",
