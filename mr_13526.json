      "notes": [
        {
          "id": 1676234050,
          "type": null,
          "body": "This works to prevent the stack overflow for me inside the container. I'm not sure what's a reasonable amount of recursion to expect for ZigBee TLVs, though. (The OER one is tricky because all those ASN.1 protocols do have a lot of recursion expected.)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
