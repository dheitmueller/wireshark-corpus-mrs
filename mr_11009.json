  "changes_data": [
    {
      "diff": "@@ -737,7 +737,8 @@ system libraries used etc. If you are unsure, go with UCRT64.\n . Build using CMake + Ninja:\n \n     mkdir build && cd build\n-    cmake -DENABLE_WERROR=Off ..\n+    # Ninja generator is the default\n+    cmake -DENABLE_CCACHE=On -DFETCH_lua=Yes ..\n     ninja\n     ninja test        # optional, to run the test suite\n     ninja install     # optional, install to the MSYS2 shell path\n@@ -765,8 +766,7 @@ The official Wireshark Windows installer is compiled using Microsoft Visual\n Studio (MSVC). Currently the MSYS2 build has the following limitations compared to\n the build using MSVC:\n \n-* Lua version is 5.1 (MSVC uses Lua 5.2) and does not have\n-  https://github.com/Lekensteyn/lua-unicode[custom UTF-8 patches].\n+* Lua does not have https://github.com/Lekensteyn/lua-unicode[custom UTF-8 patches].\n \n * The Event Tracing for Windows (ETW) extcap cannot be compiled using MinGW-w64.\n \n@@ -826,6 +826,8 @@ If successful the installer can be found in `$CMAKE_BINARY_DIR/packaging/nsis`.\n   compiled from source if desired. An up-to-date complete list can be found in\n   the bug tracker (https://gitlab.com/wireshark/wireshark/-/issues/19108[issue 19108]).\n \n+* Lua does not have https://github.com/Lekensteyn/lua-unicode[custom UTF-8 patches].\n+\n * The Event Tracing for Windows (ETW) extcap cannot be compiled using MinGW-w64.\n \n * Enhanced Kerberos dissection with decryption is not available.\n@@ -855,6 +857,7 @@ This guide assumes `paru` is being used.\n   paru -S mingw-w64-glib2\n   paru -S mingw-w64-libgcrypt\n   paru -S mingw-w64-c-ares\n+  paru -S mingw-w64-speexdsp\n   paru -S mingw-w64-libpcap\n \n . Install Qt6:\n@@ -863,7 +866,6 @@ This guide assumes `paru` is being used.\n \n . Install optional dependencies:\n \n-  paru -S mingw-w64-speexdsp\n   paru -S mingw-w64-gnutls\n   paru -S mingw-w64-lz4\n   paru -S mingw-w64-snappy\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "docbook/wsdg_src/wsdg_quick_setup.adoc",
      "old_path": "docbook/wsdg_src/wsdg_quick_setup.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -22,7 +22,6 @@ depends=(\"${MINGW_PACKAGE_PREFIX}-bcg729\"\n          \"${MINGW_PACKAGE_PREFIX}-libsmi\"\n          \"${MINGW_PACKAGE_PREFIX}-libssh\"\n          \"${MINGW_PACKAGE_PREFIX}-libxml2\"\n-         \"${MINGW_PACKAGE_PREFIX}-lua51\"\n          \"${MINGW_PACKAGE_PREFIX}-lz4\"\n          \"${MINGW_PACKAGE_PREFIX}-minizip\"\n          \"${MINGW_PACKAGE_PREFIX}-nghttp2\"\n@@ -79,6 +78,7 @@ build() {\n       -DENABLE_WERROR=OFF \\\n       -DUSE_qt6=ON \\\n       -DENABLE_WINSPARKLE=OFF \\\n+      -DFETCH_lua=ON \\\n       ../${_realname}\n \n   \"${MINGW_PREFIX}\"/bin/cmake.exe --build .\n",
