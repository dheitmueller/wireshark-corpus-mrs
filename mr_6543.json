        {
          "id": 925192158,
          "type": "DiffNote",
          "body": "This is an attempt to reuse code when doing BCD decoding of the GMLC ISDN Number.\nThe existing function have the text MSISDN while this is not an MSISDN.\nThere are other places in MAP signaling where ISDN Numbers (GTs of signaling nodes) have the text of MSISDN.\nSo maybe this change should be a more general change? Including MAP SRI-FOR-LCS for example.",
          "author": {
            "id": 2347492,
            "username": "falkevik",
            "public_email": "",
            "name": "jonas falkevik",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/d6cc263b989573d097f71150085f6e3629327bf0564272b4baa5da9abe5c9fac?s=80&d=identicon",
            "web_url": "https://gitlab.com/falkevik"
          },
          "created_at": "2022-04-26T20:46:55.089Z",
          "updated_at": "2022-04-26T20:46:55.089Z",
          "system": false,
          "noteable_id": 147333685,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
