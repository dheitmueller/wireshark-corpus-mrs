ount stratoshark_nsis_prep.vcxproj\n@@ -611,13 +611,13 @@ Windows Arm64 Package:\n     name: windows-package\n   script:\n     - C:\\Windows\\py.exe ..\\tools\\make-version.py --set-release --wireshark-version-file=wireshark_version.txt --stratoshark-version-file=stratoshark_version.txt ..\n-    - cmake -G \"Visual Studio 17 2022\" -A arm64\n+    - cmake -G \"Visual Studio 18 2026\" -A arm64\n       -DENABLE_LTO=off\n       -DBUILD_stratoshark=on\n       -DFALCO_PLUGINS=\"$FALCO_PLUGIN_DIR/cloudtrail.dll;$FALCO_PLUGIN_DIR/gcpaudit.dll;$FALCO_PLUGIN_DIR/k8saudit.dll\"\n       -DFALCO_PLUGIN_DLLS=\"$FALCO_PLUGIN_DIR/libunwind.dll\"\n       -DENABLE_SIGNED_NSIS=on ..\n-    - msbuild /verbosity:minimal \"/consoleloggerparameters:PerformanceSummary;NoSummary\" /maxcpucount Wireshark.sln\n+    - msbuild /verbosity:minimal \"/consoleloggerparameters:PerformanceSummary;NoSummary\" /maxcpucount Wireshark.slnx\n     - msbuild /verbosity:minimal /maxcpucount test-programs.vcxproj\n     - msbuild /verbosity:minimal /maxcpucount wireshark_nsis_prep.vcxproj\n     - msbuild /verbosity:minimal /maxcpucount stratoshark_nsis_prep.vcxproj\n@@ -1067,8 +1067,8 @@ Windows Build:\n     - job: \"Commit Check\"\n       optional: true\n   script:\n-    - cmake -G \"Visual Studio 17 2022\" -A x64 -DENABLE_LTO=off -DBUILD_stratoshark=on ..\n-    - msbuild /verbosity:minimal /maxcpucount /property:Configuration=Debug Wireshark.sln\n+    - cmake -G \"Visual Studio 18 2026\" -A x64 -DENABLE_LTO=off -DBUILD_stratoshark=on ..\n+    - msbuild /verbosity:minimal /maxcpucount /property:Configuration=Debug Wireshark.slnx\n     - msbuild /verbosity:minimal /maxcpucount /property:Configuration=Debug test-programs.vcxproj\n     - C:\\Windows\\py.exe -m pytest --build-type=Debug --disable-gui --enable-stratoshark --junitxml=../windows_tests.xml\n   artifacts:\n@@ -1203,9 +1203,9 @@ Coverity Visual C++ Scan:\n     - $gitDescription = (( git describe --tags ) | Out-String).Trim()\n     - C:\\Windows\\System32\\curl --output $env:temp\\cov-analysis-win64.zip --form project=$COVERITY_SCAN_PROJECT_NAME --form token=$COVERITY_SCAN_TOKEN https://scan.coverity.com/download/win64\n     - C:\\ProgramData\\chocolatey\\tools\\7z x \"$env:temp\\cov-analysis-win64.zip\" -y -r -o\"$env:temp\"\n-    - cmake -DTEST_EXTRA_ARGS=--enable-release -DENABLE_LTO=off -G \"Visual Studio 17 2022\" -A x64 ..\n+    - cmake -DTEST_EXTRA_ARGS=--enable-release -DENABLE_LTO=off -G \"Visual Studio 18 2026\" -A x64 ..\n     - $covAnalysisWin64 = (Get-ChildItem -Path $env:temp -Filter \"cov-analysis-win64-*\" -Directory)[0].FullName\n-    - Invoke-Expression \"& $covAnalysisWin64\\bin\\cov-build.exe --return-emit-failures --dir ..\\cov-int msbuild /verbosity:minimal `\"/consoleloggerparameters:PerformanceSummary;NoSummary`\" /maxcpucount:1 Wireshark.sln\"\n+    - Invoke-Expression \"& $covAnalysisWin64\\bin\\cov-build.exe --return-emit-failures --dir ..\\cov-int msbuild /verbosity:minimal `\"/consoleloggerparameters:PerformanceSummary;NoSummary`\" /maxcpucount:1 Wireshark.slnx\"\n     - cd ..\n     - C:\\ProgramData\\chocolatey\\tools\\7z a -tzip cov-int.zip cov-int\n     - '\"export ARTIFACT_JOB_URL=$env:CI_JOB_URL\" | Out-File -Encoding ascii job_environment_variables.sh'\n@@ -1262,8 +1262,8 @@ Visual Studio Code Analysis:\n     - Invoke-Webrequest -OutFile C:\\MinIO\\mc.exe https://dl.min.io/client/mc/release/windows-amd64/archive/mc.RELEASE.2025-08-13T08-35-41Z\n     - if ($( Get-FileHash -Algorithm SHA256 -Path C:\\MinIO\\mc.exe ).Hash -ne \"C8DB13EBEDA31497F354C0E950809DB0AE9B2A2A69B8AFEE68C128C37300C157\" ) { Exit 1 }\n     - $env:caexcludepath = \"C:\\Qt;$env:INCLUDE\"\n-    - cmake -DENABLE_CODE_ANALYSIS=ON -G \"Visual Studio 17 2022\" -A x64 -DENABLE_LTO=off ..\n-    - msbuild /verbosity:minimal \"/consoleloggerparameters:PerformanceSummary;NoSummary\" /maxcpucount:2 Wireshark.sln\n+    - cmake -DENABLE_CODE_ANALYSIS=ON -G \"Visual Studio 18 2026\" -A x64 -DENABLE_LTO=off ..\n+    - msbuild /verbosity:minimal \"/consoleloggerparameters:PerformanceSummary;NoSummary\" /maxcpucount:2 Wireshark.slnx\n     - $report = \"visual-c++-analyze-\" + (Get-Date -format \"yyyy-MM-dd\") + \".html\"\n     - sarif-tools.venv\\Scripts\\sarif html --output $report\n     - if (Test-Path env:MC_DESTINATION_ANALYSIS) { C:\\MinIO\\mc --quiet cp \"$report\" \"$env:MC_DESTINATION_ANALYSIS/\" }\n",
