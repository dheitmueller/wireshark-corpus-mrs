  "changes_data": [
    {
      "diff": "@@ -1017,8 +1017,10 @@ macOS Build:\n   extends: .build-macos\n   rules: !reference [.if-w-w-only-merge-request]\n   # allow_failure: true\n-  timeout: 90 minutes\n+  # https://support.gitlab.com/hc/en-us/articles/20417424085020-GitLab-com-hosted-macOS-runners-stuck-preparing-the-instance\n+  timeout: 45 minutes\n   retry:\n+    max: 2\n     when:\n       - runner_system_failure\n       - stuck_or_timeout_failure\n",
