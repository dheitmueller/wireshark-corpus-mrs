      "diff": "@@ -812,8 +812,8 @@ Ubuntu GCC Build:\n     when: always\n     paths:\n       - gcc_report.html\n-    reports:\n-      junit: ubuntu_tests.xml\n+    # reports:\n+    #   junit: ubuntu_tests.xml\n \n Fedora MinGW Build:\n   extends: .build-mingw\n@@ -910,10 +910,10 @@ Windows Build:\n     - msbuild /verbosity:minimal /maxcpucount /property:Configuration=Debug Wireshark.sln\n     - msbuild /verbosity:minimal /maxcpucount /property:Configuration=Debug test-programs.vcxproj\n     - C:\\Windows\\py.exe -m pytest --disable-gui --build-type=Debug --junitxml=../windows_tests.xml\n-  artifacts:\n-    when: always\n-    reports:\n-      junit: windows_tests.xml\n+  # artifacts:\n+  #   when: always\n+  #   reports:\n+  #     junit: windows_tests.xml\n \n Windows Qt5 Build:\n   extends: .build-windows\n@@ -942,10 +942,10 @@ macOS Build:\n     - ninja\n     - ninja test-programs\n     - pytest --disable-capture --junitxml=../macos_tests.xml\n-  artifacts:\n-    when: always\n-    reports:\n-      junit: macos_tests.xml\n+  # artifacts:\n+  #   when: always\n+  #   reports:\n+  #     junit: macos_tests.xml\n   needs: [ 'Commit Check' ]\n \n # Adapted from https://www.synopsys.com/blogs/software-security/integrating-coverity-scan-with-gitlab-ci/\n",
