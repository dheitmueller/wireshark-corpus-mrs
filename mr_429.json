      "diff": "@@ -7501,6 +7501,10 @@ ssl_dissect_hnd_hello_ext_quic_transport_parameters(ssl_common_dissect_t *hf, tv\n                                     tvb, offset, 1, ENC_BIG_ENDIAN);\n                 offset += 1;\n             break;\n+            case SSL_HND_QUIC_TP_GREASE_QUIC_BIT:\n+                quic_set_grease_quic_bit(tvb, pinfo);\n+                /* No Payload */\n+            break;\n             case SSL_HND_QUIC_TP_MIN_ACK_DELAY:\n                 proto_tree_add_item_ret_varint(parameter_tree, hf->hf.hs_ext_quictp_parameter_min_ack_delay,\n                                                tvb, offset, -1, ENC_VARINT_QUIC, &value, &len);\n",
