  "changes_data": [
    {
      "diff": "@@ -21,6 +21,7 @@\n  * https://tools.ietf.org/html/draft-pauly-quic-datagram-05\n  * https://tools.ietf.org/html/draft-huitema-quic-ts-02\n  * https://tools.ietf.org/html/draft-iyengar-quic-delayed-ack-00\n+ * https://tools.ietf.org/html/draft-thomson-quic-bit-grease-00\n  *\n  * Currently supported QUIC version(s): draft-21, draft-22, draft-23, draft-24,\n  * draft-25, draft-26, draft-27, draft-28, draft-29, draft-30.\n@@ -327,6 +328,8 @@ typedef struct quic_info_data {\n     wmem_map_t     *client_streams; /**< Map from Stream ID -> STREAM info (guint64 -> quic_stream_state), sent by the client. */\n     wmem_map_t     *server_streams; /**< Map from Stream ID -> STREAM info (guint64 -> quic_stream_state), sent by the server. */\n     gquic_info_data_t *gquic_info; /**< GQUIC info for >Q050 flows. */\n+    int             server_sent_grease_quic_bit : 1;\n+    int             client_sent_grease_quic_bit : 1;\n } quic_info_data_t;\n \n /** Per-packet information about QUIC, populated on the first pass. */\n@@ -2911,6 +2914,32 @@ dissect_quic_version_negotiation(tvbuff_t *tvb, packet_info *pinfo, proto_tree *\n     return offset;\n }\n \n+void\n+quic_set_grease_quic_bit(tvbuff_t *tvb _U_, packet_info *pinfo)\n+{\n+    quic_datagram *dgram_info;\n+\n+    if (!PINFO_FD_VISITED(pinfo)) {\n+      dgram_info = (quic_datagram *)p_get_proto_data(wmem_file_scope(), pinfo, proto_quic, 0);\n+      if (dgram_info && dgram_info->conn) {\n+        if (dgram_info->from_server) {\n+          dgram_info->conn->server_sent_grease_quic_bit = 1;\n+        } else {\n+          dgram_info->conn->client_sent_grease_quic_bit = 1;\n+        }\n+      }\n+   }\n+}\n+static int\n+quic_received_grease_quic_bit(quic_datagram *dgram_info)\n+{\n+  if (dgram_info->from_server) {\n+    return dgram_info->conn->client_sent_grease_quic_bit;\n+  } else {\n+    return dgram_info->conn->server_sent_grease_quic_bit;\n+  }\n+}\n+\n static tvbuff_t *\n quic_get_message_tvb(tvbuff_t *tvb, const guint offset)\n {\n@@ -3086,7 +3115,7 @@ dissect_quic(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree,\n             } else {\n                 new_offset = dissect_quic_long_header(next_tvb, pinfo, quic_tree, dgram_info, quic_packet);\n             }\n-        } else if (first_byte != 0) {\n+        } else if (first_byte != 0 || quic_received_grease_quic_bit(dgram_info)) {\n             // Firefox neqo adds unencrypted padding consisting of all zeroes\n             // after an Initial Packet. Whether that is valid or not is\n             // discussed at https://github.com/quicwg/base-drafts/issues/3333\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-quic.c",
      "old_path": "epan/dissectors/packet-quic.c",
