      "notes": [
        {
          "id": 2679728244,
          "type": "DiscussionNote",
          "body": "Hello,\nCan I know what changes will be merged into branch \"release-4.4\"?\nI check the changes in this MR are in master, but not in release-4.4.\nOur vendors hope WPA3 RSN Override can use The Wireshark 4.4.x.\n\nRegards,\nAlbert",
          "author": {
            "id": 14135780,
            "username": "WFA-achuang",
            "public_email": "",
            "name": "Albert Chuang",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/de830255c023f1c7bb7c5fa7c534c852bd15b0043d6a2ff18750f6c1c7bce62a?s=80&d=identicon",
            "web_url": "https://gitlab.com/WFA-achuang"
          },
          "created_at": "2025-08-11T03:21:34.980Z",
          "updated_at": "2025-08-11T16:44:08.483Z",
          "system": false,
          "noteable_id": 323903901,
          "noteable_type": "MergeRequest",
