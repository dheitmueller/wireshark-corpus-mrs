      ],
      "title": "PTP: Fix analysis when sequenceId resets happen.",
      "message": "PTP: Fix analysis when sequenceId resets happen.\n\nSplits single max delta parameter for related messages and\nconsecutive messages of same type into separate thresholds.\nAligns max delta for related messages with expectations of 1588/802.1AS.\nAdds a configurable parameter for max delta for messages of same type.\n\nCloses #20099\n",
      "author_name": "Patrik Thunström",
      "author_email": "patrik.thunstroem@technica-engineering.de",
      "authored_date": "2024-09-26T21:27:27.000+02:00",
      "committer_name": "Alexis La Goutte",
      "committer_email": "alexis.lagoutte@gmail.com",
      "committed_date": "2024-10-04T06:17:47.000+00:00",
      "trailers": {},
