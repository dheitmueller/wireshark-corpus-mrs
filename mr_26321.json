      "diff": "@@ -1,6 +1,6 @@\n /* packet-udx.h\n  * Routines for UDX dissection\n- * Copyright 2026, Prabakaran Sivakumar <zkasuran@gmail.com>\n+ * Copyright 2026, Grigoriy Pelykh <zpelykh.g@proton.me>\n  *\n  * Wireshark - Network traffic analyzer\n  * By Gerald Combs <gerald@wireshark.org>\n@@ -50,6 +50,14 @@ typedef struct udx_info {\n     unsigned num_sack_blocks;\n     uint32_t sack_start[UDX_MAX_SACK_BLOCKS];\n     uint32_t sack_end[UDX_MAX_SACK_BLOCKS];\n+    /* Extended statistics (added for the enhanced dissector) */\n+    uint32_t retrans_count;    /* total retransmissions on this flow */\n+    uint32_t sack_count;       /* total selectively ACKed packets on this flow */\n+    uint32_t mtu_probe_count;  /* total MTU probes on this flow */\n+    bool     end_seen;         /* END flag seen on this flow */\n+    bool     destroy_seen;     /* DESTROY flag seen on this flow */\n+    uint32_t rwnd;             /* advertised receive window */\n+    uint32_t pure_ack_count;   /* consecutive pure ACKs */\n } udx_info_t;\n \n #ifdef __cplusplus\n",
