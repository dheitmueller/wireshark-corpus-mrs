    {
      "diff": "@@ -0,0 +1,94 @@\n+#!/bin/bash\n+# ci/ci-test-udx.sh — UDX dissector CI checks.\n+# Exact copy of the local verification battery (TEST-REPORT.md, Дополнения 1–4).\n+# Exits non-zero on any failure.\n+set -uo pipefail\n+\n+TS=${TS:-build/run/tshark}\n+EC=${EC:-build/run/editcap}\n+CAPS=${CAPS:-test/captures}\n+EVID=${EVID:-ci/captures}\n+EH=\"--enable-heuristic udx_udp\"\n+fail=0\n+\n+step() { echo; echo \"== $* ==\"; }\n+bad()  { echo \"FAIL: $*\"; fail=1; }\n+\n+step \"Registration\"\n+\"$TS\" -G protocols 2>/dev/null | grep -qw udx || bad \"udx not registered\"\n+\n+step \"In-tree captures: every frame must dissect as UDX, none malformed\"\n+total=0; ok=0\n+for f in \"$CAPS\"/udx_*.pcap.gz; do\n+    t=$(\"$TS\" -r \"$f\" 2>/dev/null | wc -l)\n+    n=$(\"$TS\" $EH -r \"$f\" -Y udx 2>/dev/null | wc -l)\n+    m=$(\"$TS\" $EH -r \"$f\" -Y 'udx.malformed || udx.sack_invalid' 2>/dev/null | wc -l)\n+    echo \"  $(basename \"$f\"): $n/$t, malformed=$m\"\n+    total=$((total + t)); ok=$((ok + n))\n+    [ \"$n\" -eq \"$t\" ] || bad \"$(basename \"$f\"): $n != $t\"\n+    [ \"$m\" -eq 0 ]     || bad \"$(basename \"$f\"): $m malformed\"\n+done\n+echo \"  TOTAL: $ok/$total (expected 753/753)\"\n+[ \"$total\" -ge 700 ] || bad \"suspiciously few frames ($total) — captures missing?\"\n+\n+step \"Evidence captures (ci/captures/*.pcap), if present\"\n+if compgen -G \"$EVID/*.pcap\" > /dev/null; then\n+    if [ -f \"$EVID/udx-mr-claims.pcap\" ]; then\n+        # NOTE: expert infos added with pi=NULL (malformed, sack_invalid) show up\n+        # in \"tshark -q -z expert\" but are NOT addressable by display-filter\n+        # abbreviation in current master — hence the summary-grep checks.\n+        sum=$(\"$TS\" -d udp.port==40001,udx -r \"$EVID/udx-mr-claims.pcap\" \\\n+                -q -z expert 2>/dev/null)\n+        echo \"$sum\" | grep -q \"Malformed UDX packet\"  || bad \"malformed SACK tail not flagged\"\n+        echo \"$sum\" | grep -q \"SACK flag set\"         || bad \"empty SACK block not flagged\"\n+        st=$(\"$TS\" -d udp.port==40001,udx -r \"$EVID/udx-mr-claims.pcap\" \\\n+                -Y udx.analysis.ack_storm 2>/dev/null | wc -l)\n+        [ \"$st\" -ge 1 ] || bad \"no ACK storm detected in udx-mr-claims.pcap\"\n+        msg=$(\"$TS\" -d udp.port==40001,udx -r \"$EVID/udx-mr-claims.pcap\" \\\n+                -Y udx.analysis.message 2>/dev/null | wc -l)\n+        [ \"$msg\" -ge 1 ] || bad \"no MESSAGE expert in udx-mr-claims.pcap\"\n+        rej=$(\"$TS\" -d udp.port==40001,udx -r \"$EVID/udx-mr-claims.pcap\" \\\n+                -Y udx 2>/dev/null | wc -l)\n+        [ \"$rej\" -eq 15 ] || bad \"expected exactly 15 UDX frames (version=2 must be rejected), got $rej\"\n+    fi\n+    if [ -f \"$EVID/udx-lossy.pcap\" ]; then\n+        # On loopback most retransmissions classify as spurious/duplicate, so\n+        # assert on the union of all retransmission classes.\n+        rt=$(\"$TS\" $EH -r \"$EVID/udx-lossy.pcap\" \\\n+                -Y \"udx.analysis.retransmission || udx.analysis.spurious_retransmission || udx.analysis.duplicate || udx.analysis.rto_retransmission || udx.analysis.fast_retransmission\" \\\n+                2>/dev/null | wc -l)\n+        [ \"$rt\" -ge 5 ] || bad \"too few retransmission-class events in udx-lossy.pcap ($rt)\"\n+        srtt=$(\"$TS\" $EH -r \"$EVID/udx-lossy.pcap\" -Y udx.analysis.sack_rtt_avg 2>/dev/null | wc -l)\n+        [ \"$srtt\" -ge 1 ] || bad \"no SACK RTT statistics in udx-lossy.pcap\"\n+        jit=$(\"$TS\" $EH -r \"$EVID/udx-lossy.pcap\" -Y udx.analysis.jitter 2>/dev/null | wc -l)\n+        [ \"$jit\" -eq 0 ] || bad \"jitter flag spam is back ($jit frames)\"\n+    fi\n+    if [ -f \"$EVID/udx-keepalive.pcap\" ]; then\n+        ka=$(\"$TS\" $EH -r \"$EVID/udx-keepalive.pcap\" -Y udx.type.heartbeat 2>/dev/null | wc -l)\n+        [ \"$ka\" -ge 1 ] || bad \"no heartbeats in udx-keepalive.pcap\"\n+    fi\n+    if [ -f \"$EVID/udx-basic.pcap\" ]; then\n+        \"$TS\" $EH -r \"$EVID/udx-basic.pcap\" -q -z follow,udx,ascii,0 2>/dev/null \\\n+            | grep -q \"Follow: udx\" || bad \"Follow Stream broken on udx-basic.pcap\"\n+    fi\n+else\n+    echo \"  (no evidence captures committed — skipping)\"\n+fi\n+\n+step \"Preference (ACK storm threshold is configurable)\"\n+\"$TS\" -G currentprefs 2>/dev/null | grep -q \"udx.ack_storm_threshold\" \\\n+    || bad \"udx.ack_storm_threshold preference missing\"\n+\n+step \"Robustness: corrupted capture\"\n+if [ -x \"$EC\" ] && [ -f \"$EVID/udx-lossy.pcap\" ]; then\n+    \"$EC\" -E 0.05 \"$EVID/udx-lossy.pcap\" /tmp/corrupt.pcap >/dev/null 2>&1\n+    \"$TS\" $EH -r /tmp/corrupt.pcap -Y udx >/dev/null 2>&1 || bad \"crash on corrupted capture\"\n+fi\n+\n+echo\n+if [ \"$fail\" -eq 0 ]; then\n+    echo \"ALL UDX CI CHECKS PASSED\"\n+else\n+    echo \"UDX CI CHECKS FAILED\"\n+fi\n+exit \"$fail\"\n\\ No newline at end of file\n",
