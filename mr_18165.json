  "changes_data": [
    {
      "diff": "@@ -874,6 +874,23 @@ gather_caplibs_compile_info(feature_list l)\n \twith_feature(l, \"libpcap\");\n }\n \n+static void\n+with_feature_npcap(feature_list l, const char* fmt, ...)\n+{\n+\tva_list arg;\n+\tGString* msg = g_string_new(\"+\");\n+\tva_start(arg, fmt);\n+\tg_string_append_vprintf(msg, fmt, arg);\n+\tva_end(arg);\n+\t/* NPCAP is Windows only and Glib version on Windows is > 2.68.0 */\n+#if GLIB_CHECK_VERSION(2, 68, 0)\n+\t/* Strip \"version from the string\" */\n+\tg_string_replace(msg, \" version\", \"\", 0);\n+\tg_string_replace(msg, \" based on\", \"\", 0);\n+#endif\n+\t*l = g_list_prepend(*l, g_string_free(msg, FALSE));\n+}\n+\n void\n gather_caplibs_runtime_info(feature_list l)\n {\n@@ -883,7 +900,10 @@ gather_caplibs_runtime_info(feature_list l)\n \t * not and, if we have it, what version we have.\n \t */\n \tif (has_wpcap) {\n-\t\twith_feature(l, \"%s\", p_pcap_lib_version());\n+\t\t/* Use a special version of with_feature()to strip out \"version\n+\t\t * from the string as glib needs to be >= 2.68.0\n+\t\t */\n+\t\twith_feature_npcap(l, \"%s\", p_pcap_lib_version());\n \t} else\n \t\twithout_feature(l, \"Npcap or WinPcap\");\n }\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "capture/capture-wpcap.c",
      "old_path": "capture/capture-wpcap.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
