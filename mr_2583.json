      ],
      "title": "ieee80211: parse multiple TBTT in Reduced Neighbor Report",
      "message": "ieee80211: parse multiple TBTT in Reduced Neighbor Report\n\nRNR can have multiple TBTTs; this is indicated by the TBTT Information\nCount subfield, according to IEEE 802.11ai-2016 standard.\n\n\"The TBTT Information Count subfield is 4 bits in length and contains\nthe number of TBTT Information fields that are included in the Neighbor\nAP Information field, minus one\"\n\nThis commit adds parsing of all included TBTT subelements.\n",
      "author_name": "Sebastien Henri",
      "author_email": "sebastien.henri@meraki.net",
      "authored_date": "2021-03-31T18:24:41.000-07:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-04-06T14:54:55.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/f2091790a364fe0cd5167db800ecd3eb583da4c5"
    },
    {
      "id": "6eb8a81d67755741dfec6fe184ee80478a74e86a",
      "short_id": "6eb8a81d",
      "created_at": "2021-04-06T14:54:55.000+00:00",
      "parent_ids": [
        "d0088585b3df7be3efdc79037eead2a716b06ea6"
      ],
      "title": "ieee80211: add 20 MHz PSD field in Reduced Neighbor Report",
      "message": "ieee80211: add 20 MHz PSD field in Reduced Neighbor Report\n\nThis commit adds the 20 MHz PSD field in Reduced Neighbor Report field,\nas per Draft P802.11ax_D8.0, Table 9-281.\n",
      "author_name": "Sebastien Henri",
      "author_email": "sebastien.henri@meraki.net",
      "authored_date": "2021-03-31T16:47:11.000-07:00",
