      "notes": [
        {
          "id": 2458321482,
          "type": "DiscussionNote",
          "body": "Does it make sense to check for this path (the Apple Silicon keg-only path) before the `/usr/local` path (the Homebrew Intel path)? Hosts with both probably want the Apple Silicon one (#17956).\n\nChecking `CMAKE_HOST_SYSTEM_PROCESSOR` (which can be overridden when cross compiling) is probably optimal, but people who have both libraries installed and want to compile with the Intel libraries should be uncommon now.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
