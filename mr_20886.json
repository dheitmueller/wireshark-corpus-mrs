ot in valid_levels:\n-            print('Error:', filename, 'Expert severity', severity, 'is not in', valid_levels)\n+            print('Error:', filename, name, 'Expert severity', severity, 'is not in', valid_levels)\n             errors_found += 1\n \n         # Checks on the summary field\n",
