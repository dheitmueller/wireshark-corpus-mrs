          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 23715,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "40fd3e3498347fc7b350f8dc2a594419a2e68fd2",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3121861949,
          "type": null,
          "body": "I raised an MR for fixing more of this type of issue. Yes, return value of libgcrypt functions could be checked, indeed, but for now to mitigate Coverity warnings, I added `(void)` in front.",
