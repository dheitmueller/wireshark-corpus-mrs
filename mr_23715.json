    {
      "id": "fa48afba6579a3411f81a8c0b287a6e76538f691",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3121861379,
          "type": null,
          "body": "They should be fixed, although for some of them, e.g. calls to libgcrypt functions, the return value should actually be checked. For some, casting to void is fine (Coverity does heuristics, so if we use the return value 80% of the time it will warn even for functions where it's not necessary.)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-02-28T13:19:01.901Z",
          "updated_at": "2026-02-28T13:19:52.605Z",
          "system": false,
          "noteable_id": 459807197,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
