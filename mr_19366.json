      "notes": [
        {
          "id": 2412131327,
          "type": "DiscussionNote",
          "body": "The long version of this is that what comes after `-e` doesn't have to be just a field anymore, it can be any valid packet matching filter expression (same for columns), as mentioned in the 4.4.0 release notes: https://www.wireshark.org/docs/relnotes/wireshark-4.4.0.html",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-03-23T23:40:00.405Z",
          "updated_at": "2025-03-26T07:21:19.325Z",
          "system": false,
          "noteable_id": 371192851,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
