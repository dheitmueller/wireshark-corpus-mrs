        {
          "id": 2710582254,
          "type": "DiscussionNote",
          "body": "To be clear, I don't object to this change whatsoever, especially if it is soon going to be used, but wanted to point out that we can check and the results are sometimes surprising.",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2025-08-26T17:57:20.588Z",
          "updated_at": "2025-08-26T17:57:20.588Z",
          "system": false,
          "noteable_id": 410102193,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
