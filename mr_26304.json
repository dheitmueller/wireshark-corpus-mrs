  "changes_data": [
    {
      "diff": "@@ -1128,15 +1128,15 @@ AI Trailer Reminder:\n       fi\n       missing=0\n       for c in $commits; do\n-        if ! git log -1 --format=%B \"$c\" | grep -qi '^AI-Assisted:'; then\n-          echo \"WARNING: Commit $c is missing the 'AI-Assisted: yes|no [tool(s)]' trailer.\"\n+        if ! git log -1 --format=%B \"$c\" | grep -qi '^Assisted-by:'; then\n+          echo \"WARNING: Commit $c is missing the 'Assisted-by: [tool(s)]' trailer.\"\n           missing=1\n         fi\n       done\n       if [ $missing -eq 1 ]; then\n-        echo \"Reminder: please add the AI-Assisted trailer to commit messages (warning only).\"\n+        echo \"Reminder: if you used AI assistance, add an 'Assisted-by: [tool(s)]' trailer to your commit messages; see CONTRIBUTING.md (warning only).\"\n       else\n-        echo \"All checked commits include the AI-Assisted trailer.\"\n+        echo \"All checked commits include the Assisted-by AI trailer.\"\n       fi\n \n # Adapted from https://www.synopsys.com/blogs/software-security/integrating-coverity-scan-with-gitlab-ci/\n",
      "collapsed": false,
      "too_large": false,
