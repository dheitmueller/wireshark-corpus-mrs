{
  "id": 250917250,
  "iid": 12080,
  "project_id": 7898047,
  "title": "Prevent fvalue leaks",
  "description": "Add a cleanup function in proto_tree_new_item for the newly\ncreated field_info's fvalue_t, so that if we throw an exception\nbefore adding the new node to the tree, the fvalue_t is properly\nfreed. Pop it off without calling it if we do add the node.\n    \nThis is the function that adds nodes from values retrieved from\nthe tvbuffer, so it can throw exceptions, particularly on variable\nlength items like FT_STRINGZ, VARINTs, and FT_UINT_[STRING|BYTES].",
  "state": "merged",
