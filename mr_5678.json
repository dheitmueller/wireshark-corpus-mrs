        {
          "id": 799009126,
          "type": "DiscussionNote",
          "body": "That Microsoft page says\n\n> You can declare this property and target/run on earlier Windows builds, but you must handle legacy code page detection and conversion as usual.\n\nAre we doing that?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-12-31T20:24:56.628Z",
          "updated_at": "2021-12-31T21:27:49.004Z",
          "system": false,
          "noteable_id": 133322504,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6792385,
            "username": "AndersBroman",
