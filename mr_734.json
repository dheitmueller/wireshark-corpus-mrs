      "diff": "@@ -80,6 +80,14 @@ typedef struct {\n     field_info    *finfo;\n } match_data;\n \n+/**\n+ * Set maximum number of records per capture file.\n+ *\n+ * @param max_records maximum number of records to support.\n+ */\n+extern void\n+cf_set_max_records(guint max_records);\n+\n /**\n  * Add a capture file event callback.\n  *\n",
