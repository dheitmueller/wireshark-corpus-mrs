  "changes_data": [
    {
      "diff": "@@ -622,11 +622,10 @@ dissect_xtp_tspec(tvbuff_t *tvb, proto_tree *tree, uint32_t offset) {\n \n static void\n dissect_xtp_data(tvbuff_t *tvb, proto_tree *tree, uint32_t offset, bool have_btag) {\n-\tuint32_t    len = tvb_reported_length_remaining(tvb, offset);\n \tproto_tree *xtp_subtree;\n \tuint64_t    btag;\n \n-\txtp_subtree = proto_tree_add_subtree(tree, tvb, offset, len, ett_xtp_data, NULL, \"Data Segment\");\n+\txtp_subtree = proto_tree_add_subtree(tree, tvb, offset, tvb_reported_length_remaining(tvb, offset), ett_xtp_data, NULL, \"Data Segment\");\n \n \tif (have_btag) {\n \t\tbtag = tvb_get_ntohl(tvb, offset);\n@@ -634,10 +633,9 @@ dissect_xtp_data(tvbuff_t *tvb, proto_tree *tree, uint32_t offset, bool have_bta\n \t\tbtag += tvb_get_ntohl(tvb, offset+4);\n \t\tproto_tree_add_uint64(xtp_subtree, hf_xtp_btag, tvb, offset, 8, btag);\n \t\toffset += 8;\n-\t\tlen -= 8;\n \t}\n \n-\tproto_tree_add_item(xtp_subtree, hf_xtp_data, tvb, offset, len, ENC_NA);\n+\tproto_tree_add_item(xtp_subtree, hf_xtp_data, tvb, offset, tvb_reported_length_remaining(tvb, offset), ENC_NA);\n \n \treturn;\n }\n",
