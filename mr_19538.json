  "changes_data": [
    {
      "diff": "@@ -182,6 +182,18 @@ double nstime_to_sec(const nstime_t *nstime)\n     return ((double)nstime->secs + (double)nstime->nsecs/NS_PER_S);\n }\n \n+void nstime_rounded(nstime_t *a, const nstime_t *b, ws_tsprec_e prec)\n+{\n+    nstime_t round = NSTIME_INIT_ZERO;\n+    unsigned dv = NS_PER_S;\n+    for (ws_tsprec_e i = WS_TSPREC_SEC; i < prec; i++) {\n+        dv /= 10;\n+    }\n+    round.nsecs = 5 * (dv / 10);\n+    nstime_sum(a, b, &round);\n+    a->nsecs = (a->nsecs / dv) * dv;\n+}\n+\n /*\n  * Compute the minimum and maximum time_t values.\n  *\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "wsutil/nstime.c",
      "old_path": "wsutil/nstime.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -184,6 +184,17 @@ typedef enum {\n  */\n #define NUM_WS_TSPREC_VALS (WS_TSPREC_MAX + 1)\n \n+/** round an nstime to a given precision\n+ *\n+ * a = b rounded to prec\n+ *\n+ * Note that it is acceptable for a and b to point at the same structure.\n+ */\n+WS_DLL_PUBLIC void nstime_rounded(nstime_t *a, const nstime_t *b, ws_tsprec_e prec);\n+\n+/** a rounded to prec */\n+#define nstime_round(a, prec) nstime_rounded(a, a, prec)\n+\n #ifdef __cplusplus\n }\n #endif /* __cplusplus */\n",
      "collapsed": false,
      "too_large": false,
