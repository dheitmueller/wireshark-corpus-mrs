      "diff": "@@ -2268,7 +2268,7 @@ finished_fwd:\n \n         if( seq_not_advanced // XXX is this neccessary?\n         && t < ooo_thres\n-        && tcpd->fwd->tcp_analyze_seq_info->nextseq != seq + seglen ) {\n+        && tcpd->fwd->tcp_analyze_seq_info->nextseq >= seq + seglen ) {\n             if(!tcpd->ta) {\n                 tcp_analyze_get_acked_struct(pinfo->num, seq, ack, TRUE, tcpd);\n             }\n",
