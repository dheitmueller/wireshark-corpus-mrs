  "changes_data": [
    {
      "diff": "@@ -137,8 +137,8 @@ variables:\n   extends: .build-linux\n   rules: !reference [.if-merged]\n   before_script:\n-    # It might make sense to set \"GIT_STRATEGY: none\" and build from\n-    # the tarball.\n+    # Hack to let ninja make full use of the system on Fedora and Rocky.\n+    - export RPM_BUILD_NCPUS=$(( $( getconf _NPROCESSORS_ONLN ) + 2 ))\n     - git config --global user.email \"you@example.com\"\n     - git config --global user.name \"Your Name\"\n     - mkdir build\n",
