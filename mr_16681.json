      "diff": "@@ -7422,7 +7422,7 @@ decode_prefix_MP(proto_tree *tree, int hf_path_id, int hf_addr4, int hf_addr6,\n                 labnum = decode_MPLS_stack(tvb, offset + 1, stack_strbuf);\n \n                 offset += (1 + labnum * 3);\n-                if (plen <= (labnum * 3*8)) {\n+                if (plen < (labnum * 3*8)) {\n                     proto_tree_add_expert_format(tree, pinfo, &ei_bgp_prefix_length_invalid, tvb, start_offset, 1,\n                                         \"%s Labeled IPv4 prefix length %u invalid\",\n                                         tag, plen);\n@@ -7580,7 +7580,7 @@ decode_prefix_MP(proto_tree *tree, int hf_path_id, int hf_addr4, int hf_addr6,\n                 labnum = decode_MPLS_stack(tvb, offset + 1, stack_strbuf);\n \n                 offset += (1 + labnum * 3);\n-                if (plen <= (labnum * 3*8)) {\n+                if (plen < (labnum * 3*8 + 8*8)) {\n                     proto_tree_add_expert_format(tree, pinfo, &ei_bgp_prefix_length_invalid, tvb, start_offset, 1,\n                                         \"%s Labeled VPN IPv4 prefix length %u invalid\",\n                                         tag, plen);\n@@ -7670,7 +7670,7 @@ decode_prefix_MP(proto_tree *tree, int hf_path_id, int hf_addr4, int hf_addr6,\n                 labnum = decode_MPLS_stack(tvb, offset + 1, stack_strbuf);\n \n                 offset += (1 + labnum * 3);\n-                if (plen <= (labnum * 3*8)) {\n+                if (plen < (labnum * 3*8)) {\n                     proto_tree_add_expert_format(tree, pinfo, &ei_bgp_prefix_length_invalid, tvb, start_offset, 1,\n                                         \"%s Labeled IPv6 prefix length %u invalid\", tag, plen);\n                     return -1;\n@@ -7779,7 +7779,7 @@ decode_prefix_MP(proto_tree *tree, int hf_path_id, int hf_addr4, int hf_addr6,\n                 labnum = decode_MPLS_stack(tvb, offset + 1, stack_strbuf);\n \n                 offset += (1 + labnum * 3);\n-         