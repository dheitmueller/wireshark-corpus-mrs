    {
      "id": "1a512bc26d797628b50e03a062920ac9056b8dca",
      "short_id": "1a512bc2",
      "created_at": "2022-01-27T13:48:18.000+00:00",
      "parent_ids": [
        "f098b4ddba893f471078ad1c0d97f4426b61687c"
      ],
      "title": "afp: fix dissection of afp.access and afp.file_bitmap fields.",
      "message": "afp: fix dissection of afp.access and afp.file_bitmap fields.\n\nFix regressions in AppleShare dissection by correcting the length\nof afp.access and afp.file_bitmap fields to be UINT16 as specified\nin the AppleShare protocol specification.\n\nFix reuse of afp.file_bitmask in CatSearchExt as a 16 and as a 32 bit\nvalue by introducing afp.request_bitmask for the 32 bit Request\nBitmap.\n\nCloses #17907.\n",
      "author_name": "Jan Snydr-Michal",
      "author_email": "jan@dogsontheroof.de",
      "authored_date": "2022-01-27T13:54:19.000+01:00",
      "committer_name": "Martin Mathieson",
      "committer_email": "martin.r.mathieson@googlemail.com",
      "committed_date": "2022-01-27T13:48:18.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/1a512bc26d797628b50e03a062920ac9056b8dca"
    },
    {
      "id": "f098b4ddba893f471078ad1c0d97f4426b61687c",
      "short_id": "f098b4dd",
      "created_at": "2022-01-27T13:48:18.000+00:00",
      "parent_ids": [
        "5cdb661b8c63880a52e7ddc40c23ff76175d06d3"
      ],
      "title": "Prevent reuse of hf_afp_file_bitmap as a 16 and 32 bit value in",
      "message": "Prevent reuse of hf_afp_file_bitmap as a 16 and 32 bit value in\ndissections by introducing hf_afp_request_bitmap for the 32 bit\nRequest Bitmap in FPCatSearchExt.  Made the hf_afp_access_*\nFT_BOOLEANs have a width of 16 to reflect the fact that\nhf_afp_access_mode needs to be a FT_UINT16 as AFP spec defines\naccess mode as a short.\n",
      "author_name": "Jan Snydr-Michal",
      "author_email": "jan@dogsontheroof.de",
      "authored_date": "2022-01-27T12:34:47.000+01:00",
      "committer_name": "Martin Mathieson",
      "committer_email": "martin.r.mathieson@googlemail.com",
