    {
      "id": "a43fb3888faf5cd9e564496200b047ea451a80af",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 3181360249,
          "type": "DiscussionNote",
          "body": "How is this being triggered in Stratoshark?  I thought all of the deprecated port preferences were in dissectors that Stratoshark doesn't even load.  Is it from a \"(really) old\" preference file (created before Stratoshark even existed)?",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2026-03-22T11:47:17.637Z",
          "updated_at": "2026-03-22T12:42:52.441Z",
          "system": false,
          "noteable_id": 466162196,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 24013,
          "commands_changes": {}
        },
        {
          "id": 3181380518,
          "type": "DiscussionNote",
          "body": "It's from the `port_prefs` array defined at the top of `deprecated_port_pref`. It might make more sense to exit early from the function or not call it in the first place if our application flavor is Stratoshark, but this will make a demo on Tuesday more presentable.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1788740758",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2026-03-22T12:42:52.405Z",
          "updated_at": "2026-03-22T12:42:52.405Z",
