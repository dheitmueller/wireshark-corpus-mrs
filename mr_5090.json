      "notes": [
        {
          "id": 733670442,
          "type": "DiscussionNote",
          "body": "I don't think the message on build type at generation time is relevant for multitype generators such as Visual Studio, as the build type is chosen at build time.\n\nCould the message be restricted to single type generators?  Maybe for multitype generators the message could show what build types will be available?",
          "author": {
            "id": 6621762,
            "username": "graham.bloice",
            "public_email": "",
            "name": "Graham Bloice",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/8730bfac2267cb97ff1f8187d285f244745a03a783055c8fd6fcd679bfa71c6e?s=80&d=identicon",
            "web_url": "https://gitlab.com/graham.bloice"
          },
          "created_at": "2021-11-15T17:32:21.941Z",
          "updated_at": "2021-11-15T17:51:09.391Z",
