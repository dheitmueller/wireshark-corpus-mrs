  "changes_data": [
    {
      "diff": "@@ -584,11 +584,12 @@ Windows x64 Package:\n       region=us-east-2\n       env_auth=true\n       endpoint=$S3_ENDPOINT_WIRESHARK\n+      no_check_bucket=true\n       acl=private\n       --non-interactive --obscure\n     - $packages = Get-ChildItem \"packaging\\nsis\\Wireshark-*-x64.exe\", \"packaging\\nsis\\Stratoshark-*-x64.exe\", \"packaging\\wix\\Wireshark-*-x64.msi\", \"packaging\\portableapps\\WiresharkPortable??_*.paf.exe\", \"Wireshark-pdb-*x64.zip\"\n     - foreach ($package in $packages) { Write-Host $package.name $(Get-Filehash -Algorithm SHA256 $package).Hash.ToLower() $package.length \"bytes\" }\n-    - if (Test-Path env:S3_DESTINATION_WINDOWS_X64) { rclone copy . \"wireshark:$env:S3_DESTINATION_WINDOWS_X64\" --include \"packaging/nsis/Wireshark-*-x64.exe\" --include \"packaging/nsis/Stratoshark-*-x64.exe\" --include \"packaging/wix/Wireshark-*-x64.msi\" --include \"packaging/portableapps/WiresharkPortable??_*.paf.exe\" --include \"Wireshark-pdb-*x64.zip\" }\n+    - if (Test-Path env:S3_DESTINATION_WINDOWS_X64) { foreach ($package in $packages) { rclone copyto $package \"wireshark:$env:S3_DESTINATION_WINDOWS_X64/$($package.Name)\" } }\n     - $wiresharkVersion = Get-Content .\\wireshark_version.txt\n     - $wiresharkNsisSha256 = (Get-FileHash -Algorithm SHA256 .\\packaging\\nsis\\Wireshark-*-x64.exe).Hash.ToLower()\n     - Set-Content -Path wireshark-release-info-$($wiresharkVersion)-windows-x64.ini -Value (\"[DEFAULT]`nnsis_sha256 = $wiresharkNsisSha256\")\n@@ -637,11 +638,12 @@ Windows Arm64 Package:\n       region=us-east-2\n       env_auth=true\n       endpoint=$S3_ENDPOINT_WIRESHARK\n+      no_check_bucket=true\n       acl=private\n       --non-interactive --obscure\n     - $packages = Get-ChildItem \"packaging\\nsis\\Wireshark-*-arm64.exe\", \"packaging\\nsis\\Stratoshark-*-arm64.exe\", \"Wireshark-pdb-*arm64.zip\"\n     - foreach ($package in $packages) { Write-Host $package.name $(Get-Filehash -Algorithm SHA256 $package).Hash.ToLower() $package.length \"bytes\" }\n-    - if (Test-Path env:S3_DESTINATION_WINDOWS_ARM64) { rclone copy . \"wireshark:$env:S3_DESTINATION_WINDOWS_ARM64\" --include \"packaging/nsis/Wireshark-*-arm64.exe\" --include \"packaging/nsis/Stratoshark-*-arm64.exe\" --include \"Wireshark-pdb-*arm64.zip\" }\n+    - if (Test-Path env:S3_DESTINATION_WINDOWS_ARM64) { foreach ($package in $packages) { rclone copyto $package \"wireshark:$env:S3_DESTINATION_WINDOWS_ARM64/$($package.Name)\" } }\n     - $wiresharkVersion = Get-Content .\\wireshark_version.txt\n     - $wiresharkNsisSha256 = (Get-FileHash -Algorithm SHA256 .\\packaging\\nsis\\Wireshark-*-arm64.exe).Hash.ToLower()\n     - Set-Content -Path wireshark-release-info-$($wiresharkVersion)-windows-arm64.ini -Value (\"[DEFAULT]`nnsis_sha256 = $wiresharkNsisSha256\")\n",
