        {
          "id": 2608882727,
          "type": "DiscussionNote",
          "body": "This makes sense as a guard here, but does it also make sense in `proto_tree_set_representation` to call `proto_find_value_pos` on `fi->rep->representation` after the `ws_label_strcpy` call (instead of calling it beforehand on the input `str`?)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-07-07T14:57:58.513Z",
          "updated_at": "2025-07-10T00:26:27.461Z",
          "system": false,
          "noteable_id": 396816928,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
