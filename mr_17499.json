        {
          "id": 2141029553,
          "type": "DiscussionNote",
          "body": "Please have a look @chuckcraft \n\nI have some doubts, should we rather call this preference \"Conversations Deinterlacing key\" rather than \"Deinterlacing conversation key\" ?\n\nI added some words in UG to clarify the difference between _hardware duplicates_ which are the ones known since the beginning, and _capture duplicates_ that we are now managing. These ones of course are the result of how people capture (on multiple points or interfaces).",
          "author": {
            "id": 6797213,
            "username": "eugene.adell",
            "public_email": "",
            "name": "Eugène Adell",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6797213/avatar.png?v=1789284959",
            "web_url": "https://gitlab.com/eugene.adell"
          },
          "created_at": "2024-10-03T09:29:51.648Z",
          "updated_at": "2024-10-03T13:52:11.995Z",
          "system": false,
          "noteable_id": 331413361,
          "noteable_type": "MergeRequest",
