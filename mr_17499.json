        {
          "id": 2141429105,
          "type": "DiscussionNote",
          "body": "![241003_deinterlace_tooltip_VMI](/uploads/ef629c8346356924a32085ed0672b8c1/241003_deinterlace_tooltip_VMI.png)  \n> \"Separate into different conversations frames that look like duplicates but have different Interface, MAC, or VLAN field values.\",  \n  \nLooks good. My OCD thinks VLAN and Interface should be switched to match the drop down order but maybe makes sense as is based on hardware/software stack of working up levels?",
          "author": {
            "id": 6701257,
            "username": "chuckcraft",
            "public_email": "",
            "name": "Chuck Craft",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/0809ffc6d9d98013a1895132bc055c622830b8a20bfa49328f53d5eb4a1206cb?s=80&d=identicon",
            "web_url": "https://gitlab.com/chuckcraft"
          },
          "created_at": "2024-10-03T13:25:02.156Z",
          "updated_at": "2024-10-03T13:52:11.995Z",
          "system": false,
          "noteable_id": 331413361,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
