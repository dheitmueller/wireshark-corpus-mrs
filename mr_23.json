  "changes_data": [
    {
      "diff": "@@ -1,3 +1,45 @@\n+clang-format_all:\n+  stage: .pre\n+  image: wireshark/wireshark-ubuntu-dev\n+  when: manual\n+  before_script:\n+    - apt-get update && apt-get install -y git clang-format\n+  variables:\n+    ERROR_MSG: \"Detected formatting issues with clang-format!\"\n+    SUCCESS_MSG: \"No formatting issues were detected\"\n+  script:\n+    - find . -type f -not -path \"./epan/wslua/*\" -name \"*.c\" -o -name \"*.h\" -o -name  \"*.cpp\" | xargs clang-format --style=file --dry-run 2>&1 | tee formatting_issues.txt\n+    - if [[ -s formatting_issues.txt ]]; then echo $ERROR_MSG; false; else echo $SUCCESS_MSG; fi\n+  artifacts:\n+    when: on_failure\n+    paths:\n+    - formatting_issues.txt\n+  allow_failure: true\n+\n+merge-request:clang-format_diff:\n+  stage: .pre\n+  image: wireshark/wireshark-ubuntu-dev\n+  only:\n+   - merge_requests\n+  before_script:\n+    - apt-get update && apt-get install -y git clang-format\n+  variables:\n+    ERROR_MSG: \"Detected formatting issues with clang-format!\"\n+    SUCCESS_MSG: \"No formatting issues were detected\"\n+  script:\n+    - curl https://gitlab.com/api/v4/projects/wireshark%2Fwireshark/merge_requests/$CI_MERGE_REQUEST_IID/changes -s | jq -r '.changes | .[] | .new_path,.old_path'|sort -u > modified_files.txt\n+    - cat modified_files | grep -v \"/epan/wslua/\" | grep -v \"/epan/wslua/\" | grep -E \"\\.(c|h|cpp)$|\" > files_to_check.txt\n+    - cat files_to_check.txt | xargs clang-format -i --verbose -style file\n+    - git diff --stat | tee > reformatted_files.txt\n+    - git diff > formatting_issues.diff\n+    - if [[ -s reformatted_files.txt ]]; then echo $ERROR_MSG; false; else echo $SUCCESS_MSG; fi\n+  artifacts:\n+    when: on_failure\n+    paths:\n+    - reformatted_files.txt\n+    - formatting_issues.txt\n+  allow_failure: true\n+\n .build: &build\n   stage: build\n   after_script:\n",
      "collapsed": false,
      "too_large": false,
      "new_path": ".gitlab-ci.yml",
      "old_path": ".gitlab-ci.yml",
