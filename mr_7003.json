    {
      "id": "5233afc82507450d75da40f9d3777ae5ea866441",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 957817528,
          "type": null,
          "body": "I don't like it honestly. I don't think inherently unsigned is a thing here. Using `int` is fine for positive values if you don't need the extra precision. The warning is useless and wasting programmer cycles and polluting history and causing more issues with annoying narrowing warnings. Ugh.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2022-05-24T09:23:51.176Z",
          "updated_at": "2022-05-24T09:23:51.176Z",
          "system": false,
          "noteable_id": 156765693,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 7003,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "1ff43742555be992db255bb10d6d4b4c9fa4f4b3",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 957834900,
          "type": null,
          "body": "> Using `int` is fine for positive values if you don't need the extra precision.\n\nWhat reason is there to prefer `int` to `unsigned int` for values that represent counts or other values guaranteed to be positive?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-05-24T09:33:53.871Z",
          "updated_at": "2022-05-24T09:33:53.871Z",
          "system": false,
          "noteable_id": 156765693,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 7003,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "e21fb74c2ed3c19b3585c22d4761291f3b73cdab",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 957859786,
          "type": null,
          "body": "Unsigned numbers exist to do bit shifts and wrap-around.\n\nThis philosophical meaning of the quantity in relation to its signedness is not something anyone should need to waste time contemplating when programming in C.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2022-05-24T09:48:55.749Z",
          "updated_at": "2022-05-24T09:48:55.749Z",
          "system": false,
          "noteable_id": 156765693,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
