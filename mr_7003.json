          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 7003,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "2e620e1ca370876f50abcf0517cfd5c89bf553f3",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 957992207,
          "type": null,
          "body": "added 6 commits\n\n<ul><li>c5acbfd2...20b311e7 - 5 commits from branch <code>wireshark:master</code></li><li>6f7c6ff5 - tap-iostat: Make a bunch of ints unsigned</li></ul>\n\n[Compare with previous version](/wireshark/wireshark/-/merge_requests/7003/diffs?diff_id=401132836&start_sha=c5acbfd2464146e7d8ca050079cac3c8f5d6de1f)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2022-05-24T11:16:05.919Z",
          "updated_at": "2022-05-24T11:16:05.921Z",
          "system": true,
          "noteable_id": 156765693,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
