  "changes_data": [
    {
      "diff": "@@ -640,6 +640,13 @@ macOS Universal Package:\n   script:\n     - export PATH=\"/Library/Frameworks/Python.framework/Versions/3.13/bin:$PATH:$HOME/bin\"\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n+    # Temporary hack\n+    - if [ ! -d \"$WIRESHARK_BASE_DIR/cmake-4.1.2-macos-universal/CMake.app/Contents/bin/cmake\" ] ; then (\n+          cd \"$WIRESHARK_BASE_DIR\" ;\n+          curl -JLO https://github.com/Kitware/CMake/releases/download/v4.1.2/cmake-4.1.2-macos-universal.tar.gz ;\n+          tar -xf cmake-4.1.2-macos-universal.tar.gz ;\n+      ) fi\n+    - export PATH=\"$WIRESHARK_BASE_DIR/cmake-4.1.2-macos-universal/CMake.app/Contents/bin:$PATH\"\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt\" ] ; then mkdir -p \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos/lib/QtCore.framework\" ] ; then\n         pip3 install aqtinstall ;\n",
