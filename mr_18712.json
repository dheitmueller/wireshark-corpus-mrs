  "changes_data": [
    {
      "diff": "@@ -37,6 +37,9 @@ The following features are either new or have been significantly updated since v\n * The Windows installers now ship with Npcap 1.80.\n   They previously shipped with Npcap 1.79.\n \n+* The Windows installers now ship with Qt 6.8.1.\n+  They previously shipped with Qt 6.5.3.\n+\n * WinPcap is no longer supported. On Windows, use Npcap instead, uninstalling\n   WinPcap if necessary. The last release ever of WinPcap, 4.1.3, was on\n   2013-03-08 and only supports up to Windows 8, which is no longer supported\n@@ -44,9 +47,6 @@ The following features are either new or have been significantly updated since v\n \n * Source packages are now compressed using zstd.\n \n-//* The Windows installers now ship with Qt 6.5.2.\n-//  They previously shipped with Qt 6.2.3.\n-\n * Absolute time fields, regardless of field display in the Packet Details,\n   are always written in ISO 8601 format in UTC with -T json. This was already\n   the case for -T ek since version 4.2.0. JSON is primarily a data interchange\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/Wireshark_Release_Notes.adoc",
      "old_path": "doc/Wireshark_Release_Notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -22,6 +22,9 @@ variables:\n   GIT_DEPTH: \"1\"\n   GIT_FETCH_EXTRA_FLAGS: \"--depth=5000\"\n   CCACHE_DIR: \"${CI_PROJECT_DIR}/ccache\"\n+  # The Qt versions that we ship in the development installers.\n+  WINDOWS_QT_VERSION: \"6.8.1\"\n+  MACOS_QT_VERSION: \"6.5.3\"\n   # Enable color output in various tools.\n   # CMake, Ninja, and others: https://bixense.com/clicolors/\n   CLICOLOR_FORCE: \"1\"\n@@ -182,7 +185,7 @@ workflow:\n     - $env:WIRESHARK_BASE_DIR = \"C:\\Development\"\n     - $env:Configuration = \"RelWithDebInfo\"\n     - $env:Path += \";C:\\Program Files\\CMake\\bin\"\n-    - $env:CMAKE_PREFIX_PATH = \"C:\\qt\\6.8.0\\msvc2022_64\"\n+    - $env:CMAKE_PREFIX_PATH = \"C:\\qt\\$($env:WINDOWS_QT_VERSION)\\msvc2022_64\"\n     # https://help.appveyor.com/discussions/questions/18777-how-to-use-vcvars64bat-from-powershell\n     - cmd.exe /c \"call `\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat`\" && set \" | Foreach-Object { if ($_ -match \"^(.*?)=(.*)$\") { Set-Content \"env:\\$($matches[1])\" $matches[2] } }\n     # Testing / debugging only.\n@@ -494,7 +497,7 @@ Windows x64 Package:\n   before_script:\n     - $env:WIRESHARK_BASE_DIR = \"C:\\Development\"\n     - $env:Configuration = \"RelWithDebInfo\"\n-    - $env:CMAKE_PREFIX_PATH = \"C:\\Qt\\6.8.0\\msvc2022_64\"\n+    - $env:CMAKE_PREFIX_PATH = \"C:\\Qt\\$($env:WINDOWS_QT_VERSION)\\msvc2022_64\"\n     # https://help.appveyor.com/discussions/questions/18777-how-to-use-vcvars64bat-from-powershell\n     - cmd.exe /c \"call `\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat`\" && set\" | Foreach-Object { if ($_ -match \"^(.*?)=(.*)$\") { Set-Content \"env:\\$($matches[1])\" $matches[2] } }\n     - mkdir build\n@@ -542,7 +545,7 @@ Windows Arm64 Package:\n   before_script:\n     - $env:WIRESHARK_BASE_DIR = \"C:\\Development\"\n     - $env:Configuration = \"RelWithDebInfo\"\n-    - $env:CMAKE_PREFIX_PATH = \"C:\\Qt\\6.8.0\\msvc2022_arm64\"\n+    - $env:CMAKE_PREFIX_PATH = \"C:\\Qt\\$($env:WINDOWS_QT_VERSION)\\msvc2022_arm64\"\n     # https://help.appveyor.com/discussions/questions/18777-how-to-use-vcvars64bat-from-powershell\n     - cmd.exe /c \"call `\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvarsarm64.bat`\" && set\" | Foreach-Object { if ($_ -match \"^(.*?)=(.*)$\") { Set-Content \"env:\\$($matches[1])\" $matches[2] } }\n     - mkdir build\n@@ -599,7 +602,7 @@ macOS Arm Package:\n     - wireshark-macos-arm-package\n   retry: 1\n   script:\n-    - export CMAKE_PREFIX_PATH=/usr/local/Qt-6.5.3\n+    - export CMAKE_PREFIX_PATH=/usr/local/Qt-$MACOS_QT_VERSION\n     # Not needed for Falco libs 0.19?\n     - export CXXFLAGS=\"-isystem /usr/local/include/falcosecurity\"\n     - export PATH=\"$PATH:$HOME/bin\"\n@@ -659,7 +662,7 @@ macOS Intel Package:\n     - wireshark-macos-intel-package\n   retry: 1\n   script:\n-    - export CMAKE_PREFIX_PATH=/usr/local/Qt-6.5.3\n+    - export CMAKE_PREFIX_PATH=/usr/local/Qt-$MACOS_QT_VERSION\n     # Not needed for Falco libs 0.19?\n     - export CXXFLAGS=\"-isystem /usr/local/include/falcosecurity\"\n     - export PATH=\"$PATH:$HOME/bin\"\n",
