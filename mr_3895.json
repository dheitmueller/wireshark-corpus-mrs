    {
      "id": "6dbcc90e2c46ad6939b1aca9a447c538b4390998",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 654702210,
          "type": "DiscussionNote",
          "body": "That does not seem correct to me: it's the option length that should be padded to a multiple of 32 bits, as indicated in exported-pdu.h and as done in exported-pdu.c. So it means that one of the option (presumably the EXP_PDU_TAG_TCP_INFO_DATA one but I have not looked at the code nor the pcap yet) is not built correctly during the export.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
            "web_url": "https://gitlab.com/pquantin"
          },
          "created_at": "2021-08-19T06:27:32.308Z",
          "updated_at": "2021-08-19T06:27:32.308Z",
          "system": false,
          "noteable_id": 112946982,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 3895,
          "commands_changes": {}
        }
