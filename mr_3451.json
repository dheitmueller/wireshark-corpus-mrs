      "diff": "@@ -685,6 +685,17 @@ static void log_write_dispatch(const char *domain, enum ws_log_level level,\n         g_date_time_unref(now);\n     }\n \n+    if (custom_log) {\n+        va_list user_ap_copy;\n+\n+        G_VA_COPY(user_ap_copy, user_ap);\n+        log_write_do_work(custom_log, FALSE,\n+                            tstamp, domain, level,\n+                            file, line, func,\n+                            user_format, user_ap_copy);\n+        va_end(user_ap_copy);\n+    }\n+\n     if (registered_log_writer) {\n         registered_log_writer(domain, level, tstamp, file, line, func,\n                         user_format, user_ap, registered_log_writer_data);\n@@ -694,11 +705,6 @@ static void log_write_dispatch(const char *domain, enum ws_log_level level,\n                         user_format, user_ap);\n     }\n \n-    if (custom_log) {\n-        log_write_do_work(custom_log, FALSE, tstamp, domain, level, file, line, func,\n-                        user_format, user_ap);\n-    }\n-\n     g_free(tstamp);\n \n     ws_assert(level != LOG_LEVEL_NONE);\n",
