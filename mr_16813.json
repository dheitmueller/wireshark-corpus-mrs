    {
      "id": "b3738451cfe47647604abacb76d319bd1988f33a",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2041985253,
          "type": null,
          "body": "> In practice, I don't believe this matters, because we always read through the file sequentially once and only add fast seek points during that initial read. This code from zlib is for when a seek happens during a time when you might still be adding fast seek points.\n\nWe might not *currently* do seeks while we're doing sequential reads of a saved file, but I'm not 100% certain that we don't do so during a live capture, and we might do those seeks in the future.  See https://gitlab.com/wireshark/wireshark/-/commit/4e1697141bfb33af11b796cdb0726c3dc58a0ce2#note_2041977134. So this is the right thing to do regardless.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-08-12T20:28:36.407Z",
          "updated_at": "2024-08-12T20:29:01.356Z",
          "system": false,
          "noteable_id": 320781961,
