        {
          "id": 1540751772,
          "type": "DiscussionNote",
          "body": "Hello @alagoutte,\n\nI know it’s 5 months old but do you remember what was the warning you were trying to fix?\n\nI can take a look since I’m currently working around the thrift dissector again. I didn’t find anything in the latest MR results !11753 but maybe I’m not looking in the right place.",
          "author": {
            "id": 7724340,
            "username": "EnigmaTriton",
            "public_email": "",
            "name": "Triton Circonflexe",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/7724340/avatar.png?v=1789776127",
            "web_url": "https://gitlab.com/EnigmaTriton"
          },
          "created_at": "2023-09-03T14:25:37.056Z",
          "updated_at": "2023-09-04T09:39:22.467Z",
          "system": false,
          "noteable_id": 213347832,
