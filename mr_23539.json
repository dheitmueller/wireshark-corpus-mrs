mp(vvalues->vstring, \"0\")==0) {\n                     vvalues->vstring = \"Value (0) = Object\";\n                 }\n@@ -4687,7 +4687,7 @@ process_multivalues(proto_tree *ncp_tree, tvbuff_t *tvb, packet_info *pinfo, nds\n     uint32_t        value2 = 0;\n     uint8_t         value3 = 0;\n     uint32_t        value4 = 0;\n-    int             value5 = 0;\n+    uint32_t        value5 = 0;\n     uint32_t        value6 = 0;\n     uint32_t        value7 = 0;\n     const char      *valuestr = \"\";\n@@ -6694,7 +6694,7 @@ dissect_ncp_123_62_reply(tvbuff_t *tvb, packet_info* pinfo, proto_tree *volatile\n {\n     uint8_t cmd_type;\n     const char * param_string;\n-    int ret_len;\n+    uint32_t ret_len;\n \n     cmd_type = tvb_get_uint8(tvb, 8+16);\n     param_string = (const char *)tvb_get_stringz_enc(pinfo->pool, tvb, 8+24, &ret_len, ENC_ASCII);\n",
