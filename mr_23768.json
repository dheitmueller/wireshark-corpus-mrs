    {
      "id": "bcb8b1885c63776c3247c8776123b71fb6f5e077",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 3130699868,
          "type": "DiscussionNote",
          "body": "You should handle the return value of `tvb_find_line_end_remaining()` otherwise Coverity will raise a warning.\n\nPlease have a look of !23719 where we fixed many of this type of warnings.\n\nSo the correct change should be:\n\n`(void) tvb_find_line_end_remaining(tvb, 0, &sectionlen , &tvb_sectionend);`\n\n`(void) tvb_find_line_end_remaining(tvb, offset, &linelen, &next_offset);`",
          "author": {
            "id": 20971927,
            "username": "rtommy",
            "public_email": "",
            "name": "Tamas Regos",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/20971927/avatar.png?v=1788090511",
