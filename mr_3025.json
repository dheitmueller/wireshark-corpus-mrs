      "resolvable": false,
      "notes": [
        {
          "id": 576989980,
          "type": null,
          "body": "Sorry, I meant another thing. `strcmp` forbids the null pointer. Having the empty string in `topic` causes `topic_elements[0]` to be NULL. That causes an error.",
