          "commands_changes": {}
        },
        {
          "id": 823841311,
          "type": "DiscussionNote",
          "body": "I think it was just a fluke that I picked a project name that matched an existing entry in `.gitignore`.  \nUsing qt-creator on an undersized Windows VM to build or debug was frustrating hence hasn't been touched in a year. I'll purge the project files and move on.  \n  \nIs there ever a need for Projects in qt-creator and if so what should they be named to avoid issues with Git?",
          "author": {
            "id": 6701257,
            "username": "chuckcraft",
            "public_email": "",
            "name": "Chuck Craft",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/0809ffc6d9d98013a1895132bc055c622830b8a20bfa49328f53d5eb4a1206cb?s=80&d=identicon",
            "web_url": "https://gitlab.com/chuckcraft"
          },
          "created_at": "2022-01-27T17:02:15.738Z",
          "updated_at": "2022-01-27T17:02:15.738Z",
          "system": false,
          "noteable_id": 136541821,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
