          "commands_changes": {}
        },
        {
          "id": 823857070,
          "type": "DiscussionNote",
          "body": "When you open CMakeLists.txt in Qt Creator, it uses the name specified by CMake's \"project\" directive. As far as I know you can't change it.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
