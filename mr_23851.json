  "changes_data": [
    {
      "diff": "@@ -41,8 +41,8 @@ See the “New and Updated Features” section below for more details.\n \n The following features are either new or have been significantly updated since version 4.6.0:\n \n-// * The Windows installers now ship with Npcap 1.83.\n-//   They previously shipped with Npcap 1.79.\n+* The Windows installers now ship with Npcap 1.87.\n+  They previously shipped with Npcap 1.83.\n \n // * The Windows installers now ship with Qt 6.8.3.\n //   They previously shipped with Qt 6.5.3.\n",
      "collapsed": false,
      "too_large": false,
