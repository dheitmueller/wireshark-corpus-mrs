    {
      "id": "ba0c27bf55209c68abf57ed372247f85cad07b41",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1639261389,
          "type": null,
          "body": "In the original design, epan holds secrets, and wiretap updates epan with data through `secrets_wtap_callback`. This was influenced by how name resolution information was handled.\n\nIn this change, wiretap is extended with (1) accessors to the DSB and (2) mappings of the secret identifiers. I suppose having some indication of DSBs is better than none.",
          "author": {
            "id": 2415432,
            "username": "Lekensteyn",
            "public_email": "",
            "name": "Peter Wu",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/efcf30db53f30b15e7c905ef37bd4dc44d87573bd92baf97cd707115d3fcd0c0?s=80&d=identicon",
            "web_url": "https://gitlab.com/Lekensteyn"
          },
          "created_at": "2023-11-08T13:20:15.977Z",
          "updated_at": "2023-11-08T13:20:15.977Z",
          "system": false,
          "noteable_id": 261134065,
          "noteable_type": "MergeRequest",
