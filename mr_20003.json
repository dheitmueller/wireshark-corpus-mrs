  "changes_data": [
    {
      "diff": "@@ -509,7 +509,7 @@ $ export WIRESHARK_DEBUG_WMEM_OVERRIDE=simple\n \n Wireshark uses GLib's GSlice memory allocator, either indirectly via wmem or via various GLib API calls.\n GLib provides a `G_SLICE` environment variable that can be set to `always-malloc` (similar to `simple`) or `debug-blocks` (similar to `strict`).\n-See https://developer-old.gnome.org/glib/stable/glib-running.html for details.\n+See https://docs.gtk.org/glib/running.html for details.\n The C libraries on FreeBSD, Linux, and macOS also support memory allocation debugging via various environment variables.\n You can enable many of them by running `source tools/debug-alloc.env` in a POSIX shell.\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/wsdg_src/wsdg_sources.adoc",
      "old_path": "doc/wsdg_src/wsdg_sources.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -501,7 +501,7 @@ I 2019-05-14T19:04:57Z\n ==== Regular Text Dumps\n \n Wireshark is also capable of scanning the input using a custom Perl regular\n-expression as specified by GLib's https://developer-old.gnome.org/glib/stable/glib-regex-syntax.html[GRegex here].\n+expression as specified by GLib's https://docs.gtk.org/glib/struct.Regex.html[GRegex here].\n Using a regex capturing a single packet in the given file\n Wireshark will search the given file from start to the second to last character\n (the last character has to be `\\n` and is ignored)\n@@ -628,7 +628,7 @@ Packet format regular expression::\n This is the regex used for searching packets and metadata inside the input file.\n Named capturing subgroups are used to find the individual fields. Anchors `^` and\n `$` are set to match directly before and after newlines `\\n` or `\\r\\n`. See\n-https://developer-old.gnome.org/glib/stable/glib-regex-syntax.html[GRegex] for a full\n+https://docs.gtk.org/glib/struct.Regex.html[GRegex] for a full\n documentation.\n \n Data encoding::\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/wsug_src/wsug_io.adoc",
      "old_path": "doc/wsug_src/wsug_io.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -55,7 +55,7 @@ static char mmdbr_stop_sentinel[] = \"\\x04\"; // ASCII EOT. Could be anything.\n \n // The GLib documentation says that g_rw_lock_reader_lock can be called\n // recursively:\n-//   https://developer-old.gnome.org/glib/stable/glib-Threads.html#g-rw-lock-reader-lock\n+//   https://docs.gtk.org/glib/method.RWLock.reader_lock.html\n // However, g_rw_lock_reader_lock calls AcquireSRWLockShared\n //   https://gitlab.gnome.org/GNOME/glib/blob/master/glib/gthread-win32.c#L206\n // and SRW locks \"cannot be acquired recursively\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/maxmind_db.c",
      "old_path": "epan/maxmind_db.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -41,7 +41,7 @@ typedef struct _wmem_map_t wmem_map_t;\n  * the map is fully destroyed. Items stored in it will not be freed unless they\n  * were allocated from the same scope. For details on the GHashFunc and\n  * GEqualFunc parameters, see the glib documentation at:\n- * https://developer-old.gnome.org/glib/stable/glib-Hash-Tables.html\n+ * https://docs.gtk.org/glib/struct.HashTable.html\n  *\n  * If the keys are coming from untrusted data, do *not* use glib's default hash\n  * functions for strings, int64s or doubles. Wmem provides stronger equivalents\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "wsutil/wmem/wmem_map.h",
