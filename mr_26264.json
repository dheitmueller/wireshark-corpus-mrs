      "generated_file": false
    },
    {
      "diff": "@@ -32,17 +32,16 @@ ws_readme_dsym = 'Debugging symbols installation.html'\n # Uncomment to override the output volume name\n # volume_name = 'Wireshark ' + ws_version\n \n-# From the hdiutil man page:\n+# Volume format. See `diskutil image create from --help` or the diskutil\n+# man page or\n+# https://eclecticlight.co/2025/04/05/a-brief-history-of-disk-images-on-the-mac/\n # UDZO - UDIF zlib-compressed image\n-# UDBZ - UDIF bzip2-compressed image (Mac OS X 10.4+ only)\n+# UDBZ – UDIF bzip2-compressed image (deprecated)\n # ULFO - UDIF lzfse-compressed image (OS X 10.11+ only)\n # ULMO - UDIF lzma-compressed image (macOS 10.15+ only)\n-# Volume format (see hdiutil create -help)\n-\n-# dSYMs are huge, so compress them with UDBZ despite what\n-# https://developer.apple.com/forums/thread/128166\n-# currently (Jan 2023) says.\n-format = defines.get('format', 'UDBZ')\n+#\n+# diskutil uses ULFO by default, but ULMO creates smaller images.\n+format = defines.get('format', 'ULMO')\n \n # Compression level (if relevant)\n compression_level = 9\n",
