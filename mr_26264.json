  "changes_data": [
    {
      "diff": "@@ -37,16 +37,16 @@ ss_uninstall_path_helper = 'Remove Stratoshark from the system path.pkg'\n # Uncomment to override the output volume name\n # volume_name = 'Stratoshark ' + ss_version\n \n-# From the hdiutil man page:\n+# Volume format. See `diskutil image create from --help` or the diskutil\n+# man page or\n+# https://eclecticlight.co/2025/04/05/a-brief-history-of-disk-images-on-the-mac/\n # UDZO - UDIF zlib-compressed image\n-# UDBZ - UDIF bzip2-compressed image (Mac OS X 10.4+ only)\n+# UDBZ – UDIF bzip2-compressed image (deprecated)\n # ULFO - UDIF lzfse-compressed image (OS X 10.11+ only)\n # ULMO - UDIF lzma-compressed image (macOS 10.15+ only)\n-# Volume format (see hdiutil create -help)\n-\n-# https://developer.apple.com/forums/thread/128166\n-# currently (Jan 2023) says to use UDZO\n-format = defines.get('format', 'UDZO')\n+#\n+# diskutil uses ULFO by default.\n+format = defines.get('format', 'ULFO')\n \n # Compression level (if relevant)\n compression_level = 9\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/macosx/stratoshark-app.dmgbuild.in",
      "old_path": "packaging/macosx/stratoshark-app.dmgbuild.in",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -32,17 +32,16 @@ ss_readme_dsym = 'Debugging symbols installation.html'\n # Uncomment to override the output volume name\n # volume_name = 'Stratoshark ' + ss_version\n \n-# From the hdiutil man page:\n+# Volume format. See `diskutil image create from --help` or the diskutil\n+# man page or\n+# https://eclecticlight.co/2025/04/05/a-brief-history-of-disk-images-on-the-mac/\n # UDZO - UDIF zlib-compressed image\n-# UDBZ - UDIF bzip2-compressed image (Mac OS X 10.4+ only)\n+# UDBZ – UDIF bzip2-compressed image (deprecated)\n # ULFO - UDIF lzfse-compressed image (OS X 10.11+ only)\n # ULMO - UDIF lzma-compressed image (macOS 10.15+ only)\n-# Volume format (see hdiutil create -help)\n-\n-# dSYMs are huge, so compress them with UDBZ despite what\n-# https://developer.apple.com/forums/thread/128166\n-# currently (Jan 2023) says.\n-format = defines.get('format', 'UDBZ')\n+#\n+# diskutil uses ULFO by default, but ULMO creates smaller images.\n+format = defines.get('format', 'ULMO')\n \n # Compression level (if relevant)\n compression_level = 9\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/macosx/stratoshark-dsym.dmgbuild.in",
      "old_path": "packaging/macosx/stratoshark-dsym.dmgbuild.in",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -37,33 +37,16 @@ ws_uninstall_path_helper = 'Remove Wireshark from the system path.pkg'\n # Uncomment to override the output volume name\n # volume_name = 'Wireshark ' + ws_version\n \n-# From the hdiutil man page:\n+# Volume format. See `diskutil image create from --help` or the diskutil\n+# man page or\n+# https://eclecticlight.co/2025/04/05/a-brief-history-of-disk-images-on-the-mac/\n # UDZO - UDIF zlib-compressed image\n-# UDBZ - UDIF bzip2-compressed image (Mac OS X 10.4+ only)\n+# UDBZ – UDIF bzip2-compressed image (deprecated)\n # ULFO - UDIF lzfse-compressed image (OS X 10.11+ only)\n # ULMO - UDIF lzma-compressed image (macOS 10.15+ only)\n-# Volume format (see hdiutil create -help)\n #\n-# A test with the following bundles resulted in the following .dmg sizes,\n-# measured with `du -sm`:\n-# 182     Wireshark.app\n-# 267     Wireshark.dSYM\n-#\n-# UDBZ\n-# 51      Wireshark 3.7.0 Intel 64.dmg\n-# 81      Wireshark dSYM 3.7.0 Intel 64.dmg\n-#\n-# ULFO\n-# 51      Wireshark 3.7.0 Intel 64.dmg\n-# 81      Wireshark dSYM 3.7.0 Intel 64.dmg\n-#\n-# ULMO\n-# 40      Wireshark 3.7.0 Intel 64.dmg\n-# 50      Wireshark dSYM 3.7.0 Intel 64.dmg\n-\n-# https://developer.apple.com/forums/thread/128166\n-# currently (Jan 2023) says to use UDZO\n-format = defines.get('format', 'UDZO')\n+# diskutil uses ULFO by default.\n+format = defines.get('format', 'ULFO')\n \n # Compression level (if relevant)\n compression_level = 9\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/macosx/wireshark-app.dmgbuild.in",
      "old_path": "packaging/macosx/wireshark-app.dmgbuild.in",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
