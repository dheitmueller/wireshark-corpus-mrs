    {
      "id": "fb0702a933d96467a3c3ea942c3db2e001ac4248",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2790210652,
          "type": null,
          "body": "> Wasn't really sure whether/how to handle the `read_record()` return value, but the value was not used before either and the loop is determined by `to_read`.\n\nThe return value is `true` if the packet passed the read filter and was added to the packet list and `false` if it didn't pass the read filter and was discarded (other than any effect dissecting it had on persistent dissector state). It appears that nothing that calls it needs to know whether the packet passed the read filter, so the way to handle it is \"change it to `void` and return nothing\".",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2025-10-01T06:46:21.331Z",
          "updated_at": "2025-10-01T06:46:21.331Z",
          "system": false,
          "noteable_id": 419820069,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 21554,
          "commands_changes": {}
        }
      ]
    }
  ],
  "changes_data": [
