    {
      "diff": "@@ -44,7 +44,6 @@ BASIC_LIST=\"mingw64-gcc \\\n \tmingw64-qt6-qt5compat \\\n \tmingw64-qt6-qtmultimedia \\\n \tmingw64-qt6-qttools \\\n-\tmingw64-speexdsp \\\n \tmingw32-nsis \\\n \tmingw64-nsis \\\n \tmingw64-gnutls \\\n@@ -65,6 +64,21 @@ BASIC_LIST=\"mingw64-gcc \\\n \tcmake\n \tcmake-rpm-macros\"\n \n+# Adds package $2 to list variable $1 if the package is found\n+add_package() {\n+\tlocal list=\"$1\" pkgname=\"$2\"\n+\n+\t# fail if the package is not known\n+\t# shellcheck disable=SC2086\n+\tdnf info \"$pkgname\" &> /dev/null || return 1\n+\n+\t# package is found, append it to list\n+\teval \"${list}=\\\"\\${${list}} \\${pkgname}\\\"\"\n+}\n+\n+add_package BASIC_LIST mingw64-speexdsp ||\n+echo \"Basic package mingw64-speexdsp is unavailable\" >&2\n+\n ACTUAL_LIST=$BASIC_LIST\n \n dnf install $ACTUAL_LIST $OPTIONS\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "tools/mingw-rpm-setup.sh",
      "old_path": "tools/mingw-rpm-setup.sh",
      "a_mode": "100755",
