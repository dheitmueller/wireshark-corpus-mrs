  "changes_data": [
    {
      "diff": "@@ -2652,7 +2652,19 @@ sub parse_file($$)\n \t\t\t$cpp = \"$ENV{CC}\";\n \t\t\t$options = \"-E\";\n \t\t} else {\n-\t\t\t$cpp = \"cpp\";\n+\t\t\t#\n+\t\t\t# If cc is Clang-based don't use cpp, as\n+\t\t\t# at least some versions of Clang, cpp\n+\t\t\t# doesn't strip // comments, but cc -E\n+\t\t\t# does.\n+\t\t\t#\n+\t\t\tmy $cc_version = `cc --version`;\n+\t\t\tif ($cc_version =~ /clang/) {\n+\t\t\t\t$cpp = \"cc\";\n+\t\t\t\t$options = \"-E\"\n+\t\t\t} else {\n+\t\t\t\t$cpp = \"cpp\";\n+\t\t\t}\n \t\t}\n \t}\n \tmy $includes = join('',map { \" -I$_\" } @$incdirs);\n",
