  "changes_data": [
    {
      "diff": "@@ -657,6 +657,8 @@ macOS Universal Package:\n       fi\n     - export CMAKE_PREFIX_PATH=\"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos\"\n     - export PKG_CONFIG_PATH=\n+    # Temporary hack to work around loading Go plugins on x86_64\n+    - for falco_plugin in gcpaudit k8saudit ; do cp -f $FALCO_PLUGIN_DIR/lib${falco_plugin}.so $FALCO_PLUGIN_DIR/lib${falco_plugin}.so.disabled ; done\n     - mkdir build\n     - cd build\n     - ../tools/make-version.py --set-release --wireshark-version-file=wireshark_version.txt --stratoshark-version-file=stratoshark_version.txt ..\n@@ -667,7 +669,7 @@ macOS Universal Package:\n       -DCMAKE_OSX_DEPLOYMENT_TARGET=12.0\n       -DCMAKE_OSX_ARCHITECTURES=\"arm64;x86_64\"\n       -DBUILD_stratoshark=on\n-      -DFALCO_PLUGINS=\"$FALCO_PLUGIN_DIR/libcloudtrail.so;$FALCO_PLUGIN_DIR/libgcpaudit.so;$FALCO_PLUGIN_DIR/libk8saudit.so\"\n+      -DFALCO_PLUGINS=\"$FALCO_PLUGIN_DIR/libcloudtrail.so;$FALCO_PLUGIN_DIR/libgcpaudit.so.disabled;$FALCO_PLUGIN_DIR/libk8saudit.so.disabled\"\n       -DTEST_EXTRA_ARGS=--enable-release\n       ..\n     # Temporary hack to fix \"Package 'zlib', required by 'libscap', not found\"\n@@ -677,8 +679,6 @@ macOS Universal Package:\n     - for exe in $( find run/{Wire,Strato}shark.app/Contents/MacOS -type f ) ; do\n         lipo \"$exe\" -verify_arch arm64 x86_64 ;\n       done\n-    # Temporary hack to work around loading Go plugins on x86_64\n-    - for falco_plugin in gcpaudit k8saudit ; do mv run/Stratoshark.app/Contents/PlugIns/stratoshark/falco/lib${falco_plugin}.so run/Stratoshark.app/Contents/PlugIns/stratoshark/falco/lib${falco_plugin}.so.disabled ; done\n     - codesign-prep\n     - security find-identity -v -s \"$CODE_SIGN_IDENTITY\"\n     - ninja wireshark_dmg\n",
