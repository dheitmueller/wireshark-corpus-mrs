      "notes": [
        {
          "id": 1400431153,
          "type": null,
          "body": "I wasn't planning on working on it. Is it not obsolescent? Is there source code available for it?",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
