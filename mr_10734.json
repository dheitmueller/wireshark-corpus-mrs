    {
      "id": "ceaf6ca63191275fbb97b168b07f49606d7cc74c",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1400456168,
          "type": null,
          "body": "Riverbed isn't selling it any more.\n\nSource code for the AirPcap library is not available, but source code for the code that calls the library is available in both the WinPcap and Npcap packet.dll libraries and in newer versions of libpcap itself.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2023-05-22T20:08:48.709Z",
          "updated_at": "2023-05-22T20:08:48.709Z",
          "system": false,
          "noteable_id": 225303537,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 10734,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "e6ca951db5a4b89a775d70cd8ac31eb752bdf0a0",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1400472685,
          "type": null,
          "body": "The change is because the AirPcap SDK is not available in the MSYS2 environment and it is extremely unlikely it ever will be.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
