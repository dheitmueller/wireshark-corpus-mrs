{
  "id": 411992232,
  "iid": 21174,
  "project_id": 7898047,
  "title": "MPEG TS improvements adding a dissector table for handling PMT extended descriptors",
  "description": "This commit adds to the MPEG TS (ISO/IEC 13818-1 | Rec. ITU-T H.222.0) protocol a new dissector table \"mpeg_descr.iso_ext.tag\" to allow further dissection of ISO Extension descriptors (tag == 0x3F) in the PMT. This is similar to the \"mpeg-pes.stream\" dissector table and complements the existing MPEG TS protocol dissectors.",
  "state": "merged",
