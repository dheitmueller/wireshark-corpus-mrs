    {
      "id": "a1283aee802c30009d527dc0809064aa1253760f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2013860105,
          "type": null,
          "body": "I checked out the latest, re-added nspi and mapi to `CMakeLists.txt`, and they built fine, without the mentioned error (which for those is apparently C++ style comments not working.) They were building in the CI/CD before this change.\n\nI do get the \"error: inline arrays not supported\" for eventlog, though that does not actually cause a failure in regenerating the dissector.\n\nThere's also a number of Perl warnings that are now emitted after upstream Samba enabled `use warnings`, mostly comparing things to `undef`, that should probably be cleaned up eventually.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-07-24T12:32:14.126Z",
          "updated_at": "2024-07-24T12:32:14.126Z",
          "system": false,
          "noteable_id": 317017313,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 16570,
