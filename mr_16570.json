        }
      ]
    },
    {
      "id": "423d68ba8cfbae7f3a87939c27c85f4578280288",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2013896217,
          "type": null,
          "body": "For the syntax error with C++ style comments, I'm not sure how that happened but I suppose it's possible that @guyharris wasn't building with the latest [Parse::Yapp](https://metacpan.org/dist/Parse-Yapp).\n\nFor `winspool`, we have a hand written `dcerpc-spools` dissector which exposes a header file, and everything `winspool` needs it gets from that. Possibly eventually it would be nice to build the `dcerpc-spools` dissector from idl, but it doesn't seem necessary.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-07-24T12:47:28.033Z",
          "updated_at": "2024-07-24T12:48:09.288Z",
