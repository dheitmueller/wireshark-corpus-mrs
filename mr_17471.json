  "changes_data": [
    {
      "diff": "@@ -681,7 +681,7 @@ Commit Check:\n     # Adding notes (comments) to a merge request depends on a valid GitLab CI_JOB_TOKEN\n     # variable. Trying to do so will fail when run under outside projects until\n     # https://gitlab.com/gitlab-org/gitlab/-/issues/464591 is fixed.\n-    - glab auth status\n+    - glab auth status || true\n     - glab auth status 2>&1 | grep 'Logged in to gitlab.com as' > /dev/null || echo \"Unable to post merge request comments from $CI_PROJECT_PATH\"\n     - >\n       if [[ $NUM_COMMITS > 1 ]] ; then\n",
