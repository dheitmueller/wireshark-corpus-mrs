{
  "id": 440332528,
  "iid": 22762,
  "project_id": 7898047,
  "title": "RTPS: Use tvb_memdup",
  "description": "When storing in a pinfo->pool structure, use tvb_memdup instead of\ntvb_get_ptr followed by g_memdup2 and freeing the memory. This also\nmeans that we don't have to conditionally free depending on whether\nit was pinfo->pool (and zeroed out in several places) vs a direct\npointer via tvb_get_ptr (slightly unsafe but presumably a bit faster.)",
  "state": "merged",
  "created_at": "2025-12-13T18:59:28.121Z",
  "updated_at": "2025-12-13T19:49:15.534Z",
