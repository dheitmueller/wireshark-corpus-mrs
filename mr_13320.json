      "diff": "@@ -27,6 +27,7 @@ adoc_files = glob(\"docbook/wsug_src/*.adoc\")\n for adoc_file in adoc_files:\n     with open(adoc_file) as f:\n         for line in f:\n+            # Fail on legacy block anchor syntax (double square brackets)\n             if tag := search(r\"^\\[\\#(.*)]\", line):\n                 chapter = tag.group(1)\n                 if chapter in found:\n",
