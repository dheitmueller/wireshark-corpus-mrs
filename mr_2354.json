    {
      "id": "ffe4f628320d3fc317071c8796c39e937fbb510a",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 683262357,
          "type": null,
          "body": "Not sure the best place to mention this, but you cannot use try_heuristics on a listname (e.g. tcp) if the dissector you are calling it from has a heuristic registered to this list name, as this creates an infinite loop and crashes wireshark. E.g. if you have\n`proto:register_heuristic(\"tcp\", ...)`, and then use `DissectorTable.try_heuristics(\"tcp\", ...)`. Perhaps it would be better to get and try individual heuristics since this would avoid this problem, and be less expensive if you know you only need to try the heuristics from a subset of dissectors.",
          "author": {
            "id": 9483723,
            "username": "Yepadee",
            "public_email": "",
            "name": "James Hawkins",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/e824f46cad4794137836d5e019f82c955bfa586e9225a39169c24d0566334c8d?s=80&d=identicon",
            "web_url": "https://gitlab.com/Yepadee"
          },
          "created_at": "2021-09-21T14:46:31.100Z",
          "updated_at": "2021-09-21T14:48:21.501Z",
          "system": false,
          "noteable_id": 91746974,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 2354,
          "commands_changes": {}
        }
      ]
    }
