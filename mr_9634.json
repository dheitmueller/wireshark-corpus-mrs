  "changes_data": [
    {
      "diff": "@@ -29,6 +29,7 @@ dseditgroup -q -o edit -a \"$USER\" -t user \"$BPF_GROUP\"\n chmod u=rw,g=r,o=r \"$CHMOD_BPF_PLIST\"\n chown root:wheel \"$CHMOD_BPF_PLIST\"\n \n+# Clean up our legacy startup item if it's still around.\n rm -rf /Library/StartupItems/ChmodBPF\n \n-launchctl load \"$CHMOD_BPF_PLIST\"\n+launchctl bootstrap system \"$CHMOD_BPF_PLIST\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/macosx/ChmodBPF/install-scripts/postinstall",
      "old_path": "packaging/macosx/ChmodBPF/install-scripts/postinstall",
      "a_mode": "100755",
      "b_mode": "100755",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -10,7 +10,7 @@\n CHMOD_BPF_PLIST=\"/Library/LaunchDaemons/org.wireshark.ChmodBPF.plist\"\n BPF_GROUP=\"access_bpf\"\n \n-launchctl unload -F \"$CHMOD_BPF_PLIST\"\n+launchctl bootout system \"$CHMOD_BPF_PLIST\"\n \n dscl . -read /Groups/\"$BPF_GROUP\" > /dev/null 2>&1 && \\\n     dseditgroup -q -o delete \"$BPF_GROUP\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/macosx/ChmodBPF/uninstall-scripts/postinstall",
      "old_path": "packaging/macosx/ChmodBPF/uninstall-scripts/postinstall",
