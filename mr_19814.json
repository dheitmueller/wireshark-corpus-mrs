  "changes_data": [
    {
      "diff": "@@ -24,7 +24,7 @@ set(manifest_file ${ARTIFACTS_DIR}/manifest.txt)\n \n if(APPLE)\n   set(download_prefix \"https://dev-libs.wireshark.org/macos/packages\")\n-  set(OSX_APP_LIBPREFIX_ARGS \"--libraries\" ${ARTIFACTS_DIR})\n+  set(OSX_APP_LIBPREFIX ${ARTIFACTS_DIR})\n else()\n   message(FATAL_ERROR \"No artifacts for this system\")\n endif()\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "cmake/modules/FetchArtifacts.cmake",
      "old_path": "cmake/modules/FetchArtifacts.cmake",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -47,7 +47,7 @@ bundle=\"Wireshark.app\"\n # various support libraries use as their standard installation location,\n # which is /usr/local)\n if [ -z \"$LIBPREFIX\" ]; then\n-\tLIBPREFIX=\"/usr/local\"\n+\tLIBPREFIX=\"@OSX_APP_LIBPREFIX@\"\n fi\n \n \n@@ -181,7 +181,7 @@ cp -v +([^.]).+([[:digit:]]).dylib \"$pkglib\"\n \n # Fetch a unique list of LC_RPATHs from our executables, which will be used\n # for our dependency search below.\n-bundle_binary_rpaths=(\"/usr/local/lib\")\n+bundle_binary_rpaths=(\"$LIBPREFIX/lib\")\n rpaths=()\n \n # macdeployqt handles our Qt dependencies. We handle our Sparkle and\n@@ -254,8 +254,8 @@ while $endl; do\n \t\t| grep -F compatibility \\\n \t\t| grep -v @rpath \\\n \t\t| cut -d\\( -f1 \\\n-\t\t| sed '1,$s;^\tlibbrotli;\t/usr/local/lib/libbrotli;' \\\n-\t\t| sed '1,$s;^\t@loader_path/libbrotli;\t/usr/local/lib/libbrotli;' \\\n+\t\t| sed \"1,\\$s;^\tlibbrotli;\t$LIBPREFIX/lib/libbrotli;\" \\\n+\t\t| sed \"1,\\$s;^\t@loader_path/libbrotli;\t$LIBPREFIX/lib/libbrotli;\" \\\n \t\t| grep -E -v \"$install_exclude_prefixes\" \\\n \t\t| sort \\\n \t\t| uniq \\\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/macosx/osx-app.sh.in",
      "old_path": "packaging/macosx/osx-app.sh.in",
      "a_mode": "100755",
      "b_mode": "100755",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -280,6 +280,8 @@ endif(WIN32)\n \n if(WIRESHARK_BASE_DIR AND APPLE)\n \tinclude(FetchArtifacts)\n+else()\n+\tset(OSX_APP_LIBPREFIX \"/usr/local\")\n endif()\n \n include(UseCustomIncludes)\n@@ -3774,8 +3776,7 @@ if(ENABLE_APPLICATION_BUNDLE AND BUILD_wireshark)\n \tset_target_properties(wireshark_app_bundle PROPERTIES FOLDER \"Copy Tasks\")\n \tadd_custom_command(TARGET wireshark_app_bundle\n \t\tPOST_BUILD\n-\t\t# OSX_APP_LIBPREFIX_ARGS is set in FetchArtifacts.cmake if WIRESHARK_BASE_DIR is set\n-\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\" ${OSX_APP_LIBPREFIX_ARGS}\n+\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\"\n \t\tWORKING_DIRECTORY \"${CMAKE_BINARY_DIR}/run\"\n \t)\n \tadd_dependencies(wireshark_app_bundle ${PROGLIST} chmodbpf path_helper)\n@@ -3815,8 +3816,7 @@ if(ENABLE_APPLICATION_BUNDLE AND BUILD_stratoshark)\n \tset_target_properties(stratoshark_app_bundle PROPERTIES FOLDER \"Copy Tasks\")\n \tadd_custom_command(TARGET stratoshark_app_bundle\n \t\tPOST_BUILD\n-\t\t# OSX_APP_LIBPREFIX_ARGS is set in FetchArtifacts.cmake if WIRESHARK_BASE_DIR is set\n-\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\" --bundle Stratoshark.app  ${OSX_APP_LIBPREFIX_ARGS}\n+\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\" --bundle Stratoshark.app\n \t\tWORKING_DIRECTORY \"${CMAKE_BINARY_DIR}/run\"\n \t)\n \n",
