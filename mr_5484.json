      "diff": "@@ -2778,6 +2778,7 @@ if(BUILD_text2pcap)\n \t\twiretap\n \t\twsutil\n \t\tui\n+\t\tepan\n \t\tversion_info\n \t\t${M_LIBRARIES}\n \t\t${ZLIB_LIBRARIES}\n@@ -2786,9 +2787,6 @@ if(BUILD_text2pcap)\n \t\t$<TARGET_OBJECTS:cli_main>\n \t\ttext2pcap.c\n \t)\n-\tadd_lex_files(text2pcap_LEX_FILES text2pcap_FILES\n-\t\ttext2pcap-scanner.l\n-\t)\n \tset_executable_resources(text2pcap \"Text2pcap\"\n \t\tCOPYRIGHT_INFO \"2001 Ashok Narayanan <ashokn@cisco.com>\")\n \tadd_executable(text2pcap ${text2pcap_FILES})\n",
      "collapsed": false,
