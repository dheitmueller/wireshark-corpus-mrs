        },
        {
          "id": 1901576298,
          "type": "DiscussionNote",
          "body": "@johnthacker You have probably used most time analysing this issues, what do you think about a revert?",
          "author": {
            "id": 4753670,
            "username": "stigbjorlykke",
            "public_email": "",
            "name": "Stig Bjørlykke",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/905aafc6b50e246885f5ea9273a9dc4f22e2658b71f9a1b551b797082bec3f80?s=80&d=identicon",
            "web_url": "https://gitlab.com/stigbjorlykke"
          },
          "created_at": "2024-05-11T15:21:44.165Z",
          "updated_at": "2024-05-11T15:21:44.165Z",
          "system": false,
          "noteable_id": 301105583,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 15584,
          "commands_changes": {}
        },
        {
          "id": 1901586832,
          "type": "DiscussionNote",
          "body": "I think reverting makes sense, although I also think we should try to release 4.4.0 out a little earlier for the benefit of Mac Homebrew users and others.\n\nThe last few branches have been 13 months between release and that would put 4.4 at the end of the year and it would be nice to get it out a few months earlier than that.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-05-11T16:52:31.933Z",
          "updated_at": "2024-05-11T16:52:31.933Z",
          "system": false,
          "noteable_id": 301105583,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
