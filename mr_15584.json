        },
        {
          "id": 1901773626,
          "type": "DiscussionNote",
          "body": "!15607 reverts the pushinteger related changes. I don't think any of the other changes break 32-bit lua_Integer (especially common on Lua 5.1/5.2)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-05-12T13:03:24.893Z",
          "updated_at": "2024-05-12T13:03:24.893Z",
          "system": false,
          "noteable_id": 301105583,
          "noteable_type": "MergeRequest",
