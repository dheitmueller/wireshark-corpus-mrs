    },
    {
      "id": "169e1baf617aa108bf34d40c48dc1c97b686ed3e",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1901536742,
          "type": null,
          "body": "Or rather, an offset is not a float, but on 32-bit systems we can't make it a `Lua_Integer` either because an offset can be larger than 32-bit. In some cases we can make it our Int64 user type.\n\nOn Lua 5.3 and larger we probably have 64 bit signed integers by default even on 32 bit systems, though it's possible to compile Lua with 32 bit Integers.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-05-11T11:16:48.883Z",
          "updated_at": "2024-05-11T11:16:48.883Z",
