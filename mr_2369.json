      "notes": [
        {
          "id": 528765954,
          "type": "DiscussionNote",
          "body": "So the intent here is to allow an \"export PDU\" tap to, for example, write out selected Ethernet packets, using the particular file format's indication for \"the packets in this file are Ethernet packets\", or some other packet types for which we have a regular encapsulation rather than the \"this is an upper-layer PDU for the protocol whose dissector is registered under the name XXX\" encapsulation that's the \"upper PDU\" encapsulation?  (The \"upper PDU\" encapsulation is supported only by pcap and pcapng.)",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-03-13T22:56:17.907Z",
          "updated_at": "2021-03-13T23:34:03.277Z",
          "system": false,
          "noteable_id": 91933528,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
