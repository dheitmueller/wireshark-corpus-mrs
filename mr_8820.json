  "commits_data": [
    {
      "id": "bf158b3e4105a6e159ed570211d2f826e951083d",
      "short_id": "bf158b3e",
      "created_at": "2022-12-14T12:00:47.000+00:00",
      "parent_ids": [
        "d90d525dd70c9234c08cc01e86151448d9890041"
      ],
      "title": "tpkt: don't have the heuristic enforce TPKT dissecting",
      "message": "tpkt: don't have the heuristic enforce TPKT dissecting\n\nMost RDP connections starts with TPKT and then switch to TLS, so enforcing TPKT\nfor the whole conversation makes the decoding fail.\n",
      "author_name": "David Fort",
      "author_email": "contact@hardening-consulting.com",
      "authored_date": "2022-11-09T15:26:37.000+01:00",
      "committer_name": "Alexis La Goutte",
      "committer_email": "alexis.lagoutte@gmail.com",
      "committed_date": "2022-12-14T12:00:47.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/bf158b3e4105a6e159ed570211d2f826e951083d"
    },
    {
      "id": "d90d525dd70c9234c08cc01e86151448d9890041",
      "short_id": "d90d525d",
      "created_at": "2022-12-14T12:00:47.000+00:00",
      "parent_ids": [
        "d560ae612a260c2e741994c911989d7025276780"
      ],
      "title": "tls: do not enforce the TLS dissector for the whole connection",
      "message": "tls: do not enforce the TLS dissector for the whole connection\n\nIn the case of RDP traffic, the conversation usually starts with 3 TPKT packets\nand then switch to TLS. The SSL dissector was setting the conversation dissector\nwithout specifying any start packet which were leading to have the 3 first packets\ninterpreted as invalid SSL records (which they are as it's TPKT packets). This patch\nfixes by specifying the first true SSL packet.\n",
      "author_name": "David Fort",
      "author_email": "contact@hardening-consulting.com",
      "authored_date": "2022-11-09T14:50:05.000+01:00",
      "committer_name": "Alexis La Goutte",
      "committer_email": "alexis.lagoutte@gmail.com",
      "committed_date": "2022-12-14T12:00:47.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/d90d525dd70c9234c08cc01e86151448d9890041"
    },
    {
      "id": "d560ae612a260c2e741994c911989d7025276780",
      "short_id": "d560ae61",
      "created_at": "2022-12-14T12:00:47.000+00:00",
      "parent_ids": [
        "8513da747de0b5a39d23901444ef39fff5fa9280"
      ],
      "title": "rdpudp: support desegmentation",
      "message": "rdpudp: support desegmentation\n\nThe RDPUDP protocol transports TLS or DTLS records, but as the payload of RDPUDP is small,\nmost of the time records are splitted over multiple RDPUDP packets. This patch adds\nsupport for desegmentation in RDPUDP so that we interpret the results of the SSL\ndissector and we can give back untreated content when dissecting the next packet.\n",
      "author_name": "David Fort",
      "author_email": "contact@hardening-consulting.com",
      "authored_date": "2022-11-09T08:21:46.000+01:00",
      "committer_name": "Alexis La Goutte",
      "committer_email": "alexis.lagoutte@gmail.com",
      "committed_date": "2022-12-14T12:00:47.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/d560ae612a260c2e741994c911989d7025276780"
    }
  ],
