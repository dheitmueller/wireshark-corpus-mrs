        {
          "id": 1169883633,
          "type": "DiffNote",
          "body": "Without this change the whole conversation is decoded as SSL, while the 3 first packets are just TPKT on top of TCP (so on second pass wireshark will try to decode them as SSL). Specifying the start of the TLS traffic fixes it.",
          "author": {
            "id": 5717614,
            "username": "hardening1",
            "public_email": "",
            "name": "David Fort",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/5717614/avatar.png?v=1773998323",
            "web_url": "https://gitlab.com/hardening1"
          },
          "created_at": "2022-11-12T20:31:08.342Z",
          "updated_at": "2022-11-12T20:31:08.342Z",
          "system": false,
          "noteable_id": 187808852,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "commit_id": null,
          "position": {
