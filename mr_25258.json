  "changes_data": [
    {
      "diff": "@@ -44,7 +44,6 @@ BASIC_LIST=\"mingw64-gcc \\\n \tmingw64-qt6-qt5compat \\\n \tmingw64-qt6-qtmultimedia \\\n \tmingw64-qt6-qttools \\\n-\tmingw64-speexdsp \\\n \tmingw32-nsis \\\n \tmingw64-nsis \\\n \tmingw64-gnutls \\\n@@ -65,6 +64,21 @@ BASIC_LIST=\"mingw64-gcc \\\n \tcmake\n \tcmake-rpm-macros\"\n \n+# Adds package $2 to list variable $1 if the package is found\n+add_package() {\n+\tlocal list=\"$1\" pkgname=\"$2\"\n+\n+\t# fail if the package is not known\n+\t# shellcheck disable=SC2086\n+\tdnf info \"$pkgname\" &> /dev/null || return 1\n+\n+\t# package is found, append it to list\n+\teval \"${list}=\\\"\\${${list}} \\${pkgname}\\\"\"\n+}\n+\n+add_package BASIC_LIST mingw64-speexdsp ||\n+echo \"Basic package mingw64-speexdsp is unavailable\" >&2\n+\n ACTUAL_LIST=$BASIC_LIST\n \n dnf install $ACTUAL_LIST $OPTIONS\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "tools/mingw-rpm-setup.sh",
      "old_path": "tools/mingw-rpm-setup.sh",
      "a_mode": "100755",
      "b_mode": "100755",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -1358,6 +1358,16 @@ ws_find_package(LIBSSH ENABLE_LIBSSH HAVE_LIBSSH \"0.8.5\")\n ws_find_package(PCAP ENABLE_PCAP HAVE_LIBPCAP)\n ws_find_package(Systemd BUILD_sdjournal HAVE_SYSTEMD)\n \n+# The SpeexDSP resampler is required iff building sharkd, or building\n+# Wireshark or Stratoshark with Qt Multimedia\n+if(BUILD_sharkd)\n+\treset_find_package(SPEEXDSP)\n+\tfind_package(SpeexDSP REQUIRED)\n+elseif(BUILD_wireshark OR BUILD_stratoshark)\n+\treset_find_package(SPEEXDSP)\n+\tfind_package(SpeexDSP)\n+endif()\n+\n # Build one of the Qt GUIs?\n if(BUILD_wireshark OR BUILD_stratoshark)\n \t# We don't use any QVulkan* classes, so tell Qt's CMake modules not to look for Vulkan.\n@@ -1389,10 +1399,13 @@ if(BUILD_wireshark OR BUILD_stratoshark)\n \t\t\t\tCore5Compat\n \t\t\tOPTIONAL_COMPONENTS\n \t\t\t\tDBus\n-\t\t\t\tMultimedia\n \t\t\t\tSvg\n \t\t)\n \n+\t\tif (SPEEXDSP_FOUND)\n+\t\t\tfind_package(Qt6 ${Qt6_VERSION} REQUIRED OPTIONAL_COMPONENTS Multimedia)\n+\t\tendif()\n+\n \t\tif (WIN32 AND Qt6Widgets_VERSION VERSION_LESS 6.5.3)\n \t\t\tmessage(WARNING \"Qt 6.5.3 or later is required.\")\n \t\tendif()\n@@ -1581,11 +1594,6 @@ find_package( XSLTPROC )\n \n find_package(DOXYGEN)\n \n-# The SpeexDSP resampler is required iff building wireshark or sharkd.\n-if(BUILD_wireshark OR BUILD_stratoshark OR BUILD_sharkd)\n-\tfind_package(SpeexDSP REQUIRED)\n-endif()\n-\n # Generate the distribution tarball.\n add_custom_target(dist\n \tCOMMAND ${CMAKE_BINARY_DIR}/packaging/source/git-export-release.sh -d \"${CMAKE_BINARY_DIR}\"\n",
