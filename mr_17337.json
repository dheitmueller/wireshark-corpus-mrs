      "diff": "@@ -4264,6 +4264,23 @@ SR-NPRACH-Resource-NB-r15/p0-SR-r15 DISPLAY=BASE_DEC|BASE_UNIT_STRING STRINGS=UN\n     mapping->ul_priority_present = true;\n   }\n \n+#.FN_BODY MCC-MNC-Digit VAL_PTR=&value\n+  uint32_t value;\n+%(DEFAULT_BODY)s\n+  if (actx->value_ptr && value <= 9) {\n+    wmem_strbuf_t *plmn_str = (wmem_strbuf_t *)actx->value_ptr;\n+    wmem_strbuf_append_c(plmn_str, '0' + value);\n+  }\n+\n+#.FN_BODY PLMN-Identity\n+  wmem_strbuf_t *plmn_str = wmem_strbuf_new(actx->pinfo->pool, \"\");\n+  actx->value_ptr = plmn_str;\n+%(DEFAULT_BODY)s\n+  if (wmem_strbuf_get_len(plmn_str) > 0) {\n+    proto_item_append_text(actx->created_item, \": %%s\", wmem_strbuf_get_str(plmn_str));\n+  }\n+  actx->value_ptr = NULL;\n+\n #.TYPE_ATTR\n UplinkPowerControlCommon-NB-r13/p0-NominalNPUSCH-r13 DISPLAY=BASE_DEC|BASE_UNIT_STRING STRINGS=UNS(&units_dbm)\n \n",
