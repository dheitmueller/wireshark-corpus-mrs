      "diff": "@@ -1985,9 +1985,9 @@ tvb_get_string_time(tvbuff_t *tvb, const gint offset, const gint length,\n \tif (errno == 0) {\n \t\tns->secs = mktime_utc (&tm);\n \t\tif (off_hr > 0)\n-\t\t\tns->secs += (off_hr * 3600) + (off_min * 60);\n+\t\t\tns->secs -= (off_hr * 3600) + (off_min * 60);\n \t\telse if (off_hr < 0)\n-\t\t\tns->secs -= ((-off_hr) * 3600) + (off_min * 60);\n+\t\t\tns->secs += ((-off_hr) * 3600) + (off_min * 60);\n \t\tretval = ns;\n \t\tif (endoff)\n \t\t    *endoff = (gint)(offset + (end - begin));\n",
