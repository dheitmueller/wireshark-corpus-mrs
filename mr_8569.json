    {
      "id": "61d8cfd4c30a0dc5331627b9a134d6ae31285b22",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1141359875,
          "type": null,
          "body": "You're right, it would be redundant with the UTF-8 checking and slow it down. (UTF-8 does the replacement algorithm specified in https://www.unicode.org/versions/Unicode13.0.0/ch03.pdf and https://encoding.spec.whatwg.org/#utf-8 - which adds extra replacement characters compared to the \"convert 5 and 6 byte sequences to code points and replace with a single replacement character\" strategy.)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
