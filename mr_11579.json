  "changes_data": [
    {
      "diff": "@@ -918,11 +918,8 @@ Code Lines and Data:\n       #\n       # https://www.wireshark.org/download/automated/data/manuf\n       #\n-      # This file is in the same format as ethers(5) except that vendor names\n-      # are truncated to eight characters for compatibility with Wireshark, and\n-      # that well-known MAC addresses need not have a full 6 octets and may\n-      # have a netmask following them specifying how many bits of the address\n-      # are relevant (the other bits are wildcards).\n+      # The first column contains the MAC Address block (24, 28 or 36 bits wide,\n+      # per IEEE allocation sizes) and the second column contains the vendor name.\n       #\n       FIN\n     - build/run/tshark -G manuf | sed -e 's,:00:00:00/24,,' >> manuf\n",
      "collapsed": false,
      "too_large": false,
