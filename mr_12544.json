  "changes_data": [
    {
      "diff": "@@ -88,8 +88,12 @@ Too many protocol updates have been made to list them all here.\n \n //_Non-empty section placeholder._\n \n-//=== Major API Changes\n+=== Major API Changes\n \n+* The API for loading binary plugins has changed and all plugins are now required\n+  to include a new public symbol named \"plugin_type\". The possible values are\n+  defined in `wireshark.h` and correspond to the three major supported plugin\n+  types (epan/wiretap/codec).\n \n == Getting Wireshark\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/release-notes.adoc",
      "old_path": "doc/release-notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -53,9 +53,9 @@\n #include <wsutil/glib-compat.h>\n #include <wsutil/wmem/wmem.h>\n \n-#define WIRESHARK_EPAN_PLUGIN       \"epan_plugin\"\n-#define WIRESHARK_WIRETAP_PLUGIN    \"wtap_plugin\"\n-#define WIRESHARK_CODEC_PLUGIN      \"codec_plugin\"\n+#define WIRESHARK_EPAN_PLUGIN       \"epan\"\n+#define WIRESHARK_WIRETAP_PLUGIN    \"wiretap\"\n+#define WIRESHARK_CODEC_PLUGIN      \"codec\"\n \n #endif /* __WIRESHARK_H__ */\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "include/wireshark.h",
      "old_path": "include/wireshark.h",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -174,31 +174,31 @@ scan_plugins_dir(GHashTable *plugins_module, const char *plugin_folder, plugin_t\n             continue;\n         }\n \n-        if (!g_module_symbol(handle, \"plugin_version\", &symbol)) {\n-            report_failure(\"The plugin '%s' has no \\\"plugin_version\\\" symbol\", name);\n+        if (!g_module_symbol(handle, \"plugin_type\", &symbol)) {\n+            report_failure(\"The plugin '%s' has no \\\"plugin_type\\\" symbol\", name);\n             g_module_close(handle);\n             g_free(plugin_file);\n             continue;\n         }\n-        plug_version = (const char *)symbol;\n-\n-        if (!pass_plugin_version_compatibility(handle, name)) {\n-            /* pass_plugin_version_compatibility() reports failures */\n+        type_signature = (const char *)symbol;\n+        if (strcmp(type_signature, type_to_signature(type)) != 0) {\n+            /* Skip wrong type */\n+            ws_noisy(\"%s: skip type %s\", name, type_signature);\n             g_module_close(handle);\n             g_free(plugin_file);\n             continue;\n         }\n \n-        if (!g_module_symbol(handle, \"plugin_type\", &symbol)) {\n-            report_failure(\"The plugin '%s' has no \\\"plugin_type\\\" symbol\", name);\n+        if (!g_module_symbol(handle, \"plugin_version\", &symbol)) {\n+            report_failure(\"The plugin '%s' has no \\\"plugin_version\\\" symbol\", name);\n             g_module_close(handle);\n             g_free(plugin_file);\n             continue;\n         }\n-        type_signature = (const char *)symbol;\n-        if (strcmp(type_signature, type_to_signature(type)) != 0) {\n-            /* Skip wrong type */\n-            ws_noisy(\"%s: skip type %s\", name, type_signature);\n+        plug_version = (const char *)symbol;\n+\n+        if (!pass_plugin_version_compatibility(handle, name)) {\n+            /* pass_plugin_version_compatibility() reports failures */\n             g_module_close(handle);\n             g_free(plugin_file);\n             continue;\n",
