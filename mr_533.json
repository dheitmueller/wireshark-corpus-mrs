    {
      "id": "9f69104ec52281b6cd89985115c8d0a6657a7f45",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 426897259,
          "type": null,
          "body": "RFC 2578 states:\n\n>The OCTET STRING type represents arbitrary binary or textual data. Although the SMI-specified size limitation for this type is 65535 octets, MIB designers should realize that there may be implementation and interoperability limitations for sizes in excess of 255 octets.\n\nI've had a look at what BASE_SHOW_ASCII_PRINTABLE does, and it will display as a string if all octets are printable, else it will revert to hex.\n\nThe effect of this change will help folks that do have printable values that should be represented as such, but hinder those who happen to have hex values that all lie in the printable range.\n\nI have no info on which is more likely for SNMP OCTET STRING values.",
          "author": {
            "id": 6621762,
            "username": "graham.bloice",
            "public_email": "",
            "name": "Graham Bloice",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/8730bfac2267cb97ff1f8187d285f244745a03a783055c8fd6fcd679bfa71c6e?s=80&d=identicon",
            "web_url": "https://gitlab.com/graham.bloice"
          },
          "created_at": "2020-10-09T08:39:54.996Z",
          "updated_at": "2020-10-09T08:39:54.996Z",
