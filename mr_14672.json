  "changes_data": [
    {
      "diff": "@@ -1638,9 +1638,9 @@ static icmp_transaction_t *transaction_end(packet_info *pinfo, proto_tree *tree,\n \n } /* transaction_end() */\n \n-static int\n+// This is recursive, but we'll run out of PDU before we'll run out of stack.\n // NOLINTNEXTLINE(misc-no-recursion)\n-dissect_icmpv6_nd_opt(tvbuff_t *tvb, int offset, packet_info *pinfo, proto_tree *tree)\n+static int dissect_icmpv6_nd_opt(tvbuff_t *tvb, int offset, packet_info *pinfo, proto_tree *tree)\n {\n     proto_tree *icmp6opt_tree;\n     proto_item *ti, *ti_opt, *ti_opt_len;\n@@ -1650,8 +1650,6 @@ dissect_icmpv6_nd_opt(tvbuff_t *tvb, int offset, packet_info *pinfo, proto_tree\n     tvbuff_t   *opt_tvb;\n     guint       used_bytes;\n \n-    increment_dissection_depth(pinfo);\n-\n     while ((int)tvb_reported_length(tvb) > offset) {\n         /* there are more options */\n \n@@ -2602,7 +2600,6 @@ dissect_icmpv6_nd_opt(tvbuff_t *tvb, int offset, packet_info *pinfo, proto_tree\n         /* Close the ) to option root label */\n         proto_item_append_text(ti, \")\");\n     }\n-    decrement_dissection_depth(pinfo);\n     return offset;\n }\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-icmpv6.c",
      "old_path": "epan/dissectors/packet-icmpv6.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -348,10 +348,9 @@ dissect_netlink_attributes_common(tvbuff_t *tvb, header_field_info *hfi_type, in\n \t\t\toffset += 2;\n \t\t\tproto_item_append_text(ti, \" %u\", rta_type);\n \n-\t\t\t// We should use increment_dissection_depth here, but that requires\n-\t\t\t// adding pinfo all over packet-netlink*.[ch]. Instead, use our offset\n-\t\t\t// to roughly gauge our recursion level.\n-\t\t\tDISSECTOR_ASSERT((unsigned)offset < prefs.gui_max_tree_depth * 10);\n+\t\t\t// In theory we should use increment_dissection_depth here, but that\n+\t\t\t// requires adding pinfo all over packet-netlink*.[ch] and we're limited\n+\t\t\t// to 262144 bytes (WTAP_MAX_PACKET_SIZE_STANDARD).\n \t\t\tdissect_netlink_attributes(tvb, hfi_type, ett_attrib, data, nl_data, attr_tree, offset, rta_len - 4, cb);\n \t\t}\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-netlink.c",
      "old_path": "epan/dissectors/packet-netlink.c",
