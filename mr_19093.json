      "notes": [
        {
          "id": 2358568681,
          "type": null,
          "body": "If you want to keep `-fno-delete-null-pointer-checks`, I won't argue over it, but I don't agree that it's needed. We were fortunate that this showed up with a test failure and exposed a real problem. With the flag, it just becomes latent and could show up elsewhere that isn't affected by the flag anyway.",
          "author": {
            "id": 4694399,
            "username": "thesamesam",
            "public_email": "",
            "name": "Sam James",
            "state": "active",
            "locked": false,
