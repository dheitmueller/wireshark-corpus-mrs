  "commits_data": [
    {
      "id": "d97945614088cb6aa624c7bc859b4f303a62ecb8",
      "short_id": "d9794561",
      "created_at": "2025-03-06T07:03:17.000+01:00",
      "parent_ids": [
        "aa17dcab76866f392de6f3bb6425b0434b23d349"
      ],
      "title": "Drop invalid malloc attribute from wmem_tree_new*",
      "message": "Drop invalid malloc attribute from wmem_tree_new*\n\nWireshark would fail its wmem_test test when built with GCC LTO in some\ncases with a null pointer dereference with a check that got optimised out.\n\nThis turns out to be because wmem_tree_new and wmem_tree_new_autoreset\nare (incorrectly) marked with the malloc attribute, which promises to GCC\nthat any memory returned by the functions is completely clean and holds\nno references to existing objects.\n\nSimilar to 365a8212989ef0ef506969631617175a2464302f.\n\nSee also:\n* https://bugs.debian.org/1015706\n* https://bugs.gentoo.org/941890\n* https://gcc.gnu.org/PR117315\n\nCloses #18216\n",
      "author_name": "Sam James",
      "author_email": "sam@gentoo.org",
      "authored_date": "2025-02-20T14:02:51.000+00:00",
      "committer_name": "AndersBroman",
      "committer_email": "a.broman58@gmail.com",
      "committed_date": "2025-03-06T07:03:17.000+01:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/d97945614088cb6aa624c7bc859b4f303a62ecb8"
    }
  ],
