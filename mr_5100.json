  "changes_data": [
    {
      "diff": "@@ -32,7 +32,7 @@ See the “New and Updated Features” section below for more details.\n \n The following features are new (or have been significantly updated) since version 3.6.0rc3:\n \n-* Nothing of note.\n+* The macOS Intel packages now ship with Qt 5.15.3 and require macOS 10.13 or later.\n \n The following features are new (or have been significantly updated) since version 3.6.0rc2:\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "docbook/release-notes.adoc",
      "old_path": "docbook/release-notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -438,13 +438,13 @@ macOS Intel Package:\n     - wireshark-macos-intel-package\n   retry: 1\n   script:\n-    - export CMAKE_PREFIX_PATH=\"$HOME/Qt5.12.6/5.12.6/clang_64/lib/cmake\"\n+    - export CMAKE_PREFIX_PATH=/usr/local/Qt-5.15.3/lib/cmake\n     - export PATH=\"$PATH:$HOME/bin\"\n     - perl tools/make-version.pl --set-release\n     - mkdir build\n     - cd build\n     - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n-    - cmake -DENABLE_CCACHE=ON -DCMAKE_OSX_DEPLOYMENT_TARGET=10.12 -DCMAKE_OSX_SYSROOT=macosx10.15 -DTEST_EXTRA_ARGS=--enable-release -G Ninja ..\n+    - cmake -DENABLE_CCACHE=ON -DCMAKE_OSX_DEPLOYMENT_TARGET=10.13 -DCMAKE_OSX_SYSROOT=macosx10.15 -DTEST_EXTRA_ARGS=--enable-release -G Ninja ..\n     - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n     - ninja\n     - package-prep\n",
      "collapsed": false,
      "too_large": false,
      "new_path": ".gitlab-ci.yml",
      "old_path": ".gitlab-ci.yml",
      "a_mode": "100644",
