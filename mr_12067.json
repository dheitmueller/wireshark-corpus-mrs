.bundle\",\n+         FT_STRING, BASE_NONE,\n+         NULL, 0x0,\n+         \"Bundle of BFWs\",\n+         HFILL}\n+        },\n+        {&hf_oran_bfw_bundle_id,\n+         {\"Bundle Id\", \"oran_fh_cus.bfw.bundleId\",\n+         FT_UINT32, BASE_DEC,\n+         NULL, 0x0,\n+         NULL,\n+         HFILL}\n+        },\n         {&hf_oran_bfw_i,\n          {\"bfwI\", \"oran_fh_cus.bfwI\",\n          FT_FLOAT, BASE_NONE,\n@@ -4200,6 +4223,7 @@ proto_register_oran(void)\n         &ett_oran_section,\n         &ett_oran_iq,\n         &ett_oran_c_section_extension,\n+        &ett_oran_bfw_bundle,\n         &ett_oran_bfw,\n         &ett_oran_offset_start_prb_num_prb,\n         &ett_oran_prb_cisamples,\n",
