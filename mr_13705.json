          "imported_from": "none",
          "noteable_iid": 13705,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "7997d1a65d5b6698bddc5d78f1d6c35ed476af61",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1696631814,
          "type": null,
          "body": "I really don't care. I'm not a Debian developer and I shouldn't need to be to work on Wireshark. Codecs are in the wrong place. Fix this nonsense packaging setup to use a single package that abides by \"make install\" and this problem won't happen.\n\nFeel free to revert the codecs change.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2023-12-15T15:34:00.604Z",
          "updated_at": "2023-12-15T15:34:00.604Z",
