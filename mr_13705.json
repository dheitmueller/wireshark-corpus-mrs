    {
      "id": "6aceabde7bf84aed8bf7ded6391a6c9a51dd6df4",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1696610258,
          "type": null,
          "body": "Moving files across packages requires further changes in packaging to\nmake upgrades safe declaring proper versioned Breaks+Replaces in the\ncontrol files. If the proper package relationships are not declared,\napt + dpkg would bail letting the possibly inexperienced user to fix\nthe file overlaps.",
          "author": {
            "id": 7384671,
            "username": "rbalint",
            "public_email": "",
            "name": "Balint Reczey",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/3dff6a01e100a1b24a9d11cb0328f45b04c323c72058516e1e855106a993206b?s=80&d=identicon",
            "web_url": "https://gitlab.com/rbalint"
          },
          "created_at": "2023-12-15T15:19:22.858Z",
          "updated_at": "2023-12-15T15:19:22.858Z",
          "system": false,
          "noteable_id": 270412450,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
