  "changes_data": [
    {
      "diff": "@@ -101,6 +101,7 @@ static int ett_tpncp;\n static int ett_tpncp_body;\n \n static bool global_tpncp_load_db;\n+static const char* global_tpncp_dat_file_name;\n \n static dissector_handle_t tpncp_handle;\n static dissector_handle_t tpncp_tcp_handle;\n@@ -923,28 +924,21 @@ init_tpncp_data_fields_info(tpncp_data_field_info ***data_fields_info, unsigned\n \n /*---------------------------------------------------------------------------*/\n \n-static FILE *\n-open_tpncp_dat(const char *base_dir, const char *subdir)\n-{\n-    char tpncp_dat_file_path[MAX_TPNCP_DB_ENTRY_LEN];\n-    snprintf(tpncp_dat_file_path, MAX_TPNCP_DB_ENTRY_LEN,\n-             \"%s\" G_DIR_SEPARATOR_S \"%s\" G_DIR_SEPARATOR_S \"tpncp.dat\",\n-             base_dir, subdir);\n-    return ws_fopen(tpncp_dat_file_path, \"r\");\n-}\n-\n static int\n init_tpncp_db(void)\n {\n     FILE *file;\n-    const char *env_prefix = epan_get_environment_prefix();\n \n-    /* Open file with TPNCP data. */\n-    if ((file = open_tpncp_dat(get_plugins_pers_dir_with_version(env_prefix), \"epan\")) == NULL &&\n-        (file = open_tpncp_dat(get_plugins_dir_with_version(env_prefix), \"epan\")) == NULL &&\n-        (file = open_tpncp_dat(get_datafile_dir(env_prefix), \"tpncp\")) == NULL) {\n-        return (-1);\n+    /* Open file with TPNCP data, trying the preference first */\n+    if ((strlen(global_tpncp_dat_file_name) == 0) || ((file = ws_fopen(global_tpncp_dat_file_name, \"r\")) == NULL))\n+    {\n+        char* tpncp_dat_file_path = g_build_path(G_DIR_SEPARATOR_S, get_datafile_dir(epan_get_environment_prefix()), \"tpncp\", \"tpncp.dat\", NULL);\n+        file = ws_fopen(tpncp_dat_file_path, \"r\");\n+        g_free(tpncp_dat_file_path);\n+        if (file == NULL)\n+            return -1;\n     }\n+\n     fill_tpncp_id_vals(&tpncp_events_id_vals, file);\n     fill_tpncp_id_vals(&tpncp_commands_id_vals, file);\n     fill_enums_id_vals(&tpncp_enums_name_vals, &tpncp_enums_id_vals, file);\n@@ -1055,6 +1049,10 @@ proto_register_tpncp(void)\n                                    \" disables the protocol; Wireshark has to be restarted for the\"\n                                    \" setting to take effect.\",\n                                    &global_tpncp_load_db);\n+    prefs_register_filename_preference(tpncp_module, \"dat_file\", \"Database file\", \"Override location of the TCNCP Database file.  \"\n+                                                                \"If blank, database from datafile directory will be used\",\n+        &global_tpncp_dat_file_name, false);\n+\n }\n \n /*\n",
