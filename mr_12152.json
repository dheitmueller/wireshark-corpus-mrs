    {
      "id": "4748c09aaee9d8b218f53b81878d5013ef233fb0",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1565234323,
          "type": null,
          "body": "Thanks for jumping on this, but you have to use PRId64 for formatting for 64 bit integers or PRIu64 for unsigned, as we require C11 and C++11. Previously we used some glib equivalents, which are still in some code; those work too. Unfortunately different data models on different platforms cause problems using `%ld` or `%lld`.\n\nhttps://en.cppreference.com/w/c/types/integer",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2023-09-19T14:11:31.224Z",
