  "commits_data": [
    {
      "id": "eaff4d13034a20dc57c82b23337f3431d76bc4d6",
      "short_id": "eaff4d13",
      "created_at": "2025-04-12T14:23:56.000+00:00",
      "parent_ids": [
        "bc23314dd9ddae615170fc4685af9bd6ffdcf19f"
      ],
      "title": "snort: Prevent format truncation warning",
      "message": "snort: Prevent format truncation warning\n\nInstead of having the snort dissector do its own calculation for\nadding the fractional part of the absolute time stamp seconds,\ncall format_fractional_part_nsecs. That function handles format\ntruncation, and so prevents the gcc warning.\n\nThat function includes the decimal point, so adjust for that by\nincreasing the buffer size by 1 and changing where the buffer is\nadded.\n\nThis is currently the last format truncation warning.\nPing #20175\n",
      "author_name": "John Thacker",
      "author_email": "johnthacker@gmail.com",
      "authored_date": "2025-04-07T20:31:14.000-04:00",
      "committer_name": "John Thacker",
      "committer_email": "johnthacker@gmail.com",
      "committed_date": "2025-04-12T14:23:56.000+00:00",
