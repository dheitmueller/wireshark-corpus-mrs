    {
      "id": "aa0c85c8428425f28cca9f4899827dab2776c824",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 2212069420,
          "type": "DiffNote",
          "body": "This has the effect of disabling request-response matching when `g_gtp_session` (Track GTP Session) is disabled, which is the default. Track GTP session used to be more processor intensive, although I switched it from linked lists to a hash table so it's a little bit better.\n\nThe only place that the `gtp_info` conversation data is used is inside `gtp_match_response`, but maybe it just makes sense to retrieve the conversation data (and create it if it doesn't exist) instead that function rather than passing it around?",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
