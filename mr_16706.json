    {
      "id": "047894c574fec42643ba74ac2269fe9e61a32572",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2266430938,
          "type": null,
          "body": "> What's the reason for not letting people who are building with Windows or MacOS build with versions earlier than 6.5.3, though?\n\nThis just prints a warning, so it lets them do so after saying \"if this doesn't work, that's your problem\".\n\nDoing it in `find_package`, however, would presumably refuse to let them through (or would just say \"sorry, I didn't find Qt, have fun with TShark\").\n\nThere are some tests later in CMakeLists.txt where, if we're building for macOS, if Qt is >= 6.5.0 and the minimum macOS version is < 11.0 (Big Sur), it raises it to 11.0, and if it's >= 6.0.0 and the minimum macOS version is < 10.14 (Catalina), it raises it to 10.14.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-12-18T23:31:09.476Z",
          "updated_at": "2024-12-18T23:31:09.476Z",
          "system": false,
          "noteable_id": 318944233,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 16706,
          "commands_changes": {}
        }
      ]
    }
