        {
          "id": 2077807700,
          "type": "DiscussionNote",
          "body": "As the Developer's Guide says, we currently build the official Windows and macOS installers with Qt 6.5.3. The macOS MR build installs Qt using Homebrew, which currently installs 6.7.0. We could try to pin the version to 6.5.3 there, but that can often have unintended side effects.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789344738",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2024-08-27T17:07:50.395Z",
          "updated_at": "2024-08-29T20:51:01.435Z",
