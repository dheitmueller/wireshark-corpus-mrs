    {
      "id": "4136470ee0b317e14149972264f38bbea45b7007",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 535526413,
          "type": null,
          "body": "I'm not sure a preference is needed. If someone registers a dissector for a field name we should call it I think.",
          "author": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
            "web_url": "https://gitlab.com/AndersBroman"
          },
          "created_at": "2021-03-23T09:50:37.167Z",
          "updated_at": "2021-03-23T09:50:37.167Z",
          "system": false,
          "noteable_id": 92838464,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
