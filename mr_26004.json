    {
      "id": "48b508abb82028746e7396767f1e7cd689655f85",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 3626326801,
          "type": "DiffNote",
          "body": "At this point:\n\n* `rec_length_remaining` is the total length of remaining data in the record, *including* the first `bytes_to_read` bytes that we just read;\n* `bytes_to_read` is the number of bytes that we were supposed to read *and*, given that `wtap_read_bytes()` succeeded, the number of bytes that we *did* read;\n* `rec_length_remaining - bytes_to_read` is the length of the rest of the remaining data in the record, and that's guaranteed to be >= 0 (as `bytes_to_read` is guaranteed to be <= `rec_length_remaining`).\n\nHowever, `bytes_to_read` is *not* guaranteed to be equal to `sizeof buffer`.\n\nSo presumably this should check whether `bytes_to_read` is < `rec_length_remaining` and, if so, seek `rec_length_remaining - bytes_to_read` bytes forward.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2026-07-30T22:50:49.163Z",
          "updated_at": "2026-07-30T22:51:28.393Z",
          "system": false,
          "noteable_id": 513641276,
