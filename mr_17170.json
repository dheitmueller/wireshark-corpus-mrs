    {
      "id": "23cf65546f1ba7688ff601c9390f229c1bb9190e",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2094540046,
          "type": null,
          "body": "> Some files can have empty/corrupted date and time\n\nBecause that's how Vector Informatik's software writes them with a bad date/time, or because they were damaged by a third party?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-09-06T19:19:09.640Z",
          "updated_at": "2024-09-06T19:19:09.640Z",
          "system": false,
