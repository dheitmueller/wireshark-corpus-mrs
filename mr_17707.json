      "diff": "@@ -344,17 +344,17 @@ endpoint_to_interface(urb_info_t *urb)\n {\n     switch (urb->endpoint)\n     {\n-    case 0x01: /* A OUT */\n-    case 0x02: /* A IN */\n+    case 0x81: /* A IN */\n+    case 0x02: /* A OUT */\n         return FTDI_INTERFACE_A;\n-    case 0x03: /* B OUT */\n-    case 0x04: /* B IN */\n+    case 0x83: /* B IN */\n+    case 0x04: /* B OUT */\n         return FTDI_INTERFACE_B;\n-    case 0x05: /* C OUT */\n-    case 0x06: /* C IN */\n+    case 0x85: /* C IN */\n+    case 0x06: /* C OUT */\n         return FTDI_INTERFACE_C;\n-    case 0x07: /* D OUT */\n-    case 0x08: /* D IN */\n+    case 0x87: /* D IN */\n+    case 0x08: /* D OUT */\n         return FTDI_INTERFACE_D;\n     default:\n         return FTDI_INTERFACE_UNKNOWN;\n",
