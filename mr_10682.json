  "changes_data": [
    {
      "diff": "@@ -1794,6 +1794,14 @@ get_tcp_conversation_data(conversation_t *conv, packet_info *pinfo)\n       return NULL;\n     }\n \n+    if (tcp_reassemble_out_of_order) {\n+        if (tcpd->flow1.ooo_segments == NULL || tcpd->flow2.ooo_segments == NULL) {\n+            ws_critical(\"tcp.reassemble_out_of_order preference has changed since tcpd was created, but the old tcpd is still being used to dissect frame #%u!\", pinfo->num);\n+            tcpd->flow1.ooo_segments=wmem_list_new(wmem_file_scope());\n+            tcpd->flow2.ooo_segments=wmem_list_new(wmem_file_scope());\n+        }\n+    }\n+\n     /* check direction and get ua lists */\n     if(direction>=0) {\n         tcpd->fwd=&(tcpd->flow1);\n",
