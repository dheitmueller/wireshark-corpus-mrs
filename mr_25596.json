    {
      "diff": "@@ -3,14 +3,14 @@\n # Details (what/why), wrapped at 72 columns\n # - ...\n # - ...\n-#\n+\n # If this fixes an issue, you can automatically close it with the\n # \"Fixes\" or \"Closes\" keywords.\n # Fixes #10000\n-#\n-AI-Assisted: no|yes [tool(s)]\n-# Required: declare whether AI was used (e.g., \"AI-Assisted: yes (Claude)\").\n-#\n+\n+# If you used AI, say which tool(s) you used, e.g. \"Assisted-by: Claude\".\n+# Assisted-by: [tool(s)]\n+\n # Examples:\n #   CMake: Allow users to override _FORTIFY_SOURCE\n #   tools/check_spelling.py: Speed up using ProcessPoolExecutor\n",
      "collapsed": false,
