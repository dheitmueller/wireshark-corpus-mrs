  "changes_data": [
    {
      "diff": "@@ -936,18 +936,13 @@ For example, “closes #5” will close issue number 5.\n Other https://docs.gitlab.com/user/markdown/#gitlab-specific-references[GitLab-specific references] are `!` for a merge request and the short (8 character) hash for a commit.\n \n We also ask contributors to disclose whether AI tools were used when authoring the change.\n-Add a trailer such as\n+If you use an AI tool, add a trailer such as\n [source,sh]\n ----\n-AI-Assisted: yes (Claude)\n+Assisted-by: Claude\n ----\n-or\n-[source,sh]\n-----\n-AI-Assisted: no\n-----\n-to commit messages and mention the same in merge requests.\n-This notice is adapted with thanks from the Seerr project’s AI usage statement (https://github.com/seerr-team/seerr/blob/develop/CONTRIBUTING.md).\n+to your commit message(s) and mention the same in merge requests.\n+The trailer should be omitted if no AI tools were used.\n \n Putting all that together, we get the following example:\n \n@@ -958,7 +953,7 @@ MIPv6: Fix dissection of Service Selection Identifier\n APN field is not encoded as a dotted string so the first character is not a\n length. Closes #10323.\n \n-AI-Assisted: no\n+Assisted-by: Claude\n ----\n \n [#ChSrcCodeRequirements]\n@@ -994,7 +989,7 @@ $ git config core.hooksPath tools/git_hooks\n --\n This uses the dedicated `tools/git_hooks/` directory, so other scripts in `tools/` remain untouched.\n \n-To include the AI-Assisted trailer automatically, set the commit template with:\n+To include the \"Assisted-by\" trailer automatically, set the commit template with:\n --\n [source,sh]\n ----\n@@ -1003,7 +998,7 @@ $ git config commit.template .gitmessage\n --\n \n The Wireshark pre-commit hook (in `tools/git_hooks/`) runs Wireshark-specific API and formatting checks and might return false positives.\n-The commit-msg hook warns if the AI-Assisted trailer is missing.\n+The commit-msg hook warns if the \"Assisted-by\" trailer is missing.\n The wrappers in `tools/` remain for compatibility; if you prefer the classic layout you can still copy or symlink from `tools/git_hooks/` into `.git/hooks/`.\n \n If the pre-commit hook is preventing you from committing what you believe is a valid change, you can run `git commit --no-verify` to skip running the hooks.\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/wsdg_src/wsdg_sources.adoc",
      "old_path": "doc/wsdg_src/wsdg_sources.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -5,9 +5,9 @@\n msgfile=\"$1\"\n topdir=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"\n \n-# Warn (do not block) if the AI-Assisted trailer is missing.\n-if [ -f \"$msgfile\" ] && grep -qv '^#' && ! grep -qi '^AI-Assisted:' \"$msgfile\"; then\n-    echo \"Warning: Commit message is missing the 'AI-Assisted: no|yes [tool(s)]' trailer.\" >&2\n+# Warn (do not block) if the Assisted-by trailer is missing.\n+if [ -f \"$msgfile\" ] && grep -qv '^#' && ! grep -qi '^Assisted-by:' \"$msgfile\"; then\n+    echo \"Warning: Commit message is missing the 'Assisted-by: [tool(s)]' trailer.\" >&2\n fi\n \n \"$topdir/tools/validate-commit.py\" --commitmsg \"$msgfile\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "tools/git_hooks/commit-msg",
      "old_path": "tools/git_hooks/commit-msg",
      "a_mode": "100755",
