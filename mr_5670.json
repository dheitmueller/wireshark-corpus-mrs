    },
    {
      "id": "7d5a5cc8c3b6f3fbdfbf9da6bdd4c089e540f1e8",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 798969091,
          "type": "DiscussionNote",
          "body": "Or maybe just require a 'T' in the basic format? T*hhmmss*. That would do it.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2021-12-31T16:28:32.384Z",
          "updated_at": "2021-12-31T18:09:28.203Z",
          "system": false,
