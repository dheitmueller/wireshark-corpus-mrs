      "diff": "@@ -0,0 +1,32 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+\n+<!-- Travelping vendor-specific AVPs. -->\n+\n+<vendor vendor-id=\"Travelping\" code=\"18681\" name=\"Travelping\">\n+  <avp name=\"TP-NAT-IP-Address\" code=\"16\" vendor-id=\"Travelping\" mandatory=\"may\" protected=\"may\" may-encrypt=\"yes\" vendor-bit=\"must\">\n+    <type type-name=\"OctetString\"/>\n+  </avp>\n+\n+  <avp name=\"TP-NAT-Pool-Id\" code=\"27\" vendor-id=\"Travelping\" mandatory=\"may\" protected=\"may\" may-encrypt=\"yes\" vendor-bit=\"must\">\n+    <type type-name=\"UTF8String\"/>\n+  </avp>\n+\n+  <avp name=\"TP-NAT-Port-End\" code=\"29\" vendor-id=\"Travelping\" mandatory=\"may\" protected=\"may\" may-encrypt=\"yes\" vendor-bit=\"must\">\n+    <type type-name=\"Unsigned32\"/>\n+  </avp>\n+\n+  <avp name=\"TP-NAT-Port-Start\" code=\"28\" vendor-id=\"Travelping\" mandatory=\"may\" protected=\"may\" may-encrypt=\"yes\" vendor-bit=\"must\">\n+    <type type-name=\"Unsigned32\"/>\n+  </avp>\n+\n+  <avp name=\"TP-Previous-PS-Information\" code=\"64\" vendor-id=\"Travelping\" mandatory=\"may\" protected=\"may\" may-encrypt=\"yes\" vendor-bit=\"must\">\n+    <grouped>\n+      <gavp name=\"QoS-Information\"/>\n+      <gavp name=\"SGSN-Address\"/>\n+      <gavp name=\"3GPP-SGSN-MCC-MNC\"/>\n+      <gavp name=\"3GPP-MS-TimeZone\"/>\n+      <gavp name=\"3GPP-User-Location-Info\"/>\n+      <gavp name=\"3GPP-RAT-Type\"/>\n+    </grouped>\n+  </avp>\n+</vendor>\n",
