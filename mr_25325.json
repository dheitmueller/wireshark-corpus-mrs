  "changes_data": [
    {
      "diff": "@@ -700,7 +700,7 @@ macOS Universal Package:\n     - export PKG_CONFIG_PATH=\n     - mkdir build\n     - cd build\n-    - ../tools/make-version.py --set-release ..\n+    - ../tools/make-version.py --set-release --wireshark-version-file=wireshark_version.txt --stratoshark-version-file=stratoshark_version.txt ..\n     - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n     - cmake --preset=ninja_ccache\n       -DWIRESHARK_BASE_DIR=\"$WIRESHARK_BASE_DIR\"\n@@ -735,9 +735,11 @@ macOS Universal Package:\n       fi\n     - $CI_PROJECT_DIR/build/run/tshark --version\n     - WIRESHARK_SPARKLE_SIGNATURE=$( age --decrypt --identity=\"$MACOS_AGE_IDENTITY\" \"$MACOS_SPARKLE_BLOB\" | $WIRESHARK_BASE_DIR/macos-universal-master/sparkle/bin/sign_update --ed-key-file - Wireshark?[1-9]*.dmg )\n+    - WIRESHARK_VERSION=$(< ../wireshark_version.txt)\n     - printf 'sparkle_signature = %s\\n' \"$WIRESHARK_SPARKLE_SIGNATURE\" >> wireshark-release-info-${WIRESHARK_VERSION}-macos-arm64.ini\n     - cp wireshark-release-info-${WIRESHARK_VERSION}-macos-arm64.ini wireshark-release-info-${WIRESHARK_VERSION}-macos-intel64.ini\n     - STRATOSHARK_SPARKLE_SIGNATURE=$( age --decrypt --identity=\"$MACOS_AGE_IDENTITY\" \"$MACOS_SPARKLE_BLOB\" | $WIRESHARK_BASE_DIR/macos-universal-master/sparkle/bin/sign_update --ed-key-file - Stratoshark?[0-9]*.dmg )\n+    - STRATOSHARK_VERSION=$(< ../stratoshark_version.txt)\n     - printf 'sparkle_signature = %s\\n' \"$STRATOSHARK_SPARKLE_SIGNATURE\" >> stratoshark-release-info-${STRATOSHARK_VERSION}-macos-arm64.ini\n     - cp stratoshark-release-info-${STRATOSHARK_VERSION}-macos-arm64.ini stratoshark-release-info-${STRATOSHARK_VERSION}-macos-intel64.ini\n     - if [ -n \"$S3_DESTINATION_RELEASE\" ] ; then\n",
