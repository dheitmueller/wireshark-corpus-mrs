          "commands_changes": {}
        },
        {
          "id": 2933985730,
          "type": "DiscussionNote",
          "body": "> I think in this case we should not have any such messages on stderr.\n\nNot by default, at least. At a certain log level, perhaps.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-12-04T18:15:07.435Z",
          "updated_at": "2025-12-04T18:15:07.435Z",
          "system": false,
          "noteable_id": 438017711,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
