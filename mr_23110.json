  "discussions_data": [
    {
      "id": "2e0939f41a56eb7924560c8046bf56bdfef60439",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 2987381705,
          "type": "DiscussionNote",
          "body": "The change to make it synchronous like TShark was done intentionally in 09ebddaa7face2befe025e72cb6d94e497feec29 by @nielswidger \n\nWhy do you think it's \"incorrect\" to have synchronous resolution in Sharkd? With asynchronous resolution, there's no indication that one needs to request again.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-01-06T22:28:56.279Z",
          "updated_at": "2026-01-07T14:59:00.315Z",
          "system": false,
          "noteable_id": 444448584,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "resolved_at": "2026-01-07T14:59:00.315Z",
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 23110,
          "commands_changes": {}
        },
        {
          "id": 2988886733,
          "type": "DiscussionNote",
          "body": "@nielswidger and I authored the original change (09ebddaa) for GeoIP lookups without\nfully understanding the impact on DNS resolution. This is my mea culpa - that change\nwas incorrect for sharkd's architecture.\n\nThe key difference: sharkd is stateful and keeps captures in memory, unlike tshark\nwhich is single-pass and streams output. Sharkd already updates previous packets with\nnew information (like `dns.response_in` style fields) - name resolution should work the same way.\n\nSynchronous resolution makes sharkd practically unusable with name resolution enabled.\nIt blocks on every single DNS lookup before returning any data. This defeats the purpose\nof having an in-memory, interactive analysis daemon.\n\nOn the \"no indication to request again\" concern: clients already make multiple requests\nfor the same data (frame details, taps, etc.). Names appearing in subsequent requests\nmatches how Wireshark GUI works - they resolve in the background and appear when ready.\nThis is the expected behavior for an interactive tool.\n\nThis change restores sharkd to behave like Wireshark GUI (async) rather than tshark (sync), which better matches its in-memory, stateful design.",
          "author": {
            "id": 4502906,
            "username": "zachad",
            "public_email": "zachad@qacafe.com",
            "name": "Zach Chadwick",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/4502906/avatar.png?v=1788757341",
            "web_url": "https://gitlab.com/zachad"
          },
          "created_at": "2026-01-07T13:50:20.820Z",
          "updated_at": "2026-01-07T14:59:00.315Z",
