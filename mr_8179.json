      "resolvable": false,
      "notes": [
        {
          "id": 1534586921,
          "type": null,
          "body": "Can someone please push the fix for issue 18308 into a 4.0.x patch? This fixes a critical issue in the ESL_ETH dissector in which timestamps from the Beckhoff ET2000N are not recognized.\n\nI am not familiar with the Wireshark workflow, but I see that it was merged into the mainline, but patch after patch of 4.0.x comes out and this issue never gets included.",
          "author": {
            "id": 15677202,
            "username": "qtormanen",
            "public_email": null,
            "name": "qtormanen",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/7753970f87455206fb65567041274deb09e8deb8da8538abcf42b7254aec65ed?s=80&d=identicon",
            "web_url": "https://gitlab.com/qtormanen"
          },
          "created_at": "2023-08-30T00:08:59.979Z",
          "updated_at": "2023-08-30T00:08:59.979Z",
