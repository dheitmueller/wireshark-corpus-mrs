    {
      "id": "d5fe2a72c92abf4dd31797a667d49443501e4dca",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2705202967,
          "type": null,
          "body": "This falls down when a protocol is selected or even worse a protocol with \"field appendix\"?  \nIf a protocol (such as `tcp`) is selected], when the mouse leaves the byte pane only the first field in `tcp` is selected. Even worse for a protocol like `eth` which may include `eth.fcs` and/or `eth.padding` bytes that not contiguous with the rest of the `eth` bytes.  \n  \nIt's better than leaving arbitrary hovered bytes highlighted but needs work for the cases above.",
          "author": {
            "id": 6701257,
            "username": "chuckcraft",
            "public_email": "",
            "name": "Chuck Craft",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/0809ffc6d9d98013a1895132bc055c622830b8a20bfa49328f53d5eb4a1206cb?s=80&d=identicon",
            "web_url": "https://gitlab.com/chuckcraft"
          },
          "created_at": "2025-08-24T16:19:21.352Z",
          "updated_at": "2025-08-24T16:19:21.352Z",
          "system": false,
          "noteable_id": 407408465,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
