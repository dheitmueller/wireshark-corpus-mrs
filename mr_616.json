    {
      "id": "dcca171c273870dfffcabc3b9e832a09eb54192d",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 431504376,
          "type": null,
          "body": "I have asked Srivats P (the author of Ostinato) whether it would be an issue for him to remove the escaping.\nThe only field I found among a few captures I tried was \"tcp.flags.str\", which makes no sense to me (I guess it should actually just '.' for each flag bit that isn't set)\n(discussion is in #develop-den in Sharkfest'20 Virtual Discord, which is still open today)",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
