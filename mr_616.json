    {
      "id": "c286d3f7f1984bcb211a6d071e1dc35aadc5a7ef",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 431371754,
          "type": "DiffNote",
          "body": "The patch looks good for what is , but since ```write_pdml_preamble()``` always includes [```encoding=\\\"utf-8\\\"``` ](epan/print.c#L268) and most things are UTF-8 internally, does anything other the five special cases need to be escaped at all? Escaping all bytes with the high bit set might cause more trouble than it helps. See #10445.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2020-10-17T19:42:35.376Z",
          "updated_at": "2020-10-17T19:42:35.376Z",
          "system": false,
          "noteable_id": 74743034,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "commit_id": null,
          "position": {
            "base_sha": "c03011b906dfaad7ff25d7b6f284ee07f9aeffc1",
            "start_sha": "c03011b906dfaad7ff25d7b6f284ee07f9aeffc1",
