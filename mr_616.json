            "old_path": "epan/print.c",
            "new_path": "epan/print.c",
            "position_type": "text",
            "old_line": null,
            "new_line": 1781,
            "line_range": null
          },
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
