    {
      "id": "0ecccb68d78fa6e3373989fdf73eb3b1c7992127",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 431519891,
          "type": null,
          "body": "I guess it's more likely to show up in PSML. The example from #10445 is →, the rightwards arrow used for indicating communication between ports. You can try looking for things from [utf8_entities.h](wsutil/utf8_entities.h) in various dissectors. They all start with UTF8_",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2020-10-18T18:53:57.953Z",
