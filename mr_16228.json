    {
      "id": "e4216cafb250b544dd5f46eed4e30f248a622814",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1978126966,
          "type": "DiscussionNote",
          "body": "Ok! I'm new to contributing to Wireshark, and since this code isn't mine, I'm not aware of how they used asn2wrs.py. Do you know where I can find how the asn2wrs.py was used for the its dissectors? What arguments they used, etc.\n\nThere are a lot of ASN.1 and some overlap with each other.",
          "author": {
            "id": 13682248,
            "username": "daniel.ulied",
            "public_email": null,
            "name": "Daniel Ulied Guevara",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/582d02c69af989881fc9d635c24d50aafe21716a80e6e9a1bbabe4bb106dc5ce?s=80&d=identicon",
            "web_url": "https://gitlab.com/daniel.ulied"
