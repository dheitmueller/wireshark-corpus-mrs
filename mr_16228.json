    {
      "id": "826ee70fe0e9f308bbdd29ccba0c60b02af929e1",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1977117460,
          "type": null,
          "body": "When I check our branch out onto current master, and run 'make' in build/epan/dissectors/asn1/its I get lots of diffs.\n\nIn particular, your packet-its.c seems like it has still been built from an old version of tools/asn2wrs.py.  One place this shows is that lots of static int variables are being assigned to -1.  This is no longer done.  You need to do something like:\n\ngit checkout master && git pull\n\ngit checkout <your-branch>\n\ngit rebase master\n\nrebuild packet-its.c using update ans2wrs.py\n\ngit commit -a --amend\n\ngit push downstream +HEAD",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2024-07-01T16:20:51.683Z",
          "updated_at": "2024-07-01T16:20:51.683Z",
