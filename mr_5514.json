  "discussions_data": [
    {
      "id": "c87c66d93ed0d6be36b2ce74e4a95969cefeec40",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 790562689,
          "type": null,
          "body": "Note that `_read()`, `_write()`, `recv()`, `recvfrom()`, `recvmsg()`, `send()`, `sendto()`, and `sendmsg()` all return `int` on Windows.\n\nIs there any case where `ssize_t` is used in a UN\\*X routine where the Windows C library provides an equivalent routine where `int` is *not* used as a replacement for `ssize_t`?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-12-20T21:39:39.749Z",
          "updated_at": "2021-12-20T21:39:55.123Z",
          "system": false,
          "noteable_id": 131957087,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 5514,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "0a50ae29a53ffcc92bc51e2400ec0f0776f78c14",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 790586409,
          "type": null,
          "body": "No, I don't think there is any such case. But I think `ssize_t` should still be able to reasonably represent the size of an object in memory on LLP64, and this change purports to be compatible with POSIX like that.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
