    {
      "id": "5f4232788efafb7b707b8e4c1c864ac76a8508ce",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 790774142,
          "type": null,
          "body": "I will fix the clang warnings tomorrow.\n\nI see the point of defining `ssize_t` as an int on Windows, it makes a lot of sense to facilitate the use of the Microsoft POSIX-like APIs. But `size_t` is not an `unsigned` either and Microsoft (SSIZE_T), MinGW-w64 (ssize_t), GLib (gssize), they all use 64 bits `ssize_t` with LLP64 (as they should).",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2021-12-21T04:34:02.792Z",
          "updated_at": "2021-12-21T04:34:02.792Z",
