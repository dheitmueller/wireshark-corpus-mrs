  "changes_data": [
    {
      "diff": "@@ -129,7 +129,7 @@ wmem_array_append(wmem_array_t *array, const void *in, guint count)\n void *\n wmem_array_index(wmem_array_t *array, guint array_index)\n {\n-    ws_assert_bounds(array_index < array->elem_count);\n+    ws_abort_if_fail(array_index < array->elem_count);\n     return &array->buf[array_index * array->elem_size];\n }\n \n",
      "collapsed": false,
      "too_large": false,
