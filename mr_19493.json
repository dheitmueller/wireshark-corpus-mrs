      "diff": "@@ -285,6 +285,11 @@ void PacketListHeader::columnVisibilityTriggered()\n     if (ha->isChecked())\n         emit resetColumnWidth(col);\n \n+    PacketList* packetList = qobject_cast<PacketList*>(parent());\n+    if (packetList) {\n+        packetList->setColumnDelegate();\n+    }\n+\n     prefs_main_write();\n }\n \n",
