    {
      "id": "d82f9d220dcbe6c2d230825be1e84be08a830b36",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2261975954,
          "type": null,
          "body": "I don't think this quite works. In order for the protocol name for the `FT_PROTOCOL` and the `FT_STRING` for the root node to have different names, it looks like the dtd has to have a line like `root=\"poc-settings\"` or something, or else the `proto_name` will be used for the root node. I'm not sure if it makes sense to change in the XML dissector.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-12-17T00:03:33.271Z",
          "updated_at": "2024-12-17T00:03:33.271Z",
