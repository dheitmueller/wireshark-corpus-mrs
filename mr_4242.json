    {
      "id": "7fd565b9b8b4b23614c0e62de090b7a30dabe764",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 683580858,
          "type": null,
          "body": "So regardless of strategy here - I have a proposal...\n\nI think this should all be handled in a new `cmake/HomebrewPlugin.cmake` file that gets contributed to upstream.  It's really strange that every FOSS project on macOS has to re-invent this wheel.\n\nThe plugin would:\n* Use `brew --prefix` to auto-configure itself and set appropriate environment variables if found\n* Export a new `add_homebrew_formula(NAME, [VERSION])` function if homebrew is found, this would place the formula paths onto the needed environment variables.  Possibly only adding the formula's pkg-config to the search directories.\n  * Open question: should this error if not on Apple or if homebrew is not found?  Seems like we are hinting to the environment that a dependency could be resolved, not telling it explicitly... perhaps `require_homebrew_formula` and `try_homebrew_formula`?",
          "author": {
            "id": 9765948,
            "username": "rickmark1",
            "public_email": "",
            "name": "Rick Mark",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/03e5a00720fe630053752df1fb44d033da122794c1e3aa4d130a0bacb83f4f52?s=80&d=identicon",
            "web_url": "https://gitlab.com/rickmark1"
          },
          "created_at": "2021-09-21T21:07:03.036Z",
          "updated_at": "2021-09-21T21:07:03.036Z",
          "system": false,
          "noteable_id": 117462608,
