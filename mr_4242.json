    {
      "id": "2c06be45e9ad9238f6bc2761ca5566ded4b5b51d",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 681512112,
          "type": "DiscussionNote",
          "body": "You should be able to skip running `which brew`, e.g.\n\n```\nexecute_process(COMMAND brew --prefix RESULT_VARIABLE _brew_exit OUTPUT_VARIABLE _brew_stdout)\nif (${_brew_exit} EQUAL 0)\n    set(MACOS_HOMEBREW_PREFIX_PATH ${_brew_stdout})\nendif()\n```",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789948913",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2021-09-20T00:48:20.660Z",
          "updated_at": "2021-09-20T11:12:37.909Z",
