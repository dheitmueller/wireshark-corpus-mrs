  "changes_data": [
    {
      "diff": "@@ -574,22 +574,8 @@ Documentation:\n     - cmake -GNinja ..\n     - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n     - ninja all_guides\n-    - pushd docbook\n+    - cd docbook\n     - for HTML_DIR in wsug_html wsug_html_chunked wsdg_html wsdg_html_chunked ; do zip -9 -r \"$HTML_DIR.zip\" \"$HTML_DIR\" ; done\n-    - popd\n-    - |\n-      cat > ../manuf <<FIN\n-      # This file was generated by running `tshark -G manuf`.\n-      # Its canonical location is https://www.wireshark.org/download/automated/data/manuf\n-      #\n-      # This file is in the same format as ethers(5) except that vendor names\n-      # are truncated to eight characters for compatibility with Wireshark, and\n-      # that well-known MAC addresses need not have a full 6 octets and may\n-      # have a netmask following them specifying how many bits of the address\n-      # are relevant (the other bits are wildcards).\n-      #\n-      FIN\n-    - run/tshark -G manuf | sed -e 's,:00:00:00/24,,' >> ../manuf\n   after_script:\n     - mv -v build/docbook/ws[ud]g_html{,_chunked}.zip .\n     - mv -v build/docbook/Wireshark*Guide.{epub,pdf} .\n@@ -599,12 +585,6 @@ Documentation:\n           aws s3 cp \"$DOC_FILE\" \"$S3_DESTINATION_DOCS/\"\n         done\n       fi\n-    - |\n-      if [ -n \"$S3_DESTINATION_DATA\" ] ; then\n-        for DATA_FILE in manuf ; do\n-          aws s3 cp \"$DATA_FILE\" \"$S3_DESTINATION_DATA/\"\n-        done\n-      fi\n   artifacts:\n     paths:\n       - wsug_html.zip\n@@ -615,7 +595,6 @@ Documentation:\n       - \"Wireshark Developer's Guide.pdf\"\n       - \"Wireshark User's Guide.epub\"\n       - \"Wireshark Developer's Guide.epub\"\n-      - manuf\n   needs: []\n \n \n@@ -899,7 +878,7 @@ API Reference:\n     - wsar_html.zip\n   needs: []\n \n-Code Lines:\n+Code Lines and Data:\n   extends: .build-ubuntu\n   rules: !reference [.if-daily-schedule]\n   stage: analysis\n@@ -932,6 +911,19 @@ Code Lines:\n     - sloccount . | awk \"/^Computing results/ { results=1 } { if (results) print }\" | tee $SLOC_OUT\n     - /tmp/tokei --version\n     - /tmp/tokei --exclude 'qt/*.ts' . | tee $TOKEI_OUT\n+    - |\n+      cat > manuf <<FIN\n+      # This file was generated by running `tshark -G manuf`.\n+      # Its canonical location is https://www.wireshark.org/download/automated/data/manuf\n+      #\n+      # This file is in the same format as ethers(5) except that vendor names\n+      # are truncated to eight characters for compatibility with Wireshark, and\n+      # that well-known MAC addresses need not have a full 6 octets and may\n+      # have a netmask following them specifying how many bits of the address\n+      # are relevant (the other bits are wildcards).\n+      #\n+      FIN\n+    - build/run/tshark -G manuf | sed -e 's,:00:00:00/24,,' >> manuf\n     - |\n       if [ -n \"$S3_DESTINATION_ANALYSIS\" ] ; then\n         aws s3 cp \"$CLOC_OUT\" \"$S3_DESTINATION_ANALYSIS/\"\n@@ -939,6 +931,16 @@ Code Lines:\n         aws s3 cp \"$SLOC_OUT\" \"$S3_DESTINATION_ANALYSIS/\"\n         aws s3 cp \"$TOKEI_OUT\" \"$S3_DESTINATION_ANALYSIS/\"\n       fi\n+    - |\n+      if [ -n \"$S3_DESTINATION_DATA\" ] ; then\n+        for DATA_FILE in manuf ; do\n+          aws s3 cp \"$DATA_FILE\" \"$S3_DESTINATION_DATA/\"\n+        done\n+      fi\n+  artifacts:\n+    paths:\n+    - manuf\n+  needs: []\n \n # Fuzz TShark using ASAN and valgrind.\n .fuzz-ubuntu:\n",
