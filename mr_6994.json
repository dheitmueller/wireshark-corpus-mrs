    {
      "id": "c0d2d30e920469cc5ad85ffcbd62ebc2c41cb2ad",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 956434045,
          "type": "DiffNote",
          "body": "[Qt 5.12's rcc](https://doc.qt.io/archives/qt-5.12/rcc.html) doesn't have the `-compress-algo` option. It was added in [5.13](https://doc.qt.io/archives/qt-5.13/rcc.html).\n\n```suggestion:-0+0\n\tset(CMAKE_AUTORCC_OPTIONS --format-version 1)\n\tif(QT${qtver}Widgets_VERSION VERSION_GREATER_EQUAL \"5.13\")\n\t\tlist(APPEND CMAKE_AUTORCC_OPTIONS -compress-algo zlib)\n\tendif()\n```",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
