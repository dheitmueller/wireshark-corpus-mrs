    {
      "id": "e4688cd5b6b65ba795b4c3d30d84e96e93f80068",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 912195009,
          "type": null,
          "body": "I still think there's value in having a doxygen job run on each MR, but be allowed to fail, to encourage devs to document. But if the core devs don't think there's value in that, I'll close the MR - there's no value in keeping it open or working on it if it anyways wouldn't be merged in.",
          "author": {
            "id": 3194989,
            "username": "moshekaplan",
            "public_email": "",
            "name": "Moshe Kaplan",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/3194989/avatar.png?v=1789950604",
            "web_url": "https://gitlab.com/moshekaplan"
          },
          "created_at": "2022-04-14T03:45:39.959Z",
          "updated_at": "2022-04-14T03:45:39.959Z",
          "system": false,
          "noteable_id": 68599909,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 19,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "655b81a4307ba39ab3b7177d7af93d7dd3402589",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2520432891,
          "type": null,
          "body": "I really want to enforce doxygen for the \"building blocks\"/external interfaces (epan, wsutil, wiretap API, etc), but I think it's a little silly for most packet dissection because much of that is self-explanatory.  I've faced these types of decisions in my \"day job\" - it's really hard to doyxgenate a code base that is decades old and didn't have the documentation set up from the start.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2025-05-22T13:59:24.995Z",
          "updated_at": "2025-05-25T18:35:30.436Z",
          "system": false,
          "noteable_id": 68599909,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 19,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "7446d7306f980529c8cb648a3b3099f7b6958844",
