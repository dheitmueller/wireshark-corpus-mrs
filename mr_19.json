  "changes_data": [
    {
      "diff": "@@ -391,3 +391,36 @@ merge-req:windows:\n     - msbuild \"/consoleloggerparameters:PerformanceSummary;NoSummary\" /maxcpucount Wireshark.sln\n     - msbuild \"/consoleloggerparameters:PerformanceSummary;NoSummary\" test-programs.vcxproj\n     - ctest -C RelWithDebInfo --parallel 3 --force-new-ctest-process --verbose\n+\n+# Validate doxygen is proper for modified files\n+merge-req:doxygen_diff:\n+  stage: build\n+  image: wireshark/wireshark-ubuntu-dev\n+  rules:\n+    - if: '$CI_PIPELINE_SOURCE == \"merge_request_event\"'\n+  variables:\n+    ERROR_MSG: \"Detected Doxygen documentation issues! See doxygen_errors.txt for details\"\n+    SUCCESS_MSG: \"No Doxygen documentation issues were detected.\"\n+  script:\n+    # Extract the list of modified files\n+    - curl https://gitlab.com/api/v4/projects/wireshark%2Fwireshark/merge_requests/$CI_MERGE_REQUEST_IID/changes -s | jq -r '.changes | .[] | .new_path'|sort -u > modified_files.txt\n+    - if [[ ! -s modified_files.txt ]]; then echo \"No files to check! Exiting.\"; true; exit; fi\n+    - echo \"The following files will be analyzed for doxygen errors:\"\n+    - cat modified_files.txt\n+    # Update the doxygen config to avoid errors caused by obsolete values\n+    - doxygen -u doxygen.cfg.in\n+    # Set \"WARN_IF_UNDOCUMENTED\" to \"YES\" to be extra noisy.\n+    - sed -Ei 's/^WARN_IF_UNDOCUMENTED   = NO/WARN_IF_UNDOCUMENTED   = YES/' doxygen.cfg.in\n+    - export FILES=`cat modified_files.txt | tr '\\n' ' '`\n+    - mkdir build\n+    - cd build\n+    - cmake ..\n+    - cd ..\n+    - (cat build/doxygen.cfg; echo \"INPUT = $FILES\") | doxygen - 2>&1 > doxygen_output.txt | tee doxygen_errors.txt\n+    - if [[ -s doxygen_errors.txt ]]; then echo $ERROR_MSG; false; else echo $SUCCESS_MSG; true; fi\n+  artifacts:\n+    when: on_failure\n+    paths:\n+    - doxygen_errors.txt\n+    - doxygen_output.txt\n+  allow_failure: true\n",
      "collapsed": false,
      "too_large": false,
      "new_path": ".gitlab-ci.yml",
      "old_path": ".gitlab-ci.yml",
      "a_mode": "100644",
      "b_mode": "100644",
