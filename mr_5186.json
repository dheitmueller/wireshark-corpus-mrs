      "notes": [
        {
          "id": 742321629,
          "type": "DiscussionNote",
          "body": "MS have made getting a user readable OS string extra-ordinarily difficult lately.\n\nThe best I've come up with is to try the registry entries under `HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion` but I don't know what is present on Windows 11\\Server 2022:\n\nFor Windows 10 Pro, 21H2 I get:\n\n| Value | Contents |\n| ------ | ------ |\n| ProductName | Windows 10 Professional |\n| DisplayVersion | 21H2 |\n| ReleaseId | 2009 |\n\nFor Server 2019 I get:\n\n| Value | Contents |\n| ------ | ------ |\n| ProductName | Windows Server 2019 Standard |\n| DisplayVersion | Not present |\n| ReleaseId | 1809 |\n\nFor Server 2016 I get:\n\n| Value | Contents |\n| ------ | ------ |\n| ProductName | Windows Server 2016 Standard |\n| DisplayVersion | Not present |\n| ReleaseId | 1607 |",
          "author": {
            "id": 6621762,
            "username": "graham.bloice",
            "public_email": "",
            "name": "Graham Bloice",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/8730bfac2267cb97ff1f8187d285f244745a03a783055c8fd6fcd679bfa71c6e?s=80&d=identicon",
            "web_url": "https://gitlab.com/graham.bloice"
          },
          "created_at": "2021-11-24T09:29:15.674Z",
