  "changes_data": [
    {
      "diff": "@@ -99,8 +99,7 @@ wmem_strjoinv(wmem_allocator_t *allocator,\n {\n     char *string = NULL;\n \n-    if (!str_array)\n-        return NULL;\n+    ws_return_val_if(!str_array, NULL);\n \n     if (separator == NULL) {\n         separator = \"\";\n@@ -128,6 +127,8 @@ wmem_strjoinv(wmem_allocator_t *allocator,\n             ptr = g_stpcpy(ptr, separator);\n             ptr = g_stpcpy(ptr, str_array[i]);\n         }\n+    } else {\n+        string = wmem_strdup(allocator, \"\");\n     }\n \n     return string;\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "wsutil/str_util.c",
