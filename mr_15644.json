    {
      "id": "319474872c42821124799bf37b2877c724a48cb8",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1905929336,
          "type": null,
          "body": "If we need to, we can move some of the other code checks to a different or new job.\n\nI updated the checkAPI job so it no longer depends on compiling to run its needed targets (i.e., it will generate files that need to be generated itself if need be), so we could have a Code Check job that runs cmake and then does the ASN.1, pidl, checkAPIs and some of the other checks, just to shave a bit off this job.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
