  "changes_data": [
    {
      "diff": "@@ -433,7 +433,7 @@ rlc_frag_delete(gpointer data)\n     struct rlc_frag *frag = (struct rlc_frag *)data;\n \n     if (frag->data) {\n-        g_free(frag->data);\n+        wmem_free(wmem_file_scope(), frag->data);\n         frag->data = NULL;\n     }\n }\n@@ -447,7 +447,7 @@ rlc_sdu_frags_delete(gpointer data)\n     frag = sdu->frags;\n     while (frag) {\n         if (frag->data) {\n-            g_free(frag->data);\n+            wmem_free(wmem_file_scope(), frag->data);\n         }\n         frag->data = NULL;\n         frag = frag->next;\n@@ -859,8 +859,10 @@ reassemble_data(struct rlc_channel *ch, struct rlc_sdu *sdu, struct rlc_frag *fr\n     sdu->data = (guint8 *)wmem_alloc(wmem_file_scope(), sdu->len);\n     temp = sdu->frags;\n     while (temp && ((offs + temp->len) <= sdu->len)) {\n-        memcpy(sdu->data + offs, temp->data, temp->len);\n-        wmem_free(wmem_file_scope(), temp->data);\n+        if (temp->data) {\n+            memcpy(sdu->data + offs, temp->data, temp->len);\n+            wmem_free(wmem_file_scope(), temp->data);\n+        }\n         temp->data = NULL;\n         /* mark this fragment in reassembled table */\n         g_hash_table_insert(reassembled_table, temp, sdu);\n",
