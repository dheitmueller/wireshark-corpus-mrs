      "diff": "@@ -907,7 +907,7 @@ realm_is_3gpp(char** realm_tokens, unsigned *nrealm_tokensp)\n }\n \n /* Dissect the 3GPP identity */\n-static bool\n+bool\n dissect_eap_identity_3gpp(tvbuff_t *tvb, packet_info* pinfo, proto_tree* tree, int offset, int size)\n {\n   unsigned    mnc = 0;\n",
