      "diff": "@@ -362,6 +362,7 @@ set(DISSECTOR_PUBLIC_HEADERS\n \tpacket-dtls.h\n \tpacket-dvbci.h\n \tpacket-e1ap.h\n+\tpacket-eap.h\n \tpacket-enip.h\n \tpacket-erf.h\n \tpacket-e164.h\n",
