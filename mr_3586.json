      "diff": "@@ -799,3 +799,22 @@ class case_communityid(subprocesstest.SubprocessTestCase):\n              ))\n \n         self.assertBaseline(dirs, proc.stdout_str, 'communityid-filtered.txt')\n+\n+@fixtures.mark_usefixtures('test_env')\n+@fixtures.uses_fixtures\n+class case_dissect_tns(subprocesstest.SubprocessTestCase):\n+    def test_tns_bad(self, cmd_tshark, capture_file):\n+        proc = self.assertRun((cmd_tshark,\n+            '-r', capture_file('tns_bad.pcap'),\n+            '-d', 'tcp.port==1521,tns',\n+            '-Y', 'tns.data_opi.param_value == \"06DE79977310E5B78E5A9493CB4FB3D6F5A0975F2B3B5D46737189DD4B7B92AA1A36B309D39D4471568CE287A52093BA\"',\n+        ))\n+        self.assertTrue(self.grepOutput('Return OPI Parameter'))\n+\n+    def test_tns_bad2(self, cmd_tshark, capture_file):\n+        proc = self.assertRun((cmd_tshark,\n+            '-r', capture_file('tns_bad2.pcap'),\n+            '-d', 'tcp.port==1521,tns',\n+            '-Y', 'tns.data_opi.param_value == \"7BD0E1244A35B13E8E194519B105257020D2DAC3816B3C5F5A71D0A3E5C217C6E796E1B592719A0FD47B7A18EF8A0311\"',\n+        ))\n+        self.assertTrue(self.grepOutput('Return OPI Parameter'))\n",
