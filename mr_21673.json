    {
      "diff": "@@ -11,9 +11,32 @@ RSPDefinitions sgp22\n \n #.OMIT_ASSIGNMENT\n AuthenticateClientRequest\n+\n+#.PDU\n EsipaMessageFromIpaToEim\n EsipaMessageFromEimToIpa\n-#.END\n+\n+#.FN_PARS\n+EsipaMessageFromIpaToEim VAL_PTR = &choice\n+EsipaMessageFromEimToIpa VAL_PTR = &choice\n+\n+#.FN_HDR EsipaMessageFromIpaToEim\n+  int choice;\n+\n+#.FN_FTR EsipaMessageFromIpaToEim\n+  if (choice != -1) {\n+    const char *choice_str = val_to_str_const(EsipaMessageFromIpaToEim_choice[choice].value, sgp32_EsipaMessageFromIpaToEim_vals, \"Unknown\");\n+    col_append_fstr(actx->pinfo->cinfo, COL_INFO, \"%s\", choice_str);\n+  }\n+\n+#.FN_HDR EsipaMessageFromEimToIpa\n+  int choice;\n+\n+#.FN_FTR EsipaMessageFromEimToIpa\n+  if (choice != -1) {\n+    const char *choice_str = val_to_str_const(EsipaMessageFromEimToIpa_choice[choice].value, sgp32_EsipaMessageFromEimToIpa_vals, \"Unknown\");\n+    col_append_fstr(actx->pinfo->cinfo, COL_INFO, \"%s\", choice_str);\n+  }\n \n #.REGISTER\n ISDRProprietaryApplicationTemplateIoT      N sgp32.request   0xE1\n",
