  "changes_data": [
    {
      "diff": "@@ -47,6 +47,8 @@ The following bugs have been fixed since version 0.9.1:\n \n * Stratoshark and editcap could write incorrect block types. https://gitlab.com/wireshark/wireshark/-/merge_requests/19238[Merge request 19238].\n \n+* Stratoshark says I can't capture on local interfaces. wsbuglink:20494[].\n+\n The following bugs have been fixed since version 0.9.0:\n \n * Falco Bridge: Empty frame.protocols field. wsbuglink:20248[].\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/Stratoshark_Release_Notes.adoc",
      "old_path": "doc/Stratoshark_Release_Notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -410,8 +410,12 @@ void InterfaceFrame::resetInterfaceTreeDisplay()\n bool InterfaceFrame::haveLocalCapturePermissions() const\n {\n #ifdef Q_OS_MAC\n-    QFileInfo bpf0_fi = QFileInfo(\"/dev/bpf0\");\n-    return bpf0_fi.isReadable() && bpf0_fi.isWritable();\n+    if (application_flavor_is_wireshark()) {\n+        QFileInfo bpf0_fi = QFileInfo(\"/dev/bpf0\");\n+        return bpf0_fi.isReadable() && bpf0_fi.isWritable();\n+    } else {\n+        return true;\n+    }\n #elif defined(Q_OS_UNIX)\n     char *dumpcap_bin = get_executable_path(\"dumpcap\");\n     bool executable = access(dumpcap_bin, X_OK) == 0;\n",
      "collapsed": false,
