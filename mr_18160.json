      "diff": "@@ -501,6 +501,18 @@ HexExponent\t\t([pP][+-]?[[:digit:]]+)\n \treturn set_lval_float(yyextra, yytext, yytext);\n }\n \n+(?i:inf)(?i:inity)? {\n+\t/* Infinity. */\n+\tupdate_location(yyextra, yytext);\n+\treturn set_lval_float(yyextra, yytext, yytext);\n+}\n+\n+(?i:nan)(\\([[:alnum:]_]*\\))? {\n+\t/* NaNs (including quiet NaNs). */\n+\tupdate_location(yyextra, yytext);\n+\treturn set_lval_float(yyextra, yytext, yytext);\n+}\n+\n :[[:xdigit:]]+\t{\n \t/* Numeric prefixed with ':'. */\n \tupdate_location(yyextra, yytext);\n",
