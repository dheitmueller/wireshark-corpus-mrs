    {
      "id": "42ce168b36b90a5ec0a256dac5c8276fb961fb28",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1194645192,
          "type": null,
          "body": "@johnthacker I'm having a look at this again, and it seems there are still bad interpretations.\n\nWhat's wrong ? In fact the `maxseqtobeacked` is supposed to track contiguous packets, which stops to be the case after an event, and the reconciliation is too optimistic because the sender might very well keep sending data (with holes) before an ACK tries this reconciliation.\n\n~~A MR is to follow quickly.~~\n\nEdit : MR !8988",
          "author": {
            "id": 6797213,
            "username": "eugene.adell",
            "public_email": "",
            "name": "Eugène Adell",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6797213/avatar.png?v=1789284959",
            "web_url": "https://gitlab.com/eugene.adell"
          },
          "created_at": "2022-12-02T15:52:05.202Z",
          "updated_at": "2022-12-02T16:22:01.411Z",
          "system": false,
          "noteable_id": 189100212,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
