  "changes_data": [
    {
      "diff": "@@ -316,7 +316,7 @@ Debian Stable APT Package:\n     - export DPKG_GENSYMBOLS_CHECK_LEVEL=0\n     - CC=/usr/lib/ccache/gcc CXX=/usr/lib/ccache/g++ dpkg-buildpackage -b --no-sign -jauto -zfast\n     - mkdir debian-packages\n-    - mv -v ../*.deb debian-packages/\n+    - cp -v ../*.deb debian-packages/\n     - mkdir debian-symbols\n     - for wslib in wireshark wiretap wsutil ; do cp -v packaging/debian/lib${wslib}0/DEBIAN/symbols debian-symbols/lib${wslib}0.symbols ; done\n     - lintian --suppress-tags library-not-linked-against-libc --display-experimental --display-info --pedantic --profile debian\n",
