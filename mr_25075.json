      "notes": [
        {
          "id": 3379916029,
          "type": null,
          "body": "This patch is manual compared with the USB BPF header field in FreeBSD base and check whether every field's offset and meaning is unchanged.\n\nThe following is the difference of same simple request on a USB raw HID device by using hidraw on FreeBSD.\n\nBefore:\n\n![image](/uploads/2e9f478a9a36e57a80e3af78881e1575/image.png){width=900 height=600}\n\nAfter:\n\n![image](/uploads/03892fa1d906b02e68fb15da2e7c4e53/image.png){width=900 height=600}",
          "author": {
            "id": 12498601,
            "username": "aokblast",
            "public_email": "",
            "name": "aokblast",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/12498601/avatar.png?v=1788226909",
