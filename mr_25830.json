  "changes_data": [
    {
      "diff": "@@ -43,6 +43,7 @@ variables:\n     acl=private\n     --non-interactive --obscure\"\n   # --no-output\n+  WS_AQTINSTALL_LOCATION: \"aqtinstall@git+https://github.com/miurahr/aqtinstall.git@5be32a75a81513792d95f13065b72cac3381c612\"\n \n workflow:\n   auto_cancel:\n@@ -202,7 +203,7 @@ workflow:\n     - if (-Not (Test-Path C:\\Qt)) { New-Item -Path C:\\Qt -ItemType \"directory\" }\n     - if (-Not (Test-Path \"C:\\Qt\\$($env:WINDOWS_QT_VERSION)\\$($env:AQT_ARCH)\\include\\QtCore\")) {\n         py.exe -m venv --clear \"$($env:TEMP)\\aqt.venv\" ;\n-        & $env:TEMP\\aqt.venv\\Scripts\\pip3.exe install aqtinstall ;\n+        & $env:TEMP\\aqt.venv\\Scripts\\pip3.exe install $env:WS_AQTINSTALL_LOCATION ;\n         & $env:TEMP\\aqt.venv\\Scripts\\aqt.exe install-qt --outputdir C:\\Qt $env:AQT_HOST desktop $env:WINDOWS_QT_VERSION \"win64_$($env:AQT_ARCH)\" --modules qtmultimedia ;\n       }\n     - $env:Configuration = \"RelWithDebInfo\"\n@@ -267,7 +268,7 @@ workflow:\n     - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir $WIRESHARK_BASE_DIR ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt\" ] ; then mkdir \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos/lib/QtCore.framework\" ] ; then\n-        pip3 install aqtinstall ;\n+        pip3 install $WS_AQTINSTALL_LOCATION ;\n         aqt install-qt --outputdir $WIRESHARK_BASE_DIR/Qt mac desktop $MACOS_QT_VERSION clang_64 --modules qtmultimedia --timeout 10 ;\n       fi\n     - export CMAKE_PREFIX_PATH=\"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos\"\n@@ -694,7 +695,7 @@ macOS Universal Package:\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt\" ] ; then mkdir -p \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos/lib/QtCore.framework\" ] ; then\n-        pip3 install aqtinstall ;\n+        pip3 install $WS_AQTINSTALL_LOCATION ;\n         aqt install-qt --outputdir $WIRESHARK_BASE_DIR/Qt mac desktop $MACOS_QT_VERSION clang_64 --modules qtmultimedia --timeout 10 ;\n       fi\n     - export CMAKE_PREFIX_PATH=\"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos\"\n",
