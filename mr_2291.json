{
  "id": 91020706,
  "iid": 2291,
  "project_id": 7898047,
  "title": "ptvcursor: Fix crash with deeply nested subtrees",
  "description": "If the proto tree is more than 8 levels deep, the subtree_lvl array\nlength is extended, by allocating a new area and copying everything into\nthat new area. However the old array length wasn't calculated correctly,\nso only part of the subtree_lvl array was copied, causing a crash after\ntwo ptvcursor_pop_subtree() calls.",
  "state": "merged",
