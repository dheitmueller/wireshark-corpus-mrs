      "diff": "@@ -5232,14 +5232,20 @@ static struct profile *profile_load(wmem_allocator_t *allocator, const char *pat\n \t{\n \t\tprofile = profile_new(allocator);\n \t\tif (!epl_eds_load(profile, path))\n+\t\t{\n \t\t\tprofile_del(profile);\n+\t\t\tprofile = NULL;\n+\t\t}\n \t}\n \n \telse if (g_str_has_suffix(path, \".xdd\") || g_str_has_suffix(path, \".xdc\"))\n \t{\n \t\tprofile = profile_new(allocator);\n \t\tif (!epl_xdd_load(profile, path))\n+\t\t{\n \t\t\tprofile_del(profile);\n+\t\t\tprofile = NULL;\n+\t\t}\n \t}\n \n \tif (!profile)\n",
