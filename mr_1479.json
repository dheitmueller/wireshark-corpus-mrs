      "notes": [
        {
          "id": 474196314,
          "type": "DiscussionNote",
          "body": "@tuexen: The error is\n\n    ERROR: Please edit your merge request and make sure the setting\n        ✅ Allow commits from members who can merge to the target branch\n    is checked so that maintainers can rebase your change and make minor edits.\n\nThere's a checkbox somewhere that you can check to change that.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2020-12-27T18:18:57.670Z",
          "updated_at": "2020-12-27T18:46:48.024Z",
          "system": false,
          "noteable_id": 83015124,
