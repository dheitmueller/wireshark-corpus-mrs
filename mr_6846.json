      "diff": "@@ -6,3 +6,4 @@\n .gitignore                  export-ignore\n .gitreview                  export-ignore\n tools/make-version.pl       export-subst\n+packaging/source/git-export-release.sh.in export-subst\n",
      "collapsed": false,
