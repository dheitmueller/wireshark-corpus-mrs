  "changes_data": [
    {
      "diff": "@@ -0,0 +1,52 @@\n+#!/bin/bash\n+# SPDX-License-Identifier: GPL-2.0-or-later\n+#\n+# Check if PNGs in a commit can be compressed.\n+#\n+# Manual: invoke with a commit ID, e.g. `tools/pre-commit HEAD~`; relative paths\n+# work if you start inside the tree.\n+\n+COMMIT_IDS=HEAD\n+[ $# -gt 0 ] && COMMIT_IDS=\"$*\"\n+\n+UNAME=$(uname -a)\n+\n+case \"$UNAME\" in\n+    *\\ Msys)\n+        pyvar=\"pythonw.exe\"\n+        ;;\n+    *)\n+        pyvar=\"python3\"\n+        ;;\n+esac\n+\n+PYBIN=\"${WS_GITHOOK_PYTHON:-$pyvar}\"\n+\n+# Establish absolute tools directory\n+TOPDIR=\"$(git rev-parse --show-toplevel)\"\n+TOOLS_DIR=\"${TOPDIR}/tools\"\n+\n+# Always start in the root directory of the source tree, this allows for\n+# invocations via relative paths (such as ../tools/pre-commit):\n+if ! cd \"$TOPDIR\"; then\n+    echo \"Can't change to the top-level source directory.\"\n+    exit 1\n+fi\n+\n+compress_pngs=\"${TOOLS_DIR}/compress-pngs.py\"\n+exit_status=0\n+\n+for COMMIT_ID in $COMMIT_IDS; do\n+    PNG_FILES=()\n+    while read -r line; do\n+        PNG_FILES+=(\"$line\");\n+    done < <(git diff-index --cached --name-status \"$COMMIT_ID\" | grep -v \"^D\" | cut -f2 | grep \"\\\\.png$\")\n+\n+    if [ -n \"${PNG_FILES}\" ]; then\n+        \"$PYBIN\" \"$compress_pngs\" \"${PNG_FILES[@]}\"\n+    fi\n+\n+    git diff --exit-code || exit_status=1\n+done\n+\n+exit $exit_status\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "tools/check_pngs.sh",
      "old_path": "tools/check_pngs.sh",
      "a_mode": "0",
      "b_mode": "100755",
      "new_file": true,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -844,6 +844,9 @@ Commit Check:\n     - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/validate-commit ./tools/validate-commit.py $( git log --max-count=$NUM_COMMITS --pretty=format:%h $CI_MERGE_REQUEST_SOURCE_BRANCH_SHA ) || EXIT_CODE=1\n     - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/checklicenses ./tools/checklicenses.py || EXIT_CODE=1\n     - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/check_help_urls ./tools/check_help_urls.py || EXIT_CODE=1\n+    # Report this failure, but don't fail the job for now. Not all developers\n+    # might have access to all the PNG compression tools.\n+    - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/check_pngs ./tools/check_pngs.sh \"${CI_MERGE_REQUEST_SOURCE_BRANCH_SHA}~${NUM_COMMITS}\" || echo 'ℹ️ This merge request includes PNGs that can be made smaller with lossless compression. Please run tools/compress-pngs.py if possible.'\n     - exit $EXIT_CODE\n   artifacts:\n     when: always\n",
