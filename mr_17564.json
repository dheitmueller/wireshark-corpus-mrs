      "resolvable": false,
      "notes": [
        {
          "id": 2147239492,
          "type": null,
          "body": "I'm looking at Schneider's UMAS protocol, used on their 'new' PLC M580, M340, Quantums (With Unity Firmware) and smaller M221 ranges. It's messages get encapsulated in a Modbus packet with function code 0x5A.\n\nIt is a reserved function code in the Modbus spec.\n\nIt ends up something like this.\n\n![image](/uploads/ed8cc4bc68db7b9fe9e02e91a3cfb8dd/image.png){width=606 height=254}",
          "author": {
            "id": 6920520,
            "username": "hutcheb",
            "public_email": "",
            "name": "hutcheb",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9505bdff9c72bd8a3ac7e31bd6745c9a72fb916e26bedabf2540445a0e82131a?s=80&d=identicon",
