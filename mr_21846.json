    {
      "id": "e4d0d8ef0686d9382a0a892d33ad336d32697437",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 2817372801,
          "type": "DiffNote",
          "body": "This causes the MSYS2 builds to fail: https://github.com/wireshark/wireshark/actions/runs/18467248166/job/52612122350\n\nThe Microsoft documentation suggests that `#include <shobjidl.h>` (which includes `shobjidl_core.h`) be included instead:\nhttps://learn.microsoft.com/en-us/windows/win32/api/shobjidl_core/nf-shobjidl_core-setcurrentprocessexplicitappusermodelid\n\nMSYS2 appears to include a `shobjidl.h` include file, just not the `_core` one.\nhttps://packages.msys2.org/packages/mingw-w64-x86_64-headers-git",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
