          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 20892,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "ae81eb0376b6ce660fd7e20e1fc3b577ea0eb1ff",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2734294136,
          "type": null,
          "body": "I don't think those of us who initially reviewed it noticed that the boolean was already defined, just not connected to a preference (but fixed depending on if a decompression library was compiled in.)",
