    {
      "id": "3598698eb1dac5170f66c110dad6a38a29130301",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2692405442,
          "type": null,
          "body": "Just want to know, what is the case where this needs to be disabled?",
