      "diff": "@@ -36,7 +36,7 @@ Build-Depends: asciidoctor,\n                libsnappy-dev,\n                libspandsp-dev,\n                libspeexdsp-dev,\n-               libssh-gcrypt-dev,\n+               libssh-dev (>= 0.11.1-1) | libssh-gcrypt-dev,\n                libsystemd-dev,\n                libxkbcommon-dev,\n                libxml2-dev,\n",
