  "discussions_data": [
    {
      "id": "f75d37984777f376cf695ca0f1a1cd10ac764917",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3586978446,
          "type": null,
          "body": "`C:\\Qt` is where the official Qt installer installs Qt by default on Windows. It's possible that someone might install it under `C:\\Development`, particularly if using `aqtinstall` (the WSDG does recommend `C:\\Development\\Qt` for aqtinstall, but there is a reason why the documentation has what it has currently. There's also a second place in the WSDG that references `C:\\Qt\\6.10.3`, so it wouldn't be consistent to change it in only one place. That other place (https://www.wireshark.org/docs/wsdg_html_chunked/ChLibsQt.html) also seems to link only to the Qt official installer, even though the guide otherwise recommends aqtinstall first.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
