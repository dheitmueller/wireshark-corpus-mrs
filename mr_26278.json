      "diff": "@@ -2928,7 +2928,8 @@ extcap_load_interface_list(void)\n                     .output = iface_info->output,\n                     .data = NULL,\n                 };\n-                prefs_registered = cb_preference(cb_info);\n+                if (cb_preference(cb_info))\n+                    prefs_registered = true;\n             }\n         }\n         extcap_free_extcaps_info_array(infos, count);\n",
