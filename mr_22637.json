    {
      "id": "efa00fff8ffd7d7312fd0655fda6a6a07d58cd69",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 2952948808,
          "type": "DiscussionNote",
          "body": "My apologies for the delay in reviewing this, but this should not have been merged. \n\nIn the master branch I need to be able to say \"Hey, try this new version of Wireshark\" and \"Hey, try this new version of Stratoshark\" at different times and with different release cadences, at least for the time being. This ties the versions together in a way that I was specifically trying to avoid. This means that the automated build versions are messy, but IMHO avoiding that isn't nearly as important as the ability to test new features in each application separately.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1788740758",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2025-12-14T22:37:52.167Z",
          "updated_at": "2025-12-15T11:40:38.954Z",
          "system": false,
          "noteable_id": 438506794,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 22637,
          "commands_changes": {}
        },
        {
          "id": 2953972374,
          "type": "DiscussionNote",
          "body": "I tried having this discussed at https://lists.wireshark.org/archives/wireshark-dev/202511/msg00017.html , maybe we can continue there for broader audience.\n\nThis change does not prevent bumping the version of Stratoshark in master, just please use 0.10.0, 0.11.0, etc. until you are comfortable with syncing the full version with Wireshark as we discussed on the same thread.",
          "author": {
