      "notes": [
        {
          "id": 2966060968,
          "type": "DiscussionNote",
          "body": "I'm forcing the console colour to red before checking for whitespace errors.  It then gets reset inside, so with 3 separate whitespace errors it now appears as:\n\n![image](/uploads/6a535410ccdfe719e0f42ceb53de727b/image.png){width=515 height=107}\n\nI think this makes it more obvious that these errors are causing the overall pipeline failure.  Is this worth it?",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
