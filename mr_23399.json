  "changes_data": [
    {
      "diff": "@@ -5569,6 +5569,26 @@ dissect_btle(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void *data)\n         }\n     }\n \n+    /* Look up connection_info for CRC validation */\n+    if (access_address != ACCESS_ADDRESS_ADVERTISING) {\n+        wmem_tree_key_t key[4];\n+        wmem_tree_t *wmem_tree;\n+\n+        key[0].length = 1;\n+        key[0].key = &interface_id;\n+        key[1].length = 1;\n+        key[1].key = &adapter_id;\n+        key[2].length = 1;\n+        key[2].key = &access_address;\n+        key[3].length = 0;\n+        key[3].key = NULL;\n+\n+        wmem_tree = (wmem_tree_t *) wmem_tree_lookup32_array(connection_info_tree, key);\n+        if (wmem_tree) {\n+            connection_info = (connection_info_t *) wmem_tree_lookup32_le(wmem_tree, pinfo->num);\n+        }\n+    }\n+\n     offset += dissect_crc(tvb,\n                           btle_tree,\n                           offset,\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-btle.c",
      "old_path": "epan/dissectors/packet-btle.c",
