      "notes": [
        {
          "id": 2276330994,
          "type": "DiscussionNote",
          "body": "Is there any reason why the iBeacon dissector isn't registered to Apple's company ID (0x004c) in \"btcommon.eir_ad.manufacturer_company_id\" instead of just being added for Decode As? The iBeacon spec appears to say that using 0x004c as the Company ID is mandatory. (Or are only some Bluetooth Advertising Data packets with Apple's company ID iBeacon?)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-12-29T22:44:54.526Z",
          "updated_at": "2024-12-30T15:42:02.452Z",
          "system": false,
