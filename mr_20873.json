          "imported": false,
          "imported_from": "none",
          "noteable_iid": 20873,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "3fdc65421790e6e1f77ae828b42825c1aa7c7f3e",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2693988951,
          "type": null,
          "body": "I do appreciate the clarification and I was going to suggest potentially \"sanitizing\" at the UI layer (like negating key presses of invalid characters), because I prefer UIs not \"automatically adjust user input without their knowledge\" but it looks like there is already some sanitation done so this change looks fine to me.\nI would just squash the typo commit into the other.  Good catch, but not really worth a separate commit as it's \"in the area\".",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
