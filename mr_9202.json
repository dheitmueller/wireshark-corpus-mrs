  "changes_data": [
    {
      "diff": "@@ -119,7 +119,12 @@ expr(X) ::= TEST_NOT(T) expr(Y).\n }\n \n /* Any expression inside parens is simply that expression */\n-expr(X) ::= LPAREN expr(Y) RPAREN.  { X = Y; }\n+expr(X) ::= LPAREN(L) expr(Y) RPAREN(R).\n+{\n+    X = Y;\n+    df_loc_t loc = stnode_merge_location(L, Y, R, (stnode_t *)NULL);\n+    stnode_set_location(X, loc);\n+}\n \n /* Entities, or things that can be compared/tested/checked */\n atom(A) ::= STRING(S).      { A = S; }\n@@ -281,9 +286,11 @@ arithmetic_expr(T) ::= arithmetic_expr(F) PERCENT(O) arithmetic_expr(M).\n     sttype_oper_set2(T, STNODE_OP_MODULO, F, M);\n }\n \n-arithmetic_expr(T) ::= LBRACE arithmetic_expr(F) RBRACE.\n+arithmetic_expr(T) ::= LBRACE(L) arithmetic_expr(F) RBRACE(R).\n {\n     T = F;\n+    df_loc_t loc = stnode_merge_location(L, F, R, (stnode_t *)NULL);\n+    stnode_set_location(T, loc);\n }\n \n /* Relational tests */\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dfilter/grammar.lemon",
      "old_path": "epan/dfilter/grammar.lemon",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -250,6 +250,12 @@ stnode_location(stnode_t *node)\n \treturn node->location;\n }\n \n+void\n+stnode_set_location(stnode_t *node, df_loc_t loc)\n+{\n+\tnode->location = loc;\n+}\n+\n /* Finds the first and last location from a set and creates\n  * a new location from start of first (col_start) to end of\n  * last (col_start + col_len). */\n",
      "collapsed": false,
      "too_large": false,
