{
  "id": 87951577,
  "iid": 2027,
  "project_id": 7898047,
  "title": "TCP: RTO calculation relies on a wrong reference packet",
  "description": "    TCP: RTO calculation relies on a wrong reference packet\n    \n    RTO was calculated on the last packet increasing the nextseq,\n    which ended on not identifying the original right packet later\n    retransmitted. We now consider the eldest unacked packet as\n    being likely to be the one to be retransmitted, and it gives a\n    much more accurate RTO value. Closes #12259.",
  "state": "merged",
  "created_at": "2021-02-09T19:06:20.778Z",
  "updated_at": "2021-05-03T05:34:09.391Z",
