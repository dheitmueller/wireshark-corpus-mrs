      "notes": [
        {
          "id": 420514261,
          "type": "DiscussionNote",
          "body": "If \"Help -> About Wireshark -> Folders\" is to include the current profile, then shouldn't \"tshark -G folders\" be updated to also include it?  Without any options, it would just show the \"Default\" profile directory, but if run as \"tshark -C foo -G folders\", then it would show the location of the \"foo\" profile.",
          "author": {
            "id": 6624779,
            "username": "cjmaynard",
            "public_email": "",
            "name": "Christopher Maynard",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6624779/avatar.png?v=1789063434",
            "web_url": "https://gitlab.com/cjmaynard"
          },
          "created_at": "2020-09-29T13:11:17.350Z",
          "updated_at": "2020-09-29T15:12:26.657Z",
          "system": false,
          "noteable_id": 72444164,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
