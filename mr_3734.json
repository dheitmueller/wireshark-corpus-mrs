    {
      "id": "e7a4681f7e22fc0a34f454469e539a7a26f7f1e3",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 634799172,
          "type": null,
          "body": "Should the MR remove the limit instead?",
          "author": {
            "id": 6878858,
            "username": "LarsVoelker",
            "public_email": "",
            "name": "Dr. Lars Völker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/cccf2084a0438673e9e09f07ed0a5035f6e8815d3d5d888db0023a757c8dce8c?s=80&d=identicon",
            "web_url": "https://gitlab.com/LarsVoelker"
          },
          "created_at": "2021-07-25T12:29:08.391Z",
          "updated_at": "2021-07-25T12:29:08.391Z",
          "system": false,
          "noteable_id": 109477081,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
