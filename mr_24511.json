      "diff": "@@ -675,19 +675,23 @@ Windows Arm64 Package:\n     expire_in: 3 days\n \n macOS Universal Package:\n+  extends: .build-macos\n   stage: build\n   rules: !reference [.if-w-w-only-merged]\n   variables:\n     CODE_SIGN_IDENTITY: \"Wireshark Foundation\"\n-    WIRESHARK_BASE_DIR: \"$CI_PROJECT_DIR/../wireshark-third-party\"\n-    FALCO_PLUGIN_DIR: \"$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins\"\n   tags:\n     - wireshark-macos-universal-package\n   environment:\n     name: macos-package\n   retry: 1\n   before_script:\n-    - export PATH=\"/Library/Frameworks/Python.framework/Versions/3.13/bin:$PATH:$HOME/bin\"\n+    - brew --version\n+    - printf \"\\e[0Ksection_start:%s:brew_section[collapsed=true]\\r\\e[0KInstalling prerequisites\" \"$( date +%s)\"\n+    - brew install ccache cmake ninja python\n+    # - ./tools/macos-setup-brew.sh --install-optional --install-test-deps\n+    - printf \"\\e[0Ksection_end:%s:brew_section\\r\\e[0K\" \"$( date +%s)\"\n+    - export PATH=\"/opt/homebrew/bin:$PATH:$HOME/bin\"\n     - python3 -m venv --clear $CI_PROJECT_DIR/.venv\n     - source $CI_PROJECT_DIR/.venv/bin/activate\n     - pip3 install dmgbuild pyobjc-framework-Quartz pytest pytest-xdist\n",
