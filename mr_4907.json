      "diff": "@@ -304,6 +304,17 @@ relation_test(T) ::= entity(E) TEST_IN LBRACE set_node_list(L) RBRACE.\n \tsttype_test_set2(T, TEST_OP_IN, E, S);\n }\n \n+relation_test(T) ::= entity(E) TEST_NOT TEST_IN LBRACE set_node_list(L) RBRACE.\n+{\n+\tstnode_t *S = stnode_new(STTYPE_SET, L, NULL);\n+\n+\tstnode_t *R = stnode_new(STTYPE_TEST, NULL, NULL);\n+\tsttype_test_set2(R, TEST_OP_IN, E, S);\n+\n+\tT = stnode_new(STTYPE_TEST, NULL, NULL);\n+\tsttype_test_set2(T, TEST_OP_NOT, R, NULL);\n+}\n+\n set_node_list(L) ::= entity(E).\n {\n \tL = g_slist_append(NULL, E);\n",
