        {
          "id": 651265013,
          "type": "DiscussionNote",
          "body": "This seems to have broken the build for dissector plugins (including doc/plugins.example) because `target_link_libraries(hello epan)` no longer adds the glib include directory, so the build can't find `glib.h`.",
          "author": {
            "id": 620868,
            "username": "nicolas17",
            "public_email": "",
            "name": "Nicolás Alvarez",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/82fc14a8d756131416a2f108bbdd6009b2ba9df642adc22729ba38ca05c8cc00?s=80&d=identicon",
            "web_url": "https://gitlab.com/nicolas17"
          },
          "created_at": "2021-08-15T01:56:36.246Z",
          "updated_at": "2021-08-15T17:42:22.745Z",
