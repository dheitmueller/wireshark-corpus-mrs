    {
      "id": "557f8ec12fe936c74e808f88b166b37ef9b8db14",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3063960105,
          "type": null,
          "body": "The problem here is that, for some unknown reason, the commit whose commit message is validated is a merge commit, the subject of which is \"Merge branch '{branch1}' into '{branch2}'\", which can exceed 80 characters if the sum of the lengths of the two branch names is too large.\n\nThis is confusing as all hell, especially given that the merge commit doesn't, as far as I can tell, appear in the GitLab repository.\n\nSee #21004",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2026-02-06T10:49:46.793Z",
          "updated_at": "2026-02-06T10:49:46.793Z",
          "system": false,
          "noteable_id": 452536777,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 23523,
          "commands_changes": {}
        }
      ]
    }
  ],
  "changes_data": [
    {
      "diff": "@@ -109,20 +109,33 @@ def extract_subject(subject):\n \n \n def verify_body(body):\n+    print(\"Here's the body: %s\" % (body,))\n     git_cut_marker = '\\n# ------------------------ >8 ------------------------\\n'\n     cut_index = body.find(git_cut_marker)\n     if cut_index == -1:\n         cut_index = len(body) - 1\n     body = body[0:cut_index + 1]\n+    print(\"Here's the body after cutting: %s\" % (body,))\n \n     bodynocomments = re.sub('^#.*$', '', body, flags=re.MULTILINE)\n+    print(\"Here's the body without comments: %s\" % (body,))\n     old_lines = bodynocomments.splitlines(True)\n+    for index, value in enumerate(old_lines):\n+        print(f\"old_lines[{index}] = {value}\")\n     is_good = True\n     if len(old_lines) >= 2 and old_lines[1].strip():\n         print('ERROR: missing blank line after the first subject line.')\n         is_good = False\n     cleaned_subject = extract_subject(old_lines[0])\n-    if len(cleaned_subject) > 80:\n+    #\n+    # Don't require any \"Merge branch XXX into YYY\" message to fit in\n+    # 80 characters; those messages aren't written by the user, except\n+    # to the extent that they may have chosen the name of the \"from\"\n+    # branch, and it would *NOT* be obvious that you have to limit\n+    # the branch name in such a fashion as to ensure that the entire\n+    # message fit in 80 characters.\n+    #\n+    if cleaned_subject != f\"Merge branch '{CI_COMMIT_REF_NAME}' into '{CI_MERGE_REQUEST_TARGET_BRANCH_NAME}'\" and len(cleaned_subject) > 80:\n         # Note that this check is also invoked by the commit-msg hook.\n         print(\"Warning: the subject line '%s' is longer than 80 characters.\" % (cleaned_subject,))\n         is_good = False\n",
      "collapsed": false,
      "too_large": false,
