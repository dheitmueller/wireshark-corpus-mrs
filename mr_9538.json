      "diff": "@@ -298,6 +298,11 @@ frame_data_reset(frame_data *fdata)\n     g_slist_free(fdata->pfd);\n     fdata->pfd = NULL;\n   }\n+\n+  if (fdata->dependent_frames) {\n+    g_slist_free(fdata->dependent_frames);\n+    fdata->dependent_frames = NULL;\n+  }\n }\n \n void\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/frame_data.c",
      "old_path": "epan/frame_data.c",
      "a_mode": "100644",
