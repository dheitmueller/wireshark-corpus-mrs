    {
      "id": "9c793a9dabdf1fa0ba841faa22c786d1bda008ab",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1207098706,
          "type": null,
          "body": "Adding this check would make people think about whether the width field really was being set correctly.  I have a pending change that warns (only for FT_BOOLEAN) that the field_modifier indicates a wider mask - it currently sees 214 issues.\n\nThis change is fine I think.",
