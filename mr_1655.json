    {
      "id": "dc26bd15816028cfcfa80e43ca64ba691acc5863",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 483145774,
          "type": "DiscussionNote",
          "body": "> should we remove the ChToolsPatch section altogether? It dates back to a time when we used Subversion and received patches via email and Bugzilla and seems pretty vestigial now.\n\nIt says\n\n> The patch utility is used to merge a diff file into your own source tree. This tool is only needed, if you want to apply a patch (diff file) from someone else (probably from the developer mailing list) to try out in your own private source tree.\n> \n> It most cases you may not need the patch tool installed. Git should handle patches for you.\n\nIs \"here's a patch, try this with a private build\" still a thing, or is \"here's the most recent automated build, try that\" its replacement?  For non-developer users, the latter is far more likely to be usable than the former, at least on Windows and macOS, but for other OSes and for users willing to do builds, the former *could* get testing done before we commit the change - is that worth the effort?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-01-12T06:51:39.899Z",
          "updated_at": "2021-01-12T21:43:36.743Z",
          "system": false,
          "noteable_id": 84335636,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 1655,
          "commands_changes": {}
        },
        {
          "id": 483994392,
          "type": "DiscussionNote",
          "body": "I think \"here's a patch, try this with a private build\" has been replaced by \"check out this branch and try it in a private build.\" In cases where someone *does* send a diff file, people might be more likely to apply it with `git apply`.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789948913",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2021-01-12T21:43:36.691Z",
          "updated_at": "2021-01-12T21:43:36.691Z",
