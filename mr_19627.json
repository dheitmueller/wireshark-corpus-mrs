    {
      "id": "4959afe57d81db1dee5ed29b31296389f9b820e3",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2459733957,
          "type": null,
          "body": "> Though on some OSes (Windows?), \"not representable\" might be displayed instead of the 1957 date before the UN\\*X epoch.\n\nYes, Windows - MSVC's `localtime()` etc. don't support negative `time_t` values, unlike most if not all UN\\*Xes' `localtime()` etc..",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
