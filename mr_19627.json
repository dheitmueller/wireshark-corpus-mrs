        {
          "id": 2459644633,
          "type": "DiffNote",
          "body": "We probably don't want to cast to `int32_t` before casting to `time_t` here, as it will introduce a Y2K038 problem even on systems with 64 bit time_t. The constant should probably be 64 bit instead of possibly 32 bit unsigned so that the usual integer promotions occur.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
