    {
      "id": "6ce5c302e603a33ea5a83e2c1334a61ef29dbc1f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1071566105,
          "type": null,
          "body": "We should really have a set of APIs in which offsets are unsigned, so that we don't have to worry about offsets that come from packet data, and that are unsigned in the protocol, don't cause unexpected behavior if the uppermost bit is set.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
