    {
      "id": "56b6c530a2464d8527a94a5235672ea097750a65",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1009514310,
          "type": null,
          "body": "Please note: The perl script was invoked with the following:\n`perl  ./tools/make-sminmpec.pl` and would automatically write to `enterprises.tsv` in the script's parent directory.\n\nThe Python script is launched with:\n`python3  ./tools/make-sminmpec.py enterprises.tsv`\n\nThis makes the path for the output explicit, and enables running the script no matter its location.\n\n\nSimilarly, when reading from a file-based input, you'd also need to specify the destination as follows:\n```\nwget https://www.iana.org/assignments/enterprise-numbers/enterprise-numbers\npython3 ./tools/make-sminmpec.py enterprise-numbers enterprises.tsv\n```",
          "author": {
            "id": 3194989,
            "username": "moshekaplan",
            "public_email": "",
            "name": "Moshe Kaplan",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/3194989/avatar.png?v=1789864195",
            "web_url": "https://gitlab.com/moshekaplan"
          },
