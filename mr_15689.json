        {
          "id": 1913121851,
          "type": null,
          "body": "Is there any particular reason not to just replace the current CRC32 code in libwireshark with, for example, the Chromium version?  This has the advantage that you get a faster version on all platforms, including platforms that don't provide the Chromium fork of zlib, and the disadvantage that it doesn't pick up any bug fixes or other improvements from the Chromium code.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
