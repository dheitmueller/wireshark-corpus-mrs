  "changes_data": [
    {
      "diff": "@@ -174,6 +174,13 @@ The following features are new (or have been significantly updated) since versio\n \n * The \"Follow Stream\" dialog can now show delta times between turns and all packets and events.\n \n+// Lua 5.3 is supported. Different versions of Lua are not guaranteed to be\n+// compatible. If your Lua dissector does not work, check the Lua manual for\n+// incompatibilities and suggested workarounds:\n+// https://www.lua.org/manual/5.2/manual.html#8\n+// https://www.lua.org/manual/5.3/manual.html#8\n+// https://www.lua.org/manual/5.4/manual.html#8\n+\n === Removed Features and Support\n \n * The tshark `-G` option with no argument is deprecated and will be removed in\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/release-notes.adoc",
      "old_path": "doc/release-notes.adoc",
      "a_mode": "100644",
