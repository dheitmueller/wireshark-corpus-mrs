      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -35,13 +35,20 @@ local ignore = {\n     \"getfenv\",\n     \"io.gfind\",\n     \"setfenv\",\n+    \"loadstring\", -- call load with a string argument\n+    \"math.log10\", -- call math.log with second argument\n     \"math.mod\",\n+    \"module\",\n     \"newproxy\",\n+    \"package.loaders\", -- renamed package.searchers\n+    \"package.seeall\", -- used with module\n     \"string.gfind\",\n     \"table.foreach\",\n     \"table.foreachi\",\n     \"table.getn\",\n+    \"table.maxn\",\n     \"table.setn\",\n+    \"unpack\", -- replaced by table.unpack\n \n     -- in Lua 5.2+ only\n     \"bit32\",\n@@ -55,6 +62,14 @@ local ignore = {\n     \"table.pack\",\n     \"table.unpack\",\n \n+    -- removed in Lua 5.3\n+    \"math.atan2\", -- use math.atan with two arguments\n+    \"math.cosh\",\n+    \"math.sinh\",\n+    \"math.tanh\",\n+    \"math.pow\", -- use x^y\n+    \"math.frexp\",\n+    \"math.ldexp\", -- use x * 2.0^exp\n }\n \n \n",
      "collapsed": false,
