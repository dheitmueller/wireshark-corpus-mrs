  "changes_data": [
    {
      "diff": "@@ -46,6 +46,7 @@ static dissector_handle_t ipv4_handle;\n static dissector_handle_t ipv6_handle;\n static dissector_handle_t non_ip_data_handle;\n static dissector_handle_t ethernet_handle;\n+static dissector_handle_t nas_5gs_handle;\n \n /* Forward declaration */\n static void dissect_nas_eps_esm_msg(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, int offset);\n@@ -6871,6 +6872,17 @@ dissect_nas_eps_plain(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void*\n              */\n             dissect_nas_eps_emm_msg(tvb, pinfo, nas_eps_tree, offset, TRUE);\n             break;\n+        case 14:\n+            /* When the PD is set to \"extension of the PD to one octet length\", the first octet of a\n+             * standard L3 message contains the extended protocol discriminator (EPD) information element\n+             * as specified in clause 11.2.3.1.1A.\n+             */\n+            if (nas_5gs_handle) {\n+                tvbuff_t *new_tvb = tvb_new_subset_remaining(tvb, offset);\n+                call_dissector(nas_5gs_handle, new_tvb, pinfo, nas_eps_tree);\n+                break;\n+            }\n+            goto unknown;\n         case 15:\n             /* Special conformance testing functions for User Equipment messages.\n              * Ref 3GPP TS 24.007 version 8.0.0 Release 8, Table 11.2: Protocol discriminator values\n@@ -6882,6 +6894,7 @@ dissect_nas_eps_plain(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void*\n             } /* else fall through default */\n         /* FALL THROUGH */\n         default:\n+        unknown:\n             proto_tree_add_expert_format(nas_eps_tree, pinfo, &ei_nas_eps_unknown_pd, tvb, offset, -1, \"Not a NAS EPS PD %u (%s)\",\n                                          pd, val_to_str_const(pd, protocol_discriminator_vals, \"Unknown\"));\n             break;\n@@ -7025,6 +7038,17 @@ dissect_nas_eps(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void* data\n              */\n             dissect_nas_eps_emm_msg(tvb, pinfo, nas_eps_tree, offset, TRUE);\n             break;\n+        case 14:\n+            /* When the PD is set to \"extension of the PD to one octet length\", the first octet of a\n+             * standard L3 message contains the extended protocol discriminator (EPD) information element\n+             * as specified in clause 11.2.3.1.1A.\n+             */\n+            if (nas_5gs_handle) {\n+                tvbuff_t *new_tvb = tvb_new_subset_remaining(tvb, offset);\n+                call_dissector(nas_5gs_handle, new_tvb, pinfo, nas_eps_tree);\n+                break;\n+            }\n+            goto unknown;\n         case 15:\n             /* Special conformance testing functions for User Equipment messages.\n              * Ref 3GPP TS 24.007 version 8.0.0 Release 8, Table 11.2: Protocol discriminator values\n@@ -7036,6 +7060,7 @@ dissect_nas_eps(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void* data\n             } /* else fall through default */\n         /* FALL THROUGH */\n         default:\n+        unknown:\n             proto_tree_add_expert_format(nas_eps_tree, pinfo, &ei_nas_eps_unknown_pd, tvb, offset, -1, \"Not a NAS EPS PD %u (%s)\",\n                              pd, val_to_str_const(pd, protocol_discriminator_vals, \"Unknown\"));\n             break;\n@@ -9056,6 +9081,7 @@ proto_reg_handoff_nas_eps(void)\n         ipv4_handle = find_dissector_add_dependency(\"ip\", proto_nas_eps);\n         ipv6_handle = find_dissector_add_dependency(\"ipv6\", proto_nas_eps);\n         ethernet_handle = find_dissector_add_dependency(\"eth_withoutfcs\", proto_nas_eps);\n+        nas_5gs_handle = find_dissector_add_dependency(\"nas-5gs\", proto_nas_eps);\n         initialized = TRUE;\n     }\n     if (g_nas_eps_non_ip_data_dissector[0] != '\\0') {\n",
