        {
          "id": 2851374479,
          "type": "DiffNote",
          "body": "This dissection function cannot be used straight chained from the TCP dissector. It does _not_ guaranteed to deliver stream content at PDU boundaries. See README.dissector section 2.7.1 Using tcp_dissect_pdus().",
          "author": {
            "id": 2398962,
            "username": "JaapKeuter",
            "public_email": "",
