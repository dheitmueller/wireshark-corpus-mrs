    {
      "id": "e26a138cd76418b552812c9fd42b6d1bb49bc9a0",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2153842603,
          "type": null,
          "body": "Absolute minimum bug fix would be to change WISUN_WSIE_NODE_ROLE_MASK value from 0x03 to 0x07. In that case, it doesn't address the deficit of not knowing the remaining bits and it's not worth fixing. The proper bug fix is to parse all the bits in the first octet of the NR-IE and at that point it doesn't make sense to leave the rest of the bits as reserved instead of parsing the LBATS Included field too.",
          "author": {
            "id": 6760709,
            "username": "jkcko",
            "public_email": "",
            "name": "James Ko",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6760709/avatar.png?v=1781020789",
