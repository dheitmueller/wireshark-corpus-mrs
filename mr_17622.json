    {
      "id": "0c99312f6d22a8c7108363e9211cffaafd8485b4",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2153361582,
          "type": null,
          "body": "Part bug fix, part change to NR-IE format.\nThe Node Role ID is has always been define as using 3-bits, not 2 that was used in the mask.\nOf course the currently defined IDs only use 2-bits while values above 3 are reserved.\nEnhancement is that the reserved bits should have been reported in the dissector and checked for zeros as well.\nI don't know if Wi-SUN Alliance members using wireshark can wait for the 4.5 release or not.",
          "author": {
            "id": 6760709,
            "username": "jkcko",
            "public_email": "",
            "name": "James Ko",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6760709/avatar.png?v=1781020789",
            "web_url": "https://gitlab.com/jkcko"
          },
          "created_at": "2024-10-10T19:46:45.347Z",
          "updated_at": "2024-10-10T19:46:45.347Z",
