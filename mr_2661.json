      "id": "0f2c4693acaf75f9840f6146d60a95424aef4dd9",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 548770758,
          "type": null,
          "body": "Note that this isn't a problem unique to this LINKTYPE_; there are, for example, several 802.11 link-layer types that begin with a metadata pseudo-header.\n\nThis might be an OK short-term fix, but we should eventually come up with a general solution for separating metadata and packet data.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-04-09T22:08:40.941Z",
          "updated_at": "2021-04-09T22:08:40.941Z",
          "system": false,
          "noteable_id": 95370867,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
