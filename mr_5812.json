        {
          "id": 805038196,
          "type": "DiscussionNote",
          "body": "What about using `2001:db8::1` and `2001:db8::2` from RFC 3849?",
          "author": {
            "id": 4753670,
            "username": "stigbjorlykke",
            "public_email": "",
            "name": "Stig Bjørlykke",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/905aafc6b50e246885f5ea9273a9dc4f22e2658b71f9a1b551b797082bec3f80?s=80&d=identicon",
            "web_url": "https://gitlab.com/stigbjorlykke"
          },
          "created_at": "2022-01-09T07:46:27.729Z",
          "updated_at": "2022-01-09T17:14:23.061Z",
          "system": false,
