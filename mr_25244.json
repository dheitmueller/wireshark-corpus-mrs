  "discussions_data": [
    {
      "id": "e21b46bb069c37236de8c35dbdc8d1ac31b17f29",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3423167152,
          "type": null,
          "body": "Isn't SpeexDSP listed as required in CMakeLists.txt if building Wireshark or Stratoshark?\n\nI don't think it needs to be required; I think it's only used by the same code that uses QtMultimedia, which is also optional. It's also possible that there might be some way to resample without speexdsp now; there are other audio resampling libraries, but they also might not be available on Fedora MingW either. Qt 6 might have some other methods too.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
