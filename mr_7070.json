      "diff": "@@ -1531,7 +1531,7 @@ Dot11DecryptDerivePmkFromMsk(const guint8 *msk, guint8 msk_len, int akm,\n     } else {\n         *pmk_len = 256 / 8;\n     }\n-    if (msk_len + *pmk_len < msk_len) {\n+    if ((guint8)(msk_len + *pmk_len) < msk_len) {\n         *pmk_len = 0;\n         return;\n     }\n",
