  "changes_data": [
    {
      "diff": "@@ -942,7 +942,9 @@ Clang + Code Checks:\n     - ninja checkAPI\n     - ninja shellcheck\n     - cd ..\n-    - pip3 install pyspellchecker\n+    - pip3 install pyspellchecker ruff\n+    # Run Ruff on '.' and Python3 scripts without .py extension because this is a very quick check.\n+    - ruff check . tools/idl2deb tools/asn2deb tools/idl2deb tools/pidl/wscript --extend-exclude tools/pkt-from-core.py --extend-exclude tools/WiresharkXML.py --extend-exclude tools/yacc.py --extend-exclude tools/ncp2222.py\n     - ./tools/check_spelling.py --no-wikipedia --comments --commits $NUM_COMMITS | tee spelling_check.txt\n     - ./tools/check_typed_item_calls.py --consecutive --label --mask --check-bitmask-fields --commits $NUM_COMMITS | tee item_calls_check.txt\n     - ./tools/check_tfs.py --check-value-strings --commits $NUM_COMMITS | tee tfs_check.txt\n",
