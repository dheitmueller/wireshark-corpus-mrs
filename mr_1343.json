  "changes_data": [
    {
      "diff": "@@ -11,6 +11,15 @@\n # https://hub.docker.com/r/wireshark/wireshark-opensuse-15.2-dev\n # https://hub.docker.com/r/wireshark/wireshark-ubuntu-dev\n \n+workflow:\n+  rules:\n+    # We create two tags per release, wireshark-X.Y.Z and vX.Y.Z. Skip the\n+    # one with the \"wireshark-\" prefix.\n+    - if: '$CI_COMMIT_TAG =~ /wireshark-.*/'\n+      when: never\n+    # XXX when: on_success doesn't work here.\n+    - if: '$CI'\n+\n .build: &build\n   stage: build\n   after_script:\n",
