    {
      "id": "e3e43c944466ac649872671b59d395a628f0a6b7",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1074507294,
          "type": null,
          "body": "I get this warning when building on Raspberry Pi:\n```\n../wiretap/5views.c: In function '_5views_dump':\n../wiretap/5views.c:394:39: error: comparison of integer expressions of different signedness: 'time_t' {aka 'const long int'} and 'unsigned int' [-Werror=sign-compare]\n  394 |  if (rec->ts.secs < 0 || rec->ts.secs > G_MAXUINT32) {\n      |                                       ^\ncc1: all warnings being treated as errors\n```",
          "author": {
            "id": 4753670,
            "username": "stigbjorlykke",
            "public_email": "",
            "name": "Stig Bjørlykke",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/905aafc6b50e246885f5ea9273a9dc4f22e2658b71f9a1b551b797082bec3f80?s=80&d=identicon",
            "web_url": "https://gitlab.com/stigbjorlykke"
          },
          "created_at": "2022-08-23T12:57:13.672Z",
          "updated_at": "2022-08-23T12:57:13.672Z",
          "system": false,
          "noteable_id": 171931080,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 7796,
          "commands_changes": {}
        }
      ]
    }
  ],
  "changes_data": [
    {
      "diff": "@@ -386,7 +386,16 @@ static gboolean _5views_dump(wtap_dumper *wdh,\n \tHeaderFrame.RecNb = GUINT32_TO_LE(1);\n \n \t/* record-dependent fields */\n-\tHeaderFrame.Utc = GUINT32_TO_LE(rec->ts.secs);\n+\t/*\n+\t * XXX - is the frame time signed, or unsigned?  If it's signed,\n+\t * we should check against G_MININT32 and G_MAXINT32 and make\n+\t * Utc a gint32.\n+\t */\n+\tif (rec->ts.secs < 0 || rec->ts.secs > G_MAXUINT32) {\n+\t\t*err = WTAP_ERR_TIME_STAMP_NOT_SUPPORTED;\n+\t\treturn FALSE;\n+\t}\n+\tHeaderFrame.Utc = GUINT32_TO_LE((guint32)rec->ts.secs);\n \tHeaderFrame.NanoSecondes = GUINT32_TO_LE(rec->ts.nsecs);\n \tHeaderFrame.RecSize = GUINT32_TO_LE(rec->rec_header.packet_header.len);\n \tHeaderFrame.RecInfo = GUINT32_TO_LE(0);\n",
