  "changes_data": [
    {
      "diff": "@@ -687,9 +687,11 @@ Commit Check:\n   variables:\n     GITLAB_REPO: \"$CI_MERGE_REQUEST_PROJECT_URL\"\n   script:\n-    # glab depends on a valid GITALB_TOKEN variable. It will fail when run under outside projects.\n-    - if ! command -V glab 2> /dev/null ; then (cd /tmp ; curl -JLO https://gitlab.com/gitlab-org/cli/-/releases/v1.34.0/downloads/glab_1.34.0_Linux_x86_64.deb ; dpkg --install /tmp/glab_1.34.0_Linux_x86_64.deb ) ; fi\n-    - glab auth status\n+    # Adding notes (comments) to a merge request depends on a valid GitLab CI_JOB_TOKEN\n+    # variable. Trying to do so will fail when run under outside projects until\n+    # https://gitlab.com/gitlab-org/gitlab/-/issues/464591 is fixed.\n+    - glab auth status || true\n+    - glab auth status 2>&1 | grep 'Logged in to gitlab.com as' > /dev/null || echo \"Unable to post merge request comments from $CI_PROJECT_PATH\"\n     - >\n       if [[ $NUM_COMMITS > 1 ]] ; then\n         MESSAGE=\"ℹ️ This merge request has more than one commit. Please squash any trivial ones:\n",
      "collapsed": false,
      "too_large": false,
