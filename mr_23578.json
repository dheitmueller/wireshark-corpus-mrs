    {
      "id": "572774f5b2707e7da55feaae07db802ac397adbc",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 3077194248,
          "type": "DiscussionNote",
          "body": "Why would we ever want to keep global plugins around when uninstalling Wireshark?  Doesn't that risk plugin incompatibility when upgrading to a new Wireshark version?  I think it's safer to just always remove them.\n\nAnd as for [icebear17](https://ask.wireshark.org/users/21028/icebear17/), this user should have just deployed the Lua script in the Personal Lua Plugins directory, not in the Global plugins directory.",
          "author": {
            "id": 6624779,
            "username": "cjmaynard",
            "public_email": "",
            "name": "Christopher Maynard",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6624779/avatar.png?v=1788529529",
            "web_url": "https://gitlab.com/cjmaynard"
          },
          "created_at": "2026-02-11T21:11:11.616Z",
          "updated_at": "2026-02-11T21:57:47.733Z",
          "system": false,
          "noteable_id": 454316996,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
