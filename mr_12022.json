      "diff": "@@ -11,7 +11,8 @@\n #define __OVERLAY_SCROLL_BAR_H__\n \n #include <QScrollBar>\n-#include <QProxyStyle>\n+\n+class QProxyStyle;\n \n class OverlayScrollBar : public QScrollBar\n {\n@@ -74,6 +75,10 @@ private:\n     int end_pos_;\n     QList<int> positions_;\n     int row_height_;\n+\n+#if QT_VERSION >= QT_VERSION_CHECK(6, 1, 0)\n+    void updateChildStyle();\n+#endif\n };\n \n #endif // __OVERLAY_SCROLL_BAR_H__\n",
