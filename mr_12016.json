    {
      "id": "53671e8174acc09f7745a6f89f49c73438c4add1",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1561849463,
          "type": "DiscussionNote",
          "body": "RFC 1613 says \"A separate TCP connection MUST be used for each X.25 virtual circuit\" for XOT, would it be better to link things to the X.25 VC filter rather than to the TCP conversation filters, etc., so that it would work on any old LAPB capture file someone might happen to have? (I realize that these days it's pretty much all XOT.)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2023-09-15T18:03:31.322Z",
          "updated_at": "2023-09-16T17:22:45.735Z",
          "system": false,
          "noteable_id": 249806478,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 12016,
          "commands_changes": {}
        },
        {
          "id": 1562291212,
          "type": "DiscussionNote",
          "body": "This is a great idea. For an SVC, the conversation would be all packets with a given LCN from the X.25 call request to the X.29 invitation to clear.\n\nI'll take some time to think through how to implement this in the context of the existing conversation following mechanism, and also see if I can produce a pcap with some LAPB encapsulated X.25/X.29 conversations.",
          "author": {
            "id": 16798213,
            "username": "pheller",
            "public_email": "",
            "name": "Phillip Heller",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/84929421ad319b76c750df695e3ff095d2ac1cbe85a6473422a27dc30d1944a6?s=80&d=identicon",
            "web_url": "https://gitlab.com/pheller"
          },
          "created_at": "2023-09-16T17:22:45.671Z",
          "updated_at": "2023-09-16T17:22:45.671Z",
