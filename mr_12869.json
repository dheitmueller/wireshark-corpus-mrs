    {
      "id": "aa07476f33d59a99604f6cc08ff9d6bfdc3b68df",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1625651225,
          "type": "DiffNote",
          "body": "So this is to address this case \" helps for captures like #17393 that don't have a HE field (and\nset the 5 GHz bit here, since there isn't a 6 GHz bit.)\".\nIf there is no HE or EHT header, this should be basic rate frames in 6G.\nIf we don't create new definition for this case, Keep PHDR_802_11_PHY_11G should be better.\nOnly if this frame uses HE rate, there is HE header and set PHDR_802_11_PHY_11AX.",
          "author": {
            "id": 14135780,
            "username": "WFA-achuang",
            "public_email": "",
            "name": "Albert Chuang",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/de830255c023f1c7bb7c5fa7c534c852bd15b0043d6a2ff18750f6c1c7bce62a?s=80&d=identicon",
