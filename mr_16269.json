      "resolved": true,
      "notes": [
        {
          "id": 1983125847,
          "type": "DiscussionNote",
          "body": "Should not we modify instead export_pdu_create_tags() so that it takes care of the padding? Teh tag length is really 19 bytes long, not 20 and the padding should be performed by the fonction building the exported PDU packet IMHO.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
            "web_url": "https://gitlab.com/pquantin"
          },
          "created_at": "2024-07-04T12:22:21.846Z",
          "updated_at": "2024-07-05T14:54:21.352Z",
          "system": false,
          "noteable_id": 312827990,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 20332936,
            "username": "nazardo",
            "public_email": "",
            "name": "Mauro Levra",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/20332936/avatar.png?v=1778573580",
            "web_url": "https://gitlab.com/nazardo"
          },
          "resolved_at": "2024-07-05T14:54:21.352Z",
