  "changes_data": [
    {
      "diff": "@@ -51,6 +51,7 @@ typedef struct {\n  */\n /* Use the same list for Global and personal dissabled protocols */\n static GList *disabled_protos;\n+static GHashTable* disabled_proto_names;\n /*\n  * List of enabled protocols (that are disabled by default)\n  * Use the same list for Global and personal files\n@@ -142,6 +143,16 @@ set_protos_list(GList *protos_list, bool enable)\n   }\n }\n \n+bool\n+check_if_in_dissabled_proto_list(const char* name)\n+{\n+  DISSECTOR_ASSERT_HINT(name, \"No name present\");\n+\n+  if (g_hash_table_lookup(disabled_proto_names, name) != NULL) {\n+    return true;\n+  }\n+  return false;\n+}\n /*\n  * Write out a list of protocols based on condition\n  *\n@@ -885,6 +896,16 @@ disabled_protos_free(void *p, void *user_data _U_)\n   g_free(p);\n }\n \n+static void\n+create_disabled_protos_hash_table(void* p, void* user_data _U_)\n+{\n+  protocol_def* pd = (protocol_def*)p;\n+  protocol_def *prot = g_new(protocol_def, 1);\n+  prot->name = g_strdup(pd->name);\n+  g_hash_table_insert(disabled_proto_names, prot->name, prot);\n+\n+}\n+\n /*\n  * Read the files that enable and disable protocols and heuristic\n  * dissectors.  Report errors through the UI.\n@@ -990,6 +1011,19 @@ read_enabled_and_disabled_lists(const char* app_env_var_prefix)\n     path = NULL;\n   }\n \n+  disabled_proto_names = g_hash_table_new_full(wmem_str_hash, g_str_equal, g_free, g_free);\n+  g_list_foreach(disabled_protos, create_disabled_protos_hash_table, NULL);\n+\n+}\n+\n+/*\n+ * Read the files that enable and disable protocols and heuristic\n+ * dissectors.  Report errors through the UI.\n+ */\n+void\n+enabled_and_disabled_protos(void)\n+{\n+\n   /*\n    * Enable/disable protocols and heuristic dissectors as per the\n    * contents of the files we just read.\n@@ -1060,6 +1094,7 @@ cleanup_enabled_and_disabled_lists(void)\n   g_list_free(disabled_heuristics);\n   g_list_foreach(disabled_protos, disabled_protos_free, NULL);\n   g_list_free(disabled_protos);\n+  g_hash_table_destroy(disabled_proto_names);\n }\n \n /*\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/disabled_protos.c",
