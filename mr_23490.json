      "diff": "@@ -115,6 +115,7 @@ endif\n override_dh_makeshlibs:\n \tfor package in $$(grep 'Package: lib.*[0-9]$$' debian/control  | cut -d' ' -f2); do \\\n \t\tlib=$${package%%[0-9]*};\\\n+\t\tlib=$${lib//-/_};\\\n \t\tmajor=$${package##*[a-z]}; \\\n \t\techo \"$$lib $$major $$package (= $(DEB_VERSION))\"  > debian/$$package.shlibs; \\\n \tdone\n",
