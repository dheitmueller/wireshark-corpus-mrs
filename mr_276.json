  "changes_data": [
    {
      "diff": "@@ -259,13 +259,20 @@ WSLUA_METHOD ByteArray_base64_decode(lua_State* L) {\n     ByteArray ba = checkByteArray(L,1);\n     ByteArray ba2;\n     gchar *data;\n-    gsize len;\n+    gsize len = ba->len;\n+\n+    if ((len % 4) != 0) {\n+        len += 4 - (len % 4);\n+    }\n \n     ba2 = g_byte_array_new();\n     if (ba->len > 1) {\n-        data = (gchar*)g_malloc(ba->len + 1);\n+        data = (gchar*)g_malloc(len + 1);\n         memcpy(data, ba->data, ba->len);\n-        data[ba->len] = '\\0';\n+        if (len > ba->len) {\n+            memcpy(data + ba->len, \"====\", len - ba->len);\n+        }\n+        data[len] = '\\0';\n \n         g_base64_decode_inplace(data, &len);\n         g_byte_array_append(ba2, data, (int)len);\n",
      "collapsed": false,
      "too_large": false,
