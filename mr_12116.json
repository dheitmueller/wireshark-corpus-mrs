      "diff": "@@ -892,7 +892,8 @@ capture_stat_start(capture_options *capture_opts)\n             }\n         }\n     } else {\n-        g_free(msg); /* XXX: should we display this to the user ? */\n+        ws_warning(\"%s\", msg);\n+        g_free(msg); /* XXX: should we display this to the user via the GUI? */\n     }\n     return sc;\n }\n",
