      "diff": "@@ -832,6 +832,8 @@ iostat_get_item_value(const io_stat_t *iot, io_stat_item_t *item, const char *fm\n             break;\n \n         case CALC_TYPE_LOAD:\n+            if (interval == 0)\n+                break;\n             ftype = proto_registrar_get_ftype(iot->hf_indexes[j]);\n             switch (ftype) {\n             case FT_RELATIVE_TIME:\n@@ -1281,7 +1283,7 @@ iostat_draw(void *arg)\n     t = 0;\n \n     if (interval == 0 || duration == 0) {\n-        num_rows = 0;\n+        num_rows = 1;\n     } else {\n         num_rows = (unsigned int)(duration/interval) + ((unsigned int)(duration%interval) > 0 ? 1 : 0);\n     }\n",
