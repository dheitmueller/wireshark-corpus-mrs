        {
          "id": 2883843658,
          "type": "DiscussionNote",
          "body": "So the \"original\" tpncp.dat is supplied and put in the data directory as part of the build/installation.  Shouldn't that also be modified to put tpncp.dat in a plugin directory in the first place? Because I think you're adversely affecting the startup time of Wireshark for all users that don't have an \"extra\" tpncp.dat file in the plugin folder.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2025-11-12T12:53:06.262Z",
          "updated_at": "2025-11-12T12:53:06.184Z",
          "system": false,
          "noteable_id": 431703176,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
