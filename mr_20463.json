    {
      "id": "73a107d3e285e6e9e3030d6b91dd1f41b76860b7",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2608719617,
          "type": null,
          "body": "I need some help with this. The build pipeline failed:\n\n```\nWarning: keep lines in the commit message under 80 characters.\nPlease rewrite your commit message to our standards, matching this format:\n    component: a very brief summary of the change\n    A commit message should start with a brief summary, followed by a single\n    blank line and an optional longer description. If the change is specific to\n    a single protocol, start the summary line with the abbreviated name of the\n    protocol and a colon.\n    Use paragraphs to improve readability. Limit each line to 80 characters.\nYou're pushing from a protected branch (master). You will probably\nhave to close this merge request and push from a different branch.\nERROR: Please edit your merge request and make sure the setting\n```\n\nIt seems, my commit message is not accepted. I am new to using git, so I am totally clueless on how to fix this. Please, can somebody tell my how to change the commit message with git.\n\nI am useng SVN for years, and in SVN commit messages cannot be changed by me (at least for those SVN repository, I am using).",
          "author": {
            "id": 14084315,
            "username": "Mario-Klebsch",
            "public_email": null,
            "name": "Mario-Klebsch",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/4e8dd3693021ec7d20a09fff315a23de686f6be0fe80aeaa3da09f58399b3838?s=80&d=identicon",
            "web_url": "https://gitlab.com/Mario-Klebsch"
          },
          "created_at": "2025-07-07T14:07:39.846Z",
          "updated_at": "2025-07-07T14:07:39.846Z",
