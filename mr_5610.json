      "notes": [
        {
          "id": 1408335202,
          "type": "DiscussionNote",
          "body": "32 bit Wireshark is useful on 64 bit systems due to Wireshark crashing after exceeding the 32 bit memory limit. If you instead run 64 bit Wireshark on a production server it can use up all the available memory and impact services running on that server.",
          "author": {
            "id": 9593368,
            "username": "chadaustin",
            "public_email": "",
            "name": "Chad Austin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/54427bc8e55b60c7337e0df724906215c791920a9d646821922e25bfbc2b11d6?s=80&d=identicon",
            "web_url": "https://gitlab.com/chadaustin"
          },
          "created_at": "2023-05-28T13:08:44.132Z",
          "updated_at": "2023-05-28T17:46:57.762Z",
