  "commits_data": [
    {
      "id": "52955b9c43a99942b332a8a2c0c2995608a539a1",
      "short_id": "52955b9c",
      "created_at": "2022-02-11T18:21:35.000+00:00",
      "parent_ids": [
        "0011bb6a4c628b14f706288f58a056b7378f3c53"
      ],
      "title": "Qt: highlight when search result is in the current packet.",
      "message": "Qt: highlight when search result is in the current packet.\n\nCalling setCurrentIndex with QItemSelectionModel::ClearAndSelect clears\nthe currentIndex, but not the selection, so it doesn't trigger\nselectionChanged. However, highlighting depends on the selectionChanged\nsignal, not currentChanged(), and it's not emitted if we're still on the\nsame packet/row as the current selection (which can occur if searching\nfor something that occurs in exactly one packet in a capture.)\n\nSince packet_list_select_row_from_data() cares about where the data\nis within the packet, it needs to clear the selection.  Fix #8269\n",
      "author_name": "John Thacker",
      "author_email": "johnthacker@gmail.com",
      "authored_date": "2022-02-09T22:32:59.000-05:00",
