{
  "id": 378871313,
  "iid": 19668,
  "project_id": 7898047,
  "title": "Fixed issue with self-closing XML tags in TS32.423 files",
  "description": "TS32.423 XML files could result in a segfault when `<initiator>` or `<target>` XML tags were self-closing, e.g. `<initiator type=\"UE\"/>` instead of `<initiator>{address == 1.2.3.4, port == 39222, transport == TCP}</initiator>`.\n\nThis merge request adds the ability to handle the self-closing tags.",
  "state": "merged",
