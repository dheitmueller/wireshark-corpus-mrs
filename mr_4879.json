    {
      "id": "bf7b891373ef6bf03cea50dfe86a1fe2dde07155",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 720081004,
          "type": null,
          "body": "In reply to @IvanNardi's comment from https://gitlab.com/wireshark/wireshark/-/issues/13881#note_676567768:\n> Very strange, indeed. `tls` doesn't match anything (even if `tls` is present in `frame.protocol`), but other tls filters (example `tls.handshake.type == 1`) are working as expected...\n>\n> Does anyone know/remember if a simple `tls` filter ever worked (i.e. if this issue is a regression or not)?\n\nThis was kind of done on purpose, you could use `tls.handshake` if you really wanted to match TLS handshake messages. TLS in QUIC does not have TLS records and there is no following application data, so that's why I thought it would make sense not to match with the \"tls\" filter. Follow TLS also does not work with QUIC.\n\nHowever if you want to change it (as is in done in this patch), I don't have anything against it.",
          "author": {
            "id": 2415432,
            "username": "Lekensteyn",
            "public_email": "",
            "name": "Peter Wu",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/efcf30db53f30b15e7c905ef37bd4dc44d87573bd92baf97cd707115d3fcd0c0?s=80&d=identicon",
            "web_url": "https://gitlab.com/Lekensteyn"
          },
          "created_at": "2021-11-01T15:26:49.218Z",
          "updated_at": "2021-11-01T15:26:49.218Z",
          "system": false,
          "noteable_id": 123450285,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 4879,
          "commands_changes": {}
        }
      ]
    }
  ],
  "changes_data": [
    {
      "diff": "@@ -834,6 +834,8 @@ dissect_tls13_handshake(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, voi\n     SslDecryptSession *ssl_session;\n     SslSession        *session;\n     gint               is_from_server;\n+    proto_item        *ti;\n+    proto_tree        *ssl_tree;\n     /**\n      * A value that uniquely identifies this fragment in this frame.\n      */\n@@ -862,8 +864,11 @@ dissect_tls13_handshake(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, voi\n     ssl_debug_printf(\"  conversation = %p, ssl_session = %p, from_server = %d\\n\",\n                      (void *)conversation, (void *)ssl_session, is_from_server);\n \n-    /* Directly add handshake message to the tree (without proto_tls item). */\n-    dissect_tls_handshake(tvb, pinfo, tree, 0,\n+    /* Add a proto_tls item to allow simple \"tls\" display filter */\n+    ti = proto_tree_add_item(tree, proto_tls, tvb, 0, -1, ENC_NA);\n+    ssl_tree = proto_item_add_subtree(ti, ett_tls);\n+\n+    dissect_tls_handshake(tvb, pinfo, ssl_tree, 0,\n                           tvb_reported_length(tvb), FALSE, record_id, pinfo->curr_layer_num, session,\n                           is_from_server, ssl_session, TLSV1DOT3_VERSION);\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-tls.c",
      "old_path": "epan/dissectors/packet-tls.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    }
