  "changes_data": [
    {
      "diff": "@@ -339,7 +339,8 @@ Requires(post):\tdesktop-file-utils\n #Requires:\tdejavu-sans-mono-fonts\n \n %description -n stratoshark\n-This package contains the Stratoshark GUI and desktop integration files.\n+This package contains the Stratoshark GUI and desktop integration files,\n+the strato text-mode variant, and necessary Stratoshark-related extcaps.\n %endif\n \n %prep\n@@ -589,6 +590,8 @@ update-mime-database %{_datadir}/mime &> /dev/null || :\n %exclude %{_bindir}/wireshark*\n %exclude %{_bindir}/dftest\n %exclude %{_bindir}/idl2wrs\n+# Don't pick up the stratoshark or strato binaries here\n+%exclude %{_bindir}/strato*\n %{_bindir}/*\n \n # This generates a warning because dumpcap is listed twice. That's\n@@ -622,6 +625,11 @@ update-mime-database %{_datadir}/mime &> /dev/null || :\n %{_libexecdir}/wireshark\n # Don't pick up the wireshark (GUI) man page here\n %exclude %{_mandir}/man1/wireshark.*\n+# Don't pick up the stratoshark related man pages here\n+%exclude %{_mandir}/man1/strato.*\n+%exclude %{_mandir}/man1/stratoshark.*\n+%exclude %{_mandir}/man1/falcodump.*\n+%exclude %{_mandir}/man1/sshdig.*\n %{_mandir}/man1/*\n %{_mandir}/man4/*\n \n@@ -664,7 +672,7 @@ update-mime-database %{_datadir}/mime &> /dev/null || :\n %{_datadir}/icons/hicolor/*/apps/*\n %{_datadir}/icons/hicolor/*/mimetypes/*\n %{_datadir}/mime/packages/org.wireshark.Stratoshark.xml\n-%{_bindir}/stratoshark\n+%{_bindir}/strato*\n %{_libexecdir}/stratoshark\n %{_mandir}/man1/stratoshark.*\n %{_mandir}/man1/falcodump.*\n",
