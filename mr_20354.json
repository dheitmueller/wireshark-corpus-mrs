      "diff": "@@ -6834,6 +6834,9 @@ new_field_info(proto_tree *tree, header_field_info *hfinfo, tvbuff_t *tvb,\n \tfi->hfinfo     = hfinfo;\n \tfi->start      = start;\n \tfi->start     += (tvb)?tvb_raw_offset(tvb):0;\n+\t/* add the data source tvbuff */\n+\tfi->ds_tvb = tvb ? tvb_get_ds_tvb(tvb) : NULL;\n+\n \t// If our start offset hasn't advanced after adding many items it probably\n \t// means we're in a large or infinite loop.\n \tif (fi->start > 0) {\n@@ -6860,9 +6863,6 @@ new_field_info(proto_tree *tree, header_field_info *hfinfo, tvbuff_t *tvb,\n \tfi->value = fvalue_new(fi->hfinfo->type);\n \tfi->rep        = NULL;\n \n-\t/* add the data source tvbuff */\n-\tfi->ds_tvb = tvb ? tvb_get_ds_tvb(tvb) : NULL;\n-\n \tfi->appendix_start  = 0;\n \tfi->appendix_length = 0;\n \n",
