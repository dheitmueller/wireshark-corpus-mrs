  "changes_data": [
    {
      "diff": "@@ -186,7 +186,15 @@ Editions are the replacement for syntax going forward and include a few grammar\n but we don't care about what it is. We just need to support the syntax generally, so we can use a strLit to simplify things. This also\n leaves things open in case it changes to a strLit in the future. For examples and explanations see: https://protobuf.dev/editions/overview/\n */\n-edition ::= PT_EDITION PT_ASSIGN PT_STRLIT PT_SEMICOLON.\n+edition ::= PT_EDITION PT_ASSIGN strLit(B) PT_SEMICOLON. {\n+    if (strcmp(B, \"2024\") == 0) {\n+        state->file->syntax_version = 3;\n+    } else if (strcmp(B, \"2023\") == 0) {\n+        state->file->syntax_version = 3;\n+    } else {\n+        pbl_parser_error(state, \"unsupported edition %s\", B);\n+    }\n+}\n \n protoBody(A) ::= . { A = pbl_create_node(state->file, CUR_LINENO, PBL_PACKAGE, NAME_TO_BE_SET); } /* create am empty package node */\n protoBody ::= protoBody import. /* default action is {A = B; } */\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/protobuf_lang_parser.lemon",
      "old_path": "epan/protobuf_lang_parser.lemon",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    }
