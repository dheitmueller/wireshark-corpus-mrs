    {
      "id": "0ebe3befd4201476ad51524659164a1ecff8ab4b",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 616442521,
          "type": null,
          "body": "I tried this first but it did not make sense, since this would add zeros in front up to 8, 16, 32, or 64bit.\n\nThe problem is that the signal has a flexible length and this is different per signal. Currently, I just set the field to uint64 but that would mean that you always have a hex value like this: 0x0000000000000001.\n\nThis would not make sense to the user, since the original signal could be for example 5bits.",
          "author": {
            "id": 6878858,
            "username": "LarsVoelker",
            "public_email": "",
            "name": "Dr. Lars Völker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/cccf2084a0438673e9e09f07ed0a5035f6e8815d3d5d888db0023a757c8dce8c?s=80&d=identicon",
            "web_url": "https://gitlab.com/LarsVoelker"
          },
          "created_at": "2021-07-01T13:00:16.217Z",
          "updated_at": "2021-07-01T13:00:16.217Z",
