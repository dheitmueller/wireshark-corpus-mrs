    {
      "id": "b07fb9db342ef7981e9772515c918c0a45c232c5",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1775238903,
          "type": null,
          "body": "We use \"The Wireshark developer community\" in our Windows Resource Compiler files (`resources/*.rc.in`), the NSIS packages and the WiX packages. We use \"Wireshark Development Team\" in `packaging/macosx/WiresharkInfo.plist.in`. We should probably choose one and apply it everywhere, possibly via a CMake variable. I'm partial to \"The Wireshark developer community\".",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789689689",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2024-02-15T17:24:19.737Z",
          "updated_at": "2024-02-15T17:24:19.737Z",
          "system": false,
          "noteable_id": 282200578,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 14407,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "3ae741f4e50ab119210beeccaac0d32f8a967819",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1775349215,
          "type": null,
          "body": "> I'm partial to \"The Wireshark developer community\".\n\n+1 - \"team\" sounds to me like a particular group of people whom you can name, but \"community\" sounds like \"anybody who contributes to the Wireshark code, documentation, etc.\", so it includes everyone from core developers to \"I saw this typo in a field name and here's a pull request\", all of whom *I* consider to be part of the developer community.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
