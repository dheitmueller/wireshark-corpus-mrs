    },
    {
      "diff": "@@ -658,8 +658,6 @@ macOS Universal Package:\n       fi\n     - export CMAKE_PREFIX_PATH=\"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos\"\n     - export PKG_CONFIG_PATH=\n-    # Temporary hack to work around loading Go plugins on x86_64\n-    - for falco_plugin in gcpaudit k8saudit ; do cp -f $FALCO_PLUGIN_DIR/lib${falco_plugin}.so $FALCO_PLUGIN_DIR/lib${falco_plugin}.so.disabled ; done\n     - mkdir build\n     - cd build\n     - ../tools/make-version.py --set-release --wireshark-version-file=wireshark_version.txt --stratoshark-version-file=stratoshark_version.txt ..\n@@ -670,7 +668,7 @@ macOS Universal Package:\n       -DCMAKE_OSX_DEPLOYMENT_TARGET=13.0\n       -DCMAKE_OSX_ARCHITECTURES=\"arm64;x86_64\"\n       -DBUILD_stratoshark=on\n-      -DFALCO_PLUGINS=\"$FALCO_PLUGIN_DIR/libcloudtrail.so;$FALCO_PLUGIN_DIR/libgcpaudit.so.disabled;$FALCO_PLUGIN_DIR/libk8saudit.so.disabled\"\n+      -DFALCO_PLUGINS=\"$FALCO_PLUGIN_DIR/libcloudtrail.so;$FALCO_PLUGIN_DIR/libgcpaudit.so;$FALCO_PLUGIN_DIR/libk8saudit.so\"\n       -DTEST_EXTRA_ARGS=\"--enable-stratoshark;--enable-release\"\n       ..\n     # Temporary hack to fix \"Package 'zlib', required by 'libscap', not found\"\n",
