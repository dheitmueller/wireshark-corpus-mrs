  "discussions_data": [
    {
      "id": "68c6d752fb7700e105c7efb298525c03eaa5eae6",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1208414121,
          "type": "DiscussionNote",
          "body": "This registers a new dissector table that has a single entry that is used as a default/fallback if there is no entry in the existing dissector table for the type (or the dissector is disabled, fails and returns zero.)\n\nIs that what you want to do, or do you want to take the existing GRE table and make it have the decode as capability?\n\nDecode As has been in a little bit of an odd state since 3.0; `label_func` is totally unused, because the GTK GUI used it but Qt never has. Maybe it should be removed at some point?",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2022-12-14T02:15:37.077Z",
          "updated_at": "2022-12-14T11:59:15.703Z",
          "system": false,
          "noteable_id": 193685964,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
