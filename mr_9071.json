        {
          "id": 1208991593,
          "type": "DiscussionNote",
          "body": "Yes \n\nbut actually there is \n`if (!dissector_try_uint_new(gre_dissector_table, type, next_tvb, pinfo, tree, TRUE, &gre_hdr_info))`\n\nit is possible to pass &gre_hdr_info with decode_as ?",
          "author": {
            "id": 279822,
            "username": "alagoutte",
            "public_email": "",
            "name": "Alexis La Goutte",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/a15cba6417f4d1723eb56add7099bcfd8df373dc520577958b33c37915ef231b?s=80&d=identicon",
            "web_url": "https://gitlab.com/alagoutte"
          },
          "created_at": "2022-12-14T11:59:15.644Z",
          "updated_at": "2022-12-14T11:59:15.644Z",
          "system": false,
          "noteable_id": 193685964,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
