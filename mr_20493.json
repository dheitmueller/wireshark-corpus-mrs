    },
    {
      "id": "e5e45e065e28e3776cc53a18fc78b059d912fe6f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2618402700,
          "type": null,
          "body": "`dot11decrypt.c` does not include `dot11decrypt_ws.h`. So the `DOT11DECRYPT_CONTEXT dot11decrypt_ctx;` definition is in a different translation unit than the `WS_DLL_PUBLIC DOT11DECRYPT_CONTEXT dot11decrypt_ctx;` declaration (with external linkage) in the header, so it's not the same global, and the one on the header is not found when linking.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-07-10T17:47:13.782Z",
          "updated_at": "2025-07-10T17:47:30.734Z",
          "system": false,
          "noteable_id": 398004364,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 20493,
          "commands_changes": {}
