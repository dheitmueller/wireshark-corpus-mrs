    {
      "id": "4f15520349c5457b923a2ac33265fd76ae76d8a0",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 2618409886,
          "type": "DiscussionNote",
          "body": "It might, rather than adding the include to the main library file, make sense to add a `dot11decrypt_ws.c` that only defines the global, if the idea is to preserve the fiction that the crypt library might be called with multiple contexts, or built without including the WS global context at all.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
