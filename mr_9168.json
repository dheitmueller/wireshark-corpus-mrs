    {
      "id": "a04fc2bb779bce2b7212c83c4c7bf0ba5305cb54",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1218426687,
          "type": "DiscussionNote",
          "body": "Should `configuration_init()` either\n\n1) strip off /extcap or \\\\extcap from the path when setting `progfile_dir`\n\nor\n\n2) save both the stripped and unstripped version?\n\nIf a program is being run from the build tree, it should construct path names for configuration files, plugins, etc. from the stripped version, but should use the unstripped version for the directory containing the executable (if that's ever needed).",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-12-22T06:59:16.311Z",
          "updated_at": "2022-12-22T18:18:07.929Z",
          "system": false,
          "noteable_id": 195835484,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789801377",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "resolved_at": "2022-12-22T19:16:13.793Z",
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 9168,
          "commands_changes": {}
        },
        {
          "id": 1219348765,
          "type": "DiscussionNote",
          "body": "It doesn't look like any of the extcaps do anything that requires the extcap path, so the first option should be sufficient. I'll update the MR to do that, but it should be easy to split things out into a `main_progfile_dir` and `progfile_dir` if needed.\n\nStripping off /extcap or \\extcap should fix #18429 as well.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789801377",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2022-12-22T18:18:07.839Z",
