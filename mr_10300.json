      "diff": "@@ -266,14 +266,14 @@\n      <item>\n       <widget class=\"QCheckBox\" name=\"automaticUpdateCheckBox\">\n        <property name=\"text\">\n-        <string>Automatic Update</string>\n+        <string>Automatic update</string>\n        </property>\n       </widget>\n      </item>\n      <item>\n       <widget class=\"QCheckBox\" name=\"enableLegendCheckBox\">\n        <property name=\"text\">\n-        <string>Enable Legend</string>\n+        <string>Enable legend</string>\n        </property>\n       </widget>\n      </item>\n",
