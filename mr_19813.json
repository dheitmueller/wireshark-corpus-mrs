  "changes_data": [
    {
      "diff": "@@ -5,12 +5,6 @@\n # To do:\n # - Add support for Windows and migrate win-setup.ps1 here.\n \n-if(APPLE)\n-  set(download_prefix \"https://dev-libs.wireshark.org/macos/packages\")\n-else()\n-  message(FATAL_ERROR \"No artifacts for this system\")\n-endif()\n-\n # It would be nice to be able to make this self-contained, e.g. by\n # extracting artifacts somewhere under CMAKE_BINARY_DIR, but CMake\n # doesn't allow source or build paths in INTERFACE_INCLUDE_DIRECTORIES.\n@@ -28,6 +22,14 @@ file(MAKE_DIRECTORY ${ARTIFACTS_DIR})\n list(APPEND CMAKE_PREFIX_PATH ${ARTIFACTS_DIR})\n set(manifest_file ${ARTIFACTS_DIR}/manifest.txt)\n \n+if(APPLE)\n+  set(download_prefix \"https://dev-libs.wireshark.org/macos/packages\")\n+  set(OSX_APP_LIBPREFIX_ARGS \"--libraries\" ${ARTIFACTS_DIR})\n+else()\n+  message(FATAL_ERROR \"No artifacts for this system\")\n+endif()\n+\n+\n set(artifacts)\n \n function(add_artifact archive_path sha256_hash)\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "cmake/modules/FetchArtifacts.cmake",
      "old_path": "cmake/modules/FetchArtifacts.cmake",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -3774,7 +3774,8 @@ if(ENABLE_APPLICATION_BUNDLE AND BUILD_wireshark)\n \tset_target_properties(wireshark_app_bundle PROPERTIES FOLDER \"Copy Tasks\")\n \tadd_custom_command(TARGET wireshark_app_bundle\n \t\tPOST_BUILD\n-\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\"\n+\t\t# OSX_APP_LIBPREFIX_ARGS is set in FetchArtifacts.cmake if WIRESHARK_BASE_DIR is set\n+\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\" ${OSX_APP_LIBPREFIX_ARGS}\n \t\tWORKING_DIRECTORY \"${CMAKE_BINARY_DIR}/run\"\n \t)\n \tadd_dependencies(wireshark_app_bundle ${PROGLIST} chmodbpf path_helper)\n@@ -3814,7 +3815,8 @@ if(ENABLE_APPLICATION_BUNDLE AND BUILD_stratoshark)\n \tset_target_properties(stratoshark_app_bundle PROPERTIES FOLDER \"Copy Tasks\")\n \tadd_custom_command(TARGET stratoshark_app_bundle\n \t\tPOST_BUILD\n-\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\" --bundle Stratoshark.app\n+\t\t# OSX_APP_LIBPREFIX_ARGS is set in FetchArtifacts.cmake if WIRESHARK_BASE_DIR is set\n+\t\tCOMMAND \"${CMAKE_BINARY_DIR}/packaging/macosx/osx-app.sh\" --bundle Stratoshark.app  ${OSX_APP_LIBPREFIX_ARGS}\n \t\tWORKING_DIRECTORY \"${CMAKE_BINARY_DIR}/run\"\n \t)\n \n",
