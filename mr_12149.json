      "notes": [
        {
          "id": 1565567114,
          "type": "DiscussionNote",
          "body": "epan/dissectors/packet-h450-ros.c is a generated file; that's why the check is failing - it's regenerating the ASN.1 dissectors, and finding that the regenerated packet-h450-ros.c doesn't match the checked-in packet-h450-ros.c.\n\nYou need to change one or more of the .cnf files in epan/dissectors/asn1/ros, and then build the \"asn1\" target to regenerate the ASN.1 dissectors.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
