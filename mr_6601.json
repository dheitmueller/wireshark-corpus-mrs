    {
      "id": "ad46a2bde74428c6c4c672fe7406aab499765df6",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 901630988,
          "type": "DiffNote",
          "body": "The problem is that this is supposed to be `val_to_str_ext()` and not `val_to_str_ext_const()`. The former uses the last parameter as a format string, whereas the latter uses the last parameter as a constant string to replace \n\nAll you need to do is remove the \"_const\" from the function, optionally changing the format string as you have done. You don't need to do snprintf.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
