      "resolvable": false,
      "notes": [
        {
          "id": 797773877,
          "type": null,
          "body": "Personally, I think I would lean towards just expecting people to use ISO-8601 and append with \"Z\" (or possibly the time zone offets), because time zones are tricky for the reasons above. That way we could just use the `iso8601_to_nstime` function to process it. I plan to push a proposal.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
