      ]
    },
    {
      "id": "fa799d6bafebbf0fb87f5762647eb26de1796ac4",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 904965937,
          "type": null,
          "body": "Thanks for the feedback! The cask command is not supported anymore with the current homebrew versions so you are encouraged to create a new tap. One way would be to directly download the file with curl/wget and then install from the local cask which does work - just tried it.\nI will see if I can change the request accordingly.",
          "author": {
            "id": 5892385,
            "username": "schm1tz1",
            "public_email": "",
            "name": "Roman Schmitz",
            "state": "active",
