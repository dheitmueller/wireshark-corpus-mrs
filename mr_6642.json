    {
      "id": "9934eaaaccd56b08efdf082a9d35816f2fcb8e95",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 904944742,
          "type": null,
          "body": "Thanks for working on this.\nCan you install from the homebrew-cask repository instead? The command should be something along the lines of\n \n`brew cask install https://raw.githubusercontent.com/Homebrew/homebrew-cask/c6dfe6baf1639998ba1707f68668cf8fa97bac9d/Casks/sparkle.rb`\n\nIn the mean time I've opened #18035 to note that we need to switch to the v2 API at some point.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789887783",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2022-04-07T19:32:22.622Z",
          "updated_at": "2022-04-07T19:32:22.622Z",
          "system": false,
          "noteable_id": 149305701,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
