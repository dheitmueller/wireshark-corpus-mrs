    {
      "id": "1b99f860571f81a59bb8adf51bb05b15b1d869c8",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1041218714,
          "type": null,
          "body": "This first commit 624b98561c5bfcc7483e323a1fa286a7ef951a7a is just a proof of what's going on, it might not be the appropriate answer to the problem.\n\nFirst, the Retransmission part is commented, to not exit too early and give the reassembly a chance. Otherwise, !2445 was also tested and it confirms that switching the Retransmission to Out-of-Order behaves well if we are not going to keep the comment at the end.\n\nAfter that, the _forward_ right boundary is aligned as it is done the same way when all is going fine. Tests are necessary, all I am sure is that it took more time than what it looks from the code.",
          "author": {
            "id": 6797213,
            "username": "eugene.adell",
            "public_email": "",
            "name": "Eugène Adell",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6797213/avatar.png?v=1789284959",
            "web_url": "https://gitlab.com/eugene.adell"
          },
          "created_at": "2022-07-27T20:48:24.290Z",
          "updated_at": "2022-07-27T21:17:17.322Z",
          "system": false,
          "noteable_id": 168194289,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
