  "discussions_data": [
    {
      "id": "fdb553547374a8bb030216943e1b2ca1c0e02d98",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1993116442,
          "type": null,
          "body": "Hi, I was working on !16372 at the same time.\n\nSome slight differences:\n\nI think we need to only set `tp->flags |= TRIED_RESOLVE_ADDRESS;` when `resolve` is true (this avoids marking something as resolve if we did the lookup while Hardware Name Resolution was disabled, then enable it.)\n\nI didn't use the MASK in order to give the ethers files precedent over the other sources, though that's probably a matter of debate.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
