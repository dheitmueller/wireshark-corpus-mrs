        },
        {
          "id": 1858261860,
          "type": "DiscussionNote",
          "body": "Forgot to mention one thing, the access_bpf was actually created via `dseditgroup -q -o create -i 101 -r \"$BPF_GROUP_NAME\" \"$BPF_GROUP\"`, but just not having the PrimaryGroupID attribute, and it returns none zero. So it will be tricky to use || to determine if the group created successfully or not.",
          "author": {
            "id": 20835423,
            "username": "shaozx",
            "public_email": "",
            "name": "shaozx",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/921a557156120f15a2e1e5bc1d40c16c73ac9553bae2c5754f328a3ac995547a?s=80&d=identicon",
            "web_url": "https://gitlab.com/shaozx"
          },
          "created_at": "2024-04-11T20:25:00.426Z",
          "updated_at": "2024-04-11T20:25:00.426Z",
          "system": false,
          "noteable_id": 294751863,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
