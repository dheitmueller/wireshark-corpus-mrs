          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 15209,
          "commands_changes": {}
        },
        {
          "id": 1858282554,
          "type": "DiscussionNote",
          "body": "> but just not having the PrimaryGroupID attribute\n\nWhich it probably shouldn't have, unless there's some account whose sole reason for existence is to run tcpdump/Wireshark/TShark/etc., so that it would make sense for access_bpf to *be* that user's primary group.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-04-11T20:41:47.324Z",
          "updated_at": "2024-04-11T20:41:47.324Z",
