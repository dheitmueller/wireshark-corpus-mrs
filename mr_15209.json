          "commands_changes": {}
        },
        {
          "id": 1858101590,
          "type": "DiscussionNote",
          "body": "@shaozx, if you run `dscl . -list /Groups PrimaryGroupID | sort -bnk2`, do groups 100 and 101 show up in the output?\n\nI suppose we could try creating the group with a sub-500 GID first, and if that fails let the system choose the GID, e.g.:\n\n    dseditgroup -q -o create -i $free_gid -r \"$BPF_GROUP_NAME\" \"$BPF_GROUP\" || dseditgroup -q -o create -r \"$BPF_GROUP_NAME\" \"$BPF_GROUP\"",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789689689",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2024-04-11T18:33:47.726Z",
          "updated_at": "2024-04-11T18:33:47.726Z",
          "system": false,
          "noteable_id": 294751863,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
