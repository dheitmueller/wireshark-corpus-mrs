      "diff": "@@ -118,6 +118,7 @@ then\n fi\n \n # Partial upgrades are unsupported.\n+# shellcheck disable=SC2086\n pacman --sync --refresh --sysupgrade --needed $ACTUAL_LIST $OPTIONS || exit 2\n \n if [ $ADDITIONAL -eq 0 ]\n",
      "collapsed": false,
