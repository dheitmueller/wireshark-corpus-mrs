    {
      "id": "737130f5550c88bb2100e11980f3aa78f0a465d5",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 809401110,
          "type": null,
          "body": "So @guyharris, what do you recommend? Is the workaround ok for the time being?",
          "author": {
            "id": 6878858,
            "username": "LarsVoelker",
            "public_email": "",
            "name": "Dr. Lars Völker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/cccf2084a0438673e9e09f07ed0a5035f6e8815d3d5d888db0023a757c8dce8c?s=80&d=identicon",
            "web_url": "https://gitlab.com/LarsVoelker"
          },
          "created_at": "2022-01-13T11:18:29.150Z",
          "updated_at": "2022-01-13T11:18:29.150Z",
          "system": false,
          "noteable_id": 134881578,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
