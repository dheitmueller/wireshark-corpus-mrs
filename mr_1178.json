            "id": 1311327,
            "username": "Teyut",
            "public_email": "",
            "name": "Teyut",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/5dad34f8e37dc161163e31160ad2ec27c1b00aebeef795b8658220ff64bd177d?s=80&d=identicon",
            "web_url": "https://gitlab.com/Teyut"
          },
          "created_at": "2020-12-09T18:00:38.641Z",
          "updated_at": "2020-12-09T18:00:48.897Z",
          "system": false,
          "noteable_id": 81043562,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
