      "diff": "@@ -31,11 +31,7 @@ ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))\n \tMAKEFLAGS += -j$(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))\n endif\n \n-ifeq ($(MAKE),ninja)\n-\tDH_BUILDSYSTEM = cmake+ninja\n-else\n-\tDH_BUILDSYSTEM = cmake\n-endif\n+DH_BUILDSYSTEM = cmake\n \n ifneq ($(filter pkg.wireshark.stratoshark,$(DEB_BUILD_PROFILES)),)\n     CONFIGURE_SWITCHES += -DBUILD_stratoshark=ON -DBUILD_falcodump=ON -DBUILD_dumpcalls=ON\n@@ -73,11 +69,7 @@ override_dh_dwz:\n \n override_dh_auto_install:\n \tdh_auto_install\n-ifeq ($(MAKE),ninja)\n-\tDESTDIR=$(CURDIR)/debian/tmp $(MAKE) -C $(CURDIR)/obj-* install-headers\n-else\n \t$(MAKE) DESTDIR=$(CURDIR)/debian/tmp -C $(CURDIR)/obj-* install-headers\n-endif\n \trm -rf $(CURDIR)/debian/tmp/usr/share/wireshark/COPYING\n \n HEADER_CHECK_FLAGS = $(shell pkg-config --cflags glib-2.0) \\\n",
