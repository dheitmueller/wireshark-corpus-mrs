      "diff": "@@ -24,11 +24,9 @@ jobs:\n         with:\n           ruby-version: '2.6'\n       - name: Install deps\n-        run: ./tools/macos-setup-brew.sh --install-optional\n+        run: ./tools/macos-setup-brew.sh --install-optional --install-doc-deps\n         env:\n           HOMEBREW_NO_AUTO_UPDATE: 1\n-      - name: Install asciidoctor\n-        run: gem install asciidoctor\n       - name: Mkdir\n         run: mkdir build\n       - name: Cmake\n",
