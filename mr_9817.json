          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 9817,
          "commands_changes": {}
        },
        {
          "id": 1402299054,
          "type": "DiscussionNote",
          "body": "I'm not sure that works in all cases.\n\nAlso, do you have some example packets?",
          "author": {
            "id": 5884947,
