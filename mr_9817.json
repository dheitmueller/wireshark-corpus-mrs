    {
      "id": "7db7ae7b09850eed7564c60d41bd29606c932586",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1402269453,
          "type": "DiscussionNote",
          "body": "I don't think this distinguishes between a LOCAL INFILE packet, and a text mode row packet that happens to begin with a NULL.\n\nI believe that they can be distinguished by checking the current state.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2023-05-23T17:13:42.623Z",
          "updated_at": "2023-05-23T17:43:53.814Z",
          "system": false,
          "noteable_id": 205856317,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
