        {
          "id": 1402322832,
          "type": "DiscussionNote",
          "body": "So you say that a packet with:\n```\n?? ?? ?? ?? fb ...\n```\nCan be a LOCAL INFILE packet or a row packet that begins with a NULL and that the state might be able to distinguish between the two?",
          "author": {
            "id": 5884947,
            "username": "dveeden",
            "public_email": "",
            "name": "Daniël van Eeden",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/00c536bb5304097eb409787c4a770e820db2a200d04130b8ca03cbcda0f526f7?s=80&d=identicon",
            "web_url": "https://gitlab.com/dveeden"
          },
          "created_at": "2023-05-23T18:04:28.975Z",
          "updated_at": "2023-05-23T18:04:28.975Z",
          "system": false,
          "noteable_id": 205856317,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
