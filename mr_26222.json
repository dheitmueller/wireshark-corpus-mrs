  "changes_data": [
    {
      "diff": "@@ -258,7 +258,7 @@ workflow:\n     - printf \"\\e[0Ksection_end:%s:brew_section\\r\\e[0K\" \"$( date +%s)\"\n     - python3 -m venv $CI_PROJECT_DIR/.venv\n     - source $CI_PROJECT_DIR/.venv/bin/activate\n-    - pip3 install pytest pytest-xdist\n+    - pip3 install --quiet jsonschema pytest pytest-xdist\n     - export PYTEST_ADDOPTS=\"--skip-missing-programs=dumpcap,rawshark --enable-stratoshark\"\n     - mkdir -p ccache\n     - ccache --show-stats\n@@ -690,7 +690,7 @@ macOS Universal Package:\n     - export PATH=\"/opt/homebrew/bin:$PATH:$HOME/bin\"\n     - python3 -m venv --clear $CI_PROJECT_DIR/.venv\n     - source $CI_PROJECT_DIR/.venv/bin/activate\n-    - pip3 install dmgbuild pyobjc-framework-Quartz pytest pytest-xdist\n+    - pip3 install --quiet dmgbuild jsonschema pyobjc-framework-Quartz pytest pytest-xdist\n   script:\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt\" ] ; then mkdir -p \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n@@ -1063,7 +1063,6 @@ Windows Build:\n       ..\n     - msbuild /verbosity:minimal /maxcpucount /property:Configuration=Debug Wireshark.slnx\n     - msbuild /verbosity:minimal /maxcpucount /property:Configuration=Debug test-programs.vcxproj\n-    # jsonschema gates the theme.jsonc schema tests in suite_theme; the runner image doesn't ship it.\n     - C:\\Windows\\py.exe -m pip install --quiet jsonschema\n     - C:\\Windows\\py.exe -m pytest --build-type=Debug --disable-gui --enable-stratoshark --junitxml=../windows_tests.xml\n   artifacts:\n",
