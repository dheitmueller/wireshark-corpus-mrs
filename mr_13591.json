      "diff": "@@ -54,6 +54,8 @@ typedef enum mac_lte_dl_retx {\n     dl_retx_unknown\n } mac_lte_dl_retx;\n \n+/* N.B. These error codes are too specific to one old implementation, */\n+/* all just shown as failures */\n typedef enum mac_lte_crc_status {\n     crc_fail = 0,\n     crc_success = 1,\n",
