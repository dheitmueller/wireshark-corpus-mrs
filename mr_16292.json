        {
          "id": 1986471692,
          "type": "DiscussionNote",
          "body": "Is this really needed? It looks like GLib 2.82.0 and later are going to define TRUE and FALSE as their C99 bool equivalents: https://gitlab.gnome.org/GNOME/glib/-/merge_requests/4001\n\nNever mind. It looks like it was reverted:\nhttps://gitlab.gnome.org/GNOME/glib/-/merge_requests/4089",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789689689",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2024-07-06T14:52:12.195Z",
          "updated_at": "2024-07-06T14:55:27.083Z",
