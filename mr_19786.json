  "changes_data": [
    {
      "diff": "@@ -238,8 +238,8 @@ workflow:\n     - mkdir build\n     - cd build\n   script:\n-    - export WIRESHARK_BASE_DIR=/tmp/wireshark-third-party\n-    - mkdir $WIRESHARK_BASE_DIR\n+    - export WIRESHARK_BASE_DIR=${CI_PROJECT_DIR}/../wireshark-third-party\n+    - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir $WIRESHARK_BASE_DIR ; fi\n     - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n     - cmake -G Ninja\n       -DENABLE_CCACHE=ON\n@@ -616,8 +616,8 @@ macOS Universal Package:\n     - wireshark-macos-arm-package\n   retry: 1\n   script:\n-    - export WIRESHARK_BASE_DIR=/tmp/wireshark-third-party\n-    - mkdir $WIRESHARK_BASE_DIR\n+    - export WIRESHARK_BASE_DIR=${CI_PROJECT_DIR}/../wireshark-third-party\n+    - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir $WIRESHARK_BASE_DIR ; fi\n     - export CMAKE_PREFIX_PATH=/usr/local/Qt-$MACOS_QT_VERSION\n     # Not needed for Falco libs 0.19?\n     - export CXXFLAGS=\"-isystem /usr/local/include/falcosecurity\"\n@@ -635,6 +635,9 @@ macOS Universal Package:\n       -DFALCO_PLUGINS=\"$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libcloudtrail.so;$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libgcpaudit.so\"\n       -DTEST_EXTRA_ARGS=--enable-release\n       ..\n+    # The Falco libs 0.20.0 package at https://dev-libs.wireshark.org/macos/packages/falcosecurity-libs/\n+    # is missing uthash.h.\n+    - ( cd $WIRESHARK_BASE_DIR/macos-universal-master/include ; curl -JLO https://raw.githubusercontent.com/troydhanson/uthash/refs/tags/v1.9.8/src/uthash.h )\n     - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n     - ninja\n     - for exe in $( find run/{Wire,Strato}shark.app/Contents/MacOS -type f ) ; do\n",
