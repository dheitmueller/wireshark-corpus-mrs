      "resolved": false,
      "notes": [
        {
          "id": 3831242753,
          "type": "DiffNote",
          "body": "Would it be safer to have `device->external_cap_args_settings = g_hash_table_ref(ret_args)` here, and `if (ret_args) g_hash_table_unref(ret_args)` in the destructor? (`ui/capture_opts` calls `g_hash_table_unref()` not `_destroy()`.)\n\nFor that matter, with this change does `device` need to store its own copy of `external_cap_args_settings` at all?",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
