      "short_id": "f4e67a1e",
      "created_at": "2025-06-08T11:55:41.000+02:00",
      "parent_ids": [
        "4dd7bbc0a0818c382a212f235ff80f9aa194f165"
      ],
      "title": "btatt: Make L2CAP context available inside ATT dissector",
      "message": "btatt: Make L2CAP context available inside ATT dissector\n\nSpecifically, the L2CAP CID, PSM and (eventually) MTU\nfor the current ATT bearer should now be accessible to the ATT dissector.\n",
      "author_name": "Brian Ejike",
      "author_email": "bcejike@gmail.com",
      "authored_date": "2025-06-01T22:22:54.000+01:00",
