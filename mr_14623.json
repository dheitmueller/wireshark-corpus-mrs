    {
      "id": "2f78d515ab432b75a95116984a8bc130a822b702",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1800003232,
          "type": "DiscussionNote",
          "body": "Are you shure you want no dissection if there's a version missmatch? In many cases at least some things may dissect properly with a different protocol version and may be better than no dissection until the dissector can be updated.- Perhaps just warn if the version is \"wrong\"?",
          "author": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
            "web_url": "https://gitlab.com/AndersBroman"
          },
          "created_at": "2024-03-04T16:50:16.287Z",
          "updated_at": "2024-03-05T14:30:48.161Z",
          "system": false,
          "noteable_id": 285899555,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
            "web_url": "https://gitlab.com/AndersBroman"
          },
          "resolved_at": "2024-03-05T14:30:48.161Z",
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 14623,
          "commands_changes": {}
        },
        {
          "id": 1801704015,
          "type": "DiscussionNote",
          "body": "You make a very sensible point, but the next version of the GSMTAP header can be completely different from what we have today in version 2. I think it would be risky to proceed with the decoding if the format is not known to the decoder: most probably it would output some garbage.",
          "author": {
            "id": 20332936,
            "username": "nazardo",
            "public_email": "",
            "name": "Mauro Levra",
            "state": "active",
            "locked": false,
