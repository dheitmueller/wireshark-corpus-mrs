      "notes": [
        {
          "id": 3210621087,
          "type": null,
          "body": "Since the libssh fix for that is in a dot-dot release, some OSes, such as Linux distributions, might update the library without rebuilding Wireshark or requiring a version update of the OS.  Should this do a run-time check using [`ssh_version`](https://api.libssh.org/stable/group__libssh__misc.html#gaf6fc133fcb6792f93b1197b15acf66b0)?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2026-03-31T19:17:20.284Z",
          "updated_at": "2026-03-31T19:17:20.284Z",
          "system": false,
