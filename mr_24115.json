    {
      "id": "6266cdaa5ecb8a2ec05439e44392546de4312444",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3210675330,
          "type": null,
          "body": "I don't think it's necessary:\n\nlibssh 0.12.1 reduces all the logging levels for that function to a low level. If Wireshark compiled for an earlier version and runs with a shared library 0.12.1 or later, libssh will just try to issue the logging command at the low level, Wireshark will keep it at a low level -> no problem.\n\nIf Wireshark is compiled for a version earlier than the version that introduced the bug, it will either unconditionally (compiled against earlier than 0.11.0) or with the correct condition (compilers against 0.11.0-0.11.3) lower the logging level and not display it by default.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-03-31T19:41:30.426Z",
          "updated_at": "2026-03-31T19:41:30.426Z",
          "system": false,
          "noteable_id": 468842003,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
