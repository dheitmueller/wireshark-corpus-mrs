      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -438,7 +438,7 @@ dfvm_dump_str(wmem_allocator_t *alloc, dfilter_t *df, gboolean print_references)\n \t\t\t\tbreak;\n \n \t\t\tcase DFVM_UNARY_MINUS:\n-\t\t\t\twmem_strbuf_append_printf(buf, \"%05d %s\\t\\t-%s -> %s\\n\",\n+\t\t\t\twmem_strbuf_append_printf(buf, \"%05d %s\\t-%s -> %s\\n\",\n \t\t\t\t\tid, opcode_str, arg1_str, arg2_str);\n \t\t\t\tbreak;\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dfilter/dfvm.c",
      "old_path": "epan/dfilter/dfvm.c",
