      "diff": "@@ -94,6 +94,7 @@\n #define OUI_ONOS            0xA42305    /* Open Networking Laboratory (ONOS) */\n #define OUI_3GPP2           0xCF0002    /* 3GPP2 */\n #define OUI_AVAYA_EXTREME2  0xD88466    /* Avaya Extreme Fabric */\n+#define OUI_ALCATEL_LUCENT  0xDC0856    /* Alcatel-Lucent */\n \n #endif\n \n",
