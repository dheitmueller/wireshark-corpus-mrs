    {
      "id": "14502754404dacb341c213e41cb657891fd3b44b",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1710150817,
          "type": null,
          "body": "I don't understand what problem you are trying to fix. While Wireshark USB dissection framework is not quite right, this change doesn't seem to push it into the right direction. Note that besides the all zero class/subclass/protocol triple there is also 0xEF/0x02/0x01 which is used when device uses Interface Association Descriptor. While IAD is probably exhibiting the same issue you try to fix (which I am not sure what is), the solution presented in this MR won't work for IADs.",
          "author": {
            "id": 6496125,
            "username": "desowin",
            "public_email": "",
            "name": "Tomasz Moń",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/e423f0a8da1eede7f89748e5142d6915e4a636399964d35d888ed95ca85e2b50?s=80&d=identicon",
            "web_url": "https://gitlab.com/desowin"
          },
          "created_at": "2023-12-30T06:48:52.328Z",
          "updated_at": "2023-12-30T06:48:52.328Z",
          "system": false,
          "noteable_id": 272655862,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
