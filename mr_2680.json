  "commits_data": [
    {
      "id": "1dc50f7433e21f1dbb7145c290d7d40ec96ec070",
      "short_id": "1dc50f74",
      "created_at": "2021-04-14T12:42:00.000-07:00",
      "parent_ids": [
        "cf46f0d74765ef4f49934a83de1c7eb70b73dbd9"
      ],
      "title": "CMake+CI: Colorize our compiler output.",
      "message": "CMake+CI: Colorize our compiler output.\n\nAs described at\n\nhttps://medium.com/@alasher/colored-c-compiler-output-with-ninja-clang-gcc-10bfe7f2b949\n\nboth Clang and gcc generate colorized output when they detect a\nterminal, but not for piped output, which is the case when using Ninja.\nAdd an ENABLE_COMPILER_COLOR_DIAGNOSTICS CMake option, and set it to\n\"ON\" when we're using Ninja.\n\nIn the merge-req:ubuntu-gcc-ctest and merge-req:ubuntu-clang-other-tests\nGitLab CI jobs, generate colorized HTML report artifacts using\nansi2html.\n",
      "author_name": "Gerald Combs",
      "author_email": "gerald@wireshark.org",
      "authored_date": "2021-04-12T12:13:02.000-07:00",
      "committer_name": "Gerald Combs",
      "committer_email": "gerald@wireshark.org",
      "committed_date": "2021-04-14T12:42:00.000-07:00",
