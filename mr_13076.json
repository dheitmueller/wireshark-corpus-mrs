  "changes_data": [
    {
      "diff": "@@ -663,8 +663,7 @@ Commit Check:\n   script:\n     # GITLAB_TOKEN is set in wireshark/wireshark. Use CI_JOB_TOKEN in forks.\n     - if [ -z \"$GITLAB_TOKEN\" ]; then GITLAB_TOKEN=$CI_JOB_TOKEN ; fi\n-    - (cd /tmp ; curl -JLO https://gitlab.com/gitlab-org/cli/-/releases/v1.34.0/downloads/glab_1.34.0_Linux_x86_64.deb)\n-    - dpkg --install /tmp/glab_1.34.0_Linux_x86_64.deb\n+    - if ! command -V glab 2> /dev/null ; then (cd /tmp ; curl -JLO https://gitlab.com/gitlab-org/cli/-/releases/v1.34.0/downloads/glab_1.34.0_Linux_x86_64.deb ; dpkg --install /tmp/glab_1.34.0_Linux_x86_64.deb ) ; fi\n     - glab auth status\n     - >\n       if [[ $NUM_COMMITS > 1 ]] ; then\n",
