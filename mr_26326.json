    {
      "diff": "@@ -128,5 +128,46 @@\n       <![CDATA[Installed OR NOT NSIS_INSTALL_LOCATION_64]]>\n     </Condition>\n \n+<!--\n+  Starting with Visual Studio 2019 the Visual C++ Redistributable merge\n+  modules are deprecated and aren't available for Arm64:\n+  https://docs.microsoft.com/en-us/visualstudio/releases/2019/release-notes#-deprecations\n+\n+  Additionally, https://learn.microsoft.com/en-us/cpp/porting/binary-compat-2015-2017\n+  says\n+\n+  \"The Redistributable your app uses has a similar binary-compatibility\n+  restriction. When you mix binaries built by different supported\n+  versions of the build tools, the Redistributable version must be at\n+  least as new as the latest build tools used by any app component.\"\n+\n+  Instead of bundling the runtime, check whether a minimum version of\n+  the redistributable is already installed and abort with a helpful\n+  message if it isn't.\n+-->\n+\n+    <?if $(var.Platform) = x64 ?>\n+    <?define VCRedistUpgradeCode = \"{36F68A90-239C-34DF-B58C-64B30153CE35}\" ?>\n+    <?else?>\n+    <?define VCRedistUpgradeCode = \"{DC9BAE42-810B-423A-9E25-E4073F1C7B00}\" ?>\n+    <?endif?>\n+\n+    <Upgrade Id=\"$(var.VCRedistUpgradeCode)\">\n+      <UpgradeVersion OnlyDetect=\"yes\" Property=\"VCREDIST_INSTALLED\" Minimum=\"0.0.0\" IncludeMinimum=\"yes\" />\n+      <?ifdef VCRedistMinVersion?>\n+      <UpgradeVersion OnlyDetect=\"yes\" Property=\"VCREDIST_MIN_VERSION_INSTALLED\" Minimum=\"$(var.VCRedistMinVersion)\" IncludeMinimum=\"yes\" />\n+      <?endif?>\n+    </Upgrade>\n+\n+    <Condition Message=\"The Microsoft Visual C++ Redistributable is required but wasn't found. Please download and install it from https://aka.ms/vs/17/release/vc_redist.$(var.Platform).exe before continuing.\">\n+      <![CDATA[Installed OR VCREDIST_INSTALLED]]>\n+    </Condition>\n+\n+    <?ifdef VCRedistMinVersion?>\n+    <Condition Message=\"The installed Microsoft Visual C++ Redistributable is older than the version $(var.WiresharkName) was built with ($(var.VCRedistMinVersion)). Please update it from https://aka.ms/vs/17/release/vc_redist.$(var.Platform).exe before continuing.\">\n+      <![CDATA[Installed OR VCREDIST_MIN_VERSION_INSTALLED]]>\n+    </Condition>\n+    <?endif?>\n+\n   </Fragment>\n </Include>\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/wix/Prerequisites.wxi",
      "old_path": "packaging/wix/Prerequisites.wxi",
