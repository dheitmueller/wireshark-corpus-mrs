      "diff": "@@ -1,4 +1,4 @@\n-wireshark (3.4.14) unstable; urgency=low\n+wireshark (3.4.15) unstable; urgency=low\n \n   * Self-made package\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "debian/changelog",
      "old_path": "debian/changelog",
      "a_mode": "100644",
