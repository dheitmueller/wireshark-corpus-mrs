  "changes_data": [
    {
      "diff": "@@ -596,16 +596,9 @@ dissect_ssl(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void *data _U_)\n      * - TLS within a different encrypted TLS tunnel.\n      *\n      * To support the second case, 'curr_layer_num_ssl' is used as identifier\n-     * for the current TLS layer. It is however not a stable identifier for the\n-     * second pass (Bug 16109). If the first decrypted record requests\n-     * reassembly for HTTP, then the second pass will skip calling the dissector\n-     * for the first record. That means that 'pinfo->curr_layer_num' will\n-     * actually be lower the second time.\n-     *\n-     * Since this cannot be easily fixed, we will just break the (hopefully less\n-     * common) case of TLS tunneled within TLS.\n+     * for the current TLS layer.\n      */\n-    guint8             curr_layer_num_ssl = 0; // pinfo->curr_layer_num;\n+    guint8             curr_layer_num_ssl = pinfo->curr_layer_num;\n \n     ti = NULL;\n     ssl_tree   = NULL;\n@@ -1208,6 +1201,8 @@ desegment_ssl(tvbuff_t *tvb, packet_info *pinfo, int offset,\n     fragment_head *ipfd_head;\n     gboolean       must_desegment;\n     gboolean       called_dissector;\n+    guint          saved_layers_len;\n+    guint          saved_tree_count;\n     int            another_pdu_follows;\n     gboolean       another_segment_in_frame = FALSE;\n     int            deseg_offset;\n@@ -1233,6 +1228,9 @@ again:\n     pinfo->desegment_offset = 0;\n     pinfo->desegment_len = 0;\n \n+    saved_layers_len = wmem_list_count(pinfo->layers);\n+    saved_tree_count = tree ? tree->tree_data->count : 0;\n+\n     /*\n      * Initialize this to assume that this segment will just be\n      * added to the middle of a desegmented chunk of data, so\n@@ -1416,6 +1414,40 @@ again:\n                  */\n                 fragment_set_partial_reassembly(&ssl_reassembly_table,\n                                                 pinfo, tls_msp_fragment_id(msp), msp);\n+                /* If \"desegment_offset\" is 0, then nothing in the reassembled\n+                 * segments was dissected, so remove the data source and any\n+                 * layers added.\n+                 */\n+                if (pinfo->desegment_offset == 0) {\n+                    remove_last_data_source(pinfo);\n+                    if (tree) {\n+                        /* The dissector should not have added elements to the\n+                         * tree in this case.\n+                         */\n+                        DISSECTOR_ASSERT(saved_tree_count == tree->tree_data->count);\n+                    }\n+                    while (wmem_list_count(pinfo->layers) > saved_layers_len) {\n+                        pinfo->curr_layer_num--;\n+                        wmem_list_remove_frame(pinfo->layers, wmem_list_tail(pinfo->layers));\n+                    }\n+                } else {\n+                    /* XXX: This means that the MSP already covers one PDU\n+                     * plus has some bytes from a second PDU. What we should\n+                     * do is split the MSP; shrink it to the size of the\n+                     * first PDU and create a new one for the second one.\n+                     *\n+                     * What happens currently is the first PDU gets processed\n+                     * here and in a later packet (along with the second PDU)\n+                     * in the first pass, and on the second pass both PDUs\n+                     * are only processed in the later packet. That means\n+                     * that the layer numbers are different between the passes,\n+                     * which can screw up reassembly, etc.\n+                     *\n+                     * In TCP the common way to get here is reassembling out\n+                     * of order segments, but we don't do that in the TLS\n+                     * dissector, so this path shouldn't be used much.\n+                     */\n+                }\n                 /* Update msp->nxtpdu to point to the new next\n                  * pdu boundary.\n                  */\n@@ -1564,6 +1596,34 @@ again:\n                          pinfo, tls_msp_fragment_id(msp), msp,\n                          0, nxtseq - deseg_seq,\n                          LT_SEQ(nxtseq, msp->nxtpdu));\n+\n+            if (pinfo->desegment_offset == 0) {\n+                /* The subdissector told us it dissected zero bytes because\n+                 * everything is part of a PDU that ends later.\n+                 * On subsequent passes we'll find this new msp and first\n+                 * segment, and we won't hand it to the subdissector at all.\n+                 *\n+                 * However, there might be more segments (TLS, TCP, etc.)\n+                 * in the frame, and those segments might get dissected.\n+                 * Those later protocols in the stack might depend on their\n+                 * layer number being the same in each pass (for reassembly,\n+                 * looking up proto data, etc.)\n+                 *\n+                 * Remove any layers that the subdissector just added, so\n+                 * that the number of layers at this point will be the same as\n+                 * in later passes.\n+                 */\n+                if (tree) {\n+                    /* The dissector should not have added elements to the\n+                     * tree in this case.\n+                     */\n+                    DISSECTOR_ASSERT(saved_tree_count == tree->tree_data->count);\n+                }\n+                while (wmem_list_count(pinfo->layers) > saved_layers_len) {\n+                    pinfo->curr_layer_num--;\n+                    wmem_list_remove_frame(pinfo->layers, wmem_list_tail(pinfo->layers));\n+                }\n+            }\n         }\n     }\n \n",
