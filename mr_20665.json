      "notes": [
        {
          "id": 2652629200,
          "type": "DiscussionNote",
          "body": "Looks like the minimum libxml2 library version required is pretty low.  What would it take to require something like 2.14?",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2025-07-27T18:28:59.462Z",
          "updated_at": "2025-07-28T07:49:41.623Z",
          "system": false,
          "noteable_id": 402541588,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 20665,
          "commands_changes": {}
        },
        {
          "id": 2653266747,
          "type": "DiscussionNote",
          "body": "Sadly many enterprises just went to RHEL8 (2.9), and soon RHEL9, which only has version 2.12. Even latest Ubuntu LTS is running 2.9. Higher version requirement can't be done in a long time as many of us build towards these legacy environments :/",
          "author": {
            "id": 6524193,
            "username": "oakimk",
            "public_email": "",
            "name": "Joakim Karlsson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6524193/avatar.png?v=1787702414",
            "web_url": "https://gitlab.com/oakimk"
          },
          "created_at": "2025-07-28T07:49:41.494Z",
          "updated_at": "2025-07-28T07:49:41.494Z",
