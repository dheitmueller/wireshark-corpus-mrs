      "notes": [
        {
          "id": 2952155484,
          "type": null,
          "body": "Not exactly sure what I'm doing here, but this is needed for !22729. Looks like there was never a global file generated for 4.6 release, so I tried to hack something together with the 4.6.2 release build and the files from the current 4.6 branch.\nThen maybe !22729 also needs to update the (new) global file because the values changed?  Should that turn into globals_5.0.txt?\n@johnthacker - You were the last to do this, what do you think?",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
