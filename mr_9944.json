      "diff": "@@ -1,6 +1,6 @@\n // Common attributes\n \n-:wireshark-version: 4.0.4\n+:wireshark-version: 4.0.5\n :logray-version: 0.9.0\n \n // Required for btn, kbd:, and menu: macros.\n",
