      "diff": "@@ -11938,39 +11938,41 @@ elastic_add_base_mapping(json_dumper *dumper)\n }\n \n static char*\n-ws_type_to_elastic(unsigned type _U_)\n+ws_type_to_elastic(unsigned type)\n {\n \tswitch(type) {\n-\t\tcase FT_UINT16:\n+\t\tcase FT_INT8:\n+\t\t\treturn \"byte\";\n+\t\tcase FT_UINT8:\n \t\tcase FT_INT16:\n+\t\t\treturn \"short\";\n+\t\tcase FT_UINT16:\n \t\tcase FT_INT32:\n \t\tcase FT_UINT24:\n \t\tcase FT_INT24:\n \t\t\treturn \"integer\";\n-\t\tcase FT_INT8:\n-\t\tcase FT_UINT8:\n-\t\t\treturn \"short\";\n \t\tcase FT_FRAMENUM:\n \t\tcase FT_UINT32:\n \t\tcase FT_UINT40:\n \t\tcase FT_UINT48:\n \t\tcase FT_UINT56:\n-\t\tcase FT_UINT64: // Actually it's not handled by 'long' elastic type.\n+\t\tcase FT_INT40:\n \t\tcase FT_INT48:\n+\t\tcase FT_INT56:\n \t\tcase FT_INT64:\n \t\t\treturn \"long\";\n+\t\tcase FT_UINT64:\n+\t\t\treturn \"unsigned long\"; // ElasticSearch since 7.0, OpenSearch 2.8\n \t\tcase FT_FLOAT:\n-\t\tcase FT_DOUBLE:\n \t\t\treturn \"float\";\n+\t\tcase FT_DOUBLE:\n+\t\tcase FT_RELATIVE_TIME: // \"scaled_float\" with \"scaling_factor\" 1e9 superior?\n+\t\t\treturn \"double\";\n \t\tcase FT_IPv6:\n \t\tcase FT_IPv4:\n \t\t\treturn \"ip\";\n \t\tcase FT_ABSOLUTE_TIME:\n-\t\tcase FT_RELATIVE_TIME:\n-\t\t\treturn \"date\";\n-\t\tcase FT_BYTES:\n-\t\tcase FT_UINT_BYTES:\n-\t\t\treturn \"byte\";\n+\t\t\treturn \"date_nanos\"; // This is a 64 bit integer of nanoseconds, so it does have a Y2262 problem\n \t\tcase FT_BOOLEAN:\n \t\t\treturn \"boolean\";\n \t\tdefault:\n",
