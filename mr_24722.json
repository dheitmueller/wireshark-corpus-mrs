      "notes": [
        {
          "id": 3311735299,
          "type": "DiffNote",
          "body": "I've wanted to do a giant search/replace on using #pragma once, but presumed there were (C) compilers that didn't support it.  Not sure this MR is the time to introduce it.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2026-05-04T14:26:18.088Z",
          "updated_at": "2026-05-04T17:31:47.453Z",
          "system": false,
          "noteable_id": 480219981,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "commit_id": null,
          "position": {
