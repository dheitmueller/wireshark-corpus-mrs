    {
      "id": "f197fd312085ac6211a151ea66ce7c3eedf25fca",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 3312470034,
          "type": "DiscussionNote",
          "body": "The need for epan/prefs.h to include a definition of an update interval, when the dissector library doesn't know about UI updates, is probably a sign that either some code in `ui` or some code in `capture` should register it as a preference.\n\nThat's something to consider at some point.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
