  "changes_data": [
    {
      "diff": "@@ -839,22 +839,26 @@ Commit Check:\n     - TEST_SUITE=commit_checks\n     - EXIT_CODE=0\n     - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case num_commits --command \"[ $NUM_COMMITS -lt 2 ] || (echo 'ℹ️ This merge request has more than one commit. Please squash any trivial ones:\\n'; git log --oneline --no-decorate --max-count=$NUM_COMMITS ; false)\" || true\n-    # If this is a merged results pipeline, then HEAD is a temporary merged commit\n-    # with a message like \"Merge branch 'X' into 'Y'\" and the variable\n+    # If this is a merged results pipeline, then HEAD is a temporary merged\n+    # commit with a message like \"Merge branch 'X' into 'Y'\" and the variable\n     # CI_MERGE_REQUEST_SOURCE_BRANCH_SHA has the real commit to check.\n     # If not, then CI_MERGE_REQUEST_SOURCE_BRANCH_SHA is empty.\n-    # pre-commit compares the current tree with the passed in commit(s), and thus\n-    # the parameter is the Nth ancestor of our commit.\n+    - REAL_COMMIT_SHA=${CI_MERGE_REQUEST_SOURCE_BRANCH_SHA:-${CI_COMMIT_SHA}}\n+    # Some of the tests below operate on the whole tree, some operate on\n+    # individual commits, and some compare the given commit(s) to the\n+    # current index.\n+    # pre-commit and check-pngs are the last one, and thus the parameter is\n+    # the Nth ancestor of our commit.\n     # If we pass in multiple commits, pre-commit will compare each of them with\n     # the current tree, which duplicates work and is O(N^2).\n     #- ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/pre-commit ./tools/pre-commit $( git log --max-count=$NUM_COMMITS --pretty=format:%h~ ) || EXIT_CODE=1\n-    - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/pre-commit ./tools/pre-commit \"${CI_COMMIT_SHA}~${NUM_COMMITS}\" || EXIT_CODE=1\n-    - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/validate-commit ./tools/validate-commit.py $( git log --max-count=$NUM_COMMITS --pretty=format:%h $CI_MERGE_REQUEST_SOURCE_BRANCH_SHA ) || EXIT_CODE=1\n+    - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/pre-commit ./tools/pre-commit \"${REAL_COMMIT_SHA}~${NUM_COMMITS}\" || EXIT_CODE=1\n+    - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/validate-commit ./tools/validate-commit.py $( git log --max-count=$NUM_COMMITS --pretty=format:%h $REAL_COMMIT_SHA ) || EXIT_CODE=1\n     - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/checklicenses ./tools/checklicenses.py || EXIT_CODE=1\n     - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/check_help_urls ./tools/check_help_urls.py || EXIT_CODE=1\n     # Report this failure, but don't fail the job for now. Not all developers\n     # might have access to all the PNG compression tools.\n-    - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/check_pngs ./tools/check_pngs.sh \"${CI_MERGE_REQUEST_SOURCE_BRANCH_SHA}~${NUM_COMMITS}\" || echo 'ℹ️ This merge request includes PNGs that can be made smaller with lossless compression. Please run tools/compress-pngs.py if possible.'\n+    - ./tools/wrap-ci-test.py --file $REPORT_FILE --suite $TEST_SUITE --case tools/check_pngs ./tools/check_pngs.sh \"${REAL_COMMIT_SHA}~${NUM_COMMITS}\" || echo 'ℹ️ This merge request includes PNGs that can be made smaller with lossless compression. Please run tools/compress-pngs.py if possible.'\n     - exit $EXIT_CODE\n   artifacts:\n     when: always\n",
