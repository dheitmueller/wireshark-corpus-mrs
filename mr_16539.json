        },
        {
          "id": 2009758895,
          "type": "DiscussionNote",
          "body": "This change was in response to the email from Ben Geear, about the genuine issue solved with  !16532.",
          "author": {
            "id": 2398962,
            "username": "JaapKeuter",
            "public_email": "",
            "name": "Jaap Keuter",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/722b0c520542a23cb8f8ea7070a45c88f9e9214dc700ac151e419e9649e0304e?s=80&d=identicon",
            "web_url": "https://gitlab.com/JaapKeuter"
          },
          "created_at": "2024-07-22T08:39:41.268Z",
          "updated_at": "2024-07-22T08:39:41.268Z",
          "system": false,
          "noteable_id": 316471926,
          "noteable_type": "MergeRequest",
