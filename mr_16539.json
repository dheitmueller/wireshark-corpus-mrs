      "notes": [
        {
          "id": 2009333077,
          "type": "DiscussionNote",
          "body": "We have a lot of over-wide variables due to calls to e.g. proto_tree_add_item_uint(), where a guint32, or now unsigned, takes the value.  We could cast the pointer type but it's uncommon, and I think ugly.",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2024-07-21T21:37:27.848Z",
          "updated_at": "2024-07-22T08:39:41.341Z",
