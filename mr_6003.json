  "commits_data": [
    {
      "id": "84c89b8f6cf462e944a586c9dd3e490eb8428e2a",
      "short_id": "84c89b8f",
      "created_at": "2022-01-27T05:24:16.000+00:00",
      "parent_ids": [
        "6231bdc716412037366028cc8ca27fb5aa2bea7c"
      ],
      "title": "GTP': Support Release 15 and higher CDRs",
      "message": "GTP': Support Release 15 and higher CDRs\n\nThe Release Identifer field is only one nibble in GTP'. So in\nRelease 15 of 3GPP TS 32.295, an extra octet, Release Identifier\nExtension, was added to support CDRs encoded with Release 16 and\nhigher of TS 32.298. Fix #17903.\n",
