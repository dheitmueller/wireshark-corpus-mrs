    {
      "id": "50b6f387b4c5ffbafeb58d852dd8ffcfb20a290d",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 598321267,
          "type": "DiscussionNote",
          "body": "@oakimk What does `pkg-config --cflags glib-2.0` show on your system? As far as I can tell, GLIB2_HINTS should only be set by FindWSWinLibs, so the effect of 6357f46b on non-Windows systems should have been switching from looking in `/include` to `/lib`.\n\nAlso, this change will break the Windows build. The vcpkg GLib port moved `glibconfig.h` from `installed/$ARCH-windows/include` to `installed/$ARCH-windows/lib/glib-2.0/include`.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789948913",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2021-06-10T15:59:38.380Z",
          "updated_at": "2021-06-11T05:52:28.651Z",
