  "changes_data": [
    {
      "diff": "@@ -617,16 +617,16 @@ macOS Universal Package:\n   retry: 1\n   script:\n     - export PATH=\"/Library/Frameworks/Python.framework/Versions/3.13/bin:$PATH:$HOME/bin\"\n-    - export WIRESHARK_BASE_DIR=${CI_PROJECT_DIR}/../wireshark-third-party\n+    - export \"WIRESHARK_BASE_DIR=${CI_PROJECT_DIR}/../wireshark-third-party\"\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n-    - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir -p $WIRESHARK_BASE_DIR/Qt ; fi\n-    - if [ ! -d $WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos/lib/QtCore.framework ] ; then\n+    - if [ ! -d \"$WIRESHARK_BASE_DIR\" ] ; then mkdir -p \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n+    - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos/lib/QtCore.framework\" ] ; then\n         rm -rf /tmp/aqt.venv ;\n         python3 -m venv /tmp/aqt.venv ;\n         /tmp/aqt.venv/bin/pip3 install aqtinstall ;\n         /tmp/aqt.venv/bin/aqt install-qt --outputdir $WIRESHARK_BASE_DIR/Qt mac desktop 6.5.3 clang_64 --modules qt5compat qtmultimedia ;\n       fi\n-    - export CMAKE_PREFIX_PATH=$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION\n+    - export CMAKE_PREFIX_PATH=\"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos\"\n     - export PKG_CONFIG_PATH=\n     - mkdir build\n     - cd build\n@@ -634,7 +634,7 @@ macOS Universal Package:\n     - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n     - cmake -G Ninja\n       -DENABLE_CCACHE=ON\n-      -DWIRESHARK_BASE_DIR=$WIRESHARK_BASE_DIR\n+      -DWIRESHARK_BASE_DIR=\"$WIRESHARK_BASE_DIR\"\n       -DLIBXML2_INCLUDE_DIR=/Library/Developer/CommandLineTools/SDKs/MacOSX13.3.sdk/usr/include/libxml2\n       -DLIBXML2_LIBRARY=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib/libxml2.tbd\n       -DCMAKE_OSX_DEPLOYMENT_TARGET=12.0\n",
