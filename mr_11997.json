  "changes_data": [
    {
      "diff": "@@ -19,6 +19,8 @@ It is used for troubleshooting, analysis, development and education.\n // Add a summary of **major** changes here.\n // Add other changes to \"New and Updated Features\" below.\n \n+Wireshark supports dark mode on Windows.\n+\n A Windows installer for Arm64 has been added.\n \n Windows installer file names now have the format Wireshark-<version>-<architecture>.exe.\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "docbook/release-notes.adoc",
      "old_path": "docbook/release-notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -13,6 +13,10 @@\n #include <QApplication>\n #include <QPalette>\n \n+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0)\n+#include <QStyleHints>\n+#endif\n+\n // Colors we use in various parts of the UI.\n //\n // New colors should be chosen from tango_colors.h. The expert and hidden\n@@ -143,7 +147,11 @@ QRgb ColorUtils::sequenceColor(int item)\n \n bool ColorUtils::themeIsDark()\n {\n+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0)\n+    return qApp->styleHints()->colorScheme() == Qt::ColorScheme::Dark;\n+#else\n     return qApp->palette().windowText().color().lightness() > qApp->palette().window().color().lightness();\n+#endif\n }\n \n // Qt < 5.12.6 on macOS always uses Qt::blue for the link color, which is\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "ui/qt/utils/color_utils.cpp",
      "old_path": "ui/qt/utils/color_utils.cpp",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -102,6 +102,10 @@\n #include <QStyleHints>\n #endif\n \n+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0) && defined(Q_OS_WIN)\n+#include <QStyleFactory>\n+#endif\n+\n #ifdef _MSC_VER\n #pragma warning(pop)\n #endif\n@@ -277,6 +281,16 @@ void MainApplication::refreshPacketData()\n     }\n }\n \n+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0) && defined(Q_OS_WIN)\n+void MainApplication::colorSchemeChanged() {\n+    if (ColorUtils::themeIsDark()) {\n+        setStyle(QStyleFactory::create(\"fusion\"));\n+    } else {\n+        setStyle(QStyleFactory::create(\"windowsvista\"));\n+    }\n+}\n+#endif\n+\n void MainApplication::updateTaps()\n {\n     draw_tap_listeners(FALSE);\n@@ -813,13 +827,17 @@ MainApplication::MainApplication(int &argc,  char **argv) :\n     qApp->setStyleSheet(app_style_sheet);\n \n     // If our window text is lighter than the window background, assume the theme is dark.\n-    QPalette gui_pal = qApp->palette();\n-    prefs_set_gui_theme_is_dark(gui_pal.windowText().color().value() > gui_pal.window().color().value());\n+    prefs_set_gui_theme_is_dark(ColorUtils::themeIsDark());\n \n #if defined(HAVE_SOFTWARE_UPDATE) && defined(Q_OS_WIN)\n     connect(this, SIGNAL(softwareUpdateQuit()), this, SLOT(quit()), Qt::QueuedConnection);\n #endif\n \n+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0) && defined(Q_OS_WIN)\n+    colorSchemeChanged();\n+    connect(styleHints(), &QStyleHints::colorSchemeChanged, this, &MainApplication::colorSchemeChanged);\n+#endif\n+\n     connect(qApp, SIGNAL(aboutToQuit()), this, SLOT(cleanup()));\n }\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "ui/qt/main_application.cpp",
      "old_path": "ui/qt/main_application.cpp",
      "a_mode": "100644",
