  "changes_data": [
    {
      "diff": "@@ -813,40 +813,6 @@ macOS Build:\n     - wsar_html.zip\n   needs: []\n \n-.ABI Check:\n-  extends: .build-ubuntu\n-  rules: !reference [.if-merge-request]\n-  variables:\n-    # Use DWARF-4. ABI dumper version 1.3 is required for DWARF-5 support (the GCC 11 default) but version 1.3 is still not released.\n-    # https://github.com/lvc/abi-dumper/issues/34\n-    CFLAGS: \"-Og -gdwarf-4\"\n-  script:\n-    # build-ubuntu puts us in `build`.\n-    - DEBIAN_FRONTEND=noninteractive apt-get update\n-    - DEBIAN_FRONTEND=noninteractive apt-get --yes install abi-dumper abi-compliance-checker\n-    # CMake build type None is required to prevent CMake from adding its own debug flags and clobbering our own.\n-    - cmake -G Ninja -DENABLE_CCACHE=ON -DCMAKE_BUILD_TYPE=None -DBUILD_wireshark=OFF ..\n-    - ninja wiretap-abi-dump epan-abi-dump wsutil-abi-dump\n-    - set +e\n-    - abi-compliance-checker -l wiretap -old ../tools/abi-dumps/wiretap-abi-13.0.0.dump -new wiretap-abi-13*.dump\n-    - WIRETAP_EXIT=$?\n-    - abi-compliance-checker -l epan -old ../tools/abi-dumps/epan-abi-16.0.0.dump -new epan-abi-16*.dump\n-    - EPAN_EXIT=$?\n-    - abi-compliance-checker -l wsutil -old ../tools/abi-dumps/wsutil-abi-14.0.0.dump -new wsutil-abi-14*.dump\n-    - WSUTIL_EXIT=$?\n-    - set -e\n-    - printf \"WIRETAP_EXIT=%d EPAN_EXIT=%d WSUTIL_EXIT=%d\\\\n\" $WIRETAP_EXIT $EPAN_EXIT $WSUTIL_EXIT\n-    - mv compat_reports ../compat_reports_4.0\n-    - mv *-abi-*.dump ..\n-    - cd ..\n-    - zip -9 -r compat_reports_4.0.zip compat_reports_4.0\n-    - exit $(( WIRETAP_EXIT + EPAN_EXIT + WSUTIL_EXIT ))\n-  artifacts:\n-    when: always\n-    paths:\n-      - compat_reports_4.0.zip\n-      - ./*-abi-*.dump\n-\n # Fuzz TShark using ASAN and valgrind.\n .fuzz-ubuntu:\n   extends: .build-ubuntu\n",
      "collapsed": false,
      "too_large": false,
