        }
      ]
    },
    {
      "id": "17ab63913183ece017dde209f072ca43080de6a8",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2510737171,
          "type": null,
          "body": "The protocol starts with a lenght. Checking that may be the first metric. I would have to look further to see if I can come up with more metrics...\n\nThis will probably not happen soon...\n\nAnyways, thanks for the pointers @johnthacker!",
