    {
      "id": "30df8a5a8b8a00437186347a99bbe9d0afb1a1e7",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1408371847,
          "type": null,
          "body": "I think the changing layout issue is the same as when changing profile, and this is the remaining issue with !10716. I will have a look at this for a separate fix.\n\nDuring capture I think we should keep the selected packet(s) but don't scroll to it if auto-scroll is selected. The view will scroll to the end on next packet arrival anyway.\n\nIn the old GTK version I changed the select functions to show the current packet in the middle of the packet list instead of in the bottom. I still would like that feature, maybe configurable in an advanced preference (top, 25%, 50%, 75%, bottom).",
          "author": {
            "id": 4753670,
            "username": "stigbjorlykke",
            "public_email": "",
            "name": "Stig Bjørlykke",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/905aafc6b50e246885f5ea9273a9dc4f22e2658b71f9a1b551b797082bec3f80?s=80&d=identicon",
