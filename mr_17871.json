      "diff": "@@ -260,6 +260,7 @@ double asn1_get_real(const guint8 *real_ptr, gint len) {\n     switch (octet & 0x3F) {\n       case 0x00: val = HUGE_VAL; break;\n       case 0x01: val = -HUGE_VAL; break;\n+      case 0x02: val = NAN; break;\n     }\n   } else {  /* decimal encoding */\n     buf = g_strndup(p, len);\n",
