  "changes_data": [
    {
      "diff": "@@ -2263,6 +2263,9 @@ dissect_ip_v4(tvbuff_t *tvb, packet_info *pinfo, proto_tree *parent_tree, void*\n         prefs.strict_conversation_tracking_heuristics) {\n       frag_id ^= pinfo->vlan_id;\n     }\n+    if (prefs.strict_conversation_tracking_heuristics && pinfo->rec->presence_flags & WTAP_HAS_INTERFACE_ID) {\n+      frag_id ^= pinfo->rec->rec_header.packet_header.interface_id;\n+    }\n     ipfd_head = fragment_add_check(&ip_reassembly_table, tvb, offset,\n                                    pinfo,\n                                    frag_id,\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-ip.c",
      "old_path": "epan/dissectors/packet-ip.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -839,6 +839,116 @@ static gboolean ipv6_tso_supported = FALSE;\n /*\n  * defragmentation of IPv6\n  */\n+\n+typedef struct _ipv6_fragment_key {\n+    address src;\n+    address dst;\n+    guint32 id;\n+    guint32 vlan_id;\n+    guint32 if_id;\n+} ipv6_fragment_key;\n+\n+static guint\n+ipv6_fragment_hash(gconstpointer k)\n+{\n+    const ipv6_fragment_key* key = (const ipv6_fragment_key*)k;\n+\n+    /*\tMore than likely: in most captures src and dst addresses are the\n+            same, and would hash the same.\n+            We only use id as the hash as an optimization.\n+    */\n+    return key->id;\n+}\n+\n+static gint\n+ipv6_fragment_equal(gconstpointer k1, gconstpointer k2)\n+{\n+    const ipv6_fragment_key* key1 = (const ipv6_fragment_key*)k1;\n+    const ipv6_fragment_key* key2 = (const ipv6_fragment_key*)k2;\n+\n+    /*\n+     * key.id is the first item to compare since it's the item most\n+     * likely to differ between sessions, thus short-circuiting\n+     * the comparison of addresses and ports.\n+     */\n+    return (key1->id == key2->id) &&\n+        (addresses_equal(&key1->src, &key2->src)) &&\n+        (addresses_equal(&key1->dst, &key2->dst)) &&\n+        /* Check interface ID only if strict_conversation_tracking_heuristics is enabled */\n+        (!prefs.strict_conversation_tracking_heuristics ||\n+            ((key1->vlan_id == key2->vlan_id) && (key1->if_id == key2->if_id)));\n+}\n+\n+static gpointer\n+ipv6_fragment_temporary_key(const packet_info* pinfo, const guint32 id,\n+    const void* data _U_)\n+{\n+    ipv6_fragment_key* key = g_slice_new(ipv6_fragment_key);\n+\n+    /*\n+     * Do a shallow copy of the addresses.\n+     */\n+    copy_address_shallow(&key->src, &pinfo->src);\n+    copy_address_shallow(&key->dst, &pinfo->dst);\n+    key->id = id;\n+    key->vlan_id = pinfo->vlan_id;\n+    key->if_id = (pinfo->rec->presence_flags & WTAP_HAS_INTERFACE_ID) ? pinfo->rec->rec_header.packet_header.interface_id : 0;\n+\n+    return (gpointer)key;\n+}\n+\n+static gpointer\n+ipv6_fragment_persistent_key(const packet_info* pinfo, const guint32 id,\n+    const void* data _U_)\n+{\n+    ipv6_fragment_key* key = g_slice_new(ipv6_fragment_key);\n+\n+    /*\n+     * Do a deep copy of the addresses.\n+     */\n+    copy_address(&key->src, &pinfo->src);\n+    copy_address(&key->dst, &pinfo->dst);\n+    key->id = id;\n+    key->vlan_id = pinfo->vlan_id;\n+    key->if_id = (pinfo->rec->presence_flags & WTAP_HAS_INTERFACE_ID) ? pinfo->rec->rec_header.packet_header.interface_id : 0;\n+\n+    return (gpointer)key;\n+}\n+\n+\n+static void\n+ipv6_fragment_free_temporary_key(gpointer ptr)\n+{\n+    ipv6_fragment_key* key = (ipv6_fragment_key*)ptr;\n+    g_slice_free(ipv6_fragment_key, key);\n+}\n+\n+static void\n+ipv6_fragment_free_persistent_key(gpointer ptr)\n+{\n+    ipv6_fragment_key* key = (ipv6_fragment_key*)ptr;\n+\n+    if (key) {\n+        /*\n+         * Free up the copies of the addresses from the old key.\n+         */\n+        free_address(&key->src);\n+        free_address(&key->dst);\n+\n+        g_slice_free(ipv6_fragment_key, key);\n+    }\n+}\n+\n+const reassembly_table_functions\n+ipv6_reassembly_table_functions = {\n+    ipv6_fragment_hash,\n+    ipv6_fragment_equal,\n+    ipv6_fragment_temporary_key,\n+    ipv6_fragment_persistent_key,\n+    ipv6_fragment_free_temporary_key,\n+    ipv6_fragment_free_persistent_key\n+};\n+\n static reassembly_table ipv6_reassembly_table;\n \n /* http://www.iana.org/assignments/ipv6-parameters (last updated 2015-07-07) */\n@@ -5406,7 +5516,7 @@ proto_register_ipv6(void)\n \n     ipv6_handle = register_dissector(\"ipv6\", dissect_ipv6, proto_ipv6);\n     reassembly_table_register(&ipv6_reassembly_table,\n-                          &addresses_reassembly_table_functions);\n+                          &ipv6_reassembly_table_functions);\n     ipv6_tap = register_tap(\"ipv6\");\n \n     register_decode_as(&ipv6_da);\n",
