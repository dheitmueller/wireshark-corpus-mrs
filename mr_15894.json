      ],
      "title": "A-bis/RSL: fix parsing of hf_rsl_command, add hf_rsl_command_ext",
      "message": "A-bis/RSL: fix parsing of hf_rsl_command, add hf_rsl_command_ext\n\nThe extension bit shall not be part of the Command value, so use\na proper mask for hf_rsl_command.  Add hf_rsl_command_ext for the\nextended (2 octet) variant of that field, with its own mask.\n",
      "author_name": "Vadim Yanitskiy",
      "author_email": "vyanitskiy@sysmocom.de",
      "authored_date": "2024-06-07T19:41:39.000+07:00",
      "committer_name": "AndersBroman",
      "committer_email": "a.broman58@gmail.com",
      "committed_date": "2024-06-08T08:04:26.000+00:00",
