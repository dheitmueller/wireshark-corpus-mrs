      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/f7e6a27d2307fa4b7132f5de0573a593dab77b68"
    },
    {
      "id": "1bc0ffa9de079b25796df81d93618928a4f43895",
      "short_id": "1bc0ffa9",
      "created_at": "2024-06-08T08:04:26.000+00:00",
      "parent_ids": [
        "f35f05344503478b34e68b81ac8ec6dd02856868"
      ],
      "title": "A-bis/RSL: fix parsing of Command Indicator IE",
      "message": "A-bis/RSL: fix parsing of Command Indicator IE\n\n3GPP TS 48.058, sections 8.5.10 and 9.3.48 clearly define this IE\nas TLV with total length being 3-4.  The current implementation\ndoes not dissect the Length byte and assuming the total length\nto be 2, which is wrong.  Incorrect parsing of this IE breaks\nparsing of optional IEs following it.\n\nFix #19868\n",
      "author_name": "Vadim Yanitskiy",
      "author_email": "vyanitskiy@sysmocom.de",
      "authored_date": "2024-06-07T15:42:15.000+07:00",
      "committer_name": "AndersBroman",
      "committer_email": "a.broman58@gmail.com",
      "committed_date": "2024-06-08T08:04:26.000+00:00",
