  "commits_data": [
    {
      "id": "4c55cc0c14a904d162c1ac11ead0ea86397b65ca",
      "short_id": "4c55cc0c",
      "created_at": "2020-09-11T17:30:12.000-07:00",
      "parent_ids": [
        "91e24f9fe08d1e7b813593099d748bcdb93bc57f"
      ],
      "title": "GitLab CI: Don't run validate-commit.py or cppcheck.",
      "message": "GitLab CI: Don't run validate-commit.py or cppcheck.\n\nCommits in release branches are typically cherry-picked from master,\nwhich means that:\n\n- We've presumably validated the commit message there.\n\n- The \"(cherry picked from commit ...\" line that GitLab adds might have\n  extra newlines which fail the whitespace check.\n\ncppcheck.sh hasn't had any of the efficiency improvements backported,\nwhich means that it can take an excruciating amount of time to run.\n",
      "author_name": "Gerald Combs",
      "author_email": "gerald@zing.org",
      "authored_date": "2020-09-11T09:31:26.000-07:00",
      "committer_name": "Gerald Combs",
      "committer_email": "gerald@zing.org",
      "committed_date": "2020-09-11T17:30:12.000-07:00",
