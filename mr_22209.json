    {
      "id": "c33b0031ad802da21d71dc80bdfbb19ad6877a57",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 2873546320,
          "type": "DiffNote",
          "body": "OK, so `http2_set_stream_imsi` doesn't `strdup` its `imsi` parameter, which leads to confusion over the string's ownership.\n\nRather than reintroducing a leak whenever we found a match but _don't_ end up calling into `http2_set_stream_imsi`, we should either set `matched_imsi` to NULL here after calling `http2_set_stream_imsi` (essentially passing ownership of the string to the http2 dissector and neutralizing the `g_free` call here) or we should have `strdup`'d it inside `http2_set_stream_imsi`.",
          "author": {
            "id": 7889756,
            "username": "dariusd0",
            "public_email": "",
            "name": "dariusd0",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/f0f4a609abaf984c9cfe277f1321b8db104aea7290fcbb7fb0c5749a00d32e39?s=80&d=identicon",
            "web_url": "https://gitlab.com/dariusd0"
          },
          "created_at": "2025-11-06T22:01:17.425Z",
          "updated_at": "2025-11-06T22:01:17.425Z",
          "system": false,
