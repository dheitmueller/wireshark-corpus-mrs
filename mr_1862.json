    {
      "id": "a0c2dae2136c0cd34e70ec4435e13e2c1e56dbf3",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 501702819,
          "type": "DiscussionNote",
          "body": "@Lekensteyn I think you mean `classify_mbtcp_packet`? There is a `XXX` there suggesting another approach, but I'm not sure how it would work if, say, you didn't have the complete TCP stream and capture the response, but not the query. It seems that port-based detection, and therefor the `tcp.port` and `tls.port` preferences, would still be necessary. This is one of my first efforts at the WS code base, so maybe I'm missing something",
          "author": {
            "id": 1621938,
            "username": "ferst",
            "public_email": "",
            "name": "Matheus K. Ferst",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/7ae55b5bbe9406353b80c3a085b8ddb00d71b1d09995b8207ac4d0dc173e901e?s=80&d=identicon",
            "web_url": "https://gitlab.com/ferst"
          },
