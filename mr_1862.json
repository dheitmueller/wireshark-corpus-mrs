      "notes": [
        {
          "id": 499972793,
          "type": "DiffNote",
          "body": "Ideally this uses `dissector_add_for_decode_as` to avoid adding the preference, but that would require changing how port information is used in `classify_mbrtu_packet` to determine whether it is a request or response.\n\n(Edit: actually, `ssl_dissector_add` already registers a Decode As entry, so it does not have to be called at all. The comment regarding `classify_mbrtu_packet` still stands however.)\n\nThis is fine for now, but it is something that can be improved in the future.",
          "author": {
            "id": 2415432,
            "username": "Lekensteyn",
            "public_email": "",
            "name": "Peter Wu",
            "state": "active",
            "locked": false,
