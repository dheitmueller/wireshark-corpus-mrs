  "changes_data": [
    {
      "diff": "@@ -412,6 +412,35 @@ load_cap_file(capture_file *cf, int max_packet_count, int64_t max_byte_count)\n     return err;\n }\n \n+void\n+cf_close(capture_file *cf)\n+{\n+    if (cf->state == FILE_CLOSED || cf->state == FILE_READ_PENDING)\n+        return; /* Nothing to do */\n+\n+    if (cf->provider.wth) {\n+        wtap_close(cf->provider.wth);\n+        cf->provider.wth = NULL;\n+    }\n+\n+    /* We have no file open... */\n+    if (cf->filename != NULL) {\n+        /* If it's a temporary file, remove it. */\n+        if (cf->is_tempfile)\n+            ws_unlink(cf->filename);\n+        g_free(cf->filename);\n+        cf->filename = NULL;\n+    }\n+\n+    if (cf->provider.frames != NULL) {\n+        free_frame_data_sequence(cf->provider.frames);\n+        cf->provider.frames = NULL;\n+    }\n+\n+    /* We have no file open. */\n+    cf->state = FILE_CLOSED;\n+}\n+\n cf_status_t\n cf_open(capture_file *cf, const char *fname, unsigned int type, bool is_tempfile, int *err)\n {\n@@ -422,7 +451,9 @@ cf_open(capture_file *cf, const char *fname, unsigned int type, bool is_tempfile\n     if (wth == NULL)\n         goto fail;\n \n-    /* The open succeeded.  Fill in the information for this file. */\n+    /* The open succeeded.  Close whatever capture file we had open,\n+       and fill in the information for this file. */\n+    cf_close(cf);\n \n     cf->provider.wth = wth;\n     cf->f_datalen = 0; /* not used, but set it anyway */\n",
