  "changes_data": [
    {
      "diff": "@@ -155,21 +155,21 @@ CentOS 7 RPM Test:\n     - tshark --version\n   dependencies: [ 'CentOS 7 RPM Package' ]\n \n-openSUSE 15.1 RPM Package:\n+openSUSE 15.3 RPM Package:\n   extends: .build-rpm\n-  image: registry.gitlab.com/wireshark/wireshark-containers/opensuse-15.1-dev\n+  image: registry.gitlab.com/wireshark/wireshark-containers/opensuse-15.3-dev\n   script:\n     - mkdir build\n     - cd build\n     - cmake -GNinja ..\n     - ninja rpm-package\n-openSUSE 15.1 RPM Test:\n+openSUSE 15.3 RPM Test:\n   extends: .test-rpm\n-  image: registry.gitlab.com/wireshark/wireshark-containers/opensuse-15.1-dev\n+  image: registry.gitlab.com/wireshark/wireshark-containers/opensuse-15.3-dev\n   script:\n     - zypper --no-gpg-checks install -y build/packaging/rpm/RPMS/x86_64/*.rpm\n     - tshark --version\n-  dependencies: [ 'openSUSE 15.1 RPM Package' ]\n+  dependencies: [ 'openSUSE 15.3 RPM Package' ]\n \n # Disabled for now due to issues with Fedora 33.\n .Fedora RPM Package:\n",
