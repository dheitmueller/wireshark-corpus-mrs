    {
      "id": "8ee4efc01b2668d211a4051cd5f6bfd34bf19506",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 978233804,
          "type": null,
          "body": "There are reasons but they're not very strong. It removes some clutter so that's good. Also `ENC_UTF_16` would be UTF-16 in host byte order, or with a BOM, so the endianness tacked on kind of makes sense. `ENC_UTF_16LE` and `ENC_UTF_16BE` are well-known names coming from the standard. Simpler, nicer, more understandable IMO.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
