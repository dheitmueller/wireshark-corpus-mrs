    {
      "id": "456719375867106e211395aed11fa423d7487dd7",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 978193623,
          "type": null,
          "body": "Is there some reason why `ENC_UTF_16LE` isn't just `(ENC_UTF_16|ENC_LITTLE_ENDIAN)` and `ENC_UTF_16BE` isn't just `(ENC_UTF_16|ENC_BIG_ENDIAN)`?  That's how we support UTF-16BE and UTF-16LE currently.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-06-09T03:00:14.508Z",
          "updated_at": "2022-06-09T03:00:14.508Z",
          "system": false,
          "noteable_id": 159589848,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
