  "changes_data": [
    {
      "diff": "@@ -1259,6 +1259,20 @@ quic_connection_find(packet_info *pinfo, guint8 long_packet_type,\n             dcid->len = 0;\n         }\n     }\n+    // If connection was found we might need to attach the connection\n+    // information to a new conversation in case of a connection migration.\n+    // get the connection information from the conversation.\n+    quic_info_data_t *conn_from_conv = quic_connection_from_conv(pinfo);\n+    // check if the connection information is not already attached to the conversation.\n+    if(conn_from_conv==NULL && conn_from_conv!=conn){\n+        conversation_t *conv = find_conversation_pinfo(pinfo, 0);\n+        if (conv) {\n+            // attach the connection information to the conversation.\n+            conversation_add_proto_data(conv, proto_quic, conn);\n+        }\n+\n+    }\n+\n     return conn;\n }\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-quic.c",
      "old_path": "epan/dissectors/packet-quic.c",
      "a_mode": "100644",
