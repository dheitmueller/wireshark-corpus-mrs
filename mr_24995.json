  "changes_data": [
    {
      "diff": "@@ -93,8 +93,11 @@ HEADER_CHECK_FLAGS = $(shell pkg-config --cflags glib-2.0) \\\n override_dh_install:\n \tdh_install\n \t# check that all headers can be compiled\n-\tfind debian/*-dev/usr/include -type f | sed 's|.*/include/wireshark/|#include <|;s|$$|>|' | $(CC) -x c -S - $(HEADER_CHECK_FLAGS) -o /dev/null\n-\tfind debian/*-dev/usr/include -type f | sed 's|.*/include/wireshark/|#include <|;s|$$|>|' | $(CC) -x c++ -S - $(HEADER_CHECK_FLAGS) -o /dev/null\n+\t# plugin_exports.h is for building plugins, and requires setting WS_BUILD_DLL\n+\tfind debian/*-dev/usr/include -type f -not -name \"plugin_exports.h\" | sed 's|.*/include/wireshark/|#include <|;s|$$|>|' | $(CC) -x c -S - $(HEADER_CHECK_FLAGS) -o /dev/null\n+\tfind debian/*-dev/usr/include -type f -not -name \"plugin_exports.h\" | sed 's|.*/include/wireshark/|#include <|;s|$$|>|' | $(CC) -x c++ -S - $(HEADER_CHECK_FLAGS) -o /dev/null\n+\tfind debian/*-dev/usr/include -name \"plugin_exports.h\" | sed 's|.*/include/wireshark/|#include <|;s|$$|>|' | $(CC) -x c -S - $(HEADER_CHECK_FLAGS) -DWS_BUILD_DLL -o /dev/null\n+\tfind debian/*-dev/usr/include -name \"plugin_exports.h\" | sed 's|.*/include/wireshark/|#include <|;s|$$|>|' | $(CC) -x c++ -S - $(HEADER_CHECK_FLAGS) -DWS_BUILD_DLL -o /dev/null\n \t# check than #include-ing the most widely used headers compiles\n \t$(CC) -c debian/headers-check.c $(HEADER_CHECK_FLAGS) -o /dev/null\n \n",
