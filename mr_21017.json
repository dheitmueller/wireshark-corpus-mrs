    {
      "id": "495f0b386a338e97bd5a380c8076a664f62435f5",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2705184373,
          "type": null,
          "body": "Incidentally, C23 clarified this so it's no longer UB when the length is zero, as N3322 was accepted:\n\nhttps://www.open-std.org/jtc1/sc22/wg14/www/docs/n3322.pdf\n\nIn fact, the recommendation came to apply the change retroactively, which is interesting.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-08-24T14:51:47.928Z",
          "updated_at": "2025-08-24T15:04:35.523Z",
          "system": false,
          "noteable_id": 409453902,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 21017,
