      "diff": "@@ -4861,7 +4861,13 @@ sharkd_session_process_download(char *buf, const jsmntok_t *tokens, int count)\n     const char *tok_token      = json_find_attr(buf, tokens, count, \"token\");\n \n     if (!tok_token)\n+    {\n+        sharkd_json_error(\n+            rpcid, -10005, NULL,\n+            \"missing token\"\n+        );\n         return;\n+    }\n \n     if (!strncmp(tok_token, \"eo:\", 3))\n     {\n@@ -4974,6 +4980,13 @@ sharkd_session_process_download(char *buf, const jsmntok_t *tokens, int count)\n             );\n         }\n     }\n+    else\n+    {\n+        sharkd_json_error(\n+            rpcid, -10004, NULL,\n+            \"unrecognized token\"\n+        );\n+    }\n }\n \n static void\n",
