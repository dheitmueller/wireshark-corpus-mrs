      "diff": "@@ -2591,9 +2591,8 @@ wtap_dump_close(wtap_dumper *wdh, bool *needs_reload,\n \t\tif (ret) {\n \t\t\t/* The per-format finish function succeeded,\n \t\t\t   but the stream close didn't.  Save the\n-\t\t\t   reason why, if our caller asked for it. */\n-\t\t\tif (err != NULL)\n-\t\t\t\t*err = errno;\n+\t\t\t   reason why. */\n+\t\t\t*err = errno;\n \t\t}\n \t\tret = false;\n \t}\n",
