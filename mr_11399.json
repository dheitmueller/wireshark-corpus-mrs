  "changes_data": [
    {
      "diff": "@@ -836,6 +836,14 @@ dissect_dtls_record(tvbuff_t *tvb, packet_info *pinfo,\n      */\n     col_append_sep_str(pinfo->cinfo, COL_INFO, NULL, \"Continuation Data\");\n \n+    /* If GUI, show unrecognized data in tree */\n+    ti = proto_tree_add_item(tree, hf_dtls_record, tvb,\n+                                offset, dtls_record_length, ENC_NA);\n+    dtls_record_tree = proto_item_add_subtree(ti, ett_dtls_record);\n+    proto_item_set_text(dtls_record_tree, \"%s Record Layer: unrecognized content type 0x%02x\",\n+                        val_to_str_const(session->version, ssl_version_short_names, \"DTLS\"),\n+                        content_type);\n+\n     /* Set the protocol column */\n     col_set_str(pinfo->cinfo, COL_PROTOCOL, \"DTLS\");\n     return offset + dtls_record_length;\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-dtls.c",
      "old_path": "epan/dissectors/packet-dtls.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -107,6 +107,7 @@ const value_string ssl_versions[] = {\n     { DTLSV1DOT0_OPENSSL_VERSION, \"DTLS 1.0 (OpenSSL pre 0.9.8f)\" },\n     { DTLSV1DOT0_VERSION,   \"DTLS 1.0\" },\n     { DTLSV1DOT2_VERSION,   \"DTLS 1.2\" },\n+    { DTLSV1DOT3_VERSION,   \"DTLS 1.3\" },\n     { 0x0A0A,               \"Reserved (GREASE)\" }, /* RFC 8701 */\n     { 0x1A1A,               \"Reserved (GREASE)\" }, /* RFC 8701 */\n     { 0x2A2A,               \"Reserved (GREASE)\" }, /* RFC 8701 */\n",
      "collapsed": false,
