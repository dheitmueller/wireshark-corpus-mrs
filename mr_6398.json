    {
      "id": "b37e54e1fe27915093e16ecb882352cea5b2b033",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 870860603,
          "type": null,
          "body": "@jvalverde It's a little confusing to remember which filter operator to use, especially when having to switch between different versions of Wireshark. Here's the differences that I'm running into, but these all do the same thing. Examples:\n\n1. Wireshark 3.4: protocol.field != 0 (I know this one wasn't intended to work that way, but it did :) )\n2. Wireshark 3.6: protocol.field ~= 0\n3. Wireshark 3.7: protocol.field !== 0",
          "author": {
            "id": 6776884,
            "username": "daulis0",
            "public_email": "",
            "name": "Dylan Ulis",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/c68acd7dda7fdc901223951806239c2a73929b808558dfddefbcc6fa0176ca02?s=80&d=identicon",
            "web_url": "https://gitlab.com/daulis0"
          },
          "created_at": "2022-03-10T21:44:32.070Z",
          "updated_at": "2022-03-10T21:44:32.070Z",
          "system": false,
          "noteable_id": 144109198,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 6398,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "bfcfbb6a30953c36513978e77bb92f49539cc41f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 870936300,
          "type": null,
          "body": "I get that it is a little confusing between major releases but `~=` will still work in 3.7/4.0 to ease the transition. Took a few iterations to flesh out the details of the new operators and 3.6 got caught in the middle.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2022-03-10T22:32:45.983Z",
          "updated_at": "2022-03-11T02:12:24.218Z",
