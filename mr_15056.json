  "changes_data": [
    {
      "diff": "@@ -18,7 +18,7 @@\n  * At present, we use C Protocol Buffers Language Parser which generated by protobuf_lang_parser.lemon and protobuf_lang_scanner.l.\n  * Because wireshark is mainly implemented in plain ANSI C but the official protobuf library is implemented in C++ language.\n  *\n- * One day, if C++ library is allowd, we can create a protobuf-helper.cpp file, that invoking official protobuf C++ library directly,\n+ * One day, if C++ library is allowed, we can create a protobuf-helper.cpp file, that invoking official protobuf C++ library directly,\n  * to replace protobuf-helper.c. The packet-protobuf.c can keep unchanged.\n  */\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/protobuf-helper.c",
      "old_path": "epan/protobuf-helper.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -1052,7 +1052,9 @@ pbl_add_child(pbl_node_t* parent, pbl_node_t* child)\n         ((pbl_option_descriptor_t*)child)->value = g_strconcat(oval, \",\", nval, NULL);\n         g_free(nval);\n     } else if (node && child->file && parent->file\n-        && child->file->pool && child->file->pool->error_cb) {\n+\t\t&& child->file->pool && child->file->pool->error_cb\n+\t\t/* Let's assume that any set of base types we point at are valid.. */\n+\t\t&& !strstr(node->file->filename, \"google\")) {\n         child->file->pool->error_cb(\n             \"Protobuf: Warning: \\\"%s\\\" of [%s:%d] is already defined in file [%s:%d].\\n\",\n             child->name, child->file->filename, child->lineno, node->file->filename, node->lineno);\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/protobuf_lang_tree.c",
      "old_path": "epan/protobuf_lang_tree.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    }
