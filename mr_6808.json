  "changes_data": [
    {
      "diff": "@@ -350,22 +350,30 @@ development of Wireshark scripts and plugins.\n # either macro, and thus presumably does in-source builds.)\n %{?!__cmake_builddir: %global __cmake_builddir %{?__builddir}%{!?__builddir:.}}\n \n+# SUSE 15.1 moved to out of source builds but automatically enters the\n+# builddir before building, but does not when entering %%install.\n+# Fedora, RHEL, and later versions of SUSE do the opposite.\n+\n %if 0%{?rhel} && ( 0%{?rhel} <= 7 ) || (0%{?suse_version} && 0%{?sle_version} <= 150100)\n %if %{with ninja}\n %ninja_build\n %else\n # Suggestion: put this in your ~/.rpmmacros (without the hash sign, of course):\n # %_smp_mflags -j %(grep -c processor /proc/cpuinfo)\n+%if (0%{?suse_version} && 0%{?sle_version} <= 150100)\n+make %{?_smp_mflags}\n+%else\n make %{?_smp_mflags} -C %{__cmake_builddir}\n %endif\n+%endif\n %else\n %cmake_build\n %endif\n \n %install\n rm -rf $RPM_BUILD_ROOT\n-%if 0%{?suse_version} && 0%{?sle_version} <= 150100\n-cd build\n+%if (0%{?suse_version} && 0%{?sle_version} <= 150100) && %{with ninja}\n+cd %{__cmake_builddir}\n %endif\n \n %if 0%{?rhel} && ( 0%{?rhel} <= 7 ) || (0%{?suse_version} && 0%{?sle_version} <= 150100)\n@@ -386,10 +394,6 @@ make DESTDIR=$RPM_BUILD_ROOT install_guides -C %{__cmake_builddir}\n %endif\n %endif\n \n-%if 0%{?suse_version} && 0%{?sle_version} <= 150100\n-cd -\n-%endif\n-\n # If we're being installed in an unusual prefix tell the loader where\n # to find our libraries.\n %if \"%{_prefix}\" != \"/usr\"\n",
