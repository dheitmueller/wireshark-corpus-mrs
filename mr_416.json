            "avatar_url": "https://secure.gravatar.com/avatar/88911e6cfe3dfc07b327385209d35a46898b5f12538fcb9fe0d5cf97dd7b94d2?s=80&d=identicon",
            "web_url": "https://gitlab.com/sahlberg"
          },
          "resolved_at": "2020-09-28T23:08:34.611Z",
          "confidential": false,
