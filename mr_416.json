        {
          "id": 419316792,
          "type": "DiscussionNote",
          "body": "Here is a link to the request (and it links to the capture).\nhttps://ask.wireshark.org/question/18656/parse-smb-over-quic-packets/\n\nThe problem is that after it has completed reassembly of packets 39/40\nwhen we get to packet 46, which starts the next pdu (consisting of packets 46 and 47), we incorrectly re-use the msp from packets 39/40 and thus we don't dissect it. And we do not start a new msp for 46/47.",
          "author": {
            "id": 7014716,
            "username": "sahlberg",
            "public_email": "",
            "name": "Ronnie Sahlberg",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/88911e6cfe3dfc07b327385209d35a46898b5f12538fcb9fe0d5cf97dd7b94d2?s=80&d=identicon",
            "web_url": "https://gitlab.com/sahlberg"
          },
          "created_at": "2020-09-27T23:45:50.916Z",
          "updated_at": "2020-09-27T23:46:15.981Z",
          "system": false,
          "noteable_id": 72200690,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
