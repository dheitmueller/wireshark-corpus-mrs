      "notes": [
        {
          "id": 624030392,
          "type": "DiscussionNote",
          "body": "Hi,\nI finaly had some time to look at this. It seems wrong to me to decode as grpc, the next protocol up from\nTCP is HTTP2 as far as I can tell. So it think that is what you should do \"decode as\" for.\nOther opinion any one?",
          "author": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
            "web_url": "https://gitlab.com/AndersBroman"
          },
          "created_at": "2021-07-12T14:31:07.891Z",
          "updated_at": "2021-07-31T02:32:42.860Z",
          "system": false,
