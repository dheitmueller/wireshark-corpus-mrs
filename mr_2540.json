          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 2540,
          "commands_changes": {}
        },
        {
          "id": 640062606,
          "type": "DiscussionNote",
          "body": "I submit this MR because I see some people try to decode TCP directly as GRPC. They may think http2 is part of GRPC protocol.\n\nIf you think this is inappropriate, I will withdraw this MR.",
