  "changes_data": [
    {
      "diff": "@@ -616,6 +616,7 @@ macOS Universal Package:\n     - wireshark-macos-arm-package\n   retry: 1\n   script:\n+    - export PATH=\"/Library/Frameworks/Python.framework/Versions/3.13/bin:$PATH:$HOME/bin\"\n     - export WIRESHARK_BASE_DIR=${CI_PROJECT_DIR}/../wireshark-third-party\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n     - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir -p $WIRESHARK_BASE_DIR/Qt ; fi\n@@ -626,7 +627,6 @@ macOS Universal Package:\n         /tmp/aqt.venv/bin/aqt install-qt --outputdir $WIRESHARK_BASE_DIR/Qt mac desktop 6.5.3 clang_64 --modules qt5compat qtmultimedia ;\n       fi\n     - export CMAKE_PREFIX_PATH=$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION\n-    - export PATH=\"$PATH:$HOME/bin\"\n     - export PKG_CONFIG_PATH=\n     - mkdir build\n     - cd build\n",
