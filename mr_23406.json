      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3051489436,
          "type": null,
          "body": "So it was introduced by fb4fa949356dc4a68c79d418d2bc4bbe2fc48565 and then backported to 4.6. So we just need to pick a different name for the alloc-and-init function there.",
