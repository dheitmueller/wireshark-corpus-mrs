  "changes_data": [
    {
      "diff": "@@ -279,6 +279,14 @@ Debian Stable APT Test:\n   script:\n     - DEBIAN_FRONTEND=noninteractive apt-get install ./debian-packages/*.deb -y\n     - tshark --version\n+  after_script:\n+    # Used for https://www.wireshark.org/docs/dfref/\n+    - TSHARK_VERSION=$( tshark --version | head -n 1 | sed -e 's/.*(v//' -e 's/)\\.*$//' -e 's/-0-g.*//' )\n+    - tshark -G fields > dfilter-list-${TSHARK_VERSION}.txt\n+    - if [[ -n \"$S3_DESTINATION_DIST\" ]] && [[ $TSHARK_VERSION =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] ; then aws s3 cp dfilter-list-${TSHARK_VERSION}.txt \"$S3_DESTINATION_DIST/\" ; fi\n+  artifacts:\n+    paths:\n+      - dfilter-list-*.txt\n   variables:\n     GIT_STRATEGY: none\n   needs: [ 'Debian Stable APT Package' ]\n",
