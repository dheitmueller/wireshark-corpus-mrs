    {
      "id": "1dcb5b5249bee4955370e299e1ac810068a3af91",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 487293953,
          "type": null,
          "body": "I agree with @graham.bloice. Where did the developers read about how writing an extcap? In some doc/manual/wsdg/wiki/etc. That is the place where the info should stay. There is no point in giving extra info with a local readme.",
          "author": {
            "id": 277876,
            "username": "crondaemon",
            "public_email": "",
            "name": "Dario Lombardo",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/143ae7a6f9e11c9eed24a7fdb44bb40d442fd274ba01a2e3a4abe1596819bea2?s=80&d=identicon",
            "web_url": "https://gitlab.com/crondaemon"
          },
          "created_at": "2021-01-17T20:28:18.742Z",
          "updated_at": "2021-01-17T20:28:18.742Z",
