      "resolved": false,
      "notes": [
        {
          "id": 909074909,
          "type": "DiscussionNote",
          "body": "Why not make everything `size_t`?  (`size_t` is bigger than a `long` on 64-bit Windows.)",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-04-11T22:27:27.672Z",
          "updated_at": "2022-04-11T22:55:22.274Z",
          "system": false,
          "noteable_id": 149867800,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 6679,
          "commands_changes": {}
        },
        {
          "id": 909097891,
          "type": "DiscussionNote",
          "body": "Because the offset is a signed number. I could use `ssize_t` but it's a POSIX extension so I didn't, even though we provide a replacement on Windows.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
