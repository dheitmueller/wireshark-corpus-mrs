  "changes_data": [
    {
      "diff": "@@ -1435,3 +1435,84 @@ void ws_log_print_usage(FILE *fp)\n     fprintf(fp, \"  --log-noisy <[!]list>    \" USAGE_NOISY \"\\n\");\n     fprintf(fp, \"  --log-file <path>        \" USAGE_FILE \"\\n\");\n }\n+\n+static gboolean\n+gopt_set_level(const char *option_name _U_, const char *value, void *data _U_, GError **err)\n+{\n+    if (ws_log_set_level_str(value) == LOG_LEVEL_NONE) {\n+        g_set_error(err, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,\n+                    \"Invalid log level \\\"%s\\\".\", value);\n+        return false;\n+    }\n+    return true;\n+}\n+\n+static gboolean\n+gopt_fatal(const char *option_name _U_, const char *value, void *data _U_, GError **err)\n+{\n+    if (ws_log_set_fatal_level_str(value) == LOG_LEVEL_NONE) {\n+        g_set_error(err, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,\n+                    \"Fatal log level must be \\\"critical\\\" or \\\"warning\\\", not \\\"%s\\\".\", value);\n+        return false;\n+    }\n+    return true;\n+}\n+\n+static gboolean\n+gopt_domains(const char *option_name _U_, const char *value, void *data _U_, GError **err _U_)\n+{\n+    ws_log_set_domain_filter(value);\n+    return true;\n+}\n+\n+static gboolean\n+gopt_fatal_domains(const char *option_name _U_, const char *value, void *data _U_, GError **err _U_)\n+{\n+    ws_log_set_fatal_domain_filter(value);\n+    return true;\n+}\n+\n+static gboolean\n+gopt_debug_domains(const char *option_name _U_, const char *value, void *data _U_, GError **err _U_)\n+{\n+    ws_log_set_debug_filter(value);\n+    return true;\n+}\n+\n+static gboolean\n+gopt_noisy_domains(const char *option_name _U_, const char *value, void *data _U_, GError **err _U_)\n+{\n+    ws_log_set_noisy_filter(value);\n+    return true;\n+}\n+\n+static gboolean\n+gopt_file(const char *option_name _U_, const char *value, void *data _U_, GError **err)\n+{\n+    FILE *fp = ws_fopen(value, \"w\");\n+    if (fp == NULL) {\n+        g_set_error(err, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,\n+                    \"Error opening file '%s' for writing: %s.\", value, g_strerror(errno));\n+        return false;\n+    }\n+    ws_log_add_custom_file(fp);\n+    return true;\n+}\n+\n+GOptionGroup *ws_log_get_option_group(void)\n+{\n+    static GOptionEntry glib_log_entries[] = {\n+        { \"log-level\", 0, 0, G_OPTION_ARG_CALLBACK, &gopt_set_level, USAGE_LEVEL, \"<level>\" },\n+        { \"log-fatal\", 0, 0, G_OPTION_ARG_CALLBACK, &gopt_fatal, USAGE_FATAL, \"<level>\" },\n+        { \"log-domains\", 0, 0, G_OPTION_ARG_CALLBACK, &gopt_domains, USAGE_DOMAINS, \"<[!]list>\" },\n+        { \"log-fatal-domains\", 0, 0, G_OPTION_ARG_CALLBACK, &gopt_fatal_domains, USAGE_FATAL_DOMAINS, \"<list>\" },\n+        { \"log-debug\", 0, 0, G_OPTION_ARG_CALLBACK, &gopt_debug_domains, USAGE_DEBUG, \"<[!]list>\" },\n+        { \"log-noisy\", 0, 0, G_OPTION_ARG_CALLBACK, &gopt_noisy_domains, USAGE_NOISY, \"<[!]list>\" },\n+        { \"log-file\", 0, 0, G_OPTION_ARG_CALLBACK, &gopt_file, USAGE_FILE, \"<path>\" },\n+        { NULL, 0, 0, G_OPTION_ARG_NONE, NULL, NULL, NULL }\n+    };\n+\n+    GOptionGroup *group = g_option_group_new(\"log\", \"Logging Options\", \"Show logging options\", NULL, NULL);\n+    g_option_group_add_entries(group, glib_log_entries);\n+    return group;\n+}\n",
