      "resolvable": false,
      "notes": [
        {
          "id": 530979516,
          "type": null,
          "body": "In any case, with !2426, !2428, !2433, and !2435, and their backports to 3.4, this particular issue should be resolved.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-03-16T23:26:16.172Z",
          "updated_at": "2021-03-16T23:26:16.172Z",
          "system": false,
          "noteable_id": 88608167,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 2117,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "5df5f6cc21c57c2f78e6926ddd13c1f97bc038d5",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 530985474,
          "type": null,
          "body": "Or we could simply declare the\n\n    #ifdef __cplusplus\n    extern \"C\" {\n    #endif /* __cplusplus */\n\n...\n\n    #ifdef __cplusplus\n    }\n    #endif /* __cplusplus */\n\ntrope to be overrated and, instead, do something such as\n\n    #ifdef __cplusplus\n    #define WS_DLL_PUBLIC WS_DLL_PUBLIC_DEF extern \"C\"\n    #else /* __cplusplus */\n    #define WS_DLL_PUBLIC WS_DLL_PUBLIC_DEF extern\n    #endif /* __cplusplus */\n\nin ws_symbol_export.h, and get rid of all those brackets.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
