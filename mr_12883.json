      "notes": [
        {
          "id": 2524583866,
          "type": null,
          "body": "Hi @WFA-achuang,could you please share why the handling of S1G NDP specific fields was removed? These fields are essential for analyzing IEEE 802.11ah network traffic. What steps would be required to restore them in Wireshark? I am happy to do the work required to make this happen but I need an understating of the original issue first. Thank you.",
          "author": {
            "id": 28009592,
            "username": "a.baumann.morse",
            "public_email": null,
            "name": "Adam Baumann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/7139830809fefdbdf8c4f7f6a5d09099cf4a59739677f1ba6145350c8a90ef86?s=80&d=identicon",
            "web_url": "https://gitlab.com/a.baumann.morse"
          },
          "created_at": "2025-05-26T01:15:51.179Z",
          "updated_at": "2025-05-26T01:15:51.179Z",
