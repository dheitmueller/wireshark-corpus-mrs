{
  "id": 379367266,
  "iid": 19694,
  "project_id": 7898047,
  "title": "FT_ABSOLUTE_TIME: support special time values with special meanings.",
  "description": "Allow a time_value_string table to be associated with FT_ABSOLUTE_TIME\nfields; if the time has one of the values in the table, display it as\nthe corresponding string, rather than as the specified date and time.\n\nThis can handle, for example, certain Zigbee fields, where a value of 0\n(corresponding to the Zigbee epoch, 2000-01-01 00:00:00 UTC) means\n\"Now\", and, for some of those fields, a value of 0xFFFFFFFF means\n\"cancel a previous request\".",
  "state": "merged",
  "created_at": "2025-04-27T16:59:40.904Z",
  "updated_at": "2025-04-28T04:53:07.329Z",
