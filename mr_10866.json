    {
      "id": "8cc9534d70867b9fe4876d615f00faebc509e2c6",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2226753292,
          "type": null,
          "body": "`dfilter/semcheck.c` `mk_fvalue_from_val_string` converts strings in tests to numbers if the string is unique in the value string. As mentioned above, what it should do is test to see if that string is used for the same number in all fields with the same abbreviation (to avoid both false positives and false negatives.)\n\nThat would mean that matching-via-value-string is slower with multiple registrations with different value strings, but it would be more accurate.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-11-25T14:40:26.146Z",
          "updated_at": "2024-11-25T14:40:26.146Z",
          "system": false,
          "noteable_id": 227363740,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 10866,
          "commands_changes": {}
        }
      ]
    }
