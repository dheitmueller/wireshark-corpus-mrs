  "commits_data": [
    {
      "id": "1a9bc62cec4f796f0b220a7c4ceeed09eda4c9a4",
      "short_id": "1a9bc62c",
      "created_at": "2022-10-08T09:10:14.000+02:00",
      "parent_ids": [
        "a1ec85089478ea88d68f10d4d68772307127845e"
      ],
      "title": "RTP Player: Fix: Only silence played on Windows with Qt 6.x",
      "message": "RTP Player: Fix: Only silence played on Windows with Qt 6.x\n\nQt 6.x has different timing of events during audio play than Qt 5.x on\nWin32 or Qt6.x on Linux/Mac. It caused race condition which removed\nstream from playback queue sooner it was really played.\nIt was random (some audio streams triggered it, some didn't).\n\nCloses 18413\n",
      "author_name": "Jirka Novak",
      "author_email": "j.novak@netsystem.cz",
      "authored_date": "2022-10-08T09:10:14.000+02:00",
      "committer_name": "Jirka Novak",
      "committer_email": "j.novak@netsystem.cz",
      "committed_date": "2022-10-08T09:10:14.000+02:00",
