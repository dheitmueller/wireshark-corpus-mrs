    {
      "id": "ad985c0d83a90ef81e2e0a94aa972ac225c29ff5",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2321508300,
          "type": null,
          "body": "Incidentally, my understanding is that the licensing issue with OpenSSL was related to it having a 4-clause BSD like license with advertising clause. Does Debian have any opinion about libpcap, which has some files (mostly header files) with a 4-clause BSD license variant that mentions Lawrence Berkeley Laboratory (instead of the standard UC Berkeley)? Is linking against libpcap with GPL licensed code an issue?\n\nlibpcap describes itself (and is described elsewhere, e.g., https://www.freshports.org/net/libpcap/ ) as BSD 3-clause, but I don't know whether the license on specific files such as [pcap/pcap.h](https://github.com/the-tcpdump-group/libpcap/blob/master/pcap/pcap.h) affects anything.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-01-29T22:33:52.994Z",
          "updated_at": "2025-01-29T22:33:52.994Z",
          "system": false,
          "noteable_id": 357420803,
