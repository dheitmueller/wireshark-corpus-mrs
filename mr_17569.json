      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -184,7 +184,8 @@ if [ $INSTALL_LOGRAY -ne 0 ] ; then\n         patch -p1 < \"../tools/macos-setup-patches/falco-uthash_h-install.patch\"\n         mkdir build_dir\n         cd build_dir\n-        cmake -DBUILD_SHARED_LIBS=ON -DMINIMAL_BUILD=ON -DCREATE_TEST_TARGETS=OFF \\\n+        cmake -DFALCOSECURITY_LIBS_VERSION=\"$FALCO_LIBS_VERSION\" \\\n+            -DBUILD_SHARED_LIBS=ON -DMINIMAL_BUILD=ON -DCREATE_TEST_TARGETS=OFF \\\n             -DUSE_BUNDLED_DEPS=ON -DUSE_BUNDLED_CARES=OFF -DUSE_BUNDLED_ZLIB=OFF \\\n             -DUSE_BUNDLED_JSONCPP=OFF -DUSE_BUNDLED_TBB=OFF -DUSE_BUNDLED_RE2=OFF \\\n             ..\n",
