      "notes": [
        {
          "id": 3296148789,
          "type": "DiscussionNote",
          "body": "Should we 1) introduce a `wmem_array` call to create an array with an initial size and 2) use `wmem_array`s here, so that the `wmem_array` code can do the array bounds checking for us? That might avoid off-by-one errors.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2026-04-28T18:48:09.795Z",
          "updated_at": "2026-04-29T07:51:38.511Z",
          "system": false,
          "noteable_id": 479018473,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
