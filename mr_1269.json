      "notes": [
        {
          "id": 466821960,
          "type": "DiscussionNote",
          "body": "Already proposed by @moshekaplan in !18. The problem here is that you have to propose a set of patches that fix the issues raised by SAST, and then the CI change. Otherwise the ci will start to fail and that will prevent any other MR to be merged.\n\nThat said, I'm not sure all the fixes are easy without deep changes in the project structure.",
          "author": {
            "id": 277876,
            "username": "crondaemon",
            "public_email": "",
            "name": "Dario Lombardo",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/143ae7a6f9e11c9eed24a7fdb44bb40d442fd274ba01a2e3a4abe1596819bea2?s=80&d=identicon",
            "web_url": "https://gitlab.com/crondaemon"
          },
          "created_at": "2020-12-15T08:17:57.244Z",
          "updated_at": "2020-12-15T13:27:46.039Z",
          "system": false,
          "noteable_id": 81708479,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
