  "commits_data": [
    {
      "id": "faf03149af99e648bbf7308ab518c7128b8e1871",
      "short_id": "faf03149",
      "created_at": "2021-11-18T19:24:09.000+00:00",
      "parent_ids": [
        "61e4529fe57e548d25358e1f4cdd3777c7745983"
      ],
      "title": "Don't close stdin on spawn error",
      "message": "Don't close stdin on spawn error\n\nThis solves the following issue:\n\nIn cases where `mmdbresolve` fails to execute (e.g. when it's simply\nmissing from a tree) the spawn fails such that a zero initialized file\ndescriptor is closed (i.e. stdin). The close is silent, unless one\nexecutes something like `tshark -r - ...` where a bad file descriptor\nis reported then.\n",
      "author_name": "Georg Sauthoff",
      "author_email": "mail@gms.tf",
      "authored_date": "2021-11-12T23:26:05.000+01:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-11-18T19:24:09.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/faf03149af99e648bbf7308ab518c7128b8e1871"
    }
