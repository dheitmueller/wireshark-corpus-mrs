  "changes_data": [
    {
      "diff": "@@ -625,9 +625,10 @@ macOS Universal Package:\n     - ../tools/make-version.py --set-release --wireshark-version-file=wireshark_version.txt --stratoshark-version-file=stratoshark_version.txt ..\n     - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n     # macos-setup.sh installs libxml2, but we want the one from the macOS SDK.\n-    - mv /usr/local/lib/pkgconfig/libxml-2.0.pc /usr/local/lib/pkgconfig/libxml-2.0.pc.disable\n     - cmake -G Ninja\n       -DENABLE_CCACHE=ON\n+      -DLIBXML2_INCLUDE_DIR=/Library/Developer/CommandLineTools/SDKs/MacOSX13.3.sdk/usr/include/libxml2\n+      -DLIBXML2_LIBRARY=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib/libxml2.tbd\n       -DWIRESHARK_BASE_DIR=$WIRESHARK_BASE_DIR\n       -DCMAKE_OSX_DEPLOYMENT_TARGET=12.0\n       -DCMAKE_OSX_ARCHITECTURES=\"arm64;x86_64\"\n@@ -635,7 +636,6 @@ macOS Universal Package:\n       -DFALCO_PLUGINS=\"$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libcloudtrail.so;$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libgcpaudit.so\"\n       -DTEST_EXTRA_ARGS=--enable-release\n       ..\n-    - mv /usr/local/lib/pkgconfig/libxml-2.0.pc.disable /usr/local/lib/pkgconfig/libxml-2.0.pc\n     # The Falco libs 0.20.0 package at https://dev-libs.wireshark.org/macos/packages/falcosecurity-libs/\n     # is missing uthash.h.\n     - ( cd $WIRESHARK_BASE_DIR/macos-universal-master/include ; curl -JLO https://raw.githubusercontent.com/troydhanson/uthash/refs/tags/v1.9.8/src/uthash.h )\n",
      "collapsed": false,
      "too_large": false,
      "new_path": ".gitlab-ci.yml",
      "old_path": ".gitlab-ci.yml",
