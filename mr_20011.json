      "notes": [
        {
          "id": 2533492413,
          "type": "DiffNote",
          "body": "This heuristic returns true if the captured length is 6 + the first four bytes interpreted as a network byte order 32 bit integer. That seems likely to lead to too many false positives (it's not that's it's inherently probable, but a lot of protocols might have a length field in the first 4 octets), so this has to be `HEURISTIC_DISABLE` by default unless you can come up with something more discriminating.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
