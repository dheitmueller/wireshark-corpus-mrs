  "discussions_data": [
    {
      "id": "cbaf94cac8ec4ac34303174765038a1fc744124b",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1691513227,
          "type": null,
          "body": "I noticed this too, though for some reason I only get these errors when building with GCC 13.2 and Qt5, but not with Qt6.\n\nUnfortunately `-Wclobbered` has been broken on gcc for a long time (https://gcc.gnu.org/bugzilla/show_bug.cgi?id=21161 https://gcc.gnu.org/bugzilla/show_bug.cgi?id=61118 https://gcc.gnu.org/bugzilla/show_bug.cgi?id=65041) and it will definitely optimize code across lngjmps (while automatically inline static functions, etc.) and make things clobbered that otherwise wouldn't be.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
