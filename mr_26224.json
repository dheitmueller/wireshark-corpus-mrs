  "changes_data": [
    {
      "diff": "@@ -2127,7 +2127,7 @@ dissect_ieee802154(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void* da\n     unsigned fcs_len;\n     int fcs_type;\n \n-    fcs_type = data ? *(int *)data : ieee802154_fcs_type;\n+    fcs_type = (data && data != (void *)pinfo->pseudo_header) ? *(int *)data : ieee802154_fcs_type;\n \n     /* Set the default FCS length based on the FCS type in the configuration */\n     fcs_len = ieee802154_fcs_type_len(fcs_type);\n",
