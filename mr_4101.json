        {
          "id": 669439500,
          "type": "DiscussionNote",
          "body": "I have the impression it's becoming religios somehow...\n\nThis has nothing to do with LUA listeners. This is about Plugins that are written in C using the Wireshark C API.\n\nI am aware that this impacts performance. But I don't see a reason to prohibit C Plugins to use this API while everything that is not a plugin may use it.",
          "author": {
            "id": 7625625,
            "username": "Developer-Alexander",
            "public_email": "",
            "name": "Developer Alexander",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/81b3f01484e58a678d9a77825dd6726e0e7e2383b67d9a16215a35fe0a729529?s=80&d=identicon",
            "web_url": "https://gitlab.com/Developer-Alexander"
          },
          "created_at": "2021-09-04T09:54:03.824Z",
          "updated_at": "2021-09-04T09:54:03.824Z",
          "system": false,
          "noteable_id": 115471101,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 2498449,
            "username": "rknall",
            "public_email": "",
            "name": "Roland Knall",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9e1d973c5007651b2ca47071f80324c2de5349d873e365cf0761df5542dfe382?s=80&d=identicon",
            "web_url": "https://gitlab.com/rknall"
