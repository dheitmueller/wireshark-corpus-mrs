        {
          "id": 1276099642,
          "type": "DiscussionNote",
          "body": "The choice to configure for msys2 is deliberate. Wireshark's Win32 build has deeply ingrained assumptions about using our dependency repository which also assumes MSVC and fixing that while also supporting MSVC/MinGW/MinGW+MSYS2 is a big project in itself, one which I'm not keen to take on. So the choices to build on Windows currently are msys2 or MSVC. So the dependency on msys2 environment variables is a non-issue.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
