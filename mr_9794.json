    {
      "id": "14f9f63084b5a316f79194a1bcd6e78fc25d340c",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1275998325,
          "type": "DiscussionNote",
          "body": "On another note, MSYSTEM and MSYSTEM_CARCH are private environment variables for msys2 only. Instead, CMAKE_SYSTEM_PROCESSOR should be used in all cases like in my previous merge request.",
          "author": {
            "id": 6402851,
            "username": "Biswa96",
            "public_email": "",
            "name": "Biswapriyo Nath",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6402851/avatar.png?v=1788961788",
            "web_url": "https://gitlab.com/Biswa96"
          },
          "created_at": "2023-02-13T10:24:47.206Z",
          "updated_at": "2023-02-13T11:25:54.942Z",
          "system": false,
          "noteable_id": 205044318,
