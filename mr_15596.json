  "commits_data": [
    {
      "id": "f00047714e695b0b2ace5dbc3b76ce4552b24444",
      "short_id": "f0004771",
      "created_at": "2024-05-11T12:39:48.000+00:00",
      "parent_ids": [
        "fac9be32c221d9b4a18df8e193d5d1a3b16b2683"
      ],
      "title": "lua: Deregister heuristic lists added via heuristic_new on reload",
      "message": "lua: Deregister heuristic lists added via heuristic_new on reload\n\nThere's still a leak when reloading plugins because the created\nheuristic dissector list isn't returned to the caller. That also\nmeans there's no way of knowing if it succeeded, and using the\nheuristic list involves calling proto:register_heuristic with\nthe name, but rather than calling a function on a returned\nobject.\n\nFix #19603\n",
      "author_name": "John Thacker",
      "author_email": "johnthacker@gmail.com",
      "authored_date": "2024-05-11T07:33:10.000-04:00",
      "committer_name": "John Thacker",
      "committer_email": "johnthacker@gmail.com",
      "committed_date": "2024-05-11T12:39:48.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/f00047714e695b0b2ace5dbc3b76ce4552b24444"
    },
    {
      "id": "fac9be32c221d9b4a18df8e193d5d1a3b16b2683",
      "short_id": "fac9be32",
      "created_at": "2024-05-11T12:39:48.000+00:00",
      "parent_ids": [
        "c0b47f7a7b1a9d9acff86c0a54c165c854b9c979"
      ],
      "title": "epan: Add a method to deregister heuristic dissector lists by name",
      "message": "epan: Add a method to deregister heuristic dissector lists by name\n\nHeuristic dissectors lists don't necessarily (and don't usually)\nhave the name of a given dissector handle.\n\nThe Lua code needs to use this in order to deregister heuristic\ndissector lists added by Lua when Lua is reloaded.\n\nPart of #19603\n",
      "author_name": "John Thacker",
      "author_email": "johnthacker@gmail.com",
      "authored_date": "2024-05-10T23:21:06.000-04:00",
      "committer_name": "John Thacker",
      "committer_email": "johnthacker@gmail.com",
      "committed_date": "2024-05-11T12:39:48.000+00:00",
      "trailers": {},
