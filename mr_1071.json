  "changes_data": [
    {
      "diff": "@@ -4675,6 +4675,7 @@ proto_reg_handoff_dns(void)\n   dissector_add_uint_range_with_preference(\"tcp.port\", DEFAULT_DNS_TCP_PORT_RANGE, dns_handle);\n   dissector_add_uint_range_with_preference(\"udp.port\", DEFAULT_DNS_PORT_RANGE, dns_handle);\n   dissector_add_string(\"media_type\", \"application/dns-message\", dns_handle); /* since draft-ietf-doh-dns-over-https-07 */\n+  dissector_add_string(\"quic.proto\", \"doq\", dns_handle); /* https://www.ietf.org/archive/id/draft-ietf-dprive-dnsoquic-01.txt */\n   heur_dissector_add(\"udp\", dissect_dns_heur, \"DNS over UDP\", \"dns_udp\", proto_dns, HEURISTIC_ENABLE);\n }\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-dns.c",
      "old_path": "epan/dissectors/packet-dns.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -2422,9 +2422,13 @@ quic_get_1rtt_hp_cipher(packet_info *pinfo, quic_info_data_t *quic_info, gboolea\n         const char *proto_name = tls_get_alpn(pinfo);\n         if (proto_name) {\n             quic_info->app_handle = dissector_get_string_handle(quic_proto_dissector_table, proto_name);\n-            // If no specific handle is found, alias \"h3-*\" to \"h3\".\n-            if (!quic_info->app_handle && g_str_has_prefix(proto_name, \"h3-\")) {\n-                quic_info->app_handle = dissector_get_string_handle(quic_proto_dissector_table, \"h3\");\n+            // If no specific handle is found, alias \"h3-*\" to \"h3\" and \"doq-*\" to \"doq\"\n+            if (!quic_info->app_handle) {\n+                if (g_str_has_prefix(proto_name, \"h3-\")) {\n+                    quic_info->app_handle = dissector_get_string_handle(quic_proto_dissector_table, \"h3\");\n+                } else if (g_str_has_prefix(proto_name, \"doq-\")) {\n+                    quic_info->app_handle = dissector_get_string_handle(quic_proto_dissector_table, \"doq\");\n+                }\n             }\n         }\n     }\n",
      "collapsed": false,
      "too_large": false,
