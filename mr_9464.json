    {
      "id": "4e2521eb42537852b52ee6ce4cf0542218d29196",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1239926570,
          "type": null,
          "body": "MSYSTEM is a private environment in msys2 platform only. Sometimes, the compiler toolchain is used without msys2 environment, like adding the path directly in system PATH variable. It would be better if MSYSTEM or other msys2 specific variables are not used in cmake files directly. Instead, cmake's own variables like CMAKE_SYSTEM_PROCESSOR and/or CMAKE_SIZEOF_VOID_P would be a better choice.",
          "author": {
            "id": 6402851,
            "username": "Biswa96",
            "public_email": "",
            "name": "Biswapriyo Nath",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6402851/avatar.png?v=1788961788",
            "web_url": "https://gitlab.com/Biswa96"
          },
          "created_at": "2023-01-15T14:45:47.372Z",
          "updated_at": "2023-01-15T14:45:47.372Z",
          "system": false,
          "noteable_id": 199345871,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 9464,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "3b297fd05c9711a9e8f49ea7931f24756bb18eac",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1239957388,
          "type": null,
          "body": "Thanks for your interest in this. The dependency on msys2 is intentional and work is ongoing. At the moment using one of the msys2 shells is the only officially supported method to build Wireshark on Windows using Mingw-w64. That may or may not change in the future, depending on the level of interest from the community and having enough developers willing to support it.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2023-01-15T16:47:34.631Z",
          "updated_at": "2023-01-15T16:47:34.631Z",
