  "changes_data": [
    {
      "diff": "@@ -160,6 +160,10 @@ UBX protocol of u-blox GNSS receivers (UBX)\n   chunked encoding. This feature ensures the server stream messages of GRPC-Web\n   over HTTP/1.1 can be dissected even if the last chunk is absent.\n \n+* The media type dissector table now properly treats media types and subtypes\n+as case-insensitive automatically, per RFC 6838. Media types no longer need\n+to be lower cased before registering or looking up in the table.\n+\n Too many other protocols have been updated to list them all here.\n \n === New and Updated Capture File Support\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "docbook/release-notes.adoc",
      "old_path": "docbook/release-notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -19,7 +19,10 @@ proto_register_media_type(void)\n \t * Dissectors can register themselves in this table.\n \t * It's just \"media_type\", not \"http.content_type\", because\n \t * it's an Internet media type, used by other protocols as well.\n+\t *\n+\t * RFC 6838, 4.2 Naming Requirements:\n+\t * \"Both top-level type and subtype names are case-insensitive.\"\n \t */\n \t register_dissector_table(\"media_type\", \"Internet media type\",\n-\t     -1 /* no protocol */, FT_STRING, BASE_NONE);\n+\t     -1 /* no protocol */, FT_STRING, TRUE);\n }\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-media-type.c",
      "old_path": "epan/dissectors/packet-media-type.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    }
  ],
