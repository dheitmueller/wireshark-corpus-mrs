  "changes_data": [
    {
      "diff": "@@ -483,10 +483,15 @@ static int dissect_megaco_text_tcp(tvbuff_t *tvb, packet_info *pinfo, proto_tree\n      * The minimum length of a MEGACO message is 6?:\n      * Re-assembly ?\n      */\n-    if (is_tpkt(tvb, 6, NULL)) {\n+    if (!is_tpkt(tvb, 6, NULL)) {\n         /*\n          * It's not a TPKT packet;\n          * Is in MEGACO ?\n+         *\n+         * XXX - Why call dissect_tpkt_encap after deciding that\n+         * MEGACO is not in TPKT? For the Continuation case? But\n+         * dissect_megaco_text can call the data dissector if it\n+         * doesn't look like MEGACO, so it's duplicative.\n          */\n         dissect_megaco_text(tvb, pinfo, tree, data);\n     }\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-megaco.c",
      "old_path": "epan/dissectors/packet-megaco.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -544,7 +544,7 @@ dissect_tpkt_encap(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree,\n          */\n         save_fragmented = pinfo->fragmented;\n         length = length_remaining - 4;\n-        if (length > data_len) {\n+        if (length < data_len) {\n             pinfo->fragmented = true;\n         }\n         next_tvb = tvb_new_subset_length(tvb, offset, data_len);\n",
      "collapsed": false,
