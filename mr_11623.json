        {
          "id": 1505310892,
          "type": "DiscussionNote",
          "body": "> This change makes it possible to better troubleshoot DHCP cases\n\nAre the cases where the dissector could recognize the problem and provide an expert info item?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2023-08-08T22:41:59.964Z",
          "updated_at": "2023-10-01T09:00:22.035Z",
          "system": false,
          "noteable_id": 241942178,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
