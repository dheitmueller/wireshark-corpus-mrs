eturn QByteArray();\n-\n-\n-    int length = tvb_captured_length(edt_->tvb);\n-    const char *data = (const char *)tvb_get_ptr(edt_->tvb, 0, length);\n-    return QByteArray(data, length);\n+    return data_;\n }\n",
