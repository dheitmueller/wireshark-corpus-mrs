  "commits_data": [
    {
      "id": "e5eb17d41450e760b97e46fc223ac1b6ead0fd27",
      "short_id": "e5eb17d4",
      "created_at": "2021-11-08T22:20:24.000+00:00",
      "parent_ids": [
        "846b17ee9a5398d94da4aa465f8d5f462914b6c6"
      ],
      "title": "UAT: Allow missing fields.",
      "message": "UAT: Allow missing fields.\n\nAdd uat_set_default_values, which lets us provide default values for\nfields that might be missing from the end of a UAT line. Set a default\nvalue for the I/O Graph dialog's Y Axis Factor. Fixes the backward\ncompatibility issue described in #17623\n",
      "author_name": "Gerald Combs",
      "author_email": "gerald@wireshark.org",
      "authored_date": "2021-11-06T17:14:20.000-07:00",
      "committer_name": "Gerald Combs",
      "committer_email": "gerald@wireshark.org",
      "committed_date": "2021-11-08T22:20:24.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/e5eb17d41450e760b97e46fc223ac1b6ead0fd27"
    },
    {
      "id": "846b17ee9a5398d94da4aa465f8d5f462914b6c6",
      "short_id": "846b17ee",
      "created_at": "2021-11-08T22:20:24.000+00:00",
      "parent_ids": [
        "6e4e4ebd504845ea3569368441ec894e4fbde40a"
      ],
      "title": "UAT: Allow extra fields.",
      "message": "UAT: Allow extra fields.\n\nIf we encounter unexpected extra fields on a line, simply log a warning\nand continue instead of returning an error. This allows forward\ncompatibility when we add a field to a UAT. We end up throwing away the\nextra fields, but it's better than resetting the entire UAT. Fixes the\nforward compatibility issue described in #17623.\n",
      "author_name": "Gerald Combs",
      "author_email": "gerald@wireshark.org",
      "authored_date": "2021-11-06T13:52:01.000-07:00",
      "committer_name": "Gerald Combs",
      "committer_email": "gerald@wireshark.org",
      "committed_date": "2021-11-08T22:20:24.000+00:00",
      "trailers": {},
