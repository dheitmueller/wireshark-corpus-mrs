      "resolvable": false,
      "notes": [
        {
          "id": 2348135485,
          "type": null,
          "body": "For the UDP and TCP dissection, the heuristic for HiPerConTracer headers could check for the standard Echo server port (7) and may be also 7777 (for user-space servers), and ignore well-known ports for other services. This would likely remove the issue for almost all users.",
          "author": {
            "id": 5649708,
            "username": "dreibh",
            "public_email": "dreibh@simula.no",
            "name": "Thomas Dreibholz",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/b2cd008b76724c78722d428c7836d7a098cbae94d69faf8142e43fc2445bec17?s=80&d=identicon",
