      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -215,8 +215,8 @@ FolderListModel::FolderListModel(QObject * parent):\n #endif\n \n     /* Extcap */\n-    appendRow(QStringList() << tr(\"Personal Extcap path\") << QString(get_persconffile_path(\"extcap\", FALSE)).trimmed() << tr(\"external capture (extcap) plugins\"));\n-    appendRow(QStringList() << tr(\"Global Extcap path\") << QString(get_extcap_dir()).trimmed() << tr(\"external capture (extcap) plugins\"));\n+    appendRow(QStringList() << tr(\"Personal Extcap path\") << QString(get_extcap_pers_dir()) << tr(\"external capture (extcap) plugins\"));\n+    appendRow(QStringList() << tr(\"Global Extcap path\") << QString(get_extcap_dir()) << tr(\"external capture (extcap) plugins\"));\n \n #ifdef HAVE_MAXMINDDB\n     /* MaxMind DB */\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "ui/qt/about_dialog.cpp",
      "old_path": "ui/qt/about_dialog.cpp",
      "a_mode": "100644",
