  "changes_data": [
    {
      "diff": "@@ -64,11 +64,11 @@\n     expire_in: 3 days\n \n # Rely on fedora:latest and debian-stable jobs for testing a recent GCC version.\n-clang-10: &clang-10\n+clang-11: &clang-11\n   <<: *build-ubuntu\n   variables:\n-    CC: clang-10\n-    CXX: clang++-10\n+    CC: clang-11\n+    CXX: clang++-11\n \n build:rpm-centos-7:\n   <<: *build-rpm\n@@ -283,7 +283,7 @@ merge-req:ubuntu-gcc-ctest:\n     - su user -c \"ctest --parallel $(getconf _NPROCESSORS_ONLN) --force-new-ctest-process --verbose\"\n \n merge-req:ubuntu-clang-other-tests:\n-  extends: clang-10\n+  extends: clang-11\n   tags:\n     - docker\n   rules:\n",
