    {
      "id": "6d992e45c935848cc2b1f89f6ff51b6a5072aa4f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2345066617,
          "type": null,
          "body": "FWIW, what is happening is that their MinGW Qt6 packages are built separately from the Qt6 packages, but have to be the same version. They have some checks in place, but they have some latency:\n\nQt6 packages pushed as updates -> automated MinGW Qt6 packages fail to install warning -> MinGW Qt6 packages are updated by maintainer and put in updates-testing -> MinGW Qt6 packages move from updates-testing to updates.\n\nThe whole process, especially the last step, can take a week, which means with their current workflow and ours, we're close to guaranteed to have a week where the container image gets broken. Just too annoying to deal with.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-02-12T20:30:35.973Z",
          "updated_at": "2025-02-12T20:30:35.973Z",
          "system": false,
          "noteable_id": 361016479,
          "noteable_type": "MergeRequest",
