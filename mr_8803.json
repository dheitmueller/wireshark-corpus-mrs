    {
      "diff": "@@ -18,6 +18,14 @@\n extern \"C\" {\n #endif /* __cplusplus */\n \n+/* For some reason glib has decided, unlike the ISO C-standard, that\n+ * vertical tabs aren't whitespace.\n+ * This is intentional: https://bugzilla.gnome.org/show_bug.cgi?id=59388\n+ * We generally do want to replace them when we replace other whitespace.\n+ */\n+#define ws_ascii_isspace(ch) (g_ascii_isspace(ch) || (ch == '\\v'))\n+#define ws_unichar_isspace(uc) (g_unichar_isspace(uc) || (uc == '\\v'))\n+\n WS_DLL_PUBLIC\n gchar *\n wmem_strconcat(wmem_allocator_t *allocator, const gchar *first, ...)\n",
