      "diff": "@@ -650,7 +650,7 @@ format_text_internal(wmem_allocator_t *allocator,\n              */\n             FMTBUF_EXPAND(1);\n             FMTBUF_PUTCHAR(c);\n-        } else if (replace_space && g_ascii_isspace(c)) {\n+        } else if (replace_space && ws_ascii_isspace(c)) {\n             /*\n              * ASCII, so not part of a multi-byte UTF-8 sequence, but\n              * not printable, but is a space character; show it as a\n@@ -830,7 +830,7 @@ format_text_internal(wmem_allocator_t *allocator,\n                 }\n                 fmtbuf[column] = uc | first;\n                 column += utf8_len;\n-            } else if (replace_space && g_unichar_isspace(uc)) {\n+            } else if (replace_space && ws_unichar_isspace(uc)) {\n                 /*\n                  * Not printable, but is a space character; show it\n                  * as a blank.\n@@ -1018,7 +1018,7 @@ format_text_chr(wmem_allocator_t *allocator, const char *string, size_t len, cha\n         if (g_ascii_isprint(*p)) {\n             wmem_strbuf_append_c(buf, *p);\n         }\n-        else if (g_ascii_isspace(*p)) {\n+        else if (ws_ascii_isspace(*p)) {\n             wmem_strbuf_append_c(buf, ' ');\n         }\n         else {\n",
