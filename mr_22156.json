  "changes_data": [
    {
      "diff": "@@ -479,7 +479,15 @@ def replace_proto_tree_add_STAR_format(fpath, make_replacements):\n     return replace_cnt\n \n \n+def is_dissector_file(filename):\n+    # TODO: also check directory?\n+    p = re.compile(r'.*(packet|file)-.*\\.c$')\n+    return p.match(filename)\n+\n def run_specific_file(fpath, make_replacements):\n+    if not is_dissector_file(fpath):\n+        #print(fpath, 'is not a dissector')\n+        return 0\n     replace_cnt = 0\n     if (fpath.endswith('.c') or fpath.endswith('.cpp')):\n         replace_cnt += replace_file(fpath, make_replacements)\n",
