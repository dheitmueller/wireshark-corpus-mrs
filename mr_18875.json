  "discussions_data": [
    {
      "id": "6096d9222d9a1485bd248a76b27f21edb41759eb",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2317868393,
          "type": null,
          "body": "I can build without any issue using gcc 14.2.1 on Fedora 41, so `WS_IS_AT_LEAST_GNUC_VERSION(12,1)` might be a bit aggressive (but then we would need to test various gcc versions to identify whether only version 12 is impacted or not).",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
