    {
      "id": "6542ef65d84d7b43e9e303d806df5f6790b89bce",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2317917475,
          "type": null,
          "body": "For the record my gcc version on Debian 12 is the following:\n`gcc version 12.2.0 (Debian 12.2.0-14)`\n\nBut for the condition `WS_IS_AT_LEAST_GNUC_VERSION(12,1)`, I just followed what I found in wireshark repository with `git grep -C1 stringop-overread`",
          "author": {
            "id": 24576936,
            "username": "shiningxc",
            "public_email": "",
            "name": "Xavier",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/b05047130a4814b5584af91cfdc3fb157942eff18611874001a96cc52c940f93?s=80&d=identicon",
            "web_url": "https://gitlab.com/shiningxc"
          },
          "created_at": "2025-01-28T10:49:26.245Z",
          "updated_at": "2025-01-28T10:49:26.245Z",
