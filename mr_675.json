  "discussions_data": [
    {
      "id": "961de11aa998a2e7b29efc0440a89dccf604fc2e",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 434526358,
          "type": "DiscussionNote",
          "body": "This potentially breaks heuristics dissectors which kick in if no `app_handle` is set. See `process_ssl_payload`. I think you need this instead:\n\n```diff\n         } else {\n             /* No heuristics, no port-based proto, unknown protocol. */\n             ssl_debug_printf(\"%s: no appdata dissector found\\n\", G_STRFUNC);\n+            call_data_dissector(next_tvb, pinfo, tree);\n             return;\n         }\n```\n(or use `proto_tree_get_root(tree)` instead of `tree`, but you should check if that makes sense for the `data` dissector.)",
          "author": {
            "id": 2415432,
            "username": "Lekensteyn",
            "public_email": "",
            "name": "Peter Wu",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/efcf30db53f30b15e7c905ef37bd4dc44d87573bd92baf97cd707115d3fcd0c0?s=80&d=identicon",
            "web_url": "https://gitlab.com/Lekensteyn"
          },
          "created_at": "2020-10-22T16:51:56.381Z",
