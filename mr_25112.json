      "notes": [
        {
          "id": 3389536358,
          "type": "DiscussionNote",
          "body": "The next question is whether we want to cherry-pick this to 4.6 as-is, or do something more complicated that only adds the Qt SVG devel library as a requirement on macOS (and Win32), leaving it as a runtime requirement only on Linux.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-05-27T11:57:23.450Z",
          "updated_at": "2026-05-27T13:45:52.304Z",
          "system": false,
          "noteable_id": 489172463,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
