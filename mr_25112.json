          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 25112,
          "commands_changes": {}
        },
        {
          "id": 3390021856,
          "type": "DiscussionNote",
          "body": "Keeping the code similar in both branches sounds like a plus to me.",
          "author": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
            "web_url": "https://gitlab.com/AndersBroman"
          },
          "created_at": "2026-05-27T13:45:52.252Z",
          "updated_at": "2026-05-27T13:45:52.252Z",
          "system": false,
          "noteable_id": 489172463,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
