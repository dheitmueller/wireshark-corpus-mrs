      "notes": [
        {
          "id": 3155875347,
          "type": "DiscussionNote",
          "body": "What does this change have to do with `setjmp()`?",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2026-03-12T20:20:28.294Z",
          "updated_at": "2026-03-12T21:13:33.403Z",
          "system": false,
          "noteable_id": 463340694,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 23874,
          "commands_changes": {}
        },
        {
          "id": 3155998743,
          "type": "DiscussionNote",
          "body": "If I understand the pieces correctly it's a combination of Qt using FreeType, which uses setjmp/longjmp for exceptions similar to what we do in epan, setjmp on macOS < 26.4 not fully initializing jmp_buf which is incompatible with sigaltstack, and the Go runtime using sigaltstack and asserting when things go wonky: https://gitlab.com/wireshark/wireshark/-/work_items/21083#note_3152191872",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1788740758",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2026-03-12T21:13:33.349Z",
          "updated_at": "2026-03-12T21:13:33.349Z",
          "system": false,
          "noteable_id": 463340694,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 23874,
          "commands_changes": {}
        }
      ]
    }
