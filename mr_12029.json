      "resolvable": false,
      "notes": [
        {
          "id": 1553525309,
          "type": null,
          "body": "https://developer.apple.com/library/archive/releasenotes/DeveloperTools/RN-Xcode/Chapters/Introduction.html says:\n\n> The -Wunguarded-availability flag is off by default to prevent unexpected warnings in existing projects. -Wunguarded-availability-new, a less strict version of the compiler flag that warns about unguarded uses of APIs only when they were introduced in macOS 10.13 or later, iOS 11 or later, tvOS 11 or later, or watchOS 4 or later. The -Wunguarded-availability-new flag is on by default. (7184689)\n\nWe target 10.14 on the macOS Intel builder and 11.0 on the Arm builder, so this change might not be needed.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789689689",
            "web_url": "https://gitlab.com/geraldcombs"
