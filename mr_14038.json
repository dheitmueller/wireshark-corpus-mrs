    },
    {
      "diff": "@@ -0,0 +1,12 @@\n+# This file is automatically generated, DO NOT MODIFY.\n+\"TRUE\",\"Falco Events\",\"sysdig.event_name == \\x22notification\\x22\",\"This finds the Falco notifications that have been embedded into captures. It allows to quickly go to the place where something happened\"\n+\"TRUE\",\"Cmd Execs\",\"evt.type == \\x22execve\\x22\",\"List the command executions (eceve system call)\"\n+\"TRUE\",\"File Opens\",\"evt.type == \\x22open\\x22 || evt.type == \\x22openat\\x22 || evt.type == \\x22openat2\\x22\",\"Display file open events (open, openat...)\"\n+\"TRUE\",\"File Opens W\",\"(evt.type == \\x22open\\x22 || evt.type == \\x22openat\\x22 || evt.type == \\x22openat2\\x22) && (evt.is_open_write == True)\",\"Display file open events (open, openat...) where the file has been open with \\x22write\\x22 flags\"\n+\"TRUE\",\"Connects\",\"evt.type == \\x22connect\\x22\",\"Show the client-side network connection attempts\"\n+\"TRUE\",\"Accepts\",\"evt.type == \\x22accept\\x22\",\"Show the server-side network connection reception\"\n+\"TRUE\",\"Failures\",\"(evt.failed == True) && !(evt.res == \\x22EAGAIN\\x22) && !(evt.res == \\x22EALREADY\\x22)\",\"Selects that system calls that failed\"\n+\"TRUE\",\"I/O\",\"evt.is_io == True\",\"Show all IO system calls (read/write/sendto...)\"\n+\"TRUE\",\"I/O W\",\"(evt.is_io == True) && (evt.is_io_write == True)\",\"Show all of the I/O system calls that write content on file descriptors (write, sendto...)\"\n+\"TRUE\",\"File\",\"evt.category == \\x22file\\x22\",\"Display activity on files\"\n+\"TRUE\",\"Network\",\"evt.category==\\x22net\\x22\",\"Display activity on the network\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "resources/share/logray/profiles/Syscalls/dfilter_buttons",
      "old_path": "resources/share/logray/profiles/Syscalls/dfilter_buttons",
      "a_mode": "0",
      "b_mode": "100644",
      "new_file": true,
