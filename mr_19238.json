  "changes_data": [
    {
      "diff": "@@ -45,6 +45,8 @@ The following bugs have been fixed since version 0.9.1:\n \n * Stratoshark help message has Wiresharkisms in it. wsbuglink:20229[].\n \n+* Stratoshark and editcap could write incorrect block types. https://gitlab.com/wireshark/wireshark/-/merge_requests/19238[Merge request 19238].\n+\n The following bugs have been fixed since version 0.9.0:\n \n * Falco Bridge: Empty frame.protocols field. wsbuglink:20248[].\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/Stratoshark_Release_Notes.adoc",
      "old_path": "doc/Stratoshark_Release_Notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -5570,7 +5570,7 @@ pcapng_write_sysdig_event_block(wtap_dumper *wdh, const wtap_rec *rec,\n #endif\n \n     /* write sysdig event block header */\n-    bh.block_type = BLOCK_TYPE_SYSDIG_EVENT;\n+    bh.block_type = rec->rec_header.syscall_header.record_type;\n     bh.block_total_length = (uint32_t)sizeof(bh) + SYSDIG_EVENT_HEADER_SIZE + rec->rec_header.syscall_header.event_filelen + pad_len + 4;\n \n     if (!wtap_dump_file_write(wdh, &bh, sizeof bh, err))\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "wiretap/pcapng.c",
      "old_path": "wiretap/pcapng.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
