      "diff": "@@ -1127,6 +1127,10 @@ dissect_per_integer(tvbuff_t *tvb, guint32 offset, asn1_ctx_t *actx, proto_tree\n \t\tlength=4;\n \t}\n \n+\tif(length == 0){\n+\t\tdissect_per_not_decoded_yet(tree, actx->pinfo, tvb, \"unexpected length\");\n+\t}\n+\n \tif (actx->aligned) BYTE_ALIGN_OFFSET(offset);\n \tval_tvb = tvb_new_octet_aligned(tvb, offset, length * 8);\n \tval=0;\n",
