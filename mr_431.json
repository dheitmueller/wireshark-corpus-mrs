      "notes": [
        {
          "id": 421028035,
          "type": null,
          "body": "Sorry this took me so long to reply. My message was, even if this is just for the CI builds, the CLT tools have to be as valid as the Xcode internal CLT tools to build this. Instead of preventing either one from being tested (what this actually does in a way), we should figure out, what is failing and why.\n\nChances are, that our endusers run into the same issue, and then we have to fix it anyway",
          "author": {
            "id": 2498449,
            "username": "rknall",
            "public_email": "",
            "name": "Roland Knall",
            "state": "active",
            "locked": false,
