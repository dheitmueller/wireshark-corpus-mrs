    {
      "id": "7331eb8427855274dff40e7384776ab434820b21",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 419563139,
          "type": null,
          "body": "Currently there is an issue with the CLT on Big Sur 11 and Apple Silicon. Nice people at Apple do not provide the correct CLT files for XCode 12.2, only XCode builds are supported for now and I am still trying to verify, if that is the correct way to go. If we merge this, we would need to have at least a single check ensuring, that the CLTs used are able to be used on the platform.",
          "author": {
            "id": 2498449,
            "username": "rknall",
            "public_email": "",
            "name": "Roland Knall",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9e1d973c5007651b2ca47071f80324c2de5349d873e365cf0761df5542dfe382?s=80&d=identicon",
