        {
          "id": 1875627529,
          "type": "DiscussionNote",
          "body": "With only check IS_6GHZ ?",
          "author": {
            "id": 279822,
            "username": "alagoutte",
            "public_email": "",
            "name": "Alexis La Goutte",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/a15cba6417f4d1723eb56add7099bcfd8df373dc520577958b33c37915ef231b?s=80&d=identicon",
            "web_url": "https://gitlab.com/alagoutte"
          },
          "created_at": "2024-04-22T19:24:59.957Z",
          "updated_at": "2024-04-23T21:53:47.807Z",
          "system": false,
          "noteable_id": 297375200,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
            "web_url": "https://gitlab.com/AndersBroman"
          },
          "resolved_at": "2024-04-23T21:53:47.807Z",
