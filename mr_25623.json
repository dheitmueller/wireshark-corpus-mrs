  "changes_data": [
    {
      "diff": "@@ -1315,7 +1315,7 @@ Code Lines and Data:\n     - /tmp/tokei --exclude 'qt/*.ts' . | tee tokei.txt\n     - |\n       cat > manuf <<FIN\n-      # This file was generated by TShark $(git describe --tags | sed -e 's/^v//') with the\n+      # This file was generated by TShark $(git describe --tags --match \"v*\" | sed -e 's/^v//') with the\n       # command \\`tshark -G manuf\\`. Its canonical location is\n       #\n       # https://www.wireshark.org/download/automated/data/manuf.gz\n@@ -1325,6 +1325,9 @@ Code Lines and Data:\n       # used by Wireshark for address name resolution and the third column contains the\n       # full vendor name from the registry.\n       #\n+      # This file is popular but the data itself is only updated once a week. Please don't\n+      # download it more often than that.\n+      #\n       FIN\n     - build/run/tshark -G manuf | sed -e 's,:00:00:00/24,,' >> manuf\n     - gzip --best --keep manuf\n",
