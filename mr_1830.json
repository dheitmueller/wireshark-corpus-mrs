      "diff": "@@ -12950,6 +12950,7 @@ const value_string proto_checksum_vals[] = {\n \t{ PROTO_CHECKSUM_E_GOOD,       \"Good\" },\n \t{ PROTO_CHECKSUM_E_UNVERIFIED, \"Unverified\" },\n \t{ PROTO_CHECKSUM_E_NOT_PRESENT, \"Not present\" },\n+\t{ PROTO_CHECKSUM_E_ILLEGAL,    \"Illegal\" },\n \n \t{ 0,        NULL }\n };\n",
