    {
      "id": "e6a986683832d4fb2f676d7fb4aaa498b353a5d0",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 811154093,
          "type": null,
          "body": "I don't understand the IEEE80211_RADIOTAP_MCS_NESS_BIT0/1 thing, especially as they both thave the same value.\nSpecially when looking at use of the corresponding hf_radiotap_mcs_ness_bit0/1 elements.",
          "author": {
            "id": 7354663,
            "username": "jmayer2",
            "public_email": "",
            "name": "Jörg Mayer",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/169640aaef0383905a7367726222ac4b97063ae8ad4d0f72aa58ebfe89c33a5d?s=80&d=identicon",
            "web_url": "https://gitlab.com/jmayer2"
          },
          "created_at": "2022-01-14T17:31:18.156Z",
          "updated_at": "2022-01-14T17:31:18.156Z",
          "system": false,
          "noteable_id": 135050411,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 5871,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "f895ee3bd4e10564a733ffd020b1277a3c7c3975",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 811327336,
          "type": null,
          "body": "@jmayer2 I don't know if they are same in real life data but according to the 802.11n-2009 Table 20-13, number of extension spatial streams is a value between 0 and 3. So, at least one bit needs to be different than other bit for `ness` to be 1 or 2.\n[Radiotap MCS Field](https://www.radiotap.org/fields/MCS.html)",
          "author": {
            "id": 9120511,
            "username": "bhdrozgn",
            "public_email": "",
            "name": "Bahadir Ozgun",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/9120511/avatar.png?v=1762681138",
            "web_url": "https://gitlab.com/bhdrozgn"
          },
          "created_at": "2022-01-14T20:41:23.247Z",
          "updated_at": "2022-01-14T20:41:23.247Z",
          "system": false,
          "noteable_id": 135050411,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 5871,
          "commands_changes": {}
        }
      ]
    }
