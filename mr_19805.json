  "changes_data": [
    {
      "diff": "@@ -616,20 +616,15 @@ macOS Universal Package:\n     - wireshark-macos-arm-package\n   retry: 1\n   script:\n-    # Install a separate copy of pkg-config, otherwise we'll find a bunch of packages in /usr/local.\n-    # - curl -JLO https://pkgconfig.freedesktop.org/releases/pkg-config-0.29.2.tar.gz\n-    # - echo \"6fc69c01688c9458a57eb9a1664c9aba372ccda420a02bf4429fe610e7e7d591  pkg-config-0.29.2.tar.gz\" | shasum --algorithm 256 --check\n-    # - mkdir _local\n-    # - tar -xf pkg-config-0.29.2.tar.gz\n-    # - cd pkg-config-0.29.2\n-    # - CFLAGS=\"-Wno-int-conversion\" ./configure --prefix=\"$CI_PROJECT_DIR/_local\" --with-internal-glib\n-    # - make\n-    # - make install\n-    # - cd ..\n     - export WIRESHARK_BASE_DIR=${CI_PROJECT_DIR}/../wireshark-third-party\n-    - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir $WIRESHARK_BASE_DIR ; fi\n-    - export CMAKE_PREFIX_PATH=/usr/local/Qt-$MACOS_QT_VERSION\n-    # - export PATH=\"$CI_PROJECT_DIR/_local/bin:$PATH:$HOME/bin\"\n+    - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n+    - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir -p $WIRESHARK_BASE_DIR/Qt ; fi\n+    - if [ ! -d $WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos/lib/QtCore.framework ] ; then\n+        python3 -m venv /tmp/aqt.venv ;\n+        /tmp/aqt.venv/pip3 install aqtinstall ;\n+        /tmp/aqt.venv/bin/aqt install-qt --outputdir /tmp/qt mac desktop 6.5.3 clang_64 --modules qt5compat qtmultimedia ;\n+      fi\n+    - export CMAKE_PREFIX_PATH=$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION\n     - export PATH=\"$PATH:$HOME/bin\"\n     - export PKG_CONFIG_PATH=\n     - mkdir build\n",
