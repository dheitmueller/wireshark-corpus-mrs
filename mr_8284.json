      "notes": [
        {
          "id": 1118073724,
          "type": null,
          "body": "Any thoughts on how to document the domains in `ws_log_defs.h`?  \nThe man pages and WSUG mention `log domains` but not sure where end user would look to find them.",
          "author": {
