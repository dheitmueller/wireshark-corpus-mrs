      "notes": [
        {
          "id": 740194301,
          "type": "DiscussionNote",
          "body": "Not sure I'm a fan of such solution. It opens the door to all kinds of variations of showing Expert info by dissector writers. In this case what's wrong with just opening the Packet comments line? That would give you the same list. as in the second picture.",
          "author": {
            "id": 2398962,
            "username": "JaapKeuter",
            "public_email": "",
            "name": "Jaap Keuter",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/722b0c520542a23cb8f8ea7070a45c88f9e9214dc700ac151e419e9649e0304e?s=80&d=identicon",
            "web_url": "https://gitlab.com/JaapKeuter"
          },
          "created_at": "2021-11-22T14:45:29.358Z",
          "updated_at": "2021-11-22T15:03:38.004Z",
          "system": false,
          "noteable_id": 127239522,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
