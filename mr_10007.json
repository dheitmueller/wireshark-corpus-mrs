    {
      "id": "3e4462f5319f5e723f6460946c59e7c82b00715f",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1306895094,
          "type": "DiffNote",
          "body": "Thanks Gerald, this is fine for now.  rbgSize is masked to 28 bits, so this error only happens when ext6 appears twice within the same section (i.e. ext11_settings.ext6_num_bits_set was already non-zero before starting the loop).  I am thinking to add a general mechanism for checking whether extensions:\n\n- are appropriate at all for the given section type\n- appear only in valid conjunction with other extensions, in appropriate order\n- are not repeated\n\nOther, similar configs added recently do have checks in place before potentially writing beyond array bounds.",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
