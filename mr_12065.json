      "diff": "@@ -370,6 +370,42 @@ fvalue_new(ftenum_t ftype)\n \treturn fv;\n }\n \n+static bool\n+fvalue_cleanup_cb(wmem_allocator_t *allocator _U_, wmem_cb_event_t event _U_, void *user_data)\n+{\n+\tfvalue_t *fv = (fvalue_t*)user_data;\n+\tfvalue_cleanup(fv);\n+\n+\treturn FALSE;\n+}\n+\n+fvalue_t*\n+fvalue_new_wmem(wmem_allocator_t *allocator, ftenum_t ftype)\n+{\n+\tfvalue_t\t\t*fv;\n+\tftype_t\t\t\t*ft;\n+\tFvalueNewFunc\t\tnew_value;\n+\n+\tfv = wmem_new(allocator, fvalue_t);\n+\n+\tFTYPE_LOOKUP(ftype, ft);\n+\tfv->ftype = ft;\n+\n+\tnew_value = ft->new_value;\n+\tif (new_value) {\n+\t\tnew_value(fv);\n+\t}\n+\n+\t/* If we stored the allocator in the fvalue_t, we could\n+\t * ensure that any new value is allocated with it as well.\n+\t */\n+\tif (allocator != NULL && ft->free_value) {\n+\t\twmem_register_callback(allocator, fvalue_cleanup_cb, fv);\n+\t}\n+\n+\treturn fv;\n+}\n+\n fvalue_t*\n fvalue_dup(const fvalue_t *fv_orig)\n {\n@@ -421,6 +457,24 @@ fvalue_free(fvalue_t *fv)\n \tg_slice_free(fvalue_t, fv);\n }\n \n+void\n+fvalue_free_wmem(wmem_allocator_t *allocator, fvalue_t *fv)\n+{\n+\t/* XXX: In order to call cleanup here for non-NULL allocators,\n+\t * we would need to call wmem_unregister_callback, which\n+\t * requires saving the id returned by wmem_register_callback.\n+\t * Is it worth enlarging the size of fvalue_t to allow\n+\t * the values to be freed early?\n+\t * Similarly, we don't store a pointer to the allocator,\n+\t * so we don't enforce the requirement that this is called\n+\t * using the same allocator as fvalue_new_wmem().\n+\t */\n+\tif (allocator == NULL) {\n+\t\tfvalue_cleanup(fv);\n+\t}\n+\twmem_free(allocator, fv);\n+}\n+\n fvalue_t*\n fvalue_from_literal(ftenum_t ftype, const char *s, gboolean allow_partial_value, gchar **err_msg)\n {\n",
      "collapsed": false,
