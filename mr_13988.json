    {
      "id": "10b7911791096258bd1b51740da7ec1c54bf80e4",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1722027778,
          "type": "DiscussionNote",
          "body": "Hi Jeff,\n\ncould you clarify what \"Downlink messages to the SMSF are carried from the AMF in an UplinkSMS message\" mean here? A downlink message in 3GPP wording is a message from the network to the UE, so how could it be carried in an UplinkSMS message?\n\n5 years back I did not add the SMS dissector call because I thought having pinfo->link_dir was required to properly dissect the SMS whatever the direction, but after double checking packt-gsm_a_rp.c it does not seem required.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
            "web_url": "https://gitlab.com/pquantin"
          },
          "created_at": "2024-01-10T17:43:19.288Z",
          "updated_at": "2024-01-10T18:33:29.839Z",
          "system": false,
          "noteable_id": 274515430,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
