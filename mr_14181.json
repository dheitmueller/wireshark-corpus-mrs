  "changes_data": [
    {
      "diff": "@@ -92,13 +92,16 @@ static bool start_is_field_reference(const char *start)\n \tchar saved_c;\n \tconst header_field_info *hfinfo;\n \n-\tend = strchr(start, '#');\n-\tif (end == NULL)\n-\t\tend = strchr(start, '}');\n+\tend = strpbrk(start, \"#}:;\");\n \tif (end == NULL)\n \t\treturn false;\n \n \tsaved_c = *end;\n+\tif (saved_c == ';' || saved_c == ':') {\n+\t\t/* Cannot be a field, looks like macro. */\n+\t\treturn false;\n+\t}\n+\n \t/* This violates constness but we will restore the original string. */\n \t*(char *)end = '\\0';\n \t/* Search for name in registered fields. */\n",
