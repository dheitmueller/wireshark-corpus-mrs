    {
      "id": "936233428a9f1b9e92b2af2df170b429bdcab905",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2935676654,
          "type": null,
          "body": "OK, I've opened !22624 for the restoration of the function as just a stub. It it gets merged I'll pick it to the Debian package to not break the ABI there with 4.6.2-1. IMO not breaking the ABI is an important promise and having a new release would be the right thing to do, but if there isn't one then at least I can release the Debian package with a good feeling.",
          "author": {
            "id": 7384671,
            "username": "rbalint",
            "public_email": "",
            "name": "Balint Reczey",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/3dff6a01e100a1b24a9d11cb0328f45b04c323c72058516e1e855106a993206b?s=80&d=identicon",
