    {
      "id": "c8a62a6878f2decf2e33a3ff32db425f3748808f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2933026585,
          "type": null,
          "body": "One issue is that the existing code was a GPL license violation. (Or rather, was relicensed without apparent permission from the original implementation from GPLv3 or later to GPLv2 or later.) So rather than a straight revert, we would need to make it a no-op with warning.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-12-04T12:48:35.609Z",
          "updated_at": "2025-12-04T12:48:35.609Z",
