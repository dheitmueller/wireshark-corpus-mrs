    },
    {
      "id": "23be3eaa86a919f735eff5f11e85885c6a7f04ec",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2933866937,
          "type": null,
          "body": "Right, it's not the standard Base32 alphabet, so I would be very surprised if any other dissector or plugin tried to use that function.",
