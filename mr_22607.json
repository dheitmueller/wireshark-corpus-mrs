    {
      "id": "7e170d0fb4cdcfc61c4e2e9b984ad5d6a98060a6",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2933850336,
          "type": null,
          "body": "Along with the licensing issue, the function is specific to fc00. That website [went away a few years ago](https://web.archive.org/web/20220525131445/http://fc00.io/) and the repositories [appear to be unmaintained](https://github.com/fc00). I'm fine with adding a no-op to replace the removed function, but releases take a significant amount of time and effort, and I'm not sure this warrants an unscheduled release.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1788740758",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2025-12-04T17:06:27.710Z",
          "updated_at": "2025-12-04T17:06:27.710Z",
