      "diff": "@@ -195,7 +195,7 @@ static ssh_channel run_ssh_command(ssh_session sshs, const char* capture_command\n \t\tif (count > 0)\n \t\t\tcount_str = ws_strdup_printf(\"-c %u\", count);\n \n-\t\tcmdline = ws_strdup_printf(\"%s dumpcap %s %s -w - %s %s\",\n+\t\tcmdline = ws_strdup_printf(\"%s dumpcap %s %s -w - %s -f %s\",\n \t\t\tuse_sudo ? \"sudo\" : \"\",\n \t\t\tnoprom ? \"-p\" : \"\",\n \t\t\t*ifaces ? ifaces : \"\",\n",
