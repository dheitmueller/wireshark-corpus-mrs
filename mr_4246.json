      "diff": "@@ -53,7 +53,7 @@ C:\\PS> .\\tools\\win-setup.ps1 -Destination C:\\wireshark-master-64-libs -Platform\n \n Param(\n     [Parameter(Mandatory=$true, Position=0)]\n-    [ValidateScript({$_ -like \"*\\wireshark-*-libs\"})]\n+    [ValidateScript({$_ -like \"*[/\\]wireshark-*-libs\"})]\n     [String]\n     $Destination,\n \n",
