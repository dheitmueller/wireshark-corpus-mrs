oid\n ptvcursor_advance(ptvcursor_t* ptvc, int length)\n {\n-\tptvc->offset += length;\n+\tif (ckd_add(&ptvc->offset, ptvc->offset, length)) {\n+\t\tTHROW(ReportedBoundsError);\n+\t}\n }\n \n \n",
