            "name": "Joris Peeraer",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/f3b6fcda2f3bfd57026ee6ae47c1581cf645e5c49e0a0ed69164fd1088b49b4e?s=80&d=identicon",
            "web_url": "https://gitlab.com/jpeeraer"
