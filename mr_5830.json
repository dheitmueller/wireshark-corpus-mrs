  "changes_data": [
    {
      "diff": "@@ -389,8 +389,8 @@ Example: __-4 10.0.0.1,10.0.0.2__ to use 10.0.0.1 and 10.0.0.2 for all IP packet\n Prepend dummy IP header with specified IPv6 dest and source address.\n This option should be accompanied by one of the following options: -i, -s, -S, -T, -u\n Use this option to apply \"custom\" IP addresses.\n-Example: __-6 fe80::202:b3ff:fe1e:8329,2001:0db8:85a3::8a2e:0370:7334__ to\n-use fe80::202:b3ff:fe1e:8329 and 2001:0db8:85a3::8a2e:0370:7334 for all IP packets.\n+Example: __-6 2001:db8::b3ff:fe1e:8329,2001:0db8:85a3::8a2e:0370:7334__ to\n+use 2001:db8::b3ff:fe1e:8329 and 2001:0db8:85a3::8a2e:0370:7334 for all IP packets.\n --\n \n include::diagnostic-options.adoc[]\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/text2pcap.adoc",
      "old_path": "doc/text2pcap.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -237,7 +237,7 @@ print_usage (FILE *output)\n             \"                         Example: -4 10.0.0.1,10.0.0.2\\n\"\n             \"  -6 <srcip>,<destip>    prepend dummy IPv6 header with specified\\n\"\n             \"                         dest and source address.\\n\"\n-            \"                         Example: -6 fe80::202:b3ff:fe1e:8329,2001:0db8:85a3::8a2e:0370:7334\\n\"\n+            \"                         Example: -6 2001:db8::b3ff:fe1e:8329,2001:0db8:85a3::8a2e:0370:7334\\n\"\n             \"  -u <srcp>,<destp>      prepend dummy UDP header with specified\\n\"\n             \"                         source and destination ports (in DECIMAL).\\n\"\n             \"                         Automatically prepends Ethernet & IP headers as well.\\n\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "text2pcap.c",
      "old_path": "text2pcap.c",
