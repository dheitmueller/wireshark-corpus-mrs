        {
          "id": 556883724,
          "type": "DiscussionNote",
          "body": "For discoverability, would this particular preference be useful enough to have its own control on the toolbar similar to `Colorize Packet List` button?",
          "author": {
            "id": 6682068,
            "username": "jim.young",
            "public_email": "",
            "name": "Jim Young",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/db9ae68fc706b78b6724093efb95f64d89ef17c6d9b3eb4b3d632bf196ff78fb?s=80&d=identicon",
