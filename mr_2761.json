        {
          "id": 558138657,
          "type": "DiscussionNote",
          "body": "After using this preference for two days this is more a \"stable\" option. I want to have it enabled or not.\nFor me this is not a thing I want to toggle while analysing packets (like Colorize Packet List).\n\n=> I'm happy as it is and I see no need for a button in the toolbar.",
          "author": {
            "id": 6518606,
            "username": "uhei",
            "public_email": "",
            "name": "Uli Heilmeier",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6518606/avatar.png?v=1789982265",
            "web_url": "https://gitlab.com/uhei"
          },
          "created_at": "2021-04-22T15:21:57.055Z",
          "updated_at": "2021-04-22T15:21:57.055Z",
