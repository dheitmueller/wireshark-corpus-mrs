      "notes": [
        {
          "id": 907028950,
          "type": "DiffNote",
          "body": "Another way to do this would be to leave the `COL_INFO` setting as is, not move the protocol tree code and, *after* the protocol tree code, *append* the flags to the `COL_INFO` column.  That's a smaller change, and also means that the Info column will be partially set even if the packet is cut short so that an exception is thrown when fetching the flags word.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
