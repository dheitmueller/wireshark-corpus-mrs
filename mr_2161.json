      "notes": [
        {
          "id": 512900348,
          "type": "DiscussionNote",
          "body": "Can those service codes be used outside of the DCCP dissector? If not, I would recommend to drop the new `epan/dccpservicecodes.h` file and put their definition in packet-dccp.c directly. We try to minimize the number of header files and avoid them if they are not required.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
            "web_url": "https://gitlab.com/pquantin"
          },
          "created_at": "2021-02-19T13:24:23.721Z",
          "updated_at": "2021-02-19T13:24:23.721Z",
          "system": false,
          "noteable_id": 89185377,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 5649708,
            "username": "dreibh",
            "public_email": "dreibh@simula.no",
            "name": "Thomas Dreibholz",
