      "resolvable": false,
      "notes": [
        {
          "id": 2997334833,
          "type": null,
          "body": "In my (Windows) git setup (using TortoiseGit), I don't need these additional .gitignore settings.  This doesn't seem like a bad addition, just trying to figure out why it hasn't popped up sooner.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
