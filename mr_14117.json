            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-01-21T02:36:31.486Z",
          "updated_at": "2024-01-21T02:36:31.486Z",
          "system": false,
          "noteable_id": 276502097,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
