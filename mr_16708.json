      "diff": "@@ -293,11 +293,13 @@ int bufferZ_next (TBuffer *buf, size_t *iter, size_t *num, const char **str) {\n   return 0;\n }\n \n+#if LUA_VERSION_NUM < 504\n int luaL_typerror (lua_State *L, int narg, const char *tname) {\n   const char *msg = lua_pushfstring(L, \"%s expected, got %s\",\n                                     tname, luaL_typename(L, narg));\n   return luaL_argerror(L, narg, msg);\n }\n+#endif\n \n #ifndef REX_NOEMBEDDEDTEST\n static int ud_topointer (lua_State *L) {\n@@ -306,7 +308,7 @@ static int ud_topointer (lua_State *L) {\n }\n \n static int ud_len (lua_State *L) {\n-  lua_pushinteger (L, lua_objlen (L, 1));\n+  lua_pushinteger (L, lua_rawlen (L, 1));\n   return 1;\n }\n \n",
