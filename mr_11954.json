    {
      "id": "37aa9f1e0d22328faae8bfa472cde51e1e43f006",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1544636034,
          "type": null,
          "body": "Apparently the problematic commit is d72f62020254709db033706a9104eb8cf9f4cd4d. I can revert it for macOS only but it would be interesting to understand why enabling the libc `timegm()` causes the tests to fail on that platform. I haven't got the slightest clue however.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2023-09-06T00:19:20.241Z",
          "updated_at": "2023-09-06T15:52:19.473Z",
          "system": false,
          "noteable_id": 247618104,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
