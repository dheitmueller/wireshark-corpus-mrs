  "changes_data": [
    {
      "diff": "@@ -2647,23 +2647,29 @@ sub parse_file($$)\n \tundef $/;\n \tmy $cpp = $ENV{CPP};\n \tmy $options = \"\";\n-\tif (! defined $cpp) {\n-\t\tif (defined $ENV{CC}) {\n-\t\t\t$cpp = \"$ENV{CC}\";\n-\t\t\t$options = \"-E\";\n-\t\t} else {\n-\t\t\t#\n-\t\t\t# If cc is Clang-based don't use cpp, as\n-\t\t\t# at least some versions of Clang, cpp\n-\t\t\t# doesn't strip // comments, but cc -E\n-\t\t\t# does.\n-\t\t\t#\n-\t\t\tmy $cc_version = `cc --version`;\n-\t\t\tif ($cc_version =~ /clang/) {\n-\t\t\t\t$cpp = \"cc\";\n-\t\t\t\t$options = \"-E\"\n+\tmy $os=($^O)\n+\tif $os = \"win\"{\n+\n+\t}else{\n+\t\tif (! defined $cpp) {\n+\t\t\tif (defined $ENV{CC}) {\n+\t\t\t\t$cpp = \"$ENV{CC}\";\n+\t\t\t\t$options = \"-E\";\n \t\t\t} else {\n-\t\t\t\t$cpp = \"cpp\";\n+\t\t\t\t#\n+\t\t\t\t# If cc is Clang-based don't use cpp, as\n+\t\t\t\t# at least some versions of Clang, cpp\n+\t\t\t\t# doesn't strip // comments, but cc -E\n+\t\t\t\t# does.\n+\t\t\t\t#\n+\n+\t\t\t\tmy $cc_version = `cc --version`;\n+\t\t\t\tif ($cc_version =~ /clang/) {\n+\t\t\t\t\t$cpp = \"cc\";\n+\t\t\t\t\t$options = \"-E\"\n+\t\t\t\t} else {\n+\t\t\t\t\t$cpp = \"cpp\";\n+\t\t\t\t}\n \t\t\t}\n \t\t}\n \t}\n",
