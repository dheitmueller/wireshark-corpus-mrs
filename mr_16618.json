    {
      "id": "0363254fa7dae14bd3fde1faa7516cac879cbb6d",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2018490495,
          "type": null,
          "body": "> `cc --version does not work on windows.\n\n`cc` doesn't work on Windows with *any* arguments, or even with *no* argument, unless you've installed a third-party compiler such as GCC or Clang; with Visual Studio, what you want is `cl /E` (assuming it is willing to process something with a suffix .idl rather than .c - I think that's what the `-xc` is for with `cpp` and `cc -E`).",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-07-27T06:37:25.992Z",
          "updated_at": "2024-07-27T06:37:25.992Z",
          "system": false,
          "noteable_id": 317753295,
