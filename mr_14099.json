  "changes_data": [
    {
      "diff": "@@ -454,9 +454,12 @@ void commandline_override_prefs(int argc, char *argv[], gboolean opt_reset)\n                         }\n                         break;\n                     case PREFS_SET_OBSOLETE:\n-                        cmdarg_err(\"-o flag \\\"%s\\\" specifies obsolete preference\",\n-                                   ws_optarg);\n-                        exit_application(1);\n+                    /* obsolete preference, might be a recent setting */\n+                        if (recent_set_arg(ws_optarg) != PREFS_SET_OK) {\n+                            cmdarg_err(\"-o flag \\\"%s\\\" specifies obsolete preference\",\n+                                       ws_optarg);\n+                            exit_application(1);\n+                        }\n                         break;\n                     default:\n                         ws_assert_not_reached();\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "ui/commandline.c",
