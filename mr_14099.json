    {
      "id": "4627ea8c9a717b1792286b88b89c2a8e8fec16c6",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3089575816,
          "type": null,
          "body": "When prefs are written, if a preference has its default value the preference is not actually written but commented out. This provides a little more backwards compatibility - if someone runs a newer version with a new preference, but does not change that preference, then there's no warning message about an unknown preference when running an older version.\n\nThe \"recent\" file does not have handling for the default values, so it always writes the value. That is presumably why the various recent files did not return NO_SUCH_PREF. As a result of this, when a new recent pref is introduced (like the `capture.aggregation_view` in the current master), there ends up being a warning when running on older versions afterwards.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-02-17T13:40:57.375Z",
          "updated_at": "2026-02-17T13:40:57.375Z",
          "system": false,
          "noteable_id": 276221942,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 14099,
          "commands_changes": {}
        }
      ]
    }
