    {
      "id": "dc2d6608bedf3b41e04b9ce808a09c9425048c00",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1367030985,
          "type": null,
          "body": "I rewrote this PR to no longer read the keylog file whenever a capture file is being opened. Instead, the hash table keys and entries are being copied into glib allocated memory which is free'd whenever the key / entry pair is being removed from the table (thanks to `g_hash_table_new_full`). I didn't go for a UAT but rather implemented a lightweight shutdown routine which destroys the hash table via `g_hash_table_destroy`.",
          "author": {
            "id": 14343997,
            "username": "Skrillor",
            "public_email": "fabian.baeumer@ruhr-uni-bochum.de",
            "name": "Fabian Bäumer",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/14343997/avatar.png?v=1776801968",
            "web_url": "https://gitlab.com/Skrillor"
