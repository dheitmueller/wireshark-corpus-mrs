    {
      "id": "1f469b16beeadc792f57b9aaa0e5363426559a62",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 623096311,
          "type": null,
          "body": "I'm of the opinion that the introduced DISSECTOR_ASSERT is incorrect. The used function is quite capable of handling lengths of zero, so the introduced assert should at least test for 'len >= 0'.\n\nAlso the same could be added for it's sister function tvb_bytes_to_str_punct().",
          "author": {
            "id": 2398962,
            "username": "JaapKeuter",
            "public_email": "",
            "name": "Jaap Keuter",
            "state": "active",
            "locked": false,
