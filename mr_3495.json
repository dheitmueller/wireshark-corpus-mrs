  "commits_data": [
    {
      "id": "481b0ee06ce5d74470ac2f24f9d065e7c9dfb208",
      "short_id": "481b0ee0",
      "created_at": "2021-07-01T10:20:48.000+00:00",
      "parent_ids": [
        "c0e70f67b3a967cd550446e95a5c52df28e8ddbe"
      ],
      "title": "ospf: ensure a sub-tlv has a valid length before using it.",
      "message": "ospf: ensure a sub-tlv has a valid length before using it.\n\nA sub-tlv has a 2-bytes type and a 2-bytes length, that includes\nthe stlv header. For this reason the full length of a stlv must be\nover 4. This must be checked before converting the payload to a\nstring by subtracting 4 to the length.\n\nFix: #17459.\n",
      "author_name": "Dario Lombardo",
      "author_email": "lomato@gmail.com",
      "authored_date": "2021-06-28T11:23:21.000+02:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-07-01T10:20:48.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/481b0ee06ce5d74470ac2f24f9d065e7c9dfb208"
    },
    {
      "id": "c0e70f67b3a967cd550446e95a5c52df28e8ddbe",
      "short_id": "c0e70f67",
      "created_at": "2021-07-01T10:20:48.000+00:00",
      "parent_ids": [
        "b4a54704979f4cc3aa004d79185ba8cc63c1c5cd"
      ],
      "title": "tvbuff: add a DISSECTOR_ASSERT to tvb_bytes_to_str.",
      "message": "tvbuff: add a DISSECTOR_ASSERT to tvb_bytes_to_str.\n\nIt has been added since its length is signed, while the underlying\nbytes_to_str uses a size_t, causing an unwanted cast. Basically\npassing a len < 0 is pointless.\n",
      "author_name": "Dario Lombardo",
      "author_email": "lomato@gmail.com",
      "authored_date": "2021-06-28T12:04:05.000+02:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-07-01T10:20:48.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/c0e70f67b3a967cd550446e95a5c52df28e8ddbe"
    }
