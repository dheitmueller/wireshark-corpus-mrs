  "changes_data": [
    {
      "diff": "@@ -408,6 +408,11 @@ static int dissect_pbb_tlvblock(tvbuff_t *tvb, packet_info *pinfo, proto_tree *t\n     tlvType = tvb_get_guint8(tvb, offset++);\n     tlvFlags = tvb_get_guint8(tvb, offset++);\n \n+    if ((tlvFlags & TLV_HAS_TYPEEXT) != 0) {\n+      /* skip over ext-type */\n+      offset++;\n+    }\n+\n     indexStart = 0;\n     indexEnd = addrCount ? (addrCount - 1) : 0;\n \n@@ -421,7 +426,8 @@ static int dissect_pbb_tlvblock(tvbuff_t *tvb, packet_info *pinfo, proto_tree *t\n \n     if ((tlvFlags & TLV_HAS_VALUE) != 0) {\n       if ((tlvFlags & TLV_HAS_EXTLEN) != 0) {\n-        length = tvb_get_ntohs(tvb, offset++);\n+        length = tvb_get_ntohs(tvb, offset);\n+        offset += 2;\n       }\n       else {\n         length = tvb_get_guint8(tvb, offset++);\n",
