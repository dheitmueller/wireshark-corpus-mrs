    {
      "id": "069b10d3e271e0b5f85371c716901e043dcda2df",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 590433411,
          "type": null,
          "body": "GitLab is being an *******, not letting me save a comment in the code, so I'll comment here:\n\n1. `dissect_ieee80211_ranging_trigger_variant()` needs to handle `TRIGGER_SUBTYPE_PASSIVE_TB_MEAS_EXCHANGE`.\n1. The default case in `dissect_ieee80211_ranging_trigger_variant()` should call `DISSECTOR_ASSERT_NOT_REACHED()`, as it should never get to the default case - all valid subrange types should be handled by explicit cases, and, with this change, `dissect_ieee80211_he_trigger()` won't call `dissect_ieee80211_ranging_trigger_variant()` for an invalid subrange type.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
