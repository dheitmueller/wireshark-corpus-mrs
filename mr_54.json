    {
      "id": "786d8415b8a013b63db67639ef07904e12956f3c",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 404782649,
          "type": null,
          "body": "There is some decode as ber functionality I think. But in this case it does not help as they have encoded the field with the tag object identifier then put a single integer as its value. The value used seems to be the value that should have been used if this was encoded as local opcode tag integer, integer value.\n\nSo the only way to decode is to use the same faulty logic.\nAnders",
          "author": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
