    {
      "id": "28f0ace1c1228b839f22e98e05e59a8d883dfedd",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 404754097,
          "type": null,
          "body": "> I am witholding this is a serious bug in the application sending the message and I doubt it would work interoperable with other vendors equipment.\n\nThis is a precious hint. This a protocol violation, then why not adding it to the tree as expert info, stating it's a protocol violation? Expert infos are fields as others, that can be filtered, sorted, etc. Martin, would this make the job for your case?",
          "author": {
            "id": 277876,
            "username": "crondaemon",
            "public_email": "",
            "name": "Dario Lombardo",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/143ae7a6f9e11c9eed24a7fdb44bb40d442fd274ba01a2e3a4abe1596819bea2?s=80&d=identicon",
