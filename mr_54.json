    {
      "id": "b5996b19466d394da0f3276739619d1eb703499c",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 403282526,
          "type": null,
          "body": "Hi. This patch was intentional done to dissect Global Opcodes as Local Opcodes.\nThe global opcodes are not normal in signalling traffic. Many real network elements actually decode it like this patch. Because of these reasons, I would recommend that wireshark decode it also in this way and interpret the later MAP payload.",
          "author": {
            "id": 6797336,
            "username": "H21lab",
            "public_email": "",
            "name": "Martin Kacer",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/489fbb738b640364d3d0589c0e58dee28f6879e487a87c574515eb7f85d2c8a9?s=80&d=identicon",
