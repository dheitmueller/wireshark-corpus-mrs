    {
      "id": "7d99700f723498d52574ee2611ca85732002b698",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 404769764,
          "type": null,
          "body": "I agree with Anders, so lets ignore this patch for now. It seems the current wireshark decoding is correct. And I agree, for the proper patch, the ASN.1 change should done. \n\nFor me, the wished feature here, would be to have some \"Decode as ...\" feature for ASN.1 objects.",
          "author": {
            "id": 6797336,
            "username": "H21lab",
            "public_email": "",
            "name": "Martin Kacer",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/489fbb738b640364d3d0589c0e58dee28f6879e487a87c574515eb7f85d2c8a9?s=80&d=identicon",
            "web_url": "https://gitlab.com/H21lab"
