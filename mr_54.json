    {
      "id": "9168a4053df07dc20bb57f64b282276ec9dd0de4",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 404750829,
          "type": null,
          "body": "Personally I think it's the wrong way to go, a protocol analyser should show you when you are violating the protocol. I am witholding this is a serious bug in the application sending the message and I doubt it would work interoperable with other vendors equipment. The vendor should fix their protocol stack.\nMy 2 cents.\nRegards\nAnders\nP.S They deserve having this pointed out to them by every one using Wireshark :-)",
          "author": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
