          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 54,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "484017c5ca812e939a85fe6d1e51b59abb5c3494",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 404721216,
          "type": null,
          "body": "Hi Anders. Thank you for your feedback. Yes I agree, the encoding seems wrong and not normal. However such incorrect decoding seems to be implemented by some SS7 stacks. If we are sure the current wireshark decoding is correct, than no need for this change. Only for security monitoring reasons, it can be useful that wireshark attempt to dissect also that payload after Global Op Code (maybe in some heuristic way). Thanks and best regards",
          "author": {
            "id": 6797336,
            "username": "H21lab",
            "public_email": "",
            "name": "Martin Kacer",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/489fbb738b640364d3d0589c0e58dee28f6879e487a87c574515eb7f85d2c8a9?s=80&d=identicon",
