    {
      "id": "b788525b7ff9a282fd27c528ab4fa2efdfd72ca8",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1137120057,
          "type": null,
          "body": "I neglected to mention wmem should not depend on wsutil (sorry). There are at least two reasons for this. One is to make it possible to package independently as a leaner library. Two is to avoid indirectly pulling `wsutil/unicode-utils.h` to `wireshark.h`. In general cyclic dependencies should be avoided.\n\nI've thought about it some more and I think utf8_entities.h and unicode_entities.h (or some such), possibly both merged, should be moved out of wsutil to `include/` in the root dir.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2022-10-16T18:33:20.842Z",
          "updated_at": "2022-10-16T18:33:20.842Z",
          "system": false,
          "noteable_id": 183132175,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 8540,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "d8e61afab12dd180fb85994a3aa11fd52a43a933",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1137126534,
          "type": "DiscussionNote",
          "body": "Either that, or, now that we have a name for the character,\n\n    wmem_strbuf_append_unichar_repl(str)\n\ncalls should be replaced by\n\n    wmem_strbuf_append_unichar(buf, UNICODE_REPLACEMENT_CHARACTER)\n\nas it's not obvious to me that \"append a particular code point\" belongs in a general library of expand-as-necessary string routines.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
