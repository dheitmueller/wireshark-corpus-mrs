    },
    {
      "diff": "@@ -112,7 +112,6 @@ set_target_properties(register_wslua PROPERTIES FOLDER \"Libs/epan/wslua\")\n install(\n \tFILES\n \t\tconsole.lua\n-\t\tbrowser_sslkeylog.lua\n \t\tdtd_gen.lua\n \t\tinit.lua\n \tDESTINATION\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/wslua/CMakeLists.txt",
      "old_path": "epan/wslua/CMakeLists.txt",
