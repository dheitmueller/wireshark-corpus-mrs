  "discussions_data": [
    {
      "id": "32414cc54e17c7a4f873b30c087b290610d4ff12",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 1900707575,
          "type": "DiscussionNote",
          "body": "Pipeline error is:\n\nError: proto_tree_add_int(.., hf_zabbix_agent_variant, ...) called at epan/dissectors/packet-zabbix.c:698 with type FT_UINT32\n    (allowed types are {'FT_INT16', 'FT_INT24', 'FT_INT8', 'FT_INT32'} )\n\nShould the field be FT_INT32, i.e., can the JSON value really -ve?",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2024-05-10T14:03:21.936Z",
          "updated_at": "2024-05-10T16:27:30.873Z",
          "system": false,
          "noteable_id": 301043253,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "resolved_at": "2024-05-10T16:27:30.873Z",
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 15580,
          "commands_changes": {}
        },
        {
          "id": 1900732035,
          "type": "DiscussionNote",
          "body": "In Zabbix sources (Go) the field is `int`, which can be either 32-bit or 64-bit. They haven't yet publicly documented the field (as far as I see; and they don't mention the size of the integer fields in the protocol anyway), and they haven't historically responded to any questions like \"why is this counter field 32-bit in this component and 64-bit in this other component\", so I'll just make it an `int64_t`+`FT_INT64`.",
          "author": {
            "id": 7558431,
            "username": "markkuleinio",
            "public_email": "",
            "name": "Markku Leiniö",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/7558431/avatar.png?v=1789663372",
            "web_url": "https://gitlab.com/markkuleinio"
          },
          "created_at": "2024-05-10T14:20:48.109Z",
          "updated_at": "2024-05-10T16:27:30.873Z",
