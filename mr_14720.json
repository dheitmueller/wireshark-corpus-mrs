      "diff": "@@ -671,6 +671,11 @@ WSLUA_METHOD DissectorTable_try (lua_State *L) {\n             if (len > 0) {\n                 handled = TRUE;\n             }\n+\t} else if ( type == FT_NONE ) {\n+\t    len = dissector_try_payload(dt->table,tvb->ws_tvb,pinfo->ws_pinfo,ti->tree);\n+\t    if (len > 0) {\n+\t        handled = TRUE;\n+            }\n         } else {\n             error = \"No such type of dissector table\";\n         }\n",
