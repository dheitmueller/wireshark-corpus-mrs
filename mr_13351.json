      "diff": "@@ -780,11 +780,14 @@ static const value_string profinet_subtypes[] = {\n \t{ 4,  \"MRP Port Status\" },\n \t{ 5,  \"Chassis MAC\" },\n \t{ 6,  \"PTCP Status\" },\n+\t{ 7,  \"MauType Extension\" },\n+\t{ 8,  \"MRPIC Port Status\" },\n \t{ 9,  \"TSN Domain\"},\n \t{ 10, \"TSN NME Management Address\"},\n \t{ 11, \"TSN NME Name UUID\"},\n \t{ 12, \"TSN NME Parameter UUID\"},\n-\t{ 13, \"TSN Time Domain data\"},\n+\t{ 13, \"AS Working Clock\"},\n+\t{ 14, \"AS Global Time\"},\n \t{ 0, NULL }\n };\n /* extreme avaya ap subtypes */\n",
