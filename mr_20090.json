    {
      "diff": "@@ -248,9 +248,6 @@ workflow:\n       -DFALCO_PLUGINS=\"$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libcloudtrail.so;$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libgcpaudit.so\"\n       -DTEST_EXTRA_ARGS=--disable-capture\n       ..\n-    # The Falco libs 0.20.0 package at https://dev-libs.wireshark.org/macos/packages/falcosecurity-libs/\n-    # is missing uthash.h.\n-    - ( cd $WIRESHARK_BASE_DIR/macos-universal-master/include ; curl -JLO https://raw.githubusercontent.com/troydhanson/uthash/refs/tags/v1.9.8/src/uthash.h )\n     - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n     - ninja\n     - ninja test-programs\n@@ -649,8 +646,8 @@ macOS Universal Package:\n       -DFALCO_PLUGINS=\"$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libcloudtrail.so;$WIRESHARK_BASE_DIR/macos-universal-master/lib/falco/plugins/libgcpaudit.so\"\n       -DTEST_EXTRA_ARGS=--enable-release\n       ..\n-    # The Falco libs 0.20.0 package at https://dev-libs.wireshark.org/macos/packages/falcosecurity-libs/\n-    # is missing uthash.h.\n+    # Temporary hack to fix \"Package 'zlib', required by 'libscap', not found\"\n+    - sed -i .bak '/Requires.*zlib/d' $WIRESHARK_BASE_DIR/macos-universal-master/lib/pkgconfig/libscap.pc\n     - ( cd $WIRESHARK_BASE_DIR/macos-universal-master/include ; curl -JLO https://raw.githubusercontent.com/troydhanson/uthash/refs/tags/v1.9.8/src/uthash.h )\n     - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n     - ninja\n",
