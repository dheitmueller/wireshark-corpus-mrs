  "changes_data": [
    {
      "diff": "@@ -271,10 +271,6 @@ workflow:\n     - ninja\n     - ninja test-programs\n     - pytest --enable-stratoshark --disable-capture --junitxml=../macos_tests.xml\n-  after_script:\n-    # The cache should be large enough to be useful but it shouldn't take\n-    # too long to restore+save each run.\n-    - ccache --max-size $( gdu --summarize --block-size=1M \"$CI_PROJECT_DIR/build\" | awk '{printf (\"%dM\", $1 * 1.5)}' )\n   needs: []\n \n .build-mingw:\n@@ -688,13 +684,13 @@ macOS Universal Package:\n   before_script:\n     - brew --version\n     - printf \"\\e[0Ksection_start:%s:brew_section[collapsed=true]\\r\\e[0KInstalling prerequisites\" \"$( date +%s)\"\n-    - brew install ccache cmake ninja python\n+    - brew install awscli ccache cmake ninja python\n     # - ./tools/macos-setup-brew.sh --install-optional --install-test-deps\n     - printf \"\\e[0Ksection_end:%s:brew_section\\r\\e[0K\" \"$( date +%s)\"\n     - export PATH=\"/opt/homebrew/bin:$PATH:$HOME/bin\"\n     - python3 -m venv --clear $CI_PROJECT_DIR/.venv\n     - source $CI_PROJECT_DIR/.venv/bin/activate\n-    - pip3 install dmgbuild pyobjc-framework-Quartz pytest pytest-xdist\n+    - pip3 install  dmgbuild pyobjc-framework-Quartz pytest pytest-xdist\n   script:\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt\" ] ; then mkdir -p \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n@@ -1091,6 +1087,10 @@ macOS Build:\n     when:\n       - runner_system_failure\n       - stuck_or_timeout_failure\n+  after_script:\n+    # The cache should be large enough to be useful but it shouldn't take\n+    # too long to restore+save each run.\n+    - ccache --max-size $( gdu --summarize --block-size=1M \"$CI_PROJECT_DIR/build\" | awk '{printf (\"%dM\", $1 * 1.5)}' )\n   artifacts:\n     when: always\n     reports:\n",
