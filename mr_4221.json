    {
      "id": "0b42eb170ed7f4563c29771a92ba5a92c6633414",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 681315160,
          "type": null,
          "body": "As per !4227, this is probably just a case where they already ran CMake without `ENABLE_SMI=OFF` in a build directory, and later re-ran CMake with `ENABLE_SMI=OFF` without having removed the CMake cache first.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
