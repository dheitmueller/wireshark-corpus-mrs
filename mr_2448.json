      "diff": "@@ -46,7 +46,7 @@ endif()\n set (MMDBRESOLVE_EXE ${MAXMINDDB_FOUND})\n \n # Must match ${EXTRA_INSTALLER_DIR}/Npcap-X.Y.Z.exe\n-set(NPCAP_PACKAGE_VERSION \"1.10\")\n+set(NPCAP_PACKAGE_VERSION \"1.20\")\n \n set(USBPCAP_PACKAGE_VERSION \"1.5.4.0\")\n \n",
