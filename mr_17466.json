  "changes_data": [
    {
      "diff": "@@ -56,6 +56,8 @@ The following features are either new or have been significantly updated since v\n   (The `defaultprefs` report remains unaffected by any other options.)\n   As a part of this change, `-G` with no argument, which was previously deprecated,\n   is no longer supported. Use `tshark -G fields` to produce the same report.\n+  Also, the syntax for only listing fields with a certain prefix has changed to\n+  `tshark -G fields,prefix`.\n \n * Wireshark can now decrypt NTP packets using NTS (Network Time Security). To decrypt packets,\n   the NTS-KE (Network Time Security Key Establishment Protocol) packets need to be present,\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/release-notes.adoc",
      "old_path": "doc/release-notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -639,7 +639,7 @@ glossary_option_help(void)\n     fprintf(output, \"  -G elastic-mapping       dump ElasticSearch mapping file\\n\");\n     fprintf(output, \"  -G enterprises           dump IANA Private Enterprise Number (PEN) table\\n\");\n     fprintf(output, \"  -G fieldcount            dump count of header fields and exit\\n\");\n-    fprintf(output, \"  -G fields [prefix]       dump fields glossary and exit\\n\");\n+    fprintf(output, \"  -G fields,[prefix]       dump fields glossary and exit\\n\");\n     fprintf(output, \"  -G ftypes                dump field type basic and descriptive names\\n\");\n     fprintf(output, \"  -G heuristic-decodes     dump heuristic dissector tables\\n\");\n     fprintf(output, \"  -G manuf                 dump ethernet manufacturer tables\\n\");\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "tshark.c",
      "old_path": "tshark.c",
      "a_mode": "100644",
