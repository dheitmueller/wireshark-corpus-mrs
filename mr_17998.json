  "changes_data": [
    {
      "diff": "@@ -29,6 +29,7 @@\n #include \"tap-tcp-stream.h\"\n \n typedef struct _tcp_scan_t {\n+    nstime_t                first_abs_ts;\n     int                     direction;\n     struct tcp_graph       *tg;\n     struct segment         *last;\n@@ -81,11 +82,21 @@ tapall_tcpip_packet(void *pct, packet_info *pinfo, epan_dissect_t *edt _U_, cons\n                         ts->direction)\n         && tg->stream == tcphdr->th_stream)\n     {\n+        /* pinfo->rel_ts may have been reset using a Time Reference.\n+         * Adjust for this by always calculate from the first pinfo->abs_ts\n+         * in the stream.\n+         */\n+        nstime_t rel_ts;\n+        if (ts->last == NULL) { /* This is the first packet in the stream. */\n+            nstime_delta(&ts->first_abs_ts, &pinfo->abs_ts, &pinfo->rel_ts);\n+        }\n+        nstime_delta(&rel_ts, &pinfo->abs_ts, &ts->first_abs_ts);\n+\n         struct segment *segment = g_new(struct segment, 1);\n         segment->next      = NULL;\n         segment->num       = pinfo->num;\n-        segment->rel_secs  = (uint32_t)pinfo->rel_ts.secs;\n-        segment->rel_usecs = pinfo->rel_ts.nsecs/1000;\n+        segment->rel_secs  = (uint32_t)rel_ts.secs;\n+        segment->rel_usecs = rel_ts.nsecs/1000;\n         /* Currently unused\n         segment->abs_secs  = pinfo->abs_ts.secs;\n         segment->abs_usecs = pinfo->abs_ts.nsecs/1000;\n@@ -148,6 +159,7 @@ graph_segment_list_get(capture_file *cf, struct tcp_graph *tg)\n      * we only filter for TCP here for speed and do the actual compare\n      * in the tap listener\n      */\n+    nstime_set_unset(&ts.first_abs_ts);\n     ts.direction = COMPARE_ANY_DIR;\n     ts.tg      = tg;\n     ts.last    = NULL;\n",
      "collapsed": false,
