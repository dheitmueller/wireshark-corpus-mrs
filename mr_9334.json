      "parent_ids": [
        "c6c31b5340f45947ad5bebe5c9153ac2cd75a55e"
      ],
      "title": "PFCP: remove unused references to old created_nat_binding IE",
      "message": "PFCP: remove unused references to old created_nat_binding IE\n",
      "author_name": "jpeeraer",
      "author_email": "joris.peeraer@nokia.com",
      "authored_date": "2023-01-05T16:34:03.000+01:00",
      "committer_name": "Alexis La Goutte",
