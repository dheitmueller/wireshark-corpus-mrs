      "notes": [
        {
          "id": 444004889,
          "type": null,
          "body": "Changing the endianness in the patch above seems to still show the TLLI in wireshark UI the same way.\n\nI attach an example pcap file with 1 packet.[wrong_tlli_format.pcap.gz](/uploads/aa00e3efb94fb7e1ca8ada7b7383b4fc/wrong_tlli_format.pcap.gz)\n\nThe TLLI should show up as 0x00000001.",
          "author": {
            "id": 3212477,
            "username": "pespin",
            "public_email": "",
            "name": "pespin.shar@gmail.com",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/2bdd79a151c775a34e767cdef6cd400c152bee8db77654b502f00ef7a7dd758c?s=80&d=identicon",
            "web_url": "https://gitlab.com/pespin"
          },
          "created_at": "2020-11-09T10:43:01.994Z",
          "updated_at": "2020-11-09T10:43:01.994Z",
