    {
      "id": "5caa08d710034897680ef5e43abf1d680e52f8e7",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 444054659,
          "type": null,
          "body": "The problem here is that the code is using proto_tree_add_bits_item() and I'm not sure what an endianness is supposed to means for a random number of bits.\nYou will have more chance with `proto_tree_add_item(data_tree, hf_tlli, tvb, offset, 4, ENC_LITTLE_ENDIAN);`",
