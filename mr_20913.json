      "diff": "@@ -80,8 +80,9 @@ FunnelAction::FunnelAction(QString title, funnel_menu_callback callback, void *c\n         retap_(retap),\n         packetData_(NULL)\n {\n-    // Use \"&&\" to get a real ampersand in the menu item.\n-    title.replace('&', \"&&\");\n+    // Decode HTML-escaped ampersands from plugins.\n+    title.replace(QStringLiteral(\"&amp;\"), QStringLiteral(\"&\"));\n+\n \n     setText(title);\n     setObjectName(FunnelStatistics::actionName());\n@@ -97,8 +98,8 @@ FunnelAction::FunnelAction(QString title, funnel_packet_menu_callback callback,\n         packetData_(NULL),\n         packetRequiredFields_(QSet<QString>())\n {\n-    // Use \"&&\" to get a real ampersand in the menu item.\n-    title.replace('&', \"&&\");\n+    // Decode HTML-escaped ampersands from plugins.\n+    title.replace(QStringLiteral(\"&amp;\"), QStringLiteral(\"&\"));\n \n     QStringList menuComponents = title.split(QStringLiteral(\"/\"));\n     // Set the menu's text to the rightmost component, set the path to being everything to the left:\n",
