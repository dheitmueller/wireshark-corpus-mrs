    },
    {
      "diff": "@@ -17,6 +17,7 @@\n #define VERSION_MINOR @VERSION_MINOR@\n #define PRODUCT_VERSION @PRODUCT_VERSION@\n \n+#define VCREDIST_DIR \"@VCREDIST_DIR@\"\n #define VCREDIST_EXE \"@VCREDIST_EXE@\"\n \n # Optional components\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/nsis/config.nsh.in",
      "old_path": "packaging/nsis/config.nsh.in",
      "a_mode": "100644",
