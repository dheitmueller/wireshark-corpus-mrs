  "discussions_data": [
    {
      "id": "45801d4e2b745a5d532e11f3a2bbb770a41d27ed",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1353953305,
          "type": null,
          "body": "Some context for why I wrote this: I contribute to projects in both C++ and Rust that parse packets. When writing unit tests, I often want to copy some bytes out of Wireshark and include them as an array in my code. Then I often end up annotating the array with extra line breaks and block comments. This works OK in ...as Escaped String mode in C++, but needs a lot of manual fixup in Rust because it doesn't concatenate strings. This is a little cleaner in all languages, especially for formats that aren't really readable as string data.",
          "author": {
            "id": 8145634,
            "username": "danieldulaney",
            "public_email": "",
            "name": "Daniel Dulaney",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/32640efcc033ecff6416f4f5107edc0777fc37ac83dd005322e8f1d0c9212e69?s=80&d=identicon",
            "web_url": "https://gitlab.com/danieldulaney"
