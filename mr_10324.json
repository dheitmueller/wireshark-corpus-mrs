  "changes_data": [
    {
      "diff": "@@ -81,6 +81,15 @@ DIAG_ON(stringop-overread)\n     case DP_HexOnly:\n         clipboard_text = hexTextDump(printData, false);\n         break;\n+    case DP_HexArray:\n+        for (int i = 0; i < printData.length(); i++) {\n+            clipboard_text += QString(\"0x%1\").arg((uint8_t) printData[i], 2, 16, QChar('0'));\n+\n+            if (i+1 != printData.length()) {\n+                clipboard_text += QString(\", \");\n+            }\n+        }\n+        break;\n     default:\n         break;\n     }\n@@ -236,6 +245,11 @@ QActionGroup * DataPrinter::copyActions(QObject * copyClass, QObject * data)\n     action->setProperty(\"printertype\", DataPrinter::DP_EscapedString);\n     connect(action, &QAction::triggered, dpi, &DataPrinter::copyIDataBytes);\n \n+    action = new QAction(tr(\"…as Hex Array\"), actions);\n+    action->setToolTip(tr(\"Copy packet bytes as an array of hex integers.\"));\n+    action->setProperty(\"printertype\", DataPrinter::DP_HexArray);\n+    connect(action, &QAction::triggered, dpi, &DataPrinter::copyIDataBytes);\n+\n     return actions;\n }\n \n@@ -254,7 +268,7 @@ void DataPrinter::copyIDataBytes(bool /* state */)\n \n     int dump_type = sendingAction->property(\"printertype\").toInt();\n \n-    if (dump_type >= 0 && dump_type <= DataPrinter::DP_Base64) {\n+    if (dump_type >= 0 && dump_type <= DataPrinter::DP_HexArray) {\n         DataPrinter printer;\n         printer.toClipboard((DataPrinter::DumpType) dump_type, dynamic_cast<IDataPrintable *>(dataObject));\n     }\n",
      "collapsed": false,
      "too_large": false,
