    {
      "id": "2ba7bd01e11fa4d2e45b81ce3896c19269a5a714",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 518501712,
          "type": null,
          "body": "IIRC, this was things got out of hand with many different ways of outputting various forms of diagnostic info that didn't work on all supported platforms.\n\nRemoving the safety catch is liable to reintroduce the ways of the wild west.\n\nI am in agreement that some form of central logging facility would be useful.",
          "author": {
            "id": 6621762,
            "username": "graham.bloice",
            "public_email": "",
            "name": "Graham Bloice",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/8730bfac2267cb97ff1f8187d285f244745a03a783055c8fd6fcd679bfa71c6e?s=80&d=identicon",
            "web_url": "https://gitlab.com/graham.bloice"
          },
          "created_at": "2021-02-27T10:41:52.855Z",
          "updated_at": "2021-02-27T10:41:52.855Z",
          "system": false,
          "noteable_id": 90099775,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
