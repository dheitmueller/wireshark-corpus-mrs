  "discussions_data": [
    {
      "id": "4aec5ddb30fd62db85a4561ececa0d50b82396e8",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 518389612,
          "type": null,
          "body": "Note that, in GUI environments, there's no guarantee that stuff written to the standard output or error will appear anywhere, so perhaps we need APIs that write to the standard error in non-GUI programs and that write to a log of some sort in GUI programs, with the log either automatically popping up a window to display it or being viewable through a menu item.\n\nThis could be permitted even in dissectors.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
