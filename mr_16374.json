    {
      "id": "2b12738a9b828886cd203ab20c209975dae53125",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1995041928,
          "type": null,
          "body": "On windows build, `release-notes.html` was being generated three times.  \nThis is on going message reduction like !16326 and !16305.  \nThere are 31 `INFO:` logged when generating `release-notes.html` times 3 builds = 93 log messages.  \nChanges in this merge request reduce that to \"just\" the 31. \n\n```\n  Jul 10, 2024 6:10:34 PM uri:classloader:/gems/asciidoctor-2.0.18/lib/asciidoctor/substitutors.rb sub_macros\n  INFO: expected substitution value for custom inline macro to be of type Inline; got String: wsbuglink:17973[]\n```\nChanging from `WIP` and removing the one commented line.  \n  \nFuture: `release-notes.adoc` -> `release-notes.html` -> `release-notes.txt` -> `NEWS` -> `NEWS.txt` needs work.",
          "author": {
            "id": 6701257,
            "username": "chuckcraft",
            "public_email": "",
            "name": "Chuck Craft",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/0809ffc6d9d98013a1895132bc055c622830b8a20bfa49328f53d5eb4a1206cb?s=80&d=identicon",
