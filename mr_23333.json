      "diff": "@@ -54,6 +54,9 @@ target_link_libraries(falco-events\n \t${SINSP_LINK_LIBRARIES}\n )\n \n+# libsinsp requires C++ 17\n+set_target_properties(falco-events PROPERTIES CXX_STANDARD 17)\n+\n install_plugin(falco-events epan)\n \n CHECKAPI(\n",
      "collapsed": false,
