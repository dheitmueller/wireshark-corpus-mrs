      "diff": "@@ -0,0 +1,50 @@\n+#\n+# - Find systemd libraries\n+#\n+#  SODIUM_INCLUDE_DIRS - where to find systemd/sd-journal.h, etc.\n+#  SODIUM_LIBRARY    - List of libraries when using libsystemd.\n+#  SODIUM_FOUND        - True if libsystemd is found.\n+\n+if( SODIUM_INCLUDE_DIR AND SODIUM_LIBRARY )\n+\t# Already in cache, be silent\n+\tset( SODIUM_FIND_QUIETLY TRUE )\n+endif()\n+\n+\n+if (NOT WIN32)\n+\tfind_package(PkgConfig)\n+\tpkg_search_module( PC_SODIUM sodium )\n+endif()\n+\n+find_path(SODIUM_INCLUDE_DIR\n+\tNAMES\n+\t\tsodium.h\n+\tsHINTS\n+\t\t${PC_SYSTEMD_INCLUDE_DIRS}\n+\tPATHS\n+\t\t/usr/include\n+\t\t/usr/local/include\n+)\n+\n+find_library(SODIUM_LIBRARY\n+  NAMES\n+    sodium\n+  HINTS\n+    ${PC_SYSTEMD_LIBRARY_DIRS}\n+)\n+\n+include(FindPackageHandleStandardArgs)\n+find_package_handle_standard_args(SODIUM\n+  REQUIRED_VARS   SODIUM_LIBRARY SODIUM_INCLUDE_DIR\n+  VERSION_VAR     PC_SODIUM_VERSION)\n+\n+if(SODIUM_FOUND)\n+  set(SODIUM_LIBRARY ${SODIUM_LIBRARY})\n+  set(SODIUM_INCLUDE_DIR ${SODIUM_INCLUDE_DIR})\n+  SET(HAVE_SODIUM ON)\n+else()\n+  set(SODIUM_LIBRARY)\n+  set(SODIUM_INCLUDE_DIR)\n+endif()\n+\n+mark_as_advanced(SODIUM_LIBRARY SODIUM_INCLUDE_DIR)\n",
