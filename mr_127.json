  "discussions_data": [
    {
      "id": "393556f33208ee976deb429a4d5c2e10dbd5c28b",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 407690510,
          "type": null,
          "body": "The current code is showing the `data` as a string.\n\n![Untitled2](/uploads/054d7c989d6a22fde50dfbeeb96e7ac7/Untitled2.png)\n\nTherefore, That patch fixes to show the `data` as `data`! :)\n\n![Untitled](/uploads/107690004cb65a1f105776e752fd603f/Untitled.png)",
          "author": {
            "id": 2271100,
            "username": "jpereiran",
            "public_email": "",
            "name": "Jorge Pereira",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/c49f06361eb813f4733513f8b41193d82555a9c6daab379b6ca240f5d82f0ce3?s=80&d=identicon",
