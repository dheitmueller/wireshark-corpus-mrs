    {
      "id": "a586cac42df46888868c6e37e6aca353608d9d24",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 407730326,
          "type": null,
          "body": "It is not better to display string if the data is a string ?",
          "author": {
            "id": 279822,
            "username": "alagoutte",
            "public_email": "",
            "name": "Alexis La Goutte",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/a15cba6417f4d1723eb56add7099bcfd8df373dc520577958b33c37915ef231b?s=80&d=identicon",
            "web_url": "https://gitlab.com/alagoutte"
