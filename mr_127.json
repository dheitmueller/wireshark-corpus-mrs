          "created_at": "2020-09-04T19:05:39.927Z",
          "updated_at": "2020-09-04T19:05:39.927Z",
          "system": false,
          "noteable_id": 69896617,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
