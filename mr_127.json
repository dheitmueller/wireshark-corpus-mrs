    {
      "id": "bff3b58395e3b64d673c9daa623ddb300f059364",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 407736492,
          "type": "DiscussionNote",
          "body": "The FreeRADIUS added support to TACACS+ protocol and based on the RFC description. we are storing that field as `octets` \n\nreferences:\n\nhttps://github.com/FreeRADIUS/freeradius-server/blob/master/share/dictionary/tacacs/dictionary.tacacs#L35\nhttps://github.com/FreeRADIUS/freeradius-server/blob/master/src/protocols/tacacs/base.c#L90",
          "author": {
            "id": 2271100,
            "username": "jpereiran",
            "public_email": "",
            "name": "Jorge Pereira",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/c49f06361eb813f4733513f8b41193d82555a9c6daab379b6ca240f5d82f0ce3?s=80&d=identicon",
            "web_url": "https://gitlab.com/jpereiran"
          },
          "created_at": "2020-09-04T19:21:53.590Z",
          "updated_at": "2020-09-07T23:22:13.538Z",
          "system": false,
          "noteable_id": 69896617,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 127,
          "commands_changes": {}
        },
        {
          "id": 408761119,
          "type": "DiscussionNote",
          "body": "> The FreeRADIUS added support to TACACS+ protocol and based on the RFC description. we are storing that field as `octets`\n\n[draft-ietf-opsawg-tacacs-18](https://tools.ietf.org/html/draft-ietf-opsawg-tacacs-18) doesn't show an RFC, it just shows drafts 00 through 18.  I'm not sure there's a correct reading of the description of the accounting REPLY packet body that would indicate that the field should be shown as octets, rather than as ASCII.  Perhaps the FreeRADIUS developers misread the I-D.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
