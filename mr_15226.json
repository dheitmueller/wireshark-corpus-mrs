{
  "id": 295218793,
  "iid": 15226,
  "project_id": 7898047,
  "title": "ISO15765: Fix reassembling when different flows overlap",
  "description": "The ISO-15765 dissector was keeping track of first frames with a static int.\nThis meant that every time a new first frame was found, a new sequence was started.\nThis behavior causes problems when multiple flows overlap,\nfor example because they belong to different diagnostic addresses,\nor because they are routed from one interface to another.\nThis commit matches consecutive frames not with the latest first frame that has been seen,\nbut with the latest first frame having the same bus type, frame ID, and interface ID.",
  "state": "merged",
  "created_at": "2024-04-12T16:16:57.668Z",
  "updated_at": "2024-04-19T09:35:14.068Z",
