  "commits_data": [
    {
      "id": "8f0e9461556ac075d153e6b399aa7775b6efa64a",
      "short_id": "8f0e9461",
      "created_at": "2024-04-02T15:27:22.000+01:00",
      "parent_ids": [
        "0949fd3498d5607ba01c506e3a35a556b6d9f6cb"
      ],
      "title": "Add a built-in dissector for ZMTP",
      "message": "Add a built-in dissector for ZMTP\n\n    Meant as a replacement for the popular Lua dissector\n    that may be found at\n    https://github.com/whitequark/zmtp-wireshark\n\n    Preserves \"zmtp.protocol\" dissector table for TCP port -> dissector,\n    and also adds a UAT for setting (or overriding these choice)\n    as a dissector preference.\n\n    Currently a draft, with the protocol name set to \"zmtpx\",\n    allowing it to co-exist with the Lua version.\n\n    An attempt was made to support older command types by\n    copying what the Lua dissector did, but no capture files\n    were readily available to test these.\n",
      "author_name": "Martin Mathieson",
      "author_email": "martin.r.mathieson@gmail.com",
      "authored_date": "2024-03-23T23:53:00.000+00:00",
      "committer_name": "Martin Mathieson",
      "committer_email": "martin.r.mathieson@gmail.com",
      "committed_date": "2024-04-02T15:27:22.000+01:00",
