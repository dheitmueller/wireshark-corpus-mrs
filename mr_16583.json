    {
      "id": "6a16f8cc9d2bffd365f6f056e0fc85c1d9349e10",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2016991840,
          "type": null,
          "body": "Removed draft, but still need to decide which implementation we prefer. i.e.,\n\n(1) current, with casting of GQueue's internal list   OR\n\n(2) keep existing GSList but keeping our own running total\n\n\n(1) is marginally faster",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2024-07-26T07:00:44.526Z",
          "updated_at": "2024-07-26T07:06:52.467Z",
          "system": false,
          "noteable_id": 317248448,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
