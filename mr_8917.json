        {
          "id": 1181285498,
          "type": "DiffNote",
          "body": "So how will this code handle arbitrary access to a given packet in the capture (like selecting packet N in the GUI, and then selecting packet N-8)?\nRather than removing a given fragment_id, I guess it would be better to create a unique ID based on the current fragment_id and a local overflow counter.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
            "web_url": "https://gitlab.com/pquantin"
          },
          "created_at": "2022-11-22T12:31:47.004Z",
          "updated_at": "2022-11-22T12:31:47.004Z",
          "system": false,
          "noteable_id": 190179374,
