  "changes_data": [
    {
      "diff": "@@ -4115,6 +4115,9 @@ if(CLEAN_C_FILES)\n \t)\n endif()\n \n+# CMake 3.31 and later warn, if normalization changes a path (CMP0177).\n+# As we want to normalize without the warning, we do it explicitly.\n+cmake_path(SET TMP_DST_PATH NORMALIZE \"${CMAKE_INSTALL_DATADIR}/${PROJECT_NAME}\")\n install(\n \tFILES\n \t\t${INSTALL_FILES}\n@@ -4123,10 +4126,11 @@ install(\n \t\tGROUP_READ\n \t\tWORLD_READ\n \tDESTINATION\n-\t\t${CMAKE_INSTALL_DATADIR}/${PROJECT_NAME}\n+\t\t${TMP_DST_PATH}\n )\n \n if (BUILD_stratoshark)\n+\tcmake_path(SET TMP_DST_PATH NORMALIZE \"${CMAKE_INSTALL_DATADIR}/${STRATOSHARK_NAME}\")\n \tinstall(\n \t\tFILES\n \t\t\t${STRATOSHARK_INSTALL_FILES}\n@@ -4135,7 +4139,7 @@ if (BUILD_stratoshark)\n \t\t\tGROUP_READ\n \t\t\tWORLD_READ\n \t\tDESTINATION\n-\t\t\t${CMAKE_INSTALL_DATADIR}/${STRATOSHARK_NAME}\n+\t\t\t${TMP_DST_PATH}\n \t)\n endif()\n \n@@ -4231,17 +4235,19 @@ if(BUILD_stratoshark AND QT_FOUND AND NOT APPLE AND (NOT WIN32 OR USE_MSYSTEM))\n \t\tRENAME org.wireshark.Stratoshark.svg)\n endif()\n \n+cmake_path(SET TMP_DST_PATH NORMALIZE \"${CMAKE_INSTALL_LIBDIR}/pkgconfig\")\n install(FILES \"${CMAKE_BINARY_DIR}/resources/wireshark.pc\"\n-\tDESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig\n+\tDESTINATION ${TMP_DST_PATH}\n \tCOMPONENT \"Development\"\n \tEXCLUDE_FROM_ALL\n )\n \n+cmake_path(SET TMP_DST_PATH NORMALIZE \"${CMAKE_INSTALL_DATADIR}/${PROJECT_NAME}\")\n install(\n \tDIRECTORY\n \t\t${INSTALL_DIRS}\n \tDESTINATION\n-\t\t${CMAKE_INSTALL_DATADIR}/${PROJECT_NAME}\n+\t\t${TMP_DST_PATH}\n \tFILE_PERMISSIONS\n \t\tOWNER_WRITE OWNER_READ\n \t\tGROUP_READ\n@@ -4255,12 +4261,14 @@ install(\n \tPATTERN \"Makefile.*\" EXCLUDE\n )\n \n+\n if (BUILD_stratoshark)\n+\tcmake_path(SET TMP_DST_PATH NORMALIZE \"${CMAKE_INSTALL_DATADIR}/${STRATOSHARK_NAME}\")\n \tinstall(\n \t\tDIRECTORY\n \t\t\t${STRATOSHARK_INSTALL_DIRS}\n \t\tDESTINATION\n-\t\t\t${CMAKE_INSTALL_DATADIR}/${STRATOSHARK_NAME}\n+\t\t\t${TMP_DST_PATH}\n \t\tFILE_PERMISSIONS\n \t\t\tOWNER_WRITE OWNER_READ\n \t\t\tGROUP_READ\n",
