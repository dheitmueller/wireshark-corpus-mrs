  "changes_data": [
    {
      "diff": "@@ -1091,7 +1091,7 @@ Wireshark uses various mime-types for dragging dropping as well as file formats.\n This chapter gives an overview over all the mimetypes being used, as well as the\n data format in which data has to be provided for each individual mimetype.\n \n-If not otherwise stated, the data is encoded as a Json Object.\n+If not otherwise stated, the data is encoded as a JSON Object.\n \n ==== Display Filter\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "docbook/wsdg_src/WSDG_chapter_sources.adoc",
      "old_path": "docbook/wsdg_src/WSDG_chapter_sources.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -28,7 +28,7 @@ wsbuglink:17779[]\n \n * The Conversation and Endpoint dialogs have been redesigned with the following improvements:\n  - The context menu now includes the option to resize all columns, as well as copying elements\n- - Data may be exported as Json\n+ - Data may be exported as JSON\n  - Tabs may be detached and reattached from the dialog\n  - Adding/Removing tabs will keep them in the same order all the time\n  - If a filter is applied, two columns are shown in either dialog detailing the difference between\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "docbook/release-notes.adoc",
      "old_path": "docbook/release-notes.adoc",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -272,8 +272,8 @@ QMenu * TrafficTree::createCopyMenu(QWidget *parent)\n     ca->setToolTip(tr(\"Copy all values of this page to the clipboard in the YAML data serialization format.\"));\n     ca->setProperty(\"copy_as\", TrafficTree::CLIPBOARD_YAML);\n     connect(ca, &QAction::triggered, this, &TrafficTree::clipboardAction);\n-    ca = copy_menu->addAction(tr(\"as Json\"));\n-    ca->setToolTip(tr(\"Copy all values of this page to the clipboard in the Json data serialization format.\"));\n+    ca = copy_menu->addAction(tr(\"as JSON\"));\n+    ca->setToolTip(tr(\"Copy all values of this page to the clipboard in the JSON data serialization format.\"));\n     ca->setProperty(\"copy_as\", TrafficTree::CLIPBOARD_JSON);\n     connect(ca, &QAction::triggered, this, &TrafficTree::clipboardAction);\n \n",
      "collapsed": false,
