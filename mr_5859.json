    },
    {
      "id": "5b18a2ae75d185c63e5e3f1da5daba2c150a244c",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 814463221,
          "type": null,
          "body": "The downside of assuming that something is SRTCP when it's plain RTCP is that parts won't decode. The disadvantage of assuming plain RTCP when it's SRTCP is possible malformed errors (particularly if encrypted) or expert warnings.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
