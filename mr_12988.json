  "changes_data": [
    {
      "diff": "@@ -652,7 +652,14 @@ Commit Check:\n     - (cd /tmp ; curl -JLO https://gitlab.com/gitlab-org/cli/-/releases/v1.34.0/downloads/glab_1.34.0_Linux_x86_64.deb)\n     - dpkg --install /tmp/glab_1.34.0_Linux_x86_64.deb\n     - glab auth status\n-    - if [[ $NUM_COMMITS > 1 ]] ; then glab mr note $CI_MERGE_REQUEST_IID --unique --message \"ℹ️ This merge request has multiple commits.\" ; fi\n+    - >\n+      if [[ $NUM_COMMITS > 1 ]] ; then\n+        glab mr note $CI_MERGE_REQUEST_IID --unique --message \"ℹ️ This merge request has more than one commit:\n+        ~~~\n+        $(git log --oneline --no-decorate \"${CI_COMMIT_SHA}~$NUM_COMMITS..${CI_COMMIT_SHA}\")\n+        ~~~\n+        \"\n+      fi\n     # build-ubuntu puts us in `build`.\n     - cd ..\n     - git status\n",
      "collapsed": false,
      "too_large": false,
