    {
      "id": "9e14dfee61ec5da2d016b02e0476e1d5c5a62b0e",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 2974736987,
          "type": "DiscussionNote",
          "body": "I worry a little bit that being more strict about what profile files are discovered might cause accidental problems if someone adds a file to a distributed profile that isn't one of these. There are a lot of possible profile files and this is only a subset. I guess we could worry about that later, since there is the reverse problem of including unwanted files.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-12-26T16:20:04.205Z",
          "updated_at": "2025-12-26T18:32:49.227Z",
          "system": false,
          "noteable_id": 442885759,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "resolved_at": "2025-12-26T18:32:49.227Z",
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 22941,
          "commands_changes": {}
        },
        {
          "id": 2974767869,
          "type": "DiscussionNote",
          "body": "I went ahead and switched back to globbing everything. Another potential issue is the potential need to disable something in the profile directories, but it's easy enough to switch to more explicit globs or static lists if needed.",
