fest_contents}\")\n+\n endif()\n \n if (BUILD_stratoshark)\n@@ -212,6 +230,21 @@ if (BUILD_stratoshark)\n \t\tset(_all_manifest_contents \"${_all_manifest_contents}File \\\"\\${STAGING_DIR}\\\\${_dll}\\\"\\n\")\n \tendforeach()\n \tfile(WRITE \"${_all_manifest}\" \"${_all_manifest_contents}\")\n+\n+\t# stratoshark-profile-manifest.nsh.\n+\tset(_profile_manifest_contents \"# Profile files. Generated by CMake.\\n\")\n+\tset(_outdir \"Oops. This should not be here.\")\n+\tforeach(_profile_file ${STRATOSHARK_PROFILE_FILES})\n+\t\tif(${_profile_file} MATCHES \"^([^/]+)/.+\")\n+\t\t\tif (NOT ${_outdir} STREQUAL ${CMAKE_MATCH_1})\n+\t\t\t\tset(_outdir \"${CMAKE_MATCH_1}\")\n+\t\t\t\tset(_profile_manifest_contents \"${_profile_manifest_contents}SetOutPath '\\$INSTDIR\\\\profiles\\\\${_outdir}'\\n\")\n+\t\t\tendif()\n+\t\t\tfile(TO_NATIVE_PATH \"${_profile_file}\" _native_profile_file)\n+\t\t\tset(_profile_manifest_contents \"${_profile_manifest_contents}File \\\"\\${TOP_SRC_DIR}\\\\resources\\\\share\\\\stratoshark\\\\profiles\\\\${_native_profile_file}\\\"\\n\")\n+\t\tendif()\n+\tendforeach()\n+\tfile(WRITE \"${CMAKE_CURRENT_BINARY_DIR}/stratoshark-profile-manifest.nsh\" \"${_profile_manifest_contents}\")\n endif()\n \n file(TO_NATIVE_PATH \"${DATAFILE_DIR}\" _staging_dir)\n@@ -359,10 +392,12 @@ set(CLEAN_FILES\n \twireshark-${VERSION}-${WIRESHARK_TARGET_PLATFORM}.exe\n \twireshark-config.nsh\n \twireshark-manifest.nsh\n+\twireshark-profile-manifest.nsh\n \twireshark-qt-manifest.nsh\n \t${DATAFILE_DIR}/uninstall-stratoshark.exe\n \tstratoshark-${VERSION}-${WIRESHARK_TARGET_PLATFORM}.exe\n \tstratoshark-config.nsh\n \tstratoshark-manifest.nsh\n+\tstratoshark-profile-manifest.nsh\n \tstratoshark-qt-manifest.nsh\n )\n",
