        "e1d492e2e0324b8c6cf6b784b5229cebb05c6415"
      ],
      "title": "Gitlab CI: Enable -Werror with Clang builds",
      "message": "Gitlab CI: Enable -Werror with Clang builds\n\nEnable -Werror so Clang specific warnings will trigger a build\nerror and can't be checked-in.\n\nThis requires disabling \"extra\" warnings.\n\nAdd explicit ENABLE_WERROR=ON options instead of relying on defaults.\n",
      "author_name": "João Valverde",
      "author_email": "j@v6e.pt",
      "authored_date": "2022-11-15T16:56:19.000+00:00",
      "committer_name": "João Valverde",
      "committer_email": "j@v6e.pt",
      "committed_date": "2022-11-17T11:31:30.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/006f10f108ee8301a444b555b14787c2ec698e10"
    },
    {
      "id": "e1d492e2e0324b8c6cf6b784b5229cebb05c6415",
      "short_id": "e1d492e2",
      "created_at": "2022-11-17T11:22:57.000+00:00",
      "parent_ids": [
        "2443df73184f22d2a9b49e82e12a9ebb9dffeb14"
      ],
      "title": "CMake: Do not disable -Werror with \"extra compiler warnings\"",
      "message": "CMake: Do not disable -Werror with \"extra compiler warnings\"\n\nGive the ENABLE_WERROR option full control of -Werror. Silently\noverriding the user configuration is potentially confusing and\nunnecessary.\n",
      "author_name": "João Valverde",
      "author_email": "j@v6e.pt",
      "authored_date": "2022-11-12T21:07:13.000+00:00",
