    {
      "id": "df6368c2d6f9f7b16208637a74909e5fc815d577",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 679886699,
          "type": null,
          "body": "There is an assumption in TWAMP dissector currently that client can send one and only one Session-Request message, but the RFC-4656 permits client to send multiple Session-Request messages, before sending Session-Start message.  There are scenarios in live networks, where Wireshark currently fails to decode such sequence correctly.  This code change addresses this issue.",
          "author": {
            "id": 9613351,
            "username": "vivekmangala",
            "public_email": "",
            "name": "Vivek Mangala",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/9613351/avatar.png?v=1789078864",
            "web_url": "https://gitlab.com/vivekmangala"
          },
          "created_at": "2021-09-16T21:28:13.258Z",
          "updated_at": "2021-09-16T21:28:13.258Z",
