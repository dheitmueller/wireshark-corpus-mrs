  "changes_data": [
    {
      "diff": "@@ -47,6 +47,8 @@ static dissector_handle_t btcommon_eir_handle;\n static dissector_handle_t btcommon_ad_handle;\n static dissector_handle_t btcommon_le_channel_map_handle;\n \n+static dissector_table_t bthci_evt_vendor_specific_subevt_table;\n+\n /* Initialize the protocol and registered fields */\n static int proto_bthci_evt;\n static int hf_bthci_evt_code;\n@@ -6817,6 +6819,14 @@ dissect_bthci_evt(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void *dat\n             break;\n \n         case 0xff: /* Vendor-Specific */\n+            // The first byte after length can be a subevent\n+            uint8_t potential_sub_event_code = tvb_get_uint8(tvb, 2);\n+\n+            if(dissector_try_uint_new(bthci_evt_vendor_specific_subevt_table, potential_sub_event_code, tvb, pinfo, tree, TRUE, NULL)) {\n+              // Sub-dissector for this specific event found, we can return early.\n+              return tvb_captured_length(tvb);\n+            }\n+\n             if (!dissector_try_payload_new(vendor_dissector_table, tvb, pinfo, tree, true, bluetooth_data)) {\n                 if (bluetooth_data) {\n                     hci_vendor_data_t  *hci_vendor_data;\n@@ -10164,6 +10174,9 @@ proto_register_bthci_evt(void)\n             \"Version of protocol supported by this dissector.\");\n \n     register_decode_as(&bthci_evt_vendor_da);\n+\n+    /* Dissector table for vendor-specific HCI events */\n+    bthci_evt_vendor_specific_subevt_table = register_dissector_table(\"bthci_evt.vendor_subevent_code\", \"HCI Event Vendor-Specific subevent code\", proto_bluetooth, FT_UINT8, BASE_HEX);\n }\n \n \n",
