    {
      "id": "fa701966ff71ba2ed10281aebe1a704949068e80",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2887547367,
          "type": null,
          "body": "This breaks builds with MSVC before 17.10 (release date May 2024) and warning as errors, which didn't support the \"extra parentheses to mean I really mean an assignment\" idiom: https://learn.microsoft.com/en-us/cpp/overview/cpp-conformance-improvements?view=msvc-170#improvements_1710\n\n#20858",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-11-13T18:10:23.307Z",
          "updated_at": "2025-11-13T18:10:23.307Z",
          "system": false,
          "noteable_id": 377877503,
          "noteable_type": "MergeRequest",
