  "changes_data": [
    {
      "diff": "@@ -72,10 +72,14 @@ workflow:\n   - if: '$CI_PIPELINE_SOURCE == \"push\" && $CI_COMMIT_BRANCH == \"master\" && $CI_PROJECT_URL =~ /.*gitlab.com\\/wireshark\\/wireshark/'\n   - if: '$CI_PIPELINE_SOURCE == \"web\" && $CI_COMMIT_BRANCH == \"master\" && $CI_PROJECT_URL =~ /.*gitlab.com\\/wireshark\\/wireshark/'\n   - if: '$CI_PIPELINE_SOURCE == \"api\"'\n-# Incoming merge requests.\n+# Incoming merge requests, including merge trains\n .if-merge-request:\n   - if: '$CI_PIPELINE_SOURCE == \"merge_request_event\"'\n     interruptible: true\n+# Incoming merge requests, excluding merge trains.\n+.if-plain-merge-request:\n+  - if: '$CI_PIPELINE_SOURCE == \"merge_request_event\" && $CI_MERGE_REQUEST_EVENT_TYPE != \"merge_train\"'\n+    interruptible: true\n # Incoming non-detached merge requests. Must be used for runners which are only\n # available in wireshark/wireshark, e.g. wireshark-windows-*\n .if-w-w-only-merge-request:\n@@ -889,15 +893,15 @@ Ubuntu Qt5 Build:\n # packages work, so disable the MinGW builds for now.\n .Fedora MinGW Build:\n   extends: .build-mingw\n-  rules: !reference [.if-merge-request]\n+  rules: !reference [.if-plain-merge-request]\n   needs: [ 'Commit Check' ]\n \n Clang + Code Checks:\n   extends: .build-ubuntu\n   tags:\n     - saas-linux-medium-amd64\n-  rules: !reference [.if-merge-request]\n-  needs: [ 'Commit Check' ]\n+  rules: !reference [.if-plain-merge-request]\n+  # needs: [ 'Commit Check' ]\n   script:\n     - source /clang-latest.env\n     - apt-get update && apt-get --yes install python3-venv\n@@ -955,7 +959,7 @@ Clang + Code Checks:\n \n No options:\n   extends: .build-ubuntu\n-  rules: !reference [.if-merge-request]\n+  rules: !reference [.if-plain-merge-request]\n   needs: [ 'Commit Check' ]\n   script: |\n     cmake -GNinja -DENABLE_CCACHE=ON \\\n",
      "collapsed": false,
