  "changes_data": [
    {
      "diff": "@@ -26,6 +26,7 @@ function print_usage() {\n     printf \"\\\\t--install-dmg-deps: install packages required to build the .dmg file\\\\n\"\n     printf \"\\\\t--install-sparkle-deps: install the Sparkle automatic updater\\\\n\"\n     printf \"\\\\t--install-all: install everything\\\\n\"\n+    printf \"\\\\t--prefetch: prefetch packages\\\\n\"\n     printf \"\\\\t[other]: other options are passed as-is to apt\\\\n\"\n }\n \n@@ -38,6 +39,12 @@ function install_formulae() {\n         fi\n     done\n     if (( ${#INSTALL_LIST[@]} != 0 )); then\n+        if [ $PREFETCH -ne 0 ] ; then\n+            for FORMULA in \"${INSTALL_LIST[@]}\" ; do\n+                brew fetch \"$FORMULA\" &\n+            done\n+            wait\n+        fi\n         brew install \"${INSTALL_LIST[@]}\"\n     else\n         printf \"Nothing to install.\\n\"\n@@ -47,6 +54,7 @@ function install_formulae() {\n INSTALL_OPTIONAL=0\n INSTALL_DMG_DEPS=0\n INSTALL_SPARKLE_DEPS=0\n+PREFETCH=0\n OPTIONS=()\n for arg; do\n     case $arg in\n@@ -68,6 +76,9 @@ for arg; do\n             INSTALL_DMG_DEPS=1\n             INSTALL_SPARKLE_DEPS=1\n             ;;\n+        --prefetch)\n+            PREFETCH=1\n+            ;;\n         *)\n             OPTIONS+=(\"$arg\")\n             ;;\n",
      "collapsed": false,
