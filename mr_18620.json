    {
      "id": "2d6250598e9e79239aad67b12a1d2fa4af40f73b",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2279466326,
          "type": null,
          "body": "The Qt documentation recommends against using `asprintf` in new code, presumably for security reasons around buffer overflows, etc. However, the field_format member is used (and has always only been used) by the CLI tap used by tshark to display these tables (these are intended to be UI independent).\n\nSo I don't think it introduces any new issues, so long as Qt doesn't actually deprecate this later.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-01-02T16:33:54.022Z",
          "updated_at": "2025-01-02T16:33:54.022Z",
          "system": false,
          "noteable_id": 352765725,
          "noteable_type": "MergeRequest",
