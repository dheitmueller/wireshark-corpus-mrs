    {
      "id": "b745bcdeac2f955ca5a0081dba3984bd85095061",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 850522282,
          "type": "DiscussionNote",
          "body": "Can this instead be done by having post-dissectors (or dissectors in general) indicating, at registration time, that they require the columns?  That has the advantages that:\n\n1. The user doesn't have to know that they need to use `--columns` - it Just Works.\n1. `--columns` is left available to, for example, be a more convenient way in saying what columns TShark prints if you run it without `-V`.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-02-22T00:52:33.493Z",
          "updated_at": "2022-02-22T01:42:34.538Z",
          "system": false,
          "noteable_id": 92853734,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6701257,
            "username": "chuckcraft",
            "public_email": "",
            "name": "Chuck Craft",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/0809ffc6d9d98013a1895132bc055c622830b8a20bfa49328f53d5eb4a1206cb?s=80&d=identicon",
            "web_url": "https://gitlab.com/chuckcraft"
          },
          "resolved_at": "2022-03-01T17:46:12.388Z",
          "confidential": false,
          "internal": false,
