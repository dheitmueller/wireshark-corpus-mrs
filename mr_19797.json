  "changes_data": [
    {
      "diff": "@@ -616,19 +616,26 @@ macOS Universal Package:\n     - wireshark-macos-arm-package\n   retry: 1\n   script:\n+    # Install a separate copy of pkg-config, otherwise we'll find a bunch of packages in /usr/local.\n+    - curl -JLO https://pkgconfig.freedesktop.org/releases/pkg-config-0.29.2.tar.gz\n+    - echo \"6fc69c01688c9458a57eb9a1664c9aba372ccda420a02bf4429fe610e7e7d591  pkg-config-0.29.2.tar.gz\" | shasum --algorithm 256 --check\n+    - mkdir _local\n+    - tar -xf pkg-config-0.29.2.tar.gz\n+    - cd pkg-config-0.29.2\n+    - CFLAGS=\"-Wno-int-conversion\" ./configure --prefix=\"$CI_PROJECT_DIR/_local\" --with-internal-glib\n+    - make\n+    - make install\n+    - cd ..\n     - export WIRESHARK_BASE_DIR=${CI_PROJECT_DIR}/../wireshark-third-party\n     - if [ ! -d $WIRESHARK_BASE_DIR ] ; then mkdir $WIRESHARK_BASE_DIR ; fi\n     - export CMAKE_PREFIX_PATH=/usr/local/Qt-$MACOS_QT_VERSION\n-    - export PATH=\"$PATH:$HOME/bin\"\n+    - export PATH=\"$CI_PROJECT_DIR/_local/bin:$PATH:$HOME/bin\"\n     - mkdir build\n     - cd build\n     - ../tools/make-version.py --set-release --wireshark-version-file=wireshark_version.txt --stratoshark-version-file=stratoshark_version.txt ..\n     - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n-    # macos-setup.sh installs libxml2, but we want the one from the macOS SDK.\n     - cmake -G Ninja\n       -DENABLE_CCACHE=ON\n-      -DLIBXML2_INCLUDE_DIR=/Library/Developer/CommandLineTools/SDKs/MacOSX13.3.sdk/usr/include/libxml2\n-      -DLIBXML2_LIBRARY=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib/libxml2.tbd\n       -DWIRESHARK_BASE_DIR=$WIRESHARK_BASE_DIR\n       -DCMAKE_OSX_DEPLOYMENT_TARGET=12.0\n       -DCMAKE_OSX_ARCHITECTURES=\"arm64;x86_64\"\n",
      "collapsed": false,
      "too_large": false,
      "new_path": ".gitlab-ci.yml",
      "old_path": ".gitlab-ci.yml",
