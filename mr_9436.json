    {
      "id": "107b278b27caa3468a637167b5618a6804730257",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1239413698,
          "type": "DiffNote",
          "body": "C11 says \"The `isinf` macro returns a nonzero value if and only if its argument has an infinite value.\", so the old code isn't correct for *any* platform - nothing prevents a C implementation from having it return 17 if the value is infinite. (In *practice*, most if not all implementations return 1, but, in *practice*, the correct code does fewer tests.)\n\nWhat was the warning?  I'm surprised MinGW's GCC complained but no other compilers have complained.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2023-01-14T02:12:38.467Z",
          "updated_at": "2023-01-14T02:12:38.467Z",
          "system": false,
          "noteable_id": 199272677,
          "noteable_type": "MergeRequest",
