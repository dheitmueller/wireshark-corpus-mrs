    {
      "id": "b98bf97fe164b5fcc61159afe5de7cfc5ac695c9",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1050092213,
          "type": null,
          "body": "Belated answer but yes, it was intended for the reason Pascal touches upon. It is for easy navigation to the reassembled frame.\nHaving this field also present in the final frame, pointing to itself, does not make sense.\n\nI think a better solutiuon would be to add a reassembly identifier to all the frames instead.\nI.e. leave reassembled_in as now, but add a \"tcp.reassembly_id\" to all the frames.\nThat new field would just be an integer and not a link.",
          "author": {
            "id": 7014716,
            "username": "sahlberg",
            "public_email": "",
            "name": "Ronnie Sahlberg",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/88911e6cfe3dfc07b327385209d35a46898b5f12538fcb9fe0d5cf97dd7b94d2?s=80&d=identicon",
            "web_url": "https://gitlab.com/sahlberg"
          },
          "created_at": "2022-08-03T21:31:55.788Z",
          "updated_at": "2022-08-03T21:33:04.968Z",
          "system": false,
          "noteable_id": 118361220,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
