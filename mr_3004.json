      "diff": "@@ -2441,6 +2441,9 @@ if(BUILD_wireshark AND QT_FOUND)\n \t\tLINK_FLAGS \"${WS_LINK_FLAGS}\"\n \t\tFOLDER \"Executables\"\n \t\tINSTALL_RPATH \"${EXECUTABLE_INSTALL_RPATH}\"\n+\t\tAUTOMOC ON\n+\t\tAUTOUIC ON\n+\t\tAUTORCC ON\n \t)\n \tif(MSVC)\n \t\tset_target_properties(wireshark PROPERTIES LINK_FLAGS_DEBUG \"${WS_MSVC_DEBUG_LINK_FLAGS}\")\n",
