  "changes_data": [
    {
      "diff": "@@ -540,6 +540,9 @@ of the form \"\\\\pipe\\.\\B<pipename>\".  Data read from pipes must be in\n standard pcapng or pcap format. Pcapng data must have the same\n endianness as the capturing host.\n \n+\"TCP@<host>:<port>\" causes B<TShark> to attempt to connect to the\n+specified port on the specified host and read pcapng or pcap data.\n+\n This option can occur multiple times. When capturing from multiple\n interfaces, the capture file will be saved in pcapng format.\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/tshark.pod",
      "old_path": "doc/tshark.pod",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -389,7 +389,7 @@ Network interface names should match one of the names listed in\n \"B<wireshark -D>\" (described above); a number, as reported by\n \"B<wireshark -D>\", can also be used.  If you're using UNIX, \"B<netstat\n -i>\", \"B<ifconfig -a>\" or \"B<ip link>\" might also work to list interface names,\n-although not all versions of UNIX support the B<-a> flag to B<ifconfig>.\n+although not all versions of UNIX support the B<-a> option to B<ifconfig>.\n \n If no interface is specified, B<Wireshark> searches the list of\n interfaces, choosing the first non-loopback interface if there are any\n@@ -403,6 +403,9 @@ of the form \"\\\\pipe\\.\\B<pipename>\".  Data read from pipes must be in\n standard pcapng or pcap format. Pcapng data must have the same\n endianness as the capturing host.\n \n+\"TCP@<host>:<port>\" causes B<Wireshark> to attempt to connect to the\n+specified port on the specified host and read pcapng or pcap data.\n+\n This option can occur multiple times. When capturing from multiple\n interfaces, the capture file will be saved in pcapng format.\n \n",
      "collapsed": false,
      "too_large": false,
      "new_path": "doc/wireshark.pod.template",
      "old_path": "doc/wireshark.pod.template",
