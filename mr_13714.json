    {
      "id": "101ebe264bda9eccc6d6d2665779e334f1be82f2",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1697706726,
          "type": "DiscussionNote",
          "body": "I understand, but the AUTHORS file is generated from the git commit history, and your old address lives on in the git repository associated with your old commits. There's no way to avoid it without rewriting the git history, which can't happen.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2023-12-17T03:52:45.315Z",
          "updated_at": "2023-12-17T16:38:43.174Z",
