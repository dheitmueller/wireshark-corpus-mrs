    {
      "id": "cde63fd97eec7c15b7dbc25de7a380a5188bb37c",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1697654349,
          "type": null,
          "body": "By the way, @johnthacker , the gitmailmap approach makes sense when someone has two valid emails addresses, one used for committing and another IRL. \nHowever, for my case (my old email address is invalid/dead), the mapping perpetuates an stale email address.\nThanks!\nCarlos.",
          "author": {
            "id": 12112566,
            "username": "cpignata",
            "public_email": "cpignata@gmail.com",
            "name": "Carlos Pignataro",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/6c31649ad638056f69285242597483a034d19932c1cfd1e537ba3e9dcaf3509b?s=80&d=identicon",
