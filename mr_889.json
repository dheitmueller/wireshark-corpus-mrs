        }
      ]
    },
    {
      "id": "50c8003ae51ba4f7ead7ab046e5330bd35e3ad6f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 443966111,
          "type": null,
          "body": "I have fixed up around half of the issues check_typed_item_calls.py detected (see https://www.wireshark.org/lists/wireshark-dev/202010/msg00056.html).  It is tedious work though in a lot of cases to find documentation of the fields in question.\n\nQuite often (as was the case with OpenSafety), the number of bytes selected is correct, but the item itself is not wide enough.  This is often not detected because it is unlikely that values found in captures need all of the bytes.  It is surprisingly common to find e.g. a 2-byte field that uses a value_string whose largest value is (say) 4.",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2020-11-09T09:55:40.894Z",
          "updated_at": "2020-11-09T09:55:40.894Z",
          "system": false,
          "noteable_id": 77312218,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 889,
          "commands_changes": {}
        }
      ]
    }
