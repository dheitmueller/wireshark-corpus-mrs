      "resolvable": false,
      "notes": [
        {
          "id": 443753334,
          "type": null,
          "body": "Is this due to changes in the API? The original limits stem from the specification of openSAFETY",
          "author": {
            "id": 2498449,
            "username": "rknall",
            "public_email": "",
            "name": "Roland Knall",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9e1d973c5007651b2ca47071f80324c2de5349d873e365cf0761df5542dfe382?s=80&d=identicon",
            "web_url": "https://gitlab.com/rknall"
          },
          "created_at": "2020-11-08T21:16:01.288Z",
          "updated_at": "2020-11-08T21:16:01.288Z",
          "system": false,
          "noteable_id": 77312218,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 889,
