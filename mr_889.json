        }
      ]
    },
    {
      "id": "afc04bdb948a589e8b861753bcddfd92272a5bb2",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 443754198,
          "type": null,
          "body": "@rknall, these were found by tools/check_typed_item_calls.py, where the length in the proto_tree_add_item() didn't match the length implied by the item.\n\nI verified the length of the items using https://www.ethernet-powerlink.org/fileadmin/user_upload/Dokumente/Downloads/TECHNICAL_DOCUMENTS/EPSG_WDP_304_V-1-5-0__3_.pdf\n\nWhere the next item in the code was also consistent with the length in the proto_tree_add_item() calls.\n\nDo any of these look wrong to you?",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2020-11-08T21:24:43.191Z",
          "updated_at": "2020-11-08T21:24:43.191Z",
          "system": false,
          "noteable_id": 77312218,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 889,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "77b25e5bfb29efca14e7cdc49f665d06cc15470c",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 443754544,
          "type": null,
          "body": "These items are all descibed in section 5.6.4.10.1\n\nData Type Len Name\n\nUINT8 1 Parameter Set number\n\nUINT8 1 Header Version (reserved for future use)\n\nUINT16 2 SAddr of SN\n\nUINT32 4 Octet size for parameter set without header\n\nUINT32 4 CRC for parameter set without header\n\nUINT32 4 Timestamp for parameter set",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2020-11-08T21:27:29.698Z",
          "updated_at": "2020-11-08T21:27:50.761Z",
          "system": false,
          "noteable_id": 77312218,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 889,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "558dc200bf1a54623939d77579453b61861f2fa0",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 443857055,
          "type": null,
          "body": "No, you where right. Interestingly enough, I wrote both the spec as well as the dissector. Must be some form of copy/paste error.",
          "author": {
            "id": 2498449,
            "username": "rknall",
            "public_email": "",
            "name": "Roland Knall",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9e1d973c5007651b2ca47071f80324c2de5349d873e365cf0761df5542dfe382?s=80&d=identicon",
            "web_url": "https://gitlab.com/rknall"
          },
          "created_at": "2020-11-09T06:47:23.404Z",
          "updated_at": "2020-11-09T06:47:23.404Z",
          "system": false,
          "noteable_id": 77312218,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 889,
