      "diff": "@@ -1,4 +1,4 @@\n-#!/bin/bash\n+#!/bin/ash\n # Setup development environment on alpine systems\n #\n # Wireshark - Network traffic analyzer\n@@ -50,6 +50,7 @@ then\n fi\n \n BASIC_LIST=\"\n+\tbash\n \tcmake\n \tninja\n \tgcc\n@@ -60,10 +61,11 @@ BASIC_LIST=\"\n \ttiff-dev\n \tc-ares-dev\n \tpcre2-dev\n-\tqt5-qtbase-dev\n-\tqt5-qttools-dev\n-\tqt5-qtmultimedia-dev\n-\tqt5-qtsvg-dev\n+\tqt6-qtbase-dev\n+\tqt6-qttools-dev\n+\tqt6-qtmultimedia-dev\n+\tqt6-qtsvg-dev\n+\tqt6-qt5compat-dev\n \tspeexdsp-dev\n \tpython3\n \t\"\n@@ -74,6 +76,7 @@ ADDITIONAL_LIST=\"\n \tlibssh-dev\n \tspandsp-dev\n \tlibcap-dev\n+\tlibcap-setcap\n \tlibpcap-dev\n \tlibxml2-dev\n \tlibmaxminddb-dev\n@@ -83,11 +86,12 @@ ADDITIONAL_LIST=\"\n \tsnappy-dev\n \tnghttp2-dev\n \tnghttp3-dev\n-\tlua5.3-dev\n+\tlua5.4-dev\n \tlibnl3-dev\n \tsbc-dev\n \tminizip-dev\n \tbrotli-dev\n+\topencore-amr-dev\n \tperl\n \tpy3-pytest\n \tpy3-pytest-xdist\n",
