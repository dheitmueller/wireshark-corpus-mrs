      "parent_ids": [
        "b8ec3199abebdfe170e4a5165ebe68d41af2f269"
      ],
      "title": "About: Make clipboard info a close copy of dialog info",
      "message": "About: Make clipboard info a close copy of dialog info\n\nTo maintain familiarity and keep to expectations do an exact copy.\n\nThe last sentence to check the man page is an exception because it\nis an addenda and recognizing that this clipboard information will\nbe used mostly in bug reports, it might get annoying.\n",
      "author_name": "João Valverde",
      "author_email": "j@v6e.pt",
      "authored_date": "2022-07-31T10:52:08.000+01:00",
