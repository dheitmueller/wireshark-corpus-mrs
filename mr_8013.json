    {
      "id": "7c63d57a46dcd8baad29a92e549d942b266e44b0",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1087466202,
          "type": null,
          "body": "Possibly all of this should be done in general in `epan/packet.c` in the various `call_dissector` functions the same way that other packet_info information like `current_proto`, `can_desegment`, and so forth are saved and restored.\n\nThere should probably be an array/linked list for all the conversations associated with a packet (used later for the conversation table) and also a separate value for the most recent conversation, with the latter being saved and restored.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
