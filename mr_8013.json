    {
      "id": "fea4805e63bf602d62581a717e64ba1583b28a12",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1088715361,
          "type": null,
          "body": "This same kind of logic also applies to some other protocols (I ran into \"has a\" vs \"sibling alongside\" relationship confusions in LTP and BPv6/BPv7, both of which allow concatenating of multiple PDUs into a single frame). I don't think this affects your logic in any way, but it could be helpful to know there are other places where this distinction are important (both in bookkeeping like conversations and for more visual things like the protocol hierarchy). It's actually an interesting problem if there were PDUs from multiple LTP conversations in a single frame, luckily I don't think any current engines would produce such a thing.",
          "author": {
            "id": 8866386,
            "username": "BrianSipos",
            "public_email": "",
            "name": "Brian Sipos",
            "state": "active",
            "locked": false,
