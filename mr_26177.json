      "diff": "@@ -1321,7 +1321,7 @@ dissect_wlan_radio_phdr(tvbuff_t * tvb, packet_info * pinfo, proto_tree * tree,\n   }\n \n   /* make sure frame_length includes the FCS for accurate duration calculation */\n-  if (pinfo->pseudo_header->ieee_802_11.fcs_len == 0) {\n+  if (phdr->fcs_len == 0) {\n     frame_length += 4;\n   }\n \n",
