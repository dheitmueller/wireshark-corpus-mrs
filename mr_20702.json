t\", \"pfcp.jnpr.targeted_distribution.weight\",\n+            FT_UINT16, BASE_DEC, NULL,\n+            0x0, NULL, HFILL }\n+        },\n+\n         /* Nokia */\n \n         { &hf_pfcp_nokia_sap_template,\n",
