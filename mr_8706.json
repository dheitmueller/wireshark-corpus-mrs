  "changes_data": [
    {
      "diff": "@@ -523,8 +523,12 @@ Code Checks + Clang Warnings:\n   variables:\n     CC: \"clang-$CLANG_VERSION\"\n     CXX: \"clang++-$CLANG_VERSION\"\n+    CFLAGS: \"-fuse-ld=/bin/mold\"\n+    # CXXFLAGS: \"-fuse-ld=/bin/mold\"\n   needs: [ 'Commit Check' ]\n   script:\n+    # Install mold\n+    - ( cd /tmp && curl -JLO https://github.com/rui314/mold/releases/download/v1.6.0/mold-1.6.0-x86_64-linux.tar.gz && tar --extract --file  mold*.tar.gz && mv mold*/bin/mold /bin )\n     # build-ubuntu puts us in `build`.\n     - cd ..\n     - python3 tools/checklicenses.py\n",
