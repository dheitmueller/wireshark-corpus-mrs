  "changes_data": [
    {
      "diff": "@@ -5262,6 +5262,10 @@ static bool gen_conversations(packet_info *pinfo, uint32_t current_fake_aruuid)\n         if (fp != NULL) {\n             fseek(fp, 0, SEEK_END);\n             long fsize = ftell(fp);\n+            if (fsize == -1L) {\n+                fclose(fp);\n+                return false;\n+            }\n             fseek(fp, 0, SEEK_SET);\n \n             buf = (char*)wmem_alloc(pinfo->pool, fsize + 1);\n@@ -5422,6 +5426,10 @@ static void extract_pnio_objects_withoutAR(packet_info* pinfo)\n                         if (fp != NULL) {\n                             fseek(fp, 0, SEEK_END);\n                             long fsize = ftell(fp);\n+                            if (fsize == -1L) {\n+                                fclose(fp);\n+                                return;\n+                            }\n                             fseek(fp, 0, SEEK_SET);\n \n                             buf = (char*)wmem_alloc(pinfo->pool, fsize + 1);\n",
