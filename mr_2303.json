      "diff": "@@ -109,7 +109,7 @@ struct ptvcursor {\n \tPROTO_REGISTRAR_GET_NTH(hfindex, hfinfo);\t\t\t\\\n \tif (PTREE_DATA(tree)->count > prefs.gui_max_tree_items) {\t\t\t\\\n \t\tfree_block;\t\t\t\t\t\t\\\n-\t\tif (getenv(\"WIRESHARK_ABORT_ON_TOO_MANY_ITEMS\") != NULL) \\\n+\t\tif (wireshark_abort_on_too_many_items) \\\n \t\t\tg_error(\"Adding %s would put more than %d items in the tree -- possible infinite loop (max number of items can be increased in advanced preferences)\", \\\n \t\t\t    hfinfo->abbrev, prefs.gui_max_tree_items);\t\\\n \t\t/* Let the exception handler add items to the tree */\t\\\n",
