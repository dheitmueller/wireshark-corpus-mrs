    {
      "id": "495aa46c32a380a5314696573065c02535450e8b",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2330783203,
          "type": null,
          "body": "We handle this in our other other Python scripts by passing `encoding='UTF-8'` to each `open` call. This ensures that the scripts behave the same whether or not they are run as a build target or directly on the command line.\n\nIt would be useful to add a declaration at the top of the script that all text-mode `open` calls should use UTF-8, but PEP 540 doesn't appear to offer anything like that.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1788825804",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2025-02-04T18:11:40.876Z",
          "updated_at": "2025-02-04T18:11:40.876Z",
          "system": false,
          "noteable_id": 359449073,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 18926,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "0b9f8af516b7495075c9337a65ca62e9156a90e0",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2330793744,
          "type": null,
          "body": "@geraldcombs FWIW, I considered doing that, but I figured that this way it's less likely for a developer to introduce subtle breakage by forgetting to add an `encoding` argument. (It's easy to forget, since UTF-8 is usually the default encoding on non-Windows systems, and input files are usually mostly ASCII.)",
          "author": {
            "id": 4210249,
            "username": "SpecLad",
            "public_email": "",
            "name": "Roman Donchenko",
            "state": "active",
            "locked": false,
