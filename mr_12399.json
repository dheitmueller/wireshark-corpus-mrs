  "changes_data": [
    {
      "diff": "@@ -564,7 +564,7 @@ macOS Intel Package:\n     - DMG_SHA256=$( shasum --algorithm 256 Wireshark?[1-9]*.dmg | awk '{print $1}' )\n     - TSHARK_VERSION=$( ./tshark --version | head -n 1 | sed -e 's/.*(v//' -e 's/)\\.*$//' -e 's/-0-g.*//' )\n     - printf '[DEFAULT]\\nsparkle_signature = %s\\ndmg_sha256 = %s\\n' \"$SPARKLE_SIGNATURE\" \"$DMG_SHA256\" > release-info-${TSHARK_VERSION}-macos-intel64.ini\n-    - if [[ -n \"$S3_DESTINATION_RELEASE\" ]] ; then aws s3 cp release-info-${TSHARK_VERSION}-macos-arm64.ini \"$S3_DESTINATION_RELEASE/\" ; fi\n+    - if [[ -n \"$S3_DESTINATION_RELEASE\" ]] ; then aws s3 cp release-info-${TSHARK_VERSION}-macos-intel64.ini \"$S3_DESTINATION_RELEASE/\" ; fi\n     - cd ..\n     - ninja test-programs\n     - python3 -m pytest\n",
