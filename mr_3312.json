  "discussions_data": [
    {
      "id": "aa08290164094c3c360fc7a32b5e9d78a81d5723",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 599534829,
          "type": null,
          "body": "I'm getting a strong sense of deja vu about this change. I don't remember if I already opened a similar MR before or just thought about doing it.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2021-06-11T19:10:46.465Z",
          "updated_at": "2021-06-11T19:10:46.465Z",
          "system": false,
          "noteable_id": 103886947,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
