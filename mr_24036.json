      "diff": "@@ -80,7 +80,7 @@ typedef struct oran_tap_info {\n     uint32_t compression_methods;\n     uint32_t compression_width;      /* TODO: support multiple widths? */\n \n-    /* (DL) beamIds */\n+    /* BeamIds */\n     uint8_t  num_beams;\n     uint16_t beams[MAX_BEAMS_IN_FRAME];\n \n",
