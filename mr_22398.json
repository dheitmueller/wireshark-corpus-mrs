    {
      "id": "79abe5f7aa2e4b9923de35892f3090f50c48d650",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2917034279,
          "type": null,
          "body": "For non-unicode symbols that take up a single byte you can see how the byte in the hex display maps to the where the symbol is displayed in the character view.\nFor example in frame three   you have the byte 0x31 show up in the 10th byte position on the line, and the \"1\" symbol in the text display also shows up in the 10th position.\nThis is a very nice property.\n\nWhen displaying unicode symbols it would be nice if there was an indication of which byte positions belong together for the displayed symbol.\n\nFor example in the last frame shown there is a symbol efb88f that covers the three bytes at byte offsets 4,5,6 on that line. Maybe this could be drawn in the symbol display too with a box outlining positions 4,5,6, indicating they all are joined  and have the symbol drawn in the centre of that box.\n\nOtherwise I think it would be very unfortunate if it is no longer obvious from the display in the symbol pane which actual bytes it corresponds to.",
          "author": {
            "id": 7014716,
            "username": "sahlberg",
            "public_email": "",
            "name": "Ronnie Sahlberg",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/88911e6cfe3dfc07b327385209d35a46898b5f12538fcb9fe0d5cf97dd7b94d2?s=80&d=identicon",
            "web_url": "https://gitlab.com/sahlberg"
          },
          "created_at": "2025-11-27T03:33:41.818Z",
          "updated_at": "2025-11-27T03:35:16.316Z",
          "system": false,
          "noteable_id": 434636192,
