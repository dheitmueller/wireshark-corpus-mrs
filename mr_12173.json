    {
      "id": "a3c6fb63616bd3dc09b60601fbad5a246d04f404",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1728176754,
          "type": null,
          "body": "> X.75 is similar to LAPB, but has no further protocols on top of the asychronous link layer.\n\nThis means that it's not similar enough for the X.75 dissector to register for `WTAP_ENCAP_LAPB`.  That caused issue #19595, which I fixed by removing the line in the X.75 dissector that registered for `WTAP_ENCAP_LAPB`.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-01-16T01:02:39.036Z",
          "updated_at": "2024-01-16T01:02:39.036Z",
