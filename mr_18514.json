    {
      "id": "e6f21bcfcb2959cad524d052ea8f266f2f1efd55",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 2268546174,
          "type": "DiffNote",
          "body": "`%ld` will not work for all platforms to represent a `time_t`.\n\nOne option is to use `nstime_to_unix`, also from `wsutil/nstime.h`, which has fairly similar parameters to `nstime_to_iso8601`. (It does not return a length value, partly because it always succeeds. In a happy coincidence, `NSTIME_UNIX_BUFSIZE` is the same as `NSTIME_ISO8601_BUFSIZE`, 31, so the buffer is fine.)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
