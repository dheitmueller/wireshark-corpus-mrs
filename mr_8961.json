    {
      "id": "2290962edac7e99d26713a19a7cae1db14e19596",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1191214972,
          "type": null,
          "body": "I see the real problem. In `display_extension_block` when there's an error, it's returning `tvb_reported_length_remaining(tvb, offset)`, but the expected return value from that function is the current offset. Either it should just return `tvb_reported_length(tvb)` or it should set the error value `lastheader` in those cases.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
