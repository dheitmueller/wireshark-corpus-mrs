    {
      "id": "8876f5f8debeb6d1b971ac25b2848062c94d7c0d",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 683679865,
          "type": null,
          "body": "I think the CMake version check could be removed here. LINK_OPTIONS -municode is a hard requirement for MinGW so it's better to fail here rather than linking. MinGW will be false on CentOS so the build breakage should still be fixed. I suppose cross-compiling could still be an issue but those CMake requirements should be enforced elsewhere at the top anyway (and what a luxurious problem to have!).\n\nI'll leave that for a follow-up change.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
