    {
      "id": "cfad84ae4b3a326e16299cb1c1fb2c75198058e3",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1745952861,
          "type": null,
          "body": "The SRT table was written for something like how it's used in Diameter, where a row is only added the first time something is encountered when tapping, and the procedure name might be from packet data and packet scoped. So it `strdup`s the procedure name and frees it later.\n\nSome of the dissectors add rows in advance when initializing, which is fine when the strings passed in are all const.\n\nFor dynamically allocated strings, it's hard to get the right scope so creating in null or epan scope and freeing them after passing them in (as they're copied) is probably for the best.\n\nI think originally there was an idea that lots of scopes would be used, and so there could be a scope for the tap or srt table. Mostly fell by the wayside.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-01-26T18:02:49.606Z",
          "updated_at": "2024-01-26T18:02:49.606Z",
          "system": false,
          "noteable_id": 277812442,
