    {
      "diff": "@@ -631,7 +631,7 @@ Documentation:\n   script:\n     # XXX We might want to move this to wireshark-ubuntu-dev or debian-setup.sh.\n     - DEBIAN_FRONTEND=noninteractive apt-get update\n-    - DEBIAN_FRONTEND=noninteractive apt-get --yes install ruby-asciidoctor-pdf ruby-coderay ruby-dev\n+    - DEBIAN_FRONTEND=noninteractive apt-get --yes install docbook-xsl ruby-asciidoctor-pdf ruby-coderay ruby-dev\n     - NOKOGIRI_USE_SYSTEM_LIBRARIES=1 gem install asciidoctor-epub3\n     - mkdir build\n     - cd build\n@@ -746,6 +746,13 @@ Ubuntu GCC Build:\n     - cd \"🦈 build 🦈\"\n     - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n     # Test release build.\n+    # Try to get the docbook-xsl package installed so that the completely\n+    # non-functioning mechanism that attempts to download external entities,\n+    # whose sole purpose in life appears to be to whine that it can't\n+    # load external entities, is not used\n+    - DEBIAN_FRONTEND=noninteractive apt-get update\n+    - DEBIAN_FRONTEND=noninteractive apt-get --yes install docbook-xsl\n+    - printf \"HELLO, HERE I AM, I CAN HAS docbook-xsl?\\n\"\n     - cmake -G Ninja -DCMAKE_BUILD_TYPE=Debug -DENABLE_CCACHE=ON -DENABLE_WERROR=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=on ..\n     - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n     - script --command ninja --flush --quiet --return ../gcc_report.txt\n",
      "collapsed": false,
      "too_large": false,
