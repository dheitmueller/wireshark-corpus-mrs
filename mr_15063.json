    {
      "id": "17c11d93b60a26a4cf6a48827c7ed4c157885f02",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1839122792,
          "type": null,
          "body": "I am unconvinced, at this point, that libxml, at least as xsltproc uses it, is capable of loading anything from over the Intertubes.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2024-03-31T16:48:30.656Z",
          "updated_at": "2024-03-31T16:48:30.656Z",
