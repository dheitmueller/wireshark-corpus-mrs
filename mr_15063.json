    {
      "id": "f2f08d8fd0edcfa0f6ee6945c8f646671fb0fd18",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1839140785,
          "type": null,
          "body": "A better answer might be to get rid of the DocBook+xsltproc parts of the toolchain. I managed to create a script that could split our AsciiDoctor files into multiple chapters, but I couldn't quite get the CSS right. I can try to get that working if there's any interest.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789689689",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2024-03-31T18:48:06.241Z",
          "updated_at": "2024-03-31T18:48:06.241Z",
