      "diff": "@@ -52,9 +52,7 @@ get_form_key_value(wmem_allocator_t *pool, tvbuff_t *tvb, char **ptr, unsigned o\n \t\tlen += (found_offset - offset);\n \t\toffset = found_offset;\n \t\tif (ch == '%') {\n-\t\t\tif (tvb_reported_length_remaining(tvb, offset) < 2) {\n-\t\t\t\treturn false;\n-\t\t\t}\n+\t\t\ttvb_ensure_bytes_exist(tvb, offset, 3);\n \t\t\toffset++;\n \t\t\tch = tvb_get_uint8(tvb, offset);\n \t\t\tif (ws_xton(ch) == -1)\n",
