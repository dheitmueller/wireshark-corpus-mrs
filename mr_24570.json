  "commits_data": [
    {
      "id": "5c1cccc35706212dbaa3ffc08766dff1ac6e200f",
      "short_id": "5c1cccc3",
      "created_at": "2026-06-20T15:19:15.000+05:30",
      "parent_ids": [
        "22001325f20c4ee8e7beb00910329709c648a2e8"
      ],
      "title": "http-urlencoded: fix percent-decoding bounds check",
      "message": "http-urlencoded: fix percent-decoding bounds check\n\nRequire at least 3 bytes (\"%xx\") when decoding percent-encoded values.\nPreviously only 2 bytes were checked, which allowed incomplete escapes\n(e.g., \"%A\" at end-of-field) to pass validation.\n\nThis change keeps the existing behavior of relying on TVB exceptions\nfor truncated packets and only corrects the off-by-one validation.\n\nSigned-off-by: Urval <kheniurval777@gmail.com>\n",
      "author_name": "Urval",
      "author_email": "kheniurval777@gmail.com",
      "authored_date": "2026-04-24T03:09:14.000+05:30",
      "committer_name": "Urval Kheni",
      "committer_email": "kheniurval777@gmail.com",
