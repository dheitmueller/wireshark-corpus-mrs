    {
      "id": "7c2e6e6d5262a5bc30352f104d48e736335d6d6b",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1490398578,
          "type": "DiscussionNote",
          "body": "@alagoutte should we merge this into the current release? Wireshark is currently not able to dissect QUIC v2 packets at all, as the old identifier in is_quic_v2() does not recognize RFC9369 compliant QUIC v2 packets.",
          "author": {
            "id": 9274845,
            "username": "marcelpk",
            "public_email": "",
            "name": "Marcel",
