      "id": "f14cd94f593efe9792fc4dc86c0415edc32f1bf1",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1990967873,
          "type": null,
          "body": "Which RPM based distributions currently have a nghttp3 package?\n\nAFAIK, most of them don't, and  nghttp3 doesn't provide their own package. (That also means that if you install nghttp3 from source on a box you need to make sure to disable it when trying to build an RPM, or else create your own RPM.)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-07-09T21:54:05.985Z",
          "updated_at": "2024-07-09T21:54:05.985Z",
