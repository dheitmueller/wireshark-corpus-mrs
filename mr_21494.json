    {
      "id": "c2e9869dd9c39e092eebf90d3cf02e102dcf7131",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2780783527,
          "type": null,
          "body": "One of the things that tools/check_typed_item_calls.py checks for is whether the length field in proto_tree_add_item() is consistent with the width of the parsed hf item.\n\nIt will warn if the selected bytes are wider than the field (likely to result in unwanted truncation), but not if the selected bytes are fewer - it is fairly common to have a field (say an opcode or length field) that gets widened for a later version of the protocol, but it makes sense to still use the now-expanded field for v1.",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2025-09-26T09:39:24.911Z",
          "updated_at": "2025-09-26T09:39:24.911Z",
