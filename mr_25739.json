      "notes": [
        {
          "id": 3564978987,
          "type": "DiscussionNote",
          "body": "To me it seems like the CRLF is required.\n\nmultipart-body := [preamble CRLF]\n                       dash-boundary transport-padding CRLF\n                       body-part *encapsulation\n                       close-delimiter transport-padding\n                       [CRLF epilogue]",
          "author": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/132fb48f26018ea9516aea909144af3c3a94eaf2ba477efaa9a232abe80d322c?s=80&d=identicon",
            "web_url": "https://gitlab.com/AndersBroman"
          },
          "created_at": "2026-07-16T05:28:45.993Z",
          "updated_at": "2026-07-18T21:50:10.661Z",
          "system": false,
          "noteable_id": 506003495,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 6792385,
            "username": "AndersBroman",
            "public_email": "",
            "name": "AndersBroman",
