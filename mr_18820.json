  "commits_data": [
    {
      "id": "c25fca85f9c9eec05d2f07cf4426e3a05bddd69f",
      "short_id": "c25fca85",
      "created_at": "2025-01-22T08:20:34.000+00:00",
      "parent_ids": [
        "c5e4e2027271fdcb93e0a418186e20132be9047a"
      ],
      "title": "CMake: Fix static linking against GLib2",
      "message": "CMake: Fix static linking against GLib2\n\nGLib2 >= 2.73.2 links against PCRE2, not the older PCRE.\nIf we found GLib2 with pkg-config, trust what pkg-config gave us.\nOtherwise, use the version to determine which PCRE to use.\n\nFix #20344 (although there's lots of other static linking issues.)\n",
      "author_name": "John Thacker",
      "author_email": "johnthacker@gmail.com",
      "authored_date": "2025-01-22T01:18:57.000-05:00",
      "committer_name": "AndersBroman",
      "committer_email": "a.broman58@gmail.com",
      "committed_date": "2025-01-22T08:20:34.000+00:00",
