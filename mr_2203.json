  "commits_data": [
    {
      "id": "7fd71536962cc24614cdc932770f0a4a200f6008",
      "short_id": "7fd71536",
      "created_at": "2021-02-24T06:22:14.000+00:00",
      "parent_ids": [
        "ed86f51e49e2b1ca64525bd14698528a50f3bbb4"
      ],
      "title": "GQUIC: add decoding of CGST tag",
      "message": "GQUIC: add decoding of CGST tag\n\nRegression introduced by b287e7165e.\n\nTo avoid an infinite loop with malformed packets, that commit stops\nparsing the tags list after finding an unknown tag.\nWhen this \"unknown\" tag is perfectly valid but not supported by\nWireshark, we don't decode any subsequent (valid) tags anymore.\n\nGQUIC is going to die soon and it is quite unlikely it will change in\nthe next future. Therefore the best/quick solution is simply decoding\nany valid tag.\n\nClose #17250\n",
      "author_name": "Nardi Ivan",
      "author_email": "nardi.ivan@gmail.com",
      "authored_date": "2021-02-22T20:54:53.000+01:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-02-24T06:22:14.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/7fd71536962cc24614cdc932770f0a4a200f6008"
    }
  ],
