  "changes_data": [
    {
      "diff": "@@ -205,8 +205,21 @@ BuildRequires:\tlibssh-devel\n BuildRequires:\tlibmaxminddb-devel\n %endif\n \n+# RPM 4.16 introduced version comparison in macro expressions, and then\n+# RPM 4.19 introduced a built in %%{rpmversion} macro. We could define\n+# the macro if undefined on earlier versions with:\n+# %%global rpmversion %%(rpm --version | awk '{print $3}')\n+# but still couldn't easily do a version comparison with it before 4.16.\n+# OpenSUSE 15.6 uses 4.14, so that's out for right now.\n+#\n+# Right now, the only thing we need to test the version for is that\n+# that we ought to provide the group if we have any files owned by\n+# the group with RPM 4.19 and later, since it becomes Required by\n+# default in that case. Since those are the same version, that means\n+# it's enough to just check if the macro exists.\n+\n %if %{use_wireshark_group} || \"%{use_stratoshark_group}\" == \"1\"\n-%if v\"%{rpmversion}\" >= v\"4.19\"\n+%if %{defined rpmversion}\n Provides:\tgroup(wireshark)\n %endif\n %if 0%{?suse_version}\n",
      "collapsed": false,
      "too_large": false,
