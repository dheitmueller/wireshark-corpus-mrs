    {
      "id": "f7ed9ea8164dab8a8be5f15fb687114a0250d6a4",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 2214975462,
          "type": "DiscussionNote",
          "body": "Though in fact we might need to install `zlib-ng-compat-devel` instead of `zlib-ng-devel`.\n\nhttps://fedoraproject.org/wiki/Changes/ZlibNGTransition\nhttps://fedoraproject.org/wiki/Changes/MinizipNGTransition\n\nThe particular way we include files and where Fedora puts the zlib and minizip files means that on Fedora we get the NG packages by linking against the compatibility layer, not the new NG API.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
