  "discussions_data": [
    {
      "id": "976188d6f02e7dc877b08ffdae30782e3f0286d1",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2875471594,
          "type": null,
          "body": "The comments in epan/tap.h said this should probably be done anyway.  This solves an \"order of operations\" problem introduced in !22091.\nI intentionally did this after !22196 because I think the tap data should be part of the \"application layer\" when initializing epan.\nThis was introduced because tap listeners are allowed to have UATs (which seems fine).  But looking at the \"big picture\", a similar crash could be introduced if any codecs have a UAT (because of where codecs_init() is called).  Is that something to worry about? (I think not, but thought I'd ask the question).",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2025-11-07T17:00:25.465Z",
          "updated_at": "2025-11-07T17:00:25.465Z",
