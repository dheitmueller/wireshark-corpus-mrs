    {
      "id": "233baf65522e3161bca08782740e759d64559f11",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3639214780,
          "type": null,
          "body": "Hold on, I don't think this is fixing anything. `kerberos_rm_to_reclen` clears the high bit, so when interpreted as unsigned integer, it will never overflow when adding 4 to get the PDU length.\n\nThis appears to be the patch from the reporter, but the subject makes no sense. I don't believe there is a bug.",
          "author": {
            "id": 2415432,
            "username": "Lekensteyn",
            "public_email": "",
            "name": "Peter Wu",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/efcf30db53f30b15e7c905ef37bd4dc44d87573bd92baf97cd707115d3fcd0c0?s=80&d=identicon",
            "web_url": "https://gitlab.com/Lekensteyn"
