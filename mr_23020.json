  "changes_data": [
    {
      "diff": "@@ -28,6 +28,7 @@\n #include <wsutil/feature_list.h>\n \n bool has_npcap;\n+bool use_utf8;\n \n #ifdef HAVE_LIBPCAP\n \n@@ -108,6 +109,8 @@ static int      (*p_pcap_tstamp_type_name_to_val)(const char *);\n static const char * (*p_pcap_tstamp_type_val_to_name)(int);\n static const char * (*p_pcap_tstamp_type_val_to_description)(int);\n \n+static int\t(*p_pcap_init)(unsigned int, char *);\n+\n typedef struct {\n \tconst char\t*name;\n \tvoid *\t*ptr;\n@@ -182,6 +185,7 @@ load_wpcap(void)\n \t\tSYM(pcap_tstamp_type_name_to_val, true),\n \t\tSYM(pcap_tstamp_type_val_to_name, true),\n \t\tSYM(pcap_tstamp_type_val_to_description, true),\n+\t\tSYM(pcap_init, true), /* libpcap 1.10.0 */\n \t\t{ NULL, NULL, false }\n \t};\n \n@@ -215,6 +219,17 @@ load_wpcap(void)\n \n \n \thas_npcap = true;\n+\n+#ifdef HAVE_PCAP_INIT\n+\tchar errbuf[PCAP_ERRBUF_SIZE + 1];\n+\n+\t/* If we have pcap_init, call it. */\n+\tif (p_pcap_init != NULL) {\n+\t\tif (pcap_init(PCAP_CHAR_ENC_UTF_8, errbuf) != 0) {\n+\t\t\t/* This shouldn't happen. */\n+\t\t}\n+\t}\n+#endif\n }\n \n bool\n@@ -310,6 +325,9 @@ static void\n convert_errbuf_to_utf8(char *errbuf)\n {\n \tchar *utf8_err;\n+\tif (use_utf8) {\n+\t\treturn;\n+\t}\n \tif (errbuf[0] == '\\0') {\n \t\treturn;\n \t}\n@@ -348,6 +366,28 @@ cant_load_npcap_err(const char *app_name)\n \treturn g_string_free(err, FALSE);\n }\n \n+#ifdef HAVE_PCAP_INIT\n+int\n+pcap_init(unsigned opts, char *errbuf)\n+{\n+\tif (!has_npcap) {\n+\t\tsnprintf(errbuf, PCAP_ERRBUF_SIZE,\n+\t\t\t   \"unable to load Npcap (wpcap.dll); can't initialize it\");\n+\t\treturn PCAP_ERROR;\n+\t}\n+\tif (p_pcap_init != NULL) {\n+\t\tint ret = p_pcap_init(opts, errbuf);\n+\t\tif (ret == 0 && opts == PCAP_CHAR_ENC_UTF_8) {\n+\t\t\tuse_utf8 = true;\n+\t\t}\n+\t\treturn ret;\n+\t}\n+\tsnprintf(errbuf, PCAP_ERRBUF_SIZE,\n+\t\t   \"The Npcap DLL (wpcap.dll) doesn't have pcap_init\");\n+\treturn PCAP_ERROR;\n+}\n+#endif\n+\n void\n pcap_close(pcap_t *a)\n {\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "capture/capture-wpcap.c",
      "old_path": "capture/capture-wpcap.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -229,6 +229,7 @@ if(PCAP_FOUND)\n     # time, when we load wpcap.dll, and work around their absence or report\n     # an error.\n     #\n+    set(HAVE_PCAP_INIT TRUE)\n     set(HAVE_PCAP_OPEN TRUE)\n     set(HAVE_PCAP_SETSAMPLING TRUE)\n     set(HAVE_PCAP_SET_TSTAMP_PRECISION TRUE)\n@@ -245,6 +246,11 @@ if(PCAP_FOUND)\n       message(FATAL_ERROR \"You need libpcap 1.5 or later\")\n     endif()\n \n+    # pcap_init was introduced in libpcap 1.10, so if it is present we can\n+    # assume other things about libpcap, even though, at least for the moment,\n+    # we don't use pcap_init itself on non-Windows.\n+    check_function_exists( \"pcap_init\" HAVE_PCAP_INIT )\n+\n     #\n     # macOS Sonoma's libpcap includes stub versions of the remote-\n     # capture APIs.  They are exported as \"weakly linked symbols\".\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "cmake/modules/FindPCAP.cmake",
      "old_path": "cmake/modules/FindPCAP.cmake",
      "a_mode": "100644",
