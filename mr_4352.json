      "diff": "@@ -78,6 +78,7 @@ capture_info    *cinfo)\n {\n     CaptureInfoDialog *ci_dlg = qobject_cast<CaptureInfoDialog *>((QObject *)cinfo->ui);\n     if (!ci_dlg) return;\n+    cinfo->ui = NULL;\n     delete ci_dlg;\n }\n \n",
