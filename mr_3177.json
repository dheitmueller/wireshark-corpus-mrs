    {
      "id": "f3a3ca860702324b6953db6257997ba31ecd17de",
      "individual_note": false,
      "resolvable": true,
      "resolved": true,
      "notes": [
        {
          "id": 588193911,
          "type": "DiscussionNote",
          "body": "> Are you fine with using `arm-64` as the architecture name for 64-bit arm binaries?\n\nI think I've generally seen \"arm64\", with no hyphen - the hyphen is in \"x86-64\" because AMD put it there before deciding to rebrand their version \"AMD64\", perhaps because \"x86\" ends with a digit so that, without the hyphen, it'd be \"x8664\", leaving the question \"what's so significant about the number 664?\"",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-05-29T01:40:50.186Z",
          "updated_at": "2021-05-29T08:08:14.680Z",
          "system": false,
          "noteable_id": 101961534,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
            "id": 279822,
            "username": "alagoutte",
            "public_email": "",
            "name": "Alexis La Goutte",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/a15cba6417f4d1723eb56add7099bcfd8df373dc520577958b33c37915ef231b?s=80&d=identicon",
            "web_url": "https://gitlab.com/alagoutte"
          },
          "resolved_at": "2021-05-29T12:27:22.812Z",
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 3177,
          "commands_changes": {}
        },
        {
          "id": 588232978,
          "type": "DiscussionNote",
          "body": "OK, makes sense. Using now `arm64` instead of `arm-64`.",
