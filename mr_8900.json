    {
      "id": "85b1a6c3e81fc1328dd4c60fee9070c05357e6fe",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1237483156,
          "type": null,
          "body": "My inclination is to rename the existing MainWindow `hasSelection` to `hasMultiSelection` (and change it in the one place it is used to m), and have a new `hasSelection` that is true if one or more packets is selected that this code check will use.\n\nUsually in Qt (e.g. QItemSelectionModel) `hasSelection` means one or more item selected, so it's odd to have a method of that name for the MainWindow that really means two or more.\n\n@rknall, opinion?",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
