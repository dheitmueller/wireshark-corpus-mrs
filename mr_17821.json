    {
      "id": "f095db0ff288fc62a17109f315c6f3d15d7759e5",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2185903274,
          "type": null,
          "body": "True. :slight_smile:  pointer-sign should be an easy fix (sometimes a cast) but there are a lot of them. The others are a little bit more work to fix retroactively I think but there are fewer (and no more should be introduced ideally).\n\nI'll gladly to close this though, if there is no traction to move forward.",
          "author": {
            "id": 2639362,
            "username": "jvalverde",
            "public_email": "",
            "name": "João Valverde",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/bea5f745397cf5a2fe0526df96ec143db47f9334340ab56515038832be57e976?s=80&d=identicon",
            "web_url": "https://gitlab.com/jvalverde"
          },
          "created_at": "2024-10-30T14:23:30.803Z",
          "updated_at": "2024-10-30T14:23:30.803Z",
          "system": false,
          "noteable_id": 337174658,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 17821,
          "commands_changes": {}
