  "changes_data": [
    {
      "diff": "@@ -644,15 +644,6 @@ macOS Universal Package:\n     - pip3 install pytest pytest-xdist\n   script:\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n-    # Temporary hack\n-    - export CMAKE_VERSION=3.31.9\n-    - if [ ! -e \"$WIRESHARK_BASE_DIR/cmake-${CMAKE_VERSION}-macos-universal/CMake.app/Contents/bin/cmake\" ] ; then (\n-          cd \"$WIRESHARK_BASE_DIR\" ;\n-          rm -rf cmake-${CMAKE_VERSION}-macos-universal* ;\n-          curl -JLO https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-macos-universal.tar.gz ;\n-          tar -xf cmake-${CMAKE_VERSION}-macos-universal.tar.gz ;\n-      ) fi\n-    - export PATH=\"$WIRESHARK_BASE_DIR/cmake-${CMAKE_VERSION}-macos-universal/CMake.app/Contents/bin:$PATH\"\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt\" ] ; then mkdir -p \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt/$MACOS_QT_VERSION/macos/lib/QtCore.framework\" ] ; then\n         pip3 install aqtinstall ;\n",
