  "changes_data": [
    {
      "diff": "@@ -625,15 +625,16 @@ Windows Build:\n ABI Check:\n   extends: .build-ubuntu\n   rules: !reference [.if-merge-request]\n+  variables:\n+    # Use DWARF-4. ABI dumper version 1.3 is required for DWARF-5 support (the GCC 11 default) but version 1.3 is still not released.\n+    # https://github.com/lvc/abi-dumper/issues/34\n+    CFLAGS: \"-Og -gdwarf-4\"\n   script:\n     # build-ubuntu puts us in `build`.\n     - DEBIAN_FRONTEND=noninteractive apt-get update\n     - DEBIAN_FRONTEND=noninteractive apt-get --yes install abi-dumper abi-compliance-checker\n-    # Ubuntu 20.04 ships with version 1.1, which has issues: https://github.com/lvc/abi-dumper/issues/21\n-    - curl --fail -JL https://raw.githubusercontent.com/lvc/abi-dumper/1.2/abi-dumper.pl > /usr/bin/abi-dumper\n-    # ABI dumper version 1.3 required for DWARF-5 support (the GCC 11 default). Version 1.3 is still not released.\n-    # https://github.com/lvc/abi-dumper/issues/34\n-    - CFLAGS=\"-Og -gdwarf-4\" cmake -G Ninja -DENABLE_CCACHE=ON -DCMAKE_BUILD_TYPE=Debug -DBUILD_wireshark=OFF ..\n+    # CMake build type None is required to prevent CMake from adding its own debug flags and clobbering our own.\n+    - cmake -G Ninja -DENABLE_CCACHE=ON -DCMAKE_BUILD_TYPE=None -DBUILD_wireshark=OFF ..\n     - ninja wiretap-abi-dump epan-abi-dump wsutil-abi-dump\n     - ACC_EXIT=0\n     - abi-compliance-checker -l wiretap -old ../tools/abi-dumps/wiretap-abi-13.0.0.dump -new wiretap-abi-13*.dump || ACC_EXIT=1\n",
      "collapsed": false,
      "too_large": false,
