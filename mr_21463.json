      "resolvable": false,
      "notes": [
        {
          "id": 2775352252,
          "type": null,
          "body": "It's possible that this should be platform-dependent; Windows typically allows right-click to drag or zoom plus a context menu at the end with the file chooser, etc., so Qt behaves a bit differently on Windows (the context menu event gets sent on mouse release for Windows instead of mouse press on other platforms.)",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-09-24T16:21:52.525Z",
          "updated_at": "2025-09-24T16:21:52.525Z",
          "system": false,
          "noteable_id": 418215154,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
