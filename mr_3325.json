{
  "id": 103973521,
  "iid": 3325,
  "project_id": 7898047,
  "title": "Qt: Debounce View -> Internals -> Supported Protocols \"Search\" to improve UX",
  "description": "As searching the list of protocols takes a noticeable amount\nof time and so would introduce significant lag while typing a string\ninto the Search box, we instead debounce the call to\nupdateSearchLineEdit(), so that it doesn't run until a set amount of\ntime has elapsed with no updates to the Search field.\nIf the user types something before the timer elapses, the timer restarts\nthe countdown.",
  "state": "merged",
