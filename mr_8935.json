  "discussions_data": [
    {
      "id": "dce9efaa42eb4fa1e037cbe21a11106986dd62a1",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1186684514,
          "type": null,
          "body": "@easonweii \nI think it makes no sense to display most of the fields in decimal format, since the H.224 standard for some fields explains the value in hexadecimal format, and T.35 in binary.\nI think the best would be:\n- hf_h224_q922_dlci_priority in hex\n- hf_h224_q922_ctl in hex\n- hf_h224_dta in decimal ([see H.243 rec.](https://www.itu.int/rec/T-REC-H.243-201905-I/en))\n- hf_h224_sta in decimal ([see H.243 rec.](https://www.itu.int/rec/T-REC-H.243-201905-I/en))\n- hf_h224_standard_client_id in hex\n- hf_h224_extended_client_id in hex\n- hf_h224_country_code in binary (as 16 bits separately, e.g. 00000000 00000000) ([see T.35 rec.](https://www.itu.int/rec/T-REC-T.35/en))\n- hf_h224_manufacturer_code in hex\n- hf_h224_client_id_manufacturer in hex",
          "author": {
            "id": 12778676,
            "username": "g.apollonov",
            "public_email": "andorian.rus@gmail.com",
            "name": "Gennadiy Apollonov",
            "state": "active",
            "locked": false,
