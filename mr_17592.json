  "changes_data": [
    {
      "diff": "@@ -16,6 +16,7 @@\n #include <stdint.h>\n \n #include \"epan/packet.h\"\n+#include \"ws_attributes.h\"\n #include \"ws_symbol_export.h\"\n \n /* According to TS 26.101 Table A.1b: */\n@@ -34,7 +35,7 @@\n /* version 16.0.0 Release 16: 12-14 for future use */\n #define AMR_FT_NO_DATA\t\t15\t/* NO_DATA */\n \n-struct amr_oa_hdr {\n+WS_PACKED(struct amr_oa_hdr {\n #if G_BYTE_ORDER == G_LITTLE_ENDIAN\n \t/* Payload Header */\n \tuint8_t pad1:4,\n@@ -49,7 +50,7 @@ struct amr_oa_hdr {\n \tuint8_t f:1, ft:4, q:1, pad2:2;\n #endif\n \tuint8_t data[0];\n-};\n+});\n \n WS_DLL_PUBLIC\n int amr_nb_bytes_to_ft(uint8_t bytes);\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/dissectors/packet-amr.h",
      "old_path": "epan/dissectors/packet-amr.h",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    },
    {
      "diff": "@@ -124,6 +124,25 @@ extern \"C\" {\n   #define WS_WARN_UNUSED\n #endif\n \n+/* Packed Structure: Avoid byte alignment & padding.\n+ * https://learn.microsoft.com/en-us/cpp/preprocessor/pack?view=msvc-140\n+ * https://www.gnu.org/software/c-intro-and-ref/manual/html_node/Packed-Structures.html\n+ * Use examples:\n+ * WS_PACKED(struct FooBar { int a; int b; });\n+ * WS_PACKED(typedef struct { int x; }) FooBar_t;\n+ */\n+#if defined(_MSC_VER)\n+  #define WS_PACKED_PRE __pragma(pack(push, 1))\n+  #define WS_PACKED_POST __pragma(pack(pop))\n+#elif defined(__GNUC__) || defined(__clang__)\n+  #define WS_PACKED_PRE\n+  #define WS_PACKED_POST __attribute__((__packed__))\n+#else\n+  #error \"WS_PACKED_PRE/WS_PACKED_POST unsupported\"\n+#endif\n+#define WS_PACKED(...) WS_PACKED_PRE __VA_ARGS__ WS_PACKED_POST\n+\n+\n #ifdef __cplusplus\n }\n #endif /* __cplusplus */\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "include/ws_attributes.h",
      "old_path": "include/ws_attributes.h",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": false
    }
