    {
      "id": "b26ae71d418b22041bb74d809978ec97d0c312be",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2149286014,
          "type": null,
          "body": "> That's a candidate for changing to an array rather than doing structure overlaying.\n\nDone.  All the other uses of \"packed\" are either in comments (perhaps there should be a non-C-family language to indicate packet layouts in comments) or in the AirPcap code, which is typically compiled with MSVC, not MinGW, so it's not typically being used, and it apparently doesn't need anything for MSVC, as there isn't anything there for MSVC).",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
