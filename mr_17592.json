            "id": 3212477,
            "username": "pespin",
            "public_email": "",
            "name": "pespin.shar@gmail.com",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/2bdd79a151c775a34e767cdef6cd400c152bee8db77654b502f00ef7a7dd758c?s=80&d=identicon",
            "web_url": "https://gitlab.com/pespin"
          },
          "created_at": "2024-10-09T12:34:10.914Z",
          "updated_at": "2024-10-09T12:34:10.914Z",
          "system": false,
          "noteable_id": 332721630,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
