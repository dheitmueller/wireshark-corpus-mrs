      "resolvable": false,
      "notes": [
        {
          "id": 737987316,
          "type": null,
          "body": "Right now we have hf_gtpv2_tac and hf_gtpv2_tai_tac for the EPS TAC, and hf_gtpv2_5gs_tac and hf_gtpv2_5gs_tai_tac.\nThe difference between both is whether we are calling the dissect_gtpv2_tai function or not.\nIMHO we should drop hf_gtpv2_tai_tac and hf_gtpv2_5gs_tai_tac and keep only hf_gtpv2_tac and hf_gtpv2_5gs_tac.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
