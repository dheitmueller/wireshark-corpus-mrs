  "changes_data": [
    {
      "diff": "@@ -419,17 +419,27 @@ static bool\n string_utf8_validate(const char *str, ssize_t max_len, const char **endpptr)\n {\n     bool valid;\n+    const char *endp;\n \n-    if (max_len <= 0)\n+    if (max_len <= 0) {\n+        if (endpptr) {\n+            *endpptr = str;\n+        }\n         return true;\n+    }\n+\n+    valid = g_utf8_validate(str, max_len, &endp);\n \n-    valid = g_utf8_validate(str, max_len, endpptr);\n-    if (valid || **endpptr != '\\0')\n+    if (valid || *endp != '\\0') {\n+        if (endpptr) {\n+            *endpptr = endp;\n+        }\n         return valid;\n+    }\n \n     /* Invalid because of a nul byte. Skip nuls and continue. */\n-    max_len -= *endpptr - str;\n-    str = *endpptr;\n+    max_len -= endp - str;\n+    str = endp;\n     while (max_len > 0 && *str == '\\0') {\n         str++;\n         max_len--;\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "wsutil/wmem/wmem_strbuf.c",
      "old_path": "wsutil/wmem/wmem_strbuf.c",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
