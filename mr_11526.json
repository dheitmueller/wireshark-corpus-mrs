      "notes": [
        {
          "id": 1493941100,
          "type": null,
          "body": "Wireshark search results using the new _\"MAC Address Blocks\"_ tool produce a 3 column output: **Address Block**, **Short Name** and **Vendor Name**, but `tshark -G manuf` doesn't include the **Short Name**.  Should it?",
          "author": {
            "id": 6624779,
            "username": "cjmaynard",
            "public_email": "",
            "name": "Christopher Maynard",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/6624779/avatar.png?v=1789063434",
            "web_url": "https://gitlab.com/cjmaynard"
          },
          "created_at": "2023-07-31T14:13:14.087Z",
          "updated_at": "2023-07-31T14:13:14.087Z",
          "system": false,
          "noteable_id": 239322048,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
