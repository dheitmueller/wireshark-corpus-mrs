      "resolved": true,
      "notes": [
        {
          "id": 2254382233,
          "type": "DiffNote",
          "body": "Should this pass in the `is_null` boolean parameter and only add the insert id if it is non NULL? Both and actual length encoded integer and a NULL return 0 in the integer parameter - maybe that's why the check for zero was there before.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
