    {
      "id": "7d7887bc3ad4d883fcfec22d3587575f75ea3f34",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1511252648,
          "type": null,
          "body": "Specifically, it seems to break on Linux with Qt Wayland. Works fine with `QT_QPA_PLATFORM=xcb` set. With this patch at Qt Wayland, it's not the packet bytes but the packet list scrolling that's completely broken for some reason.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2023-08-13T10:34:35.080Z",
          "updated_at": "2023-08-13T10:34:35.080Z",
          "system": false,
          "noteable_id": 192106872,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 8971,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "d993b19825bda99630e9b89afad01e46a585b43f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1511253172,
          "type": null,
          "body": "https://bugreports.qt.io/browse/QTBUG-93103\nand\nhttps://bugreports.qt.io/browse/QTBUG-76983\n\nsay that `WinId()` doesn't work on QT Wayland, which is why this patch doesn't work.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
