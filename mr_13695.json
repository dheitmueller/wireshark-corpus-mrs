  "changes_data": [
    {
      "diff": "@@ -159,7 +159,7 @@ frame_data_init(frame_data *fdata, guint32 num, const wtap_rec *rec,\n   fdata->num = num;\n   fdata->file_off = offset;\n   fdata->subnum = 0;\n-  fdata->passed_dfilter = 0;\n+  fdata->passed_dfilter = 1;\n   fdata->dependent_of_displayed = 0;\n   fdata->dependent_frames = NULL;\n   fdata->encoding = PACKET_CHAR_ENC_CHAR_ASCII;\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "epan/frame_data.c",
      "old_path": "epan/frame_data.c",
      "a_mode": "100644",
