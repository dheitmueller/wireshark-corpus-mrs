      "notes": [
        {
          "id": 2073052185,
          "type": "DiscussionNote",
          "body": "I think @geraldcombs usually takes the approach of creating a file that can be sourced that creates an environment variable in the container, so that the the CI file doesn't have to change on every branch when the container does (and prevents having to revert).\n\nRegardless, another issue is that the `wireshark-containers` job doesn't automatically run after commits (only quarterly), unless you manually run whichever job (such as the `ubuntu-dev` here).",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2024-08-23T10:34:53.774Z",
          "updated_at": "2024-08-26T21:40:36.734Z",
