  "changes_data": [
    {
      "diff": "@@ -636,22 +636,26 @@ Windows Arm64 Package:\n     expire_in: 3 days\n \n macOS Universal Package:\n+  extends: .build-macos\n   stage: build\n   rules: !reference [.if-w-w-only-merged]\n   variables:\n     CODE_SIGN_IDENTITY: \"Wireshark Foundation\"\n-    WIRESHARK_BASE_DIR: \"$CI_PROJECT_DIR/../wireshark-third-party\"\n-    FALCO_PLUGIN_DIR: \"$WIRESHARK_BASE_DIR/macos-universal-4.6/lib/falco/plugins\"\n   tags:\n-    - wireshark-macos-universal-package\n+    - wireshark-macos-universal-package-4.6\n   environment:\n     name: macos-package\n   retry: 1\n   before_script:\n-    - export PATH=\"/Library/Frameworks/Python.framework/Versions/3.13/bin:$PATH:$HOME/bin\"\n+    - brew --version\n+    - printf \"\\e[0Ksection_start:%s:brew_section[collapsed=true]\\r\\e[0KInstalling prerequisites\" \"$( date +%s)\"\n+    - brew install ccache cmake ninja python\n+    # - ./tools/macos-setup-brew.sh --install-optional --install-test-deps\n+    - printf \"\\e[0Ksection_end:%s:brew_section\\r\\e[0K\" \"$( date +%s)\"\n+    - export PATH=\"/opt/homebrew/bin:$PATH:$HOME/bin\"\n     - python3 -m venv --clear $CI_PROJECT_DIR/.venv\n     - source $CI_PROJECT_DIR/.venv/bin/activate\n-    - pip3 install pytest pytest-xdist\n+    - pip3 install dmgbuild pyobjc-framework-Quartz pytest pytest-xdist\n   script:\n     - if [[ $MACOS_REINSTALL_THIRD_PARTY == true ]] ; then rm -rf \"$WIRESHARK_BASE_DIR\" ; fi\n     - if [ ! -d \"$WIRESHARK_BASE_DIR/Qt\" ] ; then mkdir -p \"$WIRESHARK_BASE_DIR/Qt\" ; fi\n@@ -674,14 +678,12 @@ macOS Universal Package:\n       -DFALCO_PLUGINS=\"$FALCO_PLUGIN_DIR/libcloudtrail.so;$FALCO_PLUGIN_DIR/libgcpaudit.so;$FALCO_PLUGIN_DIR/libk8saudit.so\"\n       -DTEST_EXTRA_ARGS=--enable-release\n       ..\n-    # Temporary hack to fix \"Package 'zlib', required by 'libscap', not found\"\n-    - sed -i .bak '/Requires.*zlib/d' $WIRESHARK_BASE_DIR/macos-universal-4.6/lib/pkgconfig/libscap.pc\n     - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n     - ninja\n     - for exe in $( find run/{Wire,Strato}shark.app/Contents/MacOS -type f ) ; do\n         lipo \"$exe\" -verify_arch arm64 x86_64 ;\n       done\n-    - codesign-prep\n+    - base64 -d < $MACOS_CODESIGN_PREP_B64 | bash\n     - security find-identity -v -s \"$CODE_SIGN_IDENTITY\"\n     - ninja wireshark_dmg\n     - ninja stratoshark_dmg\n",
