  "commits_data": [
    {
      "id": "53cded5062330a0f1ee3c381e26ff2ec5dc9cf1a",
      "short_id": "53cded50",
      "created_at": "2021-12-11T00:19:09.000+00:00",
      "parent_ids": [
        "7d7873187e278c47a6da99bb9319ab6119d0e08b"
      ],
      "title": "wslog: Add backward compatibility with 'console.log.level'",
      "message": "wslog: Add backward compatibility with 'console.log.level'\n\nThis adds some custom logic to check if we were given\nthe obsolete 'console.log.level' setting from the CLI\narguments, that specified the log level using a bitmask\ncopied from GLib. If we find that map the bitmask to a\nwslog log level.\n\nIn any case the option is not removed from the argv (unlike\nother wslog arguments like --log-level, etc.).\n\nAdds deprecation warning for 'console.log.level' printed to\nthe console.\n\nRelated to #17763.\n",
      "author_name": "João Valverde",
      "author_email": "j@v6e.pt",
      "authored_date": "2021-12-09T16:32:42.000+00:00",
      "committer_name": "João Valverde",
      "committer_email": "j@v6e.pt",
      "committed_date": "2021-12-11T00:19:09.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/53cded5062330a0f1ee3c381e26ff2ec5dc9cf1a"
    },
    {
      "id": "7d7873187e278c47a6da99bb9319ab6119d0e08b",
      "short_id": "7d787318",
      "created_at": "2021-12-11T00:01:41.000+00:00",
      "parent_ids": [
        "7699d540940c9d6f217da5071e271fb92f1a80d6"
      ],
      "title": "GUI: Lower log level of \"up and ready\" message",
      "message": "GUI: Lower log level of \"up and ready\" message\n\nThis lowers the level of this message from \"message\" to\n\"info\". This has two side-effects:\n  - It is not displayed by default\n  - It is printed to stdout instead of stderr.\n\nSome users were depending on this message. Restore this to\nthe level it had before 05ed76d4. Even though this output is\nnot considered a stable interface restoring the old behavior\nhelps them and has no meaningful usability downsides. The\nchanges in 05ed76d4 were experimental anyway.\n\nRelated to #17763.\n",
      "author_name": "João Valverde",
      "author_email": "j@v6e.pt",
      "authored_date": "2021-12-09T19:05:31.000+00:00",
      "committer_name": "João Valverde",
      "committer_email": "j@v6e.pt",
      "committed_date": "2021-12-11T00:01:41.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/7d7873187e278c47a6da99bb9319ab6119d0e08b"
    }
  ],
