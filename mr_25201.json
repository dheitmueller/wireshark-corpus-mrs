    {
      "id": "453fef4f69301d93f7d968a23be9a9e889d80c81",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3419100086,
          "type": null,
          "body": "I think so, because `krb5.h` doesn't actually expose any functions that take a `krb5_context` - it just so happens that the Kerberos dissector and `read_keytab_file` share a global Kerberos context, though I'm not sure that is quite the right thing to do either.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
