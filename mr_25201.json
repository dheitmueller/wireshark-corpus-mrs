      "diff": "@@ -12,6 +12,7 @@\n #include <wireshark.h>\n \n #include \"read_keytab_file.h\"\n+#include \"keytab_krb5_ctx.h\"\n #include \"wmem_scopes.h\"\n \n #if defined(HAVE_HEIMDAL_KERBEROS) || defined(HAVE_MIT_KERBEROS)\n",
      "collapsed": false,
