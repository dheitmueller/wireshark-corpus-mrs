  "changes_data": [
    {
      "diff": "@@ -58,7 +58,13 @@ BuildRequires:  python3\n BuildRequires:\tgcc\n BuildRequires:\tperl\n BuildRequires:\tflex\n-BuildRequires:\tasciidoctor\n+# XXX We always require Asciidoctor for packaging builds as of 84ab55cf75,\n+# unfortunately it's not evently distributed across distros.\n+# CentOS 7: rubygem-asciidoctor\n+# CentOS 8: <no package?>\n+# Fedora: rubygem-asciidoctor\n+# openSUSE 15.2: ruby2.5-rubygem-asciidoctor\n+# BuildRequires:\tasciidoctor\n \n BuildRequires:\tglib2-devel >= 2.32.0\n Requires:\tglib2\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "packaging/rpm/wireshark.spec.in",
      "old_path": "packaging/rpm/wireshark.spec.in",
      "a_mode": "100644",
      "b_mode": "100644",
      "new_file": false,
      "renamed_file": false,
      "deleted_file": false,
      "generated_file": null
    },
    {
      "diff": "@@ -76,8 +76,8 @@ ADDITIONAL_LIST=\"libcap-devel \\\n #\toxipng \\\n #\tpngcrush\"\n \n-RPMDEPS_LIST=\"rpm-build \\\n-\trubygem-asciidoctor.noarch\"\n+# XXX\n+RPMDEPS_LIST=\"rpm-build\"\n \n # Guess which package manager we will use\n for PM in zypper dnf yum ''; do\n@@ -175,6 +175,13 @@ echo \"update-desktop-files is unavailable\" >&2\n add_package BASIC_LIST perl-podlators ||\n echo \"perl-podlators unavailable\" >&2\n \n+# rubygem-asciidoctor.noarch: Centos 7, Fedora\n+# ruby2.5-rubygem-asciidoctor: openSUSE 15.2\n+# You will get nothing and you will like it: CentOS 8\n+add_package RPMDEPS_LIST rubygem-asciidoctor.noarch || add_package RPMDEPS_LIST ruby2.5-rubygem-asciidoctor ||\n+echo \"asciidoctor is unavailable\" >&2\n+\n+\n # libcap: CentOS 7, Fedora 28, Fedora 29\n # libcap2: OpenSUSE Leap 42.3, OpenSUSE Leap 15.0\n add_package ADDITIONAL_LIST libcap || add_package ADDITIONAL_LIST libcap2 ||\n",
      "collapsed": false,
      "too_large": false,
      "new_path": "tools/rpm-setup.sh",
      "old_path": "tools/rpm-setup.sh",
