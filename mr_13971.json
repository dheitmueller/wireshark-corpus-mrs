    {
      "id": "bb9faa99aff6a2fab930fa38a474495e76467078",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1721166654,
          "type": null,
          "body": "check_decode.py is a script I've used to find issues in my own dissectors, but yesterday I tried it with some others.  It exports to PDML, then looks for things like:\n\n- gaps between fields within the same tree\n\n- items within a tree that don't fit into the parent's range",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2024-01-10T09:38:49.850Z",
          "updated_at": "2024-01-10T09:38:49.850Z",
          "system": false,
          "noteable_id": 274214498,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
