      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1003417470,
          "type": null,
          "body": "Examplary script that illustrates two potential ways to use the API:\n\n```\nlocal trivial_protocol = Proto(\"trivial\", \"Trivial Protocol\")\n\nlocal frame_field_id = Field.get_id(\"frame\")\n\nfunction trivial_protocol.dissector(buffer, pinfo, tree)\n    local frame_fields = { all_field_infos(frame_field_id) }\n    for ix, field_info in ipairs(frame_fields) do\n        tree:add(tostring(field_info.name))\n    end\n\n    local frame_if_fields = { all_field_infos(\"frame.interface_id\") }\n    for ix, field_info in ipairs(frame_if_fields) do\n        tree:add(tostring(field_info.name))\n    end\nend\n\nregister_postdissector(trivial_protocol, true)\n```",
