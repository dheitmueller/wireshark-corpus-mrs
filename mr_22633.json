      "notes": [
        {
          "id": 2936432278,
          "type": "DiscussionNote",
          "body": "This is definitely a change in behavior that should be documented in the Lua documentation (DissectorTable_try?) as part of this MR.  I can see both sides of the argument on why this is good/bad and there may need to be Lua scripts updated to have old behavior, because full dissection of all bytes is desired.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
          "created_at": "2025-12-05T18:31:43.417Z",
          "updated_at": "2025-12-10T10:08:00.053Z",
          "system": false,
          "noteable_id": 438473751,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": true,
          "resolved_by": {
