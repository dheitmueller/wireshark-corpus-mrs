        {
          "id": 879824448,
          "type": "DiscussionNote",
          "body": "I don't remember, why do we want a checkbox to show hidden interfaces?",
          "author": {
            "id": 4753670,
            "username": "stigbjorlykke",
            "public_email": "",
            "name": "Stig Bjørlykke",
