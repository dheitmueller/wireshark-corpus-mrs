  "commits_data": [
    {
      "id": "e5adb4b5064927626d7f14886602959ed83e519e",
      "short_id": "e5adb4b5",
      "created_at": "2021-03-12T18:01:47.000+00:00",
      "parent_ids": [
        "71f471253248e83b4f7999ffbe4b7893ce225b07"
      ],
      "title": "GitLab CI: Speed up our fetching/cloning.",
      "message": "GitLab CI: Speed up our fetching/cloning.\n\nFetching the complete Wireshark repository in GitLab's CI currently\ntakes about 3.5 minutes. GitLab CI lets you do shallow cloning, but only\nup to 1000 commits. This isn't sufficient for any of our jobs that might\nneed a reachable tag since it's currently about 1200 commits away in\nmaster.\n\nSet GIT_DEPTH to 1 (which appears to trigger the required shallow clone\nlogic in GitLab's CI), then deepen it by setting GIT_FETCH_EXTRA_FLAGS\nto \"--depth=5000\". This is *should* be much faster than a full checkout\nand still give us a reachable tag:\n\n$ git rev-list --count v3.3.0rc0..v3.5.0rc0\n2330\n$ git rev-list --count v3.1.0rc0..v3.3.0rc0\n2198\n$ git rev-list --count v2.9.0rc0..v3.1.0rc0\n3449\n",
      "author_name": "Gerald Combs",
      "author_email": "gerald@wireshark.org",
      "authored_date": "2021-03-11T13:56:44.000-08:00",
      "committer_name": "Wireshark GitLab Utility",
      "committer_email": "gerald+gitlab-utility@wireshark.org",
      "committed_date": "2021-03-12T18:01:47.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/e5adb4b5064927626d7f14886602959ed83e519e"
    }
