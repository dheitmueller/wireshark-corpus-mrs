    {
      "id": "30bdb08c032108f95f9ca8e3bf2b853512a069d5",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 2532311269,
          "type": "DiscussionNote",
          "body": "Port 926 (and 925) are unassigned by the IANA. Have you thought about requesting an assignment from the IANA? Your dissector does not seem to ever reject packets, so we are reluctant to register it by default to a System Port that is not assigned to your protocol. It will dissect packets that are not yours by default.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-05-29T09:43:04.444Z",
          "updated_at": "2025-05-29T10:03:23.881Z",
          "system": false,
          "noteable_id": 386948512,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 20004,
          "commands_changes": {}
        },
        {
          "id": 2532346005,
          "type": "DiscussionNote",
          "body": "Good point. I'm not sure if this was already discussed when I contributed the dissector.\n\nThis protocol is mostly used internally in AudioCodes for debugging purposes. I don't think it justifies IANA assignment. It might be ok to disable the dissector by default, like we do in TPNCP.\n\nI'll discuss it internally and update.",
          "author": {
            "id": 4838727,
            "username": "orgads",
            "public_email": "",
            "name": "Orgad Shaneh",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/d1663e2309e26976c90f9aced3f52852da603ca06f78b81af61db6f4007fcc6b?s=80&d=identicon",
            "web_url": "https://gitlab.com/orgads"
          },
          "created_at": "2025-05-29T10:03:23.808Z",
          "updated_at": "2025-05-29T10:03:23.808Z",
          "system": false,
          "noteable_id": 386948512,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 20004,
          "commands_changes": {}
        },
        {
          "id": 2532489296,
          "type": "DiscussionNote",
          "body": "TCP/UDP protocols that are unassigned by IANA (and have weak heuristics) should be handled by \"preferences\" - Either within the dissector itself or through Decode As.  \"Internal use\" means your users should probably have those preferences already set up.",
          "author": {
            "id": 8399509,
            "username": "mmann78",
            "public_email": "",
            "name": "Michael Mann",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/fad119898ba16a3f8be2f765dcff399098444abd4f85a04d4c3ef415a2bbe3d9?s=80&d=identicon",
            "web_url": "https://gitlab.com/mmann78"
          },
