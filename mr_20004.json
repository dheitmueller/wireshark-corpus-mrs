    {
      "id": "187fe9e171b79715291b368f9c237cd9ba97b974",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2594150345,
          "type": null,
          "body": "After some discussion, we've decided not to include the additional port by default.\n\nIs it acceptable to keep port 925 as-is? We have many internal users and customers relying on the dissector, and we'd prefer to keep it working out of the box for them.\n\nThe TCP removal has been submitted as a separate merge request: !20396.\n\nI'll go ahead and close this MR and wait for your confirmation regarding retaining the current port.\n\nThanks again for all your reviews!",
          "author": {
            "id": 4838727,
            "username": "orgads",
            "public_email": "",
            "name": "Orgad Shaneh",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/d1663e2309e26976c90f9aced3f52852da603ca06f78b81af61db6f4007fcc6b?s=80&d=identicon",
