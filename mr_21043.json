    {
      "id": "0dfafb49aac4bcfd7738e8cb4df467af77e7f03d",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 2709326543,
          "type": null,
          "body": "The falcodump test fails on a number of platforms because it returns having left the exit code as its initial `EXIT_FAILURE` if there are no available interfaces, which causes the test to fail. \n\nIt possibly should still print the `help` text and exit with success if `--help` is given. For the other case, with no interfaces it should either return success, or possibly should include `include/ws_exit_codes.h` and return `WS_EXIT_NO_INTERFACES`, and then the test harness should ignore that error code (but not others) if `always_present` is False.",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2025-08-26T11:20:05.197Z",
          "updated_at": "2025-08-26T11:20:05.197Z",
          "system": false,
          "noteable_id": 409759041,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
