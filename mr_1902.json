{
  "id": 87075398,
  "iid": 1902,
  "project_id": 7898047,
  "title": "QT ByteViewText: calculate string widths consistently to prevent clipping",
  "description": "For QT >5.11, stringWidth() uses horizontalAdvance, which gives different\n(longer) widths than the old boundingRect().width() method.\n\nOther locations use the boundRect().width() method directly, resulting\nin underestimating line widths and clipping the last characters in\nthe byte view window.\n\nFix by forcing all width calculations to use stringWidth().\nCloses #17087.",
  "state": "merged",
  "created_at": "2021-02-02T19:58:02.608Z",
  "updated_at": "2021-04-19T09:26:05.338Z",
