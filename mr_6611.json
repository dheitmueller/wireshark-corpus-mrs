    {
      "id": "e5d5ebf31920faa990977e6f92d0454906caea46",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1035115558,
          "type": null,
          "body": "This is an UI issue, not a resolve issue. So why not solve it via UI? Just check for the flag after accepting the new name from \"Edit Resolve Name\" and ask the user if he wants to enable name resolution? There could be scenarios, where he explicitly may not want to, and there are scenarios where he may not be aware of it.\n\nBy asking him (and sure, do it everytime why not?) you ensure the same outcome, just enable more guidance and create a learning opportunity (aka - see, if you want this than you have to do that).\n\nThat way you also would not have to mess with the whole, what gets resolved and how stuff",
          "author": {
            "id": 2498449,
            "username": "rknall",
            "public_email": "",
            "name": "Roland Knall",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9e1d973c5007651b2ca47071f80324c2de5349d873e365cf0761df5542dfe382?s=80&d=identicon",
            "web_url": "https://gitlab.com/rknall"
          },
