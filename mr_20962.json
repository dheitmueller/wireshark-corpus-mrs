      "notes": [
        {
          "id": 2696977599,
          "type": "DiffNote",
          "body": "Not all platforms have libm. [It looks as if they're part of the C library in Windows](https://learn.microsoft.com/en-us/cpp/c-runtime-library/reference/cos-cosf-cosl?view=msvc-170), and it appears to be a dummy library in Darwin, with a program using <math.h> routines just being linked with libSystem.\n\nLink with `${M_LIBRARIES}`, instead; our top-level CMakeLists.txt does `find_package(M REQUIRED)`, and cmake/modules/FindM.cmake sets `M_LIBRARIES` appropriately.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
