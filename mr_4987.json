heck direction and get ua lists */\n-    direction=cmp_address(&pinfo->src, &pinfo->dst);\n-    /* if the addresses are equal, match the ports instead */\n-    if(direction==0) {\n-        direction= (pinfo->srcport > pinfo->destport) ? 1 : -1;\n-    }\n     if(direction>=0) {\n         tcpd->fwd=&(tcpd->flow1);\n         tcpd->rev=&(tcpd->flow2);\n",
