  "changes_data": [
    {
      "diff": "@@ -847,27 +847,28 @@ static int ws80211_iface_up(const char *ifname)\n {\n \tint sock;\n \tstruct ifreq ifreq;\n+\tint err = 0;\n \n \tsock = socket(AF_PACKET, SOCK_RAW, 0);\n \tif (sock == -1)\n-\t\treturn -1;\n+\t\treturn -errno;\n \n \t(void) g_strlcpy(ifreq.ifr_name, ifname, sizeof(ifreq.ifr_name));\n \n-\tif (ioctl(sock, SIOCGIFFLAGS, &ifreq))\n-\t\tgoto out_err;\n+\tif (ioctl(sock, SIOCGIFFLAGS, &ifreq)) {\n+\t\terr = -errno;\n+\t\tgoto out;\n+\t}\n \n \tifreq.ifr_flags |= IFF_UP;\n \n-\tif (ioctl(sock, SIOCSIFFLAGS, &ifreq))\n-\t\tgoto out_err;\n-\n-\tclose(sock);\n-\treturn 0;\n+\tif (ioctl(sock, SIOCSIFFLAGS, &ifreq)) {\n+\t\terr = -errno;\n+\t}\n \n-out_err:\n+out:\n \tclose(sock);\n-\treturn -1;\n+\treturn err;\n }\n \n /* Needed for NLA_PUT_STRING, which passes strlen as an int */\n",
