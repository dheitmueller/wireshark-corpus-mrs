tree, hf_usb_darwin_iso_status, tvb, offset + 8, 4, ENC_LITTLE_ENDIAN, &status);\n+\n+            proto_item_append_text(iso_desc_ti, \" [%s]\", val_to_str_ext(status, &usb_darwin_status_vals_ext, \"Error %d\"));\n \n             /* Data */\n             if (frame_length > len) {\n",
