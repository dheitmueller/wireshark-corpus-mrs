        },
        {
          "id": 493419334,
          "type": "DiscussionNote",
          "body": "The [Ask question](https://ask.wireshark.org/question/20889/problem-with-extcap-preferences-in-tshark-wireshark-342/) (Problem with extcap preferences in TShark (Wireshark) 3.4.2) for context.",
          "author": {
            "id": 6701257,
            "username": "chuckcraft",
            "public_email": "",
            "name": "Chuck Craft",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/0809ffc6d9d98013a1895132bc055c622830b8a20bfa49328f53d5eb4a1206cb?s=80&d=identicon",
            "web_url": "https://gitlab.com/chuckcraft"
          },
          "created_at": "2021-01-25T16:38:37.669Z",
          "updated_at": "2021-01-25T16:39:20.371Z",
          "system": false,
