        {
          "id": 492702799,
          "type": "DiscussionNote",
          "body": "This reverts part of 9c53ac018759f6fca092d8aa8411aa9f9411950c (by @geraldcombs). I wonder whether this will result in a slowdown on startup when trying to probe for extcap interfaces even if no capture is in progress. Should it be reverted and replaced by a more targeted fix?",
          "author": {
            "id": 2415432,
            "username": "Lekensteyn",
            "public_email": "",
            "name": "Peter Wu",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/efcf30db53f30b15e7c905ef37bd4dc44d87573bd92baf97cd707115d3fcd0c0?s=80&d=identicon",
            "web_url": "https://gitlab.com/Lekensteyn"
          },
          "created_at": "2021-01-24T23:30:50.301Z",
          "updated_at": "2021-01-24T23:30:50.301Z",
