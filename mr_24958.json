  "changes_data": [
    {
      "diff": "@@ -34,7 +34,7 @@ variables:\n   HOMEBREW_COLOR: \"1\"\n   # Skip irrelevant SAST scanners:\n   SAST_EXCLUDED_ANALYZERS: \"brakeman,eslint,security-code-scan,semgrep,spotbugs\"\n-  RCLONE_CONFIG: \"s3\n+  WS_RCLONE_REMOTE_OPTS: \"s3\n     provider=AWS\n     region=us-east-2\n     env_auth=true\n@@ -333,7 +333,7 @@ Source Package:\n     # - ccache --max-size $( du --summarize --block-size=1M \"$CI_PROJECT_DIR/build\" | awk '{printf (\"%dM\", $1 * 1.5)}' )\n     - if [ \"$CI_JOB_STATUS\" != \"success\" ]; then exit 0 ; fi\n     - if [ -n \"$SCHEDULE_TYPE\" ] ; then exit 0 ; fi\n-    - rclone config create wireshark $RCLONE_CONFIG\n+    - rclone config create wireshark $WS_RCLONE_REMOTE_OPTS\n     - stat --format=\"%n %s bytes\" wireshark-*.tar.*\n     - for digest in sha512 sha256 sha1 ; do openssl $digest wireshark-*.tar.* ; done\n     - if [ -n \"$S3_DESTINATION_DIST\" ] ; then rclone copy . \"wireshark:$S3_DESTINATION_DIST\" --include \"wireshark-*.tar.*\" ; fi\n@@ -581,14 +581,7 @@ Windows x64 Package:\n     - msbuild /verbosity:minimal pdb_zip_package.vcxproj\n     - C:\\gitlab-builds\\bin\\mse-scan.ps1\n     - run\\RelWithDebInfo\\tshark --version\n-    - rclone config create wireshark s3\n-      provider=AWS\n-      region=us-east-2\n-      env_auth=true\n-      endpoint=$S3_ENDPOINT_WIRESHARK\n-      acl=private\n-      --non-interactive --obscure\n-    # --no-output\n+    - rclone config create wireshark @(-split $env:WS_RCLONE_REMOTE_OPTS) --no-output\n     - $packages = Get-ChildItem \"packaging\\nsis\\Wireshark-*-x64.exe\", \"packaging\\nsis\\Stratoshark-*-x64.exe\", \"packaging\\wix\\Wireshark-*-x64.msi\", \"packaging\\portableapps\\WiresharkPortable??_*.paf.exe\", \"Wireshark-pdb-*x64.zip\"\n     - foreach ($package in $packages) { Write-Host $package.name $(Get-Filehash -Algorithm SHA256 $package).Hash.ToLower() $package.length \"bytes\" }\n     - if (Test-Path env:S3_DESTINATION_WINDOWS_X64) { foreach ($package in $packages) { rclone copyto $package \"wireshark:$env:S3_DESTINATION_WINDOWS_X64/$($package.Name)\" --missing-on-dst - } }\n@@ -635,14 +628,7 @@ Windows Arm64 Package:\n     - msbuild /verbosity:minimal pdb_zip_package.vcxproj\n     - C:\\gitlab-builds\\bin\\mse-scan.ps1\n     - run\\RelWithDebInfo\\tshark --version\n-    - rclone config create wireshark s3\n-      provider=AWS\n-      region=us-east-2\n-      env_auth=true\n-      endpoint=$S3_ENDPOINT_WIRESHARK\n-      acl=private\n-      --non-interactive --obscure\n-    # --no-output\n+    - rclone config create wireshark @(-split $env:WS_RCLONE_REMOTE_OPTS) --no-output\n     - $packages = Get-ChildItem \"packaging\\nsis\\Wireshark-*-arm64.exe\", \"packaging\\nsis\\Stratoshark-*-arm64.exe\", \"Wireshark-pdb-*arm64.zip\"\n     - foreach ($package in $packages) { Write-Host $package.name $(Get-Filehash -Algorithm SHA256 $package).Hash.ToLower() $package.length \"bytes\" }\n     - if (Test-Path env:S3_DESTINATION_WINDOWS_ARM64) { foreach ($package in $packages) { rclone copyto $package \"wireshark:$env:S3_DESTINATION_WINDOWS_ARM64/$($package.Name)\" --missing-on-dst - } }\n",
