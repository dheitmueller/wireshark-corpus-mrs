    {
      "id": "caf5a99ee5985db0862bd39ece39795efaecb327",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3091618465,
          "type": null,
          "body": "I'm not sure from the documentation how much trouble Qt goes to for the problem of \"if neither of these files exist, would the names compare equally if they existed?\"",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-02-17T22:22:26.515Z",
          "updated_at": "2026-02-17T22:22:26.515Z",
          "system": false,
          "noteable_id": 456610543,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 23630,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "5a595076f7558779749eeefc52e7def69820fb16",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3091643376,
          "type": null,
          "body": "> I'm not sure from the documentation how much trouble Qt goes to for the problem of \"if neither of these files exist, would the names compare equally if they existed?\"\n\nThe tl;dr version of [the Qt 6 QFileInfo documentation for the `==` operator](https://doc.qt.io/qt-6/qfileinfo.html#operator-eq-eq):\n\n> Note that the result of comparing two empty QFileInfo objects, containing no file system entry references (paths that do not exist or are empty), is undefined.\n\nappears to be \"as little trouble as possible\".",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
