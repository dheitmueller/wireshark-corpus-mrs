    {
      "id": "a28901390380ffb078a189cccb22c89b4c0f5e83",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 3091592211,
          "type": null,
          "body": "The native Qt way to do it is to create [QFileInfo](https://doc.qt.io/qt-6/qfileinfo.html#operator-eq-eq)s for each path, and if they both exist, use the overloaded equals operator to compare them. That is supposed to do the right thing with regards to case sensitivity of the filesystem on Darwin since 6.8, but apparently not on FreeBSD (and maybe not on Windows?) See https://qt-project.atlassian.net/browse/QTBUG-28246\n\nIt resolves to canonical paths; it does compare differently for symlinks that point to the same thing (I think that's good) and also differently for the Windows short path and long path (fine).",
          "author": {
            "id": 6764551,
            "username": "johnthacker",
            "public_email": "",
            "name": "John Thacker",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/99c30adacedf45514aaf711ba8a44f56322ebb53e9b550b7e3c9cd83bd6a1408?s=80&d=identicon",
            "web_url": "https://gitlab.com/johnthacker"
          },
          "created_at": "2026-02-17T22:08:14.702Z",
          "updated_at": "2026-02-17T22:08:14.702Z",
          "system": false,
          "noteable_id": 456610543,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
