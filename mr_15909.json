      "title": "CMake+NSIS: Add the CloudTrail Falco plugin",
      "message": "CMake+NSIS: Add the CloudTrail Falco plugin\n\nWe now have CloudTrail plugin builds for Windows, so add a way to discover\nthem and add them to the Logray NSIS package.\n",
      "author_name": "Gerald Combs",
      "author_email": "gerald@wireshark.org",
      "authored_date": "2024-06-08T17:51:23.000-07:00",
      "committer_name": "Gerald Combs",
      "committer_email": "gerald@wireshark.org",
