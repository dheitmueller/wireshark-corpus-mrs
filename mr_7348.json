    {
      "id": "74a4dcd8b2c56a5c8bf7810c44cc86975ca18398",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 1027470737,
          "type": "DiffNote",
          "body": "This does not work.\n\nAny `proto_tree_add_..._ret_...` routine must *always* return a value through the `retval` pointer, even if `tree` is null, even if no protocol tree is being built, as there's no guarantee that a protocol tree will be built under all circumstances (for example, if the dissection is only being done to generate the column values, no column is a custom column, there are no coloring rules, etc., so that none of the named field values are of interest, and the protocol tree isn't going to be displayed, no protocol tree will be built).\n\nThis causes bug #18203, and is fixed in !7432.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2022-07-15T07:30:31.788Z",
          "updated_at": "2022-07-15T07:30:31.788Z",
