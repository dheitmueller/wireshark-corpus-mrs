        {
          "id": 3068254547,
          "type": "DiffNote",
          "body": "`unsaved_changes` is a flag specific to \"read the file in and let the user edit it\" applications such as Wireshark; it indicates that the user has made edits but hasn't done a \"Save\" operation.\n\nPrograms that read one file and write out another file, with some processing in between, have a different path, so those programs, e.g. TShark and editcap, don't need it.",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2026-02-09T07:24:00.616Z",
          "updated_at": "2026-02-09T13:12:32.644Z",
          "system": false,
          "noteable_id": 454000075,
