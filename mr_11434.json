    {
      "id": "bbbbd135c0023a5fb2d8d148a151fb1826e0c827",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1471174968,
          "type": null,
          "body": "Thanks Jaap.\n\n@pquantin - do you think this was worth doing?  There are some other cases where the function from the conformance file returns something else (I think a call to tvb_captured_length), but asn2ws.py still writes '  return offset;' after it (which will never be reached).  It maybe worth exploring whether we can detect a return at the top-level at the end of the function from the conformance file, and avoid generating '  return offset;' in those cases?",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/030414c33f619ee28811cd9c073802ef2267d160ab2744eb8427bd49af4c7998?s=80&d=identicon",
            "web_url": "https://gitlab.com/martin.r.mathieson"
          },
          "created_at": "2023-07-16T09:04:50.495Z",
          "updated_at": "2023-07-16T09:04:50.495Z",
          "system": false,
          "noteable_id": 236771600,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": false,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 11434,
          "commands_changes": {}
        }
      ]
    },
    {
      "id": "35cae9a4abf29a897c13bcd5a264df43a4ee9122",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1471184644,
          "type": null,
          "body": "I think it was worth fixing it, but I'm not sure it is worth the trouble trying to detect it given the low occurrence number compared to the thousands of lines that were OK. I could have expected a compiler or static analyser complaining instead.",
          "author": {
            "id": 6722527,
            "username": "pquantin",
            "public_email": "",
            "name": "Pascal Quantin",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/9bf49edc6acae0eca821eb90309381794fb4fbea4f3fb7c2378428862ddbb430?s=80&d=identicon",
            "web_url": "https://gitlab.com/pquantin"
          },
