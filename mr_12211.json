  "changes_data": [
    {
      "diff": "@@ -606,12 +606,32 @@ check_relation_LHS_FIELD(dfwork_t *dfw, stnode_op_t st_op _U_,\n \theader_field_info\t*hfinfo1;\n \tftenum_t\t\tftype1, ftype2;\n \tfvalue_t\t\t*fvalue;\n+\tstnode_t\t\t*st_tmp;\n \n \tLOG_NODE(st_node);\n \n-\tif (stnode_type_id(st_arg1) == STTYPE_FIELD)\n+\tif (stnode_type_id(st_arg1) == STTYPE_FIELD) {\n \t\tdfw->field_count++;\n \n+                /* When comparing a protocol with an integer field, the protocol\n+                 * name could be a member of a value_string, as seen with e.g.\n+                 * \"smb2.cmd == find\", \"smb2.cmd in {find}\" and \"find == smb2.cmd\". */\n+\t\tif (stnode_type_id(st_arg2) == STTYPE_FIELD) {\n+\t\t\tftype1 = sttype_field_ftenum(st_arg1);\n+\t\t\tftype2 = sttype_field_ftenum(st_arg2);\n+\t\t\tif (FT_IS_INTEGER(ftype1) && ftype2 == FT_PROTOCOL) {\n+\t\t\t\t/* Use protocol name as a string literal. */\n+\t\t\t\tstnode_replace(st_arg2, STTYPE_LITERAL, g_strdup(st_arg2->repr_token));\n+\t\t\t} else if (ftype1 == FT_PROTOCOL && FT_IS_INTEGER(ftype2)) {\n+\t\t\t\t/* Swap arguemnts so LHS remains a FIELD. */\n+\t\t\t\tst_tmp = st_arg1;\n+\t\t\t\tst_arg1 = st_arg2;\n+\t\t\t\tst_arg2 = st_tmp;\n+\t\t\t\tstnode_replace(st_arg2, STTYPE_LITERAL, g_strdup(st_arg2->repr_token));\n+\t\t\t}\n+\t\t}\n+\t}\n+\n \thfinfo1 = sttype_field_hfinfo(st_arg1);\n \tftype1 = sttype_field_ftenum(st_arg1);\n \tif (!can_func(ftype1)) {\n",
