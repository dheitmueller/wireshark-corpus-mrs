      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/b27a29b9e5d0ce3856c14882c6e4be76f4ab0ea1"
    },
    {
      "id": "15f02361f5ab6c605247b42dc77a207af07ba88f",
      "short_id": "15f02361",
      "created_at": "2024-10-31T12:53:50.000+00:00",
      "parent_ids": [
        "c020c3b214d39f6b441561520788346e71a476dc"
      ],
      "title": "epan: Fix decoding of ASN.1 REAL numbers with zero length (0.0)",
      "message": "epan: Fix decoding of ASN.1 REAL numbers with zero length (0.0)\n\nThe length zero is valid for ASN.1 REAL types representing the value 0.0.\nRemoved the incorrect check that treated (val_length == 0) as an unexpected length,\nallowing proper decoding of REAL numbers with zero length.\n",
      "author_name": "Piotr Gawlowicz",
      "author_email": "piotr.gawlowicz@srs.io",
      "authored_date": "2024-10-31T11:22:31.000+01:00",
      "committer_name": "John Thacker",
      "committer_email": "johnthacker@gmail.com",
      "committed_date": "2024-10-31T12:53:50.000+00:00",
      "trailers": {},
      "extended_trailers": {},
      "web_url": "https://gitlab.com/wireshark/wireshark/-/commit/15f02361f5ab6c605247b42dc77a207af07ba88f"
    },
    {
      "id": "c020c3b214d39f6b441561520788346e71a476dc",
      "short_id": "c020c3b2",
      "created_at": "2024-10-31T12:53:50.000+00:00",
      "parent_ids": [
        "af92dfa217185395a986ea1e5d37caf19cefdb02"
      ],
      "title": "epan: Fix asn1 REAL number decoding by correcting lenE assertion",
      "message": "epan: Fix asn1 REAL number decoding by correcting lenE assertion\n\nAdjusted the assertion from (lenE < len - 1) to (lenE < len) because len is decremented after decoding info_octet.\nNote that len = 1B (info_octet) + lenE (Exponent Length, 1-3B) + lenM (Mantissa Length).\n",
      "author_name": "Piotr Gawlowicz",
      "author_email": "piotr.gawlowicz@srs.io",
      "authored_date": "2024-10-29T12:30:23.000+01:00",
      "committer_name": "John Thacker",
      "committer_email": "johnthacker@gmail.com",
      "committed_date": "2024-10-31T12:53:50.000+00:00",
