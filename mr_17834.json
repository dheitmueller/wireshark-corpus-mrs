      "title": "epan: Add handling for ASN.1 REAL special value NaN",
      "message": "epan: Add handling for ASN.1 REAL special value NaN\n\nAdd support for decoding the ASN.1 REAL special value of NaN.\n",
      "author_name": "Piotr Gawlowicz",
      "author_email": "piotr.gawlowicz@srs.io",
      "authored_date": "2024-10-31T12:57:56.000+01:00",
      "committer_name": "John Thacker",
      "committer_email": "johnthacker@gmail.com",
      "committed_date": "2024-10-31T12:53:50.000+00:00",
      "trailers": {},
