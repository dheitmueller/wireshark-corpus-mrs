      "diff": "@@ -140,6 +140,7 @@ void proto_reg_handoff_ipv6(void);\n /* Protocol specific data indices */\n #define IPV6_PROTO_VALUE            1\n #define IPV6_PROTO_PINFO            2\n+#define IPV6_PROTO_GLOBAL_PINFO     3\n \n static int ipv6_tap;\n \n@@ -615,6 +616,11 @@ extern const ws_in6_addr *tvb_get_ptr_ipv6(tvbuff_t tvb, int offset);\n #define tvb_get_ptr_ipv6(tvb, offset) \\\n     ((const ws_in6_addr *)tvb_get_ptr(tvb, offset, IPv6_ADDR_SIZE))\n \n+ipv6_pinfo_t *p_get_ipv6_layer_pinfo(packet_info *pinfo, int layer_num)\n+{\n+    return (ipv6_pinfo_t *)p_get_proto_data(pinfo->pool, pinfo, proto_ipv6, (layer_num << 8) | IPV6_PROTO_GLOBAL_PINFO);\n+}\n+\n ipv6_pinfo_t *p_get_ipv6_pinfo(packet_info *pinfo)\n {\n     return (ipv6_pinfo_t *)p_get_proto_data(pinfo->pool, pinfo, proto_ipv6, (pinfo->curr_proto_layer_num << 8) | IPV6_PROTO_PINFO);\n@@ -3826,6 +3832,7 @@ dissect_ipv6(tvbuff_t *tvb, packet_info *pinfo, proto_tree *tree, void* data _U_\n         ipv6_pinfo->ipv6_item_len = IPv6_HDR_SIZE;\n     }\n     p_add_proto_data(pinfo->pool, pinfo, proto_ipv6, (pinfo->curr_proto_layer_num << 8) | IPV6_PROTO_PINFO, ipv6_pinfo);\n+    p_add_proto_data(pinfo->pool, pinfo, proto_ipv6, (pinfo->curr_layer_num << 8) | IPV6_PROTO_GLOBAL_PINFO, ipv6_pinfo);\n \n     /* Adjust the length of this tvbuff to include only the IPv6 datagram. */\n     set_actual_length(tvb, IPv6_HDR_SIZE + plen);\n",
