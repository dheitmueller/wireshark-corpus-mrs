    {
      "id": "4dd4079269001ef90051cb874b827495d60e41b3",
      "individual_note": false,
      "resolvable": true,
      "resolved": false,
      "notes": [
        {
          "id": 624380579,
          "type": "DiscussionNote",
          "body": "We need a Windows build in the merge pipeline, to catch code that passes on UN\\*Xes but not Windows.  In this case, it \"passes\" because it's only compiled on Windows.\n\n(macOS might also be nice as well, but as it's a UN\\*X, it's probably a lower priority.)",
          "author": {
            "id": 5636682,
            "username": "guyharris",
            "public_email": "",
            "name": "Guy Harris",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/1b7c243a9b1d6587a9a9067e5d83aba1e87212df7c4eeae3690f791ecbe4675a?s=80&d=identicon",
            "web_url": "https://gitlab.com/guyharris"
          },
          "created_at": "2021-07-12T21:55:30.318Z",
          "updated_at": "2021-07-12T22:23:45.907Z",
          "system": false,
          "noteable_id": 107954753,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 3645,
          "commands_changes": {}
        },
        {
          "id": 624391347,
          "type": "DiscussionNote",
          "body": "We do have one, but since GitLab's shared Windows runners don't currently let you use custom docker images and since it takes more than 60 minutes to install all of our prerequisites and build Wireshark on GitLab's Windows docker image, we use a dedicated (\"specific\") runner for our Windows builds. It gets run sometimes, e.g. for merge requests that are run under gitlab.com/wireshark/wireshark, but not always, e.g. for ones that are run under forks.",
          "author": {
            "id": 860017,
            "username": "geraldcombs",
            "public_email": "",
            "name": "Gerald Combs",
            "state": "active",
            "locked": false,
            "avatar_url": "https://gitlab.com/uploads/-/system/user/avatar/860017/avatar.png?v=1789948913",
            "web_url": "https://gitlab.com/geraldcombs"
          },
          "created_at": "2021-07-12T22:23:45.855Z",
          "updated_at": "2021-07-12T22:24:26.525Z",
          "system": false,
          "noteable_id": 107954753,
          "noteable_type": "MergeRequest",
          "project_id": 7898047,
          "resolvable": true,
          "resolved": false,
          "resolved_by": null,
          "resolved_at": null,
          "confidential": false,
          "internal": false,
          "imported": false,
          "imported_from": "none",
          "noteable_iid": 3645,
