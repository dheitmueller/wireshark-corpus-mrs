    {
      "id": "a54a518779749d93730193b1eb7dbdbb128e220c",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 550896080,
          "type": null,
          "body": "Apologies, I omitted the `-s` in my original PR description. Using the real (symlink) command from the current documentation, the link created is incorrect:\n```\nwireshark$ ln -s ./tools/pre-commit .git/hooks\nwireshark$ ls -l .git/hooks/pre-commit\nlrwxrwxrwx 1 mal mal 18 Apr 13 14:07 .git/hooks/pre-commit -> ./tools/pre-commit\nwireshark$ realpath .git/hooks/pre-commit\nrealpath: .git/hooks/pre-commit: No such file or directory\nwireshark$ rm .git/hooks/pre-commit\nwireshark$ ln -s ../../tools/pre-commit .git/hooks\nwireshark$ realpath .git/hooks/pre-commit\n/tmp/wireshark/tools/pre-commit\n```",
          "author": {
            "id": 3284432,
            "username": "half-duplex",
            "public_email": "",
            "name": "mal",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/4348868c84e71ab88dc310b0dbab07b6c3fef6cc6387efa233088cc400953392?s=80&d=identicon",
