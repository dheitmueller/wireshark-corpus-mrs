  "discussions_data": [
    {
      "id": "0a12d22a833185da6d6ba8b17f2713ecd12ca74f",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 550423583,
          "type": null,
          "body": "The WSDG text for this item assumes that your current working directory is the root of your git repository, i.e. the \"wireshark\" directory, as do all the previous git example commands and in that case the text is correct.  The proposed modification assumes the working directory is two levels deeper than the wireshark directory, hence the \"../..\" prefix, but then the destination .git/hooks will be incorrect.\n\nI don't think this change should be merged.",
          "author": {
            "id": 6621762,
            "username": "graham.bloice",
            "public_email": "",
            "name": "Graham Bloice",
            "state": "active",
            "locked": false,
