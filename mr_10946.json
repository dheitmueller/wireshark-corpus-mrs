      "diff": "@@ -13,6 +13,7 @@ set -e -u -o pipefail\n \n eval \"$(brew shellenv)\"\n \n+HOMEBREW_NO_AUTO_UPDATE=${HOMEBREW_NO_AUTO_UPDATE:-}\n # Update to last brew release\n if [ -z \"$HOMEBREW_NO_AUTO_UPDATE\" ] ; then\n     brew update\n",
