  "changes_data": [
    {
      "diff": "@@ -1034,6 +1034,30 @@ No options:\n       -DENABLE_ZLIB=OFF -DENABLE_ZSTD=OFF -DBUILD_mmdbresolve=OFF ..\n     - ninja\n \n+Clang ASAN Build:\n+  extends: .build-ubuntu\n+  tags:\n+    - saas-linux-medium-amd64\n+  rules: !reference [.if-plain-merge-request]\n+  needs:\n+    - job: \"Commit Check\"\n+      optional: true\n+  script:\n+    - source /clang-latest.env\n+    - printf \"\\e[0Ksection_start:%s:cmake_section[collapsed=true]\\r\\e[0KRunning CMake\" \"$( date +%s)\"\n+    - cmake --preset=ninja_ccache -DCMAKE_BUILD_TYPE=Debug -DENABLE_ASAN=ON -DENABLE_WERROR=ON -DBUILD_stratoshark=ON ..\n+    - printf \"\\e[0Ksection_end:%s:cmake_section\\r\\e[0K\" \"$( date +%s)\"\n+    - ninja\n+    - ninja test-programs\n+    - chown -R user .\n+    - if [ -f run/dumpcap ]; then setcap cap_net_raw,cap_net_admin+eip run/dumpcap; fi\n+    - if [ -f run/dumpcap ]; then su user -c \"run/dumpcap -D\" ; fi\n+    - WIRESHARK_DEBUG_WMEM_OVERRIDE=simple PYTEST_ADDOPTS=\"--skip-missing-programs=dumpcap,rawshark,falcodump --enable-stratoshark\" su user -c \"pytest --junitxml=../clang_asan_tests.xml\"\n+  artifacts:\n+    when: always\n+    reports:\n+      junit: clang_asan_tests.xml\n+\n # Windows runners are still beta, at least technically:\n # https://docs.gitlab.com/ee/user/gitlab_com/index.html#windows-shared-runners-beta\n Windows Build:\n",
