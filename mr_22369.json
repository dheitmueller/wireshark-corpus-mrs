            "id": 31712054,
            "username": "rrtake",
            "public_email": "",
            "name": "Ryosuke Takenaka",
            "state": "active",
            "locked": false,
            "avatar_url": "https://secure.gravatar.com/avatar/11a1b4da2d26d77da5c4669f26d2b8aadaaae4714d849267cbbab6023bc95c4d?s=80&d=identicon",
            "web_url": "https://gitlab.com/rrtake"
