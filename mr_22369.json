      "resolvable": false,
      "notes": [
        {
          "id": 2932654796,
          "type": null,
          "body": "I pushed the new change. Please review it.\n\n* Added the new definition 'BGP_MAX_PACKET_SIZE_EXTENDED 65535'.\n* Extended the size of the bgp_len from 2 bytes to 4 bytes to count a length greater than 65535.\n* Added the new function to check the bgp_len with each message type.",
