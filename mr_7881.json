  "changes_data": [
    {
      "diff": "@@ -631,7 +631,9 @@ ABI Check:\n     - DEBIAN_FRONTEND=noninteractive apt-get --yes install abi-dumper abi-compliance-checker\n     # Ubuntu 20.04 ships with version 1.1, which has issues: https://github.com/lvc/abi-dumper/issues/21\n     - curl --fail -JL https://raw.githubusercontent.com/lvc/abi-dumper/1.2/abi-dumper.pl > /usr/bin/abi-dumper\n-    - CFLAGS=\"-Og\" cmake -G Ninja -DENABLE_CCACHE=ON -DCMAKE_BUILD_TYPE=Debug -DBUILD_wireshark=OFF ..\n+    # ABI dumper version 1.3 required for DWARF-5 support (the GCC 11 default). Version 1.3 is still not released.\n+    # https://github.com/lvc/abi-dumper/issues/34\n+    - CFLAGS=\"-Og -gdwarf-4\" cmake -G Ninja -DENABLE_CCACHE=ON -DCMAKE_BUILD_TYPE=Debug -DBUILD_wireshark=OFF ..\n     - ninja wiretap-abi-dump epan-abi-dump wsutil-abi-dump\n     - ACC_EXIT=0\n     - abi-compliance-checker -l wiretap -old ../tools/abi-dumps/wiretap-abi-13.0.0.dump -new wiretap-abi-13*.dump || ACC_EXIT=1\n",
      "collapsed": false,
      "too_large": false,
      "new_path": ".gitlab-ci.yml",
      "old_path": ".gitlab-ci.yml",
