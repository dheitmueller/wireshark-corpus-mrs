  "discussions_data": [
    {
      "id": "1c3e10606e3ec20ca3609e8844e36d9cf5b335c4",
      "individual_note": true,
      "resolvable": false,
      "notes": [
        {
          "id": 1267551521,
          "type": null,
          "body": "tools/check_static.py shows 274 symbols that are in header files, but not referenced by any other modules.\n\nSome of these are not called at all, some are called by only that module.  The only valid reason not to either make them static or delete them, is that they might be called by private dissectors, e.g. to set key information that is logged by some internal protocol.  I think this is the exception though, and in most cases declarations in header files are caused by laziness about ordering functions (or a reluctance to maintain some forward declarations).",
          "author": {
            "id": 6810036,
            "username": "martin.r.mathieson",
            "public_email": "",
            "name": "Martin Mathieson",
            "state": "active",
            "locked": false,
